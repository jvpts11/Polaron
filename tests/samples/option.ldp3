program OptionTest;

// A generic Maybe<T> built from generic inheritance + virtual dispatch. (Named Maybe/Just/Nothing
// rather than Option/Some/None, which are now built-in prelude types; this is a generics demo.)
public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Maybe<T> {
            public constructor Maybe() {}
            public method isSome() returns boolean { return false; }
            public method orElse(T fallback) returns T { return fallback; }
        }
        public class Just<T> extends Maybe<T> {
            private T value;
            public constructor Just(T value) { this.value = value; }
            public override method isSome() returns boolean { return true; }
            public override method orElse(T fallback) returns T { return this.value; }
        }
        public class Nothing<T> extends Maybe<T> {
            public constructor Nothing() {}
        }

        public class Main {
            public static method main(string[] args) returns void {
                Maybe<int>* a = new Just<int>(42) on heap;
                Maybe<int>* b = new Nothing<int>() on heap;
                System.IO.Console.println($"a: some={a.isSome()} val={a.orElse(0)}");    // some=1 val=42
                System.IO.Console.println($"b: some={b.isSome()} val={b.orElse(99)}");   // some=0 val=99
                delete a;
                delete b;
                return;
            }
        }
    }
}
