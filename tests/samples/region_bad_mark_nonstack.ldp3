import System.Memory.Units.kilobytes;
program RegionBadMarkNonStack;

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                pool region k = itself.allocate(1 kilobytes);
                checkpoint m = mark of region k;   // LDP3-1713: mark needs a stack region
                rollback region k to m;
                release region k;
                return;
            }
        }
    }
}
