import System.IO.Console;
import System.Text.JaroWinkler;
program JaroWinklerDemo;

// Jaro-Winkler string similarity (spec 34) in pure LDP3. Prints:
//   martha=0.961 dixon=0.813 same=1.000
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("martha=%.3f dixon=%.3f same=%.3f\n",
                    JaroWinkler.similarity("MARTHA", "MARHTA"),
                    JaroWinkler.similarity("DIXON", "DICKSONX"),
                    JaroWinkler.similarity("hello", "hello"));
                return;
            }
        }
    }
}
