import System.IO.Console;
import System.IO.Paths;
program PathUtils;

// Path-string manipulation (spec 34.4): join segments with a separator, and split a path into its final
// component, directory, and extension. Pure string work, no filesystem access.
// Prints: join=src/lib/file.ldp3 / base=file.ldp3 dir=src/lib ext=ldp3 noext=[].
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("join=%s\n", Paths.join("src/lib", "file.ldp3"));
                System.IO.Console.printf("base=%s dir=%s ext=%s\n",
                    Paths.basename("src/lib/file.ldp3"),
                    Paths.dirname("src/lib/file.ldp3"),
                    Paths.extension("src/lib/file.ldp3"));
                System.IO.Console.printf("noext=[%s]\n", Paths.extension("README"));
                return;
            }
        }
    }
}
