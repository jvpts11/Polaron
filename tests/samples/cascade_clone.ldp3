import System.IO.Console;
program CascadeClone;

// `cascade clone X into Y` (spec 37.1) deep-copies X's owned graph (value fields and owned
// pointers) into a fresh graph stored in Y, sharing nothing with the original. Mutating the clone
// leaves the original untouched. A shared or cyclic graph is cloned once via an original-to-clone
// map.

public bundle main {
    public namespace app {
        public class Node {
            public mutable int id;
            public mutable Node* next;
            public constructor Node() {
                this.id = 0;
                this.next = null;
            }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Node* a = new Node() on heap; a.id = 1;
                Node* b = new Node() on heap; b.id = 2;
                a.next = b;
                Node* c = null;
                cascade clone a into c;          // c is a deep copy of a's graph
                c.id = 100; c.next.id = 200;     // mutate the clone only
                System.IO.Console.println($"{a.id} {a.next.id} {c.id} {c.next.id}");
                cascade delete a;
                cascade delete c;
                return;
            }
        }
    }
}
