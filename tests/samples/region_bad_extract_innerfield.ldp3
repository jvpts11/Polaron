import System.Memory.Units.kilobytes;
program RegionBadExtractInnerField;

public bundle main {
    public namespace app {

        public class Node {
            public mutable int v;
            public mutable nullable Node* next;
            public constructor Node(int x) {
                this.v = x;
                this.next = null;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                pool region R = itself.allocate(1 kilobytes);
                Node* n = new Node(1) in region R;
                n.next = new Node(2) in region R;      // sibling in the SAME region
                Node* out = extract n from region R;   // LDP3-1718: n.next lives in R
                delete out;
                release region R;
                return;
            }
        }
    }
}
