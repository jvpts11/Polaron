import System.IO.Console;

// `File` is a type the compiler answers for itself (spec 34) -- there is no prelude class to
// redeclare, so nothing looked like a collision and the name was simply taken over. The failure
// surfaced as four errors inside <prelude> telling the STANDARD LIBRARY to import your class.
//
// `Math` is the deliberate exception and lives in stdlib_name_shadow.ldp3: it is virtual precisely so
// a program with its own Math compiles.
program BuiltinNameBad;

public bundle main {
    public namespace app {

        public class File {
            public mutable int v;
            public constructor File(int v) { this.v = v; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                File f = new File(1) on stack;
                System.IO.Console.println($"{f.v}");
                return;
            }
        }
    }
}
