import System.IO.Console;
program ForeachCSharp;

// The C#-style `foreach` keyword. Polaron keeps both spellings -- `for (T v in coll)` (Java/C++) and
// `foreach (T v in coll)` (C#) -- as pure style choices that lower to the same loop. Also models the
// new import model's PascalCase bundle/namespace convention.
public bundle App {
    public namespace Demo {
        public class Main {
            public static method main(string[] args) returns void {
                int[] nums = new int[5]();
                for (mutable int i = 0; i < 5; i++) {
                    nums[i] = i * i;
                }
                // foreach over an array with an inferred element type.
                mutable int sum = 0;
                foreach (var x in nums) {
                    sum = sum + x;
                }
                // foreach over an inclusive range with an explicit element type.
                mutable int count = 0;
                foreach (int k in 0..=10) {
                    count = count + 1;
                }
                System.IO.Console.println($"sum of squares = {sum}");   // 0+1+4+9+16 = 30
                System.IO.Console.println($"count = {count}");          // 0..=10 -> 11
                delete nums;
                return;
            }
        }
    }
}
