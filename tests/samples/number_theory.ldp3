import System.IO.Console;
import System.Math.NumberTheory;
import System.Math.Combinatorics;
program NumberTheoryDemo;

// Number theory + combinatorics (spec 34.6) in pure LDP3. Prints:
//   gcd=12 lcm=12 inv=4
//   p97=1 p100=0 p7919=1 modpow=24
//   fact5=120 c10_3=120 cat4=14 perms=6
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("gcd=%d lcm=%d inv=%d\n",
                    NumberTheory.gcd(48, 36), NumberTheory.lcm(4, 6), NumberTheory.modInverse(3, 11));
                System.IO.Console.printf("p97=%d p100=%d p7919=%d modpow=%d\n",
                    NumberTheory.isPrime(97), NumberTheory.isPrime(100), NumberTheory.isPrime(7919),
                    cast<int>(NumberTheory.modpow(2, 10, 1000)));
                mutable int[] perm = new int[3]();
                perm[0]=1; perm[1]=2; perm[2]=3;
                mutable int cnt = 1;
                while (Combinatorics.nextPermutation(perm, 3)) { cnt = cnt + 1; }
                System.IO.Console.printf("fact5=%d c10_3=%d cat4=%d perms=%d\n",
                    cast<int>(Combinatorics.factorial(5)), cast<int>(Combinatorics.choose(10, 3)),
                    cast<int>(Combinatorics.catalan(4)), cnt);
                return;
            }
        }
    }
}
