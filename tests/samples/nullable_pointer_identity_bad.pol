import System.IO.Console;
program NullablePointerIdentityBad;

// The other half of nullable_pointer_identity.pol: a nullable pointer and a pointer to an UNRELATED
// type are still not comparable. Letting `nullable` through must not let any two pointers through.
//
// Refused: "operator '==' requires operands of the same type".
public bundle Main {
    public namespace App {
        public class Dog { public mutable int legs; public constructor Dog() { this.legs = 4; } }
        public class Cat { public mutable int lives; public constructor Cat() { this.lives = 9; } }
        public class Main {
            public static method main(string[] args) returns void {
                Dog* d = new Dog() on heap;
                Cat* c = new Cat() on heap;
                nullable Dog* maybe = d;
                if (maybe == c) { System.IO.Console.println("same"); }
                delete c;
                delete d;
                return;
            }
        }
    }
}
