program Match;

public bundle main {
    import System.IO.Console;
    public namespace app {

        public abstract class Shape {
            public abstract method area() returns int;
        }
        public class Circle extends Shape {
            private int r;
            public constructor Circle(int r) { this.r = r; }
            public override method area() returns int { return this.r * this.r * 3; }
        }
        public class Square extends Shape {
            private int side;
            public constructor Square(int side) { this.side = side; }
            public override method area() returns int { return this.side * this.side; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Shape* s = new Square(4) on heap;
                match (s) {
                    case Circle(int r) {
                        System.IO.Console.println($"circle r = {r}");
                    }
                    case Square(int side) {
                        System.IO.Console.println($"square side = {side}");   // this arm
                    }
                    default {
                        System.IO.Console.println("unknown");
                    }
                }
                delete s;
                return;
            }
        }
    }
}
