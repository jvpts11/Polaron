import System.IO.Console;
import System.Text.Luhn;
import System.Text.Isbn;
program Validators;

// Checksum validators (spec 34) in pure LDP3. Prints:
//   luhnOk=1 luhnBad=0 isbnOk=1 isbnBad=0
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("luhnOk=%d luhnBad=%d isbnOk=%d isbnBad=%d\n",
                    Luhn.isValid("79927398713"),
                    Luhn.isValid("79927398710"),
                    Isbn.isValid13("9780306406157"),
                    Isbn.isValid13("9780306406158"));
                return;
            }
        }
    }
}
