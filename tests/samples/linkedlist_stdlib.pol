import System.IO.Console;
import System.Collections.LinkedList;
program LinkedListStdlib;

// LinkedList<T> (spec 34.1): O(1) append + O(1) head removal, with self-referential generic
// pointer nodes (LinkedNode<T> holds a LinkedNode<T>* next).

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                LinkedList<int> list = new LinkedList<int>() on heap;
                list.add(10); list.add(20); list.add(30);
                System.IO.Console.printf("size=%d g0=%d g2=%d\n", list.size(), list.get(0), list.get(2));
                int r = list.removeFirst();
                list.add(40);
                System.IO.Console.printf("rm=%d size=%d g0=%d g2=%d\n",
                                         r, list.size(), list.get(0), list.get(2));
                return;
            }
        }
    }
}
