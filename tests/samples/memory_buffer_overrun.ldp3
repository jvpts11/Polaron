import System.IO.Console;
import System.Memory.Buffer;
program MemoryBufferOverrun;

// A Buffer that is written past its end must STOP, naming the clause and the two numbers. The
// length travelling with the pointer is the entire point of the class; if an overrun went through
// silently it would be a plain address with extra ceremony.

public bundle Main {
    public namespace App {
        public class Main {
            public static method main(string[] args) returns void {
                Buffer b = new Buffer(32) on stack;
                // 30 + 4 = 34 > 32: two bytes past the end, the size of mistake that corrupts a
                // neighbouring allocation and is found three frames later.
                b.writeInt(30, 1);
                System.IO.Console.println($"unreachable = {1}");
                return;
            }
        }
    }
}
