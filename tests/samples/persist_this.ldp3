program PersistThis;

// Object reattach via `this` (spec 18.2): chassi is persistent. The constructor and methods use
// this.chassi -- they reach the right per-variable block through the object's __persist pointer
// (wired at construction). tick() deletes its Car every call, yet chassi keeps counting across
// calls and across runs. Run 1: a=1 b=2 c=3. Run 2: a=4 b=5 c=6.
public bundle main {
    public namespace app {
        public class Car {
            public persistent mutable int chassi = 0;
            public constructor Car() {}
            public method bump() returns void { this.chassi = this.chassi + 1; }
            public method get() returns int { return this.chassi; }
        }

        public class Main {
            public static method tick() returns int {
                Car c = new Car() on heap;
                c.bump();
                int r = c.get();
                delete c;
                return r;
            }
            public static method main(string[] args) returns void {
                System.IO.println($"a={Main.tick()} b={Main.tick()} c={Main.tick()}");
                return;
            }
        }
    }
}
