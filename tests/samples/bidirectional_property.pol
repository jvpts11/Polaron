import System.IO.Console;
program BidirectionalProperty;

// Bidirectional properties (spec 32.6): one property that converts BOTH ways over a backing field.
// Reading it computes the value from the field; assigning it computes the field from the value. The
// classic case is two representations of the same datum (Celsius/Fahrenheit, radians/degrees, ...).
public bundle main {
    public namespace app {

        public class Temperature {
            private mutable double celsius;

            public constructor Temperature(double c) {
                this.celsius = c;
            }

            public bidirectional double fahrenheit {
                celsius to fahrenheit: celsius * 9.0 / 5.0 + 32.0;
                fahrenheit to celsius: (fahrenheit - 32.0) * 5.0 / 9.0;
            }

            public method c() returns double {
                return this.celsius;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Temperature* t = new Temperature(100.0) on heap;
                double f = t.fahrenheit;          // reads celsius, converts: 212
                t.fahrenheit = 32.0;              // converts and stores into celsius: 0
                System.IO.Console.println($"f={f:0.0} c={t.c():0.0}");
                delete t;
                return;
            }
        }
    }
}
