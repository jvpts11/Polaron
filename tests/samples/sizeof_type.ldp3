import System.IO.Console;
import System.Memory;
program SizeofType;

// A type's byte size, in the two spellings LDP3 keeps (spec, issue #7):
//   `T.sizeof()`        -- the type answers about itself; reach for this when the thing has a name
//   `Memory.sizeof(x)`  -- a static method on System.Memory, and the only way to ask about an
//                          EXPRESSION rather than a named type
// The bare `sizeof(T)` is GONE. It was the C spelling and it was never even a keyword -- an
// identifier the analyzer recognised by name, leaving `sizeof` free to be used as a variable.

public bundle main {
    public namespace app {
        public class Pair {
            public mutable int a;
            public mutable int b;
            public constructor Pair() { this.a = 0; this.b = 0; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                int n = Pair.sizeof();         // 16 (vtable pointer + two ints; every class is an Object)
                int n2 = Memory.sizeof(Pair);  // 16 -- the same size, asked the other way
                Pair p = new Pair() on stack;
                int m = Memory.sizeof(p);      // size of p's type (pointer to Pair)
                System.IO.Console.printf("n=%d n2=%d mpos=%d\n", n, n2, m > 0);
                return;
            }
        }
    }
}
