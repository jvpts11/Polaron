import System.IO.Console;
program SizeofType;

// sizeof(Type) / sizeof(expr) and the Type.sizeof() member form (spec, issue #7): the byte size of
// a type or an expression's type. Both spellings are accepted and equivalent.

public bundle main {
    public namespace app {
        public class Pair {
            public mutable int a;
            public mutable int b;
            public constructor Pair() { this.a = 0; this.b = 0; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                int n = sizeof(Pair);          // 16 (vtable pointer + two ints; every class is an Object)
                int n2 = Pair.sizeof();        // 16 (the member form)
                Pair p = new Pair() on stack;
                int m = sizeof(p);             // size of p's type (pointer to Pair)
                System.IO.Console.printf("n=%d n2=%d mpos=%d\n", n, n2, m > 0);
                return;
            }
        }
    }
}
