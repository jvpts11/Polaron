import System.IO.Console;
program DefinedConversions;

// LDP3 has no undefined behaviour: an out-of-range float->int cast SATURATES (clamps to the
// integer min/max) instead of producing poison like raw fptosi would, and unary minus works
// on any numeric type (float, double, sized ints), not just int.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                double big = 1000000000000000000.0;   // way past int range
                double neg = -big;                      // unary minus on a double
                double ok = 42.9;
                System.IO.Console.printf("%d %d %d\n", cast<int>(big), cast<int>(neg), cast<int>(ok));
                return;
            }
        }
    }
}
