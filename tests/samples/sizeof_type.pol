import System.IO.Console;
import System.Memory.Raw;
program SizeofType;

// A type's byte size, in the two spellings Polaron keeps (spec, issue #7):
//   `T.sizeof()`        -- the type answers about itself; reach for this when the thing has a name
//   `Memory.sizeof(x)`  -- a static method on System.Memory, and the only way to ask about an
//                          EXPRESSION rather than a named type
// The bare `sizeof(T)` is GONE. It was the C spelling and it was never even a keyword -- an
// identifier the analyzer recognised by name, leaving `sizeof` free to be used as a variable.

public bundle main {
    public namespace app {
        public class Pair {
            public mutable int a;
            public mutable int b;
            public constructor Pair() { this.a = 0; this.b = 0; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                // EIGHT, AND IT USED TO BE SIXTEEN. `Pair` is two `int`s and that is now what it
                // costs. `dynamic` made the object header a word the AUTHOR writes rather than one
                // the driver assigned to every class in a loop: nothing extends `Pair`, nothing
                // overrides anything on it, and nobody asked to hold it as an `Object`, so it is
                // its fields. AP-02 -- *every object carries a vtable pointer whether it needs one
                // or not* -- falls here, and this is the line that measures it.
                int n = Pair.sizeof();         // 8 -- two ints, and no header
                int n2 = Raw.sizeof(Pair);     // 8 -- the same size, asked the other way
                Pair p = new Pair() on stack;
                int m = Raw.sizeof(p);         // size of p's type (pointer to Pair)
                System.IO.Console.printf("n=%d n2=%d mpos=%d\n", n, n2, m > 0);
                return;
            }
        }
    }
}
