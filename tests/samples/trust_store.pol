import System.IO.Console;
import System.Net.Tls.Certificate;
import System.Net.Tls.CertificateException;
import System.Net.Tls.CertificateValidator;
import System.Net.Tls.TrustStore;
import System.Collections.ArrayList;
program TrustStoreTest;

// THE CERTIFICATES THIS MACHINE ALREADY TRUSTS, and a chain checked all the way to one of them.
//
// A chain proves each certificate was signed by the one above it, and that proves nothing on its
// own: a chain forged from top to bottom is just as self-consistent. What makes it mean something is
// ending at a key trusted for reasons outside the chain — and those keys are curated, updated and
// revoked by the operating system, which is why they are read from there rather than shipped inside
// the compiler where they would go stale between releases.
//
// A ROOT IS ITS OWN ISSUER, so every root in the store carries a signature by its own key. Verifying
// a sample of them exercises the whole path against certificates from every authority the machine
// trusts — many issuers, many encodings, RSA and ECDSA both — rather than against the one certificate
// somebody chose for a test. If any of them fails to verify, the arithmetic is wrong for a shape
// that exists in the real world.
//
// The counts are printed as ranges rather than exact numbers: a trust store is a moving target, and a
// test that demands exactly 47 roots is a test that fails when Windows updates.
//
// Prints:
//   store: loaded=1 many=1
//   roots: checked=37 selfVerified=37 unsupported=<varies>
//   every checked root verified: 1
//   every refusal is an obsolete digest: 1
//   unknown issuer: refused=1
//
// The exact counts move with the machine's store, which is why the assertions are the two LINES
// BELOW them. The first: every root this library claims it can check must check out. The second is
// the one that closed a real gap — "unsupported" used to mix two opposite things, roots a modern
// client is SUPPOSED to refuse (SHA-1, MD5, MD2) and roots this library simply could not reach.
// Measured here: 30 checked and 36 refused, of which SIX were P-384 — a curve, not a policy. With
// P-384 in, it reads 37 checked and 29 refused, and all 29 are obsolete digests. The line is what
// keeps that true: a modern algorithm falling out of reach fails this test instead of hiding in a
// count nobody can act on.
public bundle Main {
    public namespace App {
        public class Main {
            public static method main(string[] args) returns void {
                mutable TrustStore* system = TrustStore.system();
                System.IO.Console.printf("store: loaded=%d many=%d\n",
                                         system.count() > 0 ? 1 : 0,
                                         system.count() >= 10 ? 1 : 0);

                // Every root is self-signed, so each is a complete test of parse plus verify. Twenty
                // is enough to cross several authorities and both key kinds without making the suite
                // slow — each RSA verification is real modular exponentiation.
                mutable int checked = 0;
                mutable int verified = 0;
                mutable int cannot = 0;
                mutable int obsolete = 0;
                mutable ArrayList<Certificate*> roots = system.certificates();
                mutable int i = 0;
                // THE WHOLE STORE, every root the machine holds. That is only affordable because the
                // arithmetic is purpose-built: through the standard library's decimal BigInteger the
                // same scan took 69 seconds, twelve roots alone took 28, and it now finishes in
                // under a second. A test that could only afford a sample was a test that could be
                // passing by luck of ordering.
                while (i < roots.size()) {
                    Certificate* root = roots.get(i);
                    if (root.isSelfIssued()) {
                        // "Cannot check" and "does not check out" are counted apart, because they
                        // mean opposite things: the first is a gap in this library, the second is a
                        // certificate that is lying. Real stores contain both old SHA-1 authorities
                        // and P-384 ones, and refusing those IS the correct answer.
                        String why = CertificateValidator.unsupportedReason(root, root);
                        if (why.length() > 0) {
                            cannot = cannot + 1;
                            // WHY it cannot, and not merely that it cannot. An obsolete digest is a
                            // root a modern client is SUPPOSED to refuse; anything else on that list
                            // is a hole in this library wearing the same words. Counting them apart
                            // is what turns "36 unsupported" from a number nobody can act on into a
                            // claim that can fail.
                            if (why.contains("SHA-1") || why.contains("MD5") || why.contains("MD2")) {
                                obsolete = obsolete + 1;
                            }
                        } else {
                            checked = checked + 1;
                            if (CertificateValidator.signedBy(root, root)) {
                                verified = verified + 1;
                            }
                        }
                    }
                    i = i + 1;
                }
                System.IO.Console.printf("roots: checked=%d selfVerified=%d unsupported=%d\n",
                                         checked, verified, cannot);
                System.IO.Console.printf("every checked root verified: %d\n",
                                         checked > 0 && checked == verified ? 1 : 0);
                System.IO.Console.printf("every refusal is an obsolete digest: %d\n",
                                         cannot == obsolete ? 1 : 0);

                // ...and a certificate whose issuer is in no store: the chain has nowhere to end.
                mutable TrustStore* empty = new TrustStore() on heap;
                mutable ArrayList<Certificate*> one = new ArrayList<Certificate*>() on heap;
                if (roots.size() > 0) { one.add(roots.get(0)); }
                mutable boolean refused = false;
                try {
                    CertificateValidator.check(one, "example.com", empty, cast<long>(1700000000));
                } catch (CertificateException e) {
                    refused = true;
                }
                System.IO.Console.printf("unknown issuer: refused=%d\n", refused ? 1 : 0);

                delete one;
                delete empty;
                delete system;
                return;
            }
        }
    }
}
