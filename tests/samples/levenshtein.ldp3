import System.IO.Console;
import System.Text.Levenshtein;
program LevenshteinDemo;

// Levenshtein edit distance (spec 34) in pure LDP3. Prints:
//   kit=3 empty=3 same=0 flaw=2
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("kit=%d empty=%d same=%d flaw=%d\n",
                    Levenshtein.distance("kitten", "sitting"),
                    Levenshtein.distance("", "abc"),
                    Levenshtein.distance("abc", "abc"),
                    Levenshtein.distance("flaw", "lawn"));
                return;
            }
        }
    }
}
