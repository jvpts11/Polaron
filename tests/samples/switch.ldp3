program Switch;

public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                for (mutable int x = 0; x < 4; x++) {
                    switch (x) {
                        case 0 {
                            System.IO.Console.printf("zero ");
                            // no break: falls through to case 1 (spec 7.3)
                        }
                        case 1 {
                            System.IO.Console.printf("one ");
                            break;
                        }
                        case 2 {
                            System.IO.Console.printf("two ");
                            break;
                        }
                        default {
                            System.IO.Console.printf("other ");
                        }
                    }
                }
                System.IO.Console.println("");
                return;
            }
        }
    }
}
