program RegionRaii;

// A region declared in a lexical scope is freed automatically at the end of the
// block (spec 17.7) -- no explicit `release region` needed. The result is the
// same; RAII just reclaims the arena on the way out.

public bundle main {
    import System.Memory.Units.kilobytes;

    public namespace app {
        public class Dog {
            private int years;
            public constructor Dog(int years) { this.years = years; }
            public method getAge() returns int { return this.years; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                region pen = itself.allocate(1 kilobytes);
                Dog* a = new Dog(5) in region pen;
                System.IO.println($"a = {a.getAge()}");   // a = 5
                return;                                     // pen freed here by RAII
            }
        }
    }
}
