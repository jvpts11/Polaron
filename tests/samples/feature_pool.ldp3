import System.IO.Console;
import System.App.FeatureFlags;
import System.App.ObjectPool;
program FeaturePool;

// Feature flags and an object pool (spec 34) in pure LDP3. Prints:
//   dark=1 beta=0 darkoff=0
//   a=0,1,2 exhausted=-1 reuse=1 inUse=3
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable FeatureFlags ff = new FeatureFlags() on heap;
                ff.enable("dark");
                boolean d1 = ff.isEnabled("dark");
                boolean b1 = ff.isEnabled("beta");
                ff.disable("dark");
                boolean d2 = ff.isEnabled("dark");
                System.IO.Console.printf("dark=%d beta=%d darkoff=%d\n", d1, b1, d2);

                mutable ObjectPool pool = new ObjectPool(3) on heap;
                int a0 = pool.acquire(); int a1 = pool.acquire(); int a2 = pool.acquire();
                int ex = pool.acquire();
                pool.recycle(a1);
                int reuse = pool.acquire();
                System.IO.Console.printf("a=%d,%d,%d exhausted=%d reuse=%d inUse=%d\n",
                    a0, a1, a2, ex, reuse, pool.inUse());
                return;
            }
        }
    }
}
