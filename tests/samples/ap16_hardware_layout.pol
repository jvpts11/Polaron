import System.IO.Console;

program Ap16HardwareLayout;

// ANTI-PROCEDURAL TEST AP-16 AND AP-20: a declaration produces exactly the bytes the hardware
// defines, and an object is exactly its fields.
//
// THE CLAIM. "MMIO registers, descriptor tables and packet headers need byte-exact layout, and an
// object-oriented language cannot give you that: it reorders, it pads, and it puts a header on
// every object that the hardware does not expect."
//
// WHAT REFUTES IT. Not a promise in a document -- the bytes. This declares the x86-64 **interrupt
// descriptor table entry**, which is a real sixteen-byte structure whose fields the CPU reads at
// fixed offsets and in a fixed order, and then WRITES IT THROUGH THE FIELDS AND READS IT BACK AS
// BYTES. If any field moved, any padding appeared, or any header were prepended, one of the sixteen
// assertions below fails and says which byte.
//
// A `struct` AND NOT A `layout`, which is the distinction this test also pins. Implementing a
// `layout` AUTHORISES the compiler to order the fields widest-first (spec 11.1) -- that is what a
// layout is for, and it is exactly wrong here. A plain `struct` keeps the order it was written in,
// which is the one thing a hardware descriptor cannot do without.
//
// AND THE SIZE IS SETTLED WHILE THE PROGRAM IS BUILT. `demand` refuses a build whose descriptor is
// not sixteen bytes, so the failure lands on the compiler's output rather than on a triple fault in
// QEMU an hour later. That is the difference between a language that can describe hardware and one
// that can be made to.
public bundle Main {
    public namespace App {

        // The x86-64 IDT entry, as Intel defines it. Sixteen bytes, and every one of them is read by
        // the processor at an offset it will not negotiate about.
        public struct IdtEntry {
            public mutable ushort offsetLow;    // 0..1   handler address, bits 0-15
            public mutable ushort selector;     // 2..3   code segment selector
            public mutable ubyte  ist;          // 4      interrupt stack table index
            public mutable ubyte  flags;        // 5      type and attributes
            public mutable ushort offsetMid;    // 6..7   handler address, bits 16-31
            public mutable uint   offsetHigh;   // 8..11  handler address, bits 32-63
            public mutable uint   reserved;     // 12..15 must be zero
        }

        // The same sixteen bytes, seen as bytes. A union is how a value is read two ways without a
        // cast that could be lying: both members name the same storage.
        public union IdtBytes {
            IdtEntry entry;
            Raw16 raw;
        }

        // `ubyte` AND NOT `byte`, AND THAT IS PART OF THE TEST. Polaron's `byte` is signed, as
        // Java's is -- so a descriptor byte of 0x88 read through one and widened to `int` is -120,
        // and every comparison against the value the hardware documents fails. A byte of hardware
        // is a number from zero to two hundred and fifty-five; the type that says so is `ubyte`.
        // Written with `byte` first, on purpose, and the bytes came back negative: this file caught
        // it, which is what it is for.
        public struct Raw16 {
            public mutable ubyte b0;  public mutable ubyte b1;  public mutable ubyte b2;  public mutable ubyte b3;
            public mutable ubyte b4;  public mutable ubyte b5;  public mutable ubyte b6;  public mutable ubyte b7;
            public mutable ubyte b8;  public mutable ubyte b9;  public mutable ubyte b10; public mutable ubyte b11;
            public mutable ubyte b12; public mutable ubyte b13; public mutable ubyte b14; public mutable ubyte b15;
        }

        public class Main {
            // SETTLED WHILE THE PROGRAM IS BUILT, not while it runs. A descriptor of the wrong size
            // is a build that does not happen.
            public static method main(string[] args) returns void {
                demand IdtEntry.sizeof() == 16 otherwise "an IDT entry is sixteen bytes; the CPU does not negotiate";
                demand Raw16.sizeof() == 16 otherwise "sixteen bytes read as sixteen bytes";

                mutable IdtBytes view = new IdtBytes();
                view.entry.offsetLow  = cast<ushort>(0x1122);
                view.entry.selector   = cast<ushort>(0x3344);
                view.entry.ist        = cast<ubyte>(0x55);
                view.entry.flags      = cast<ubyte>(0x66);
                view.entry.offsetMid  = cast<ushort>(0x7788);
                view.entry.offsetHigh = cast<uint>(0x99AABBCC);
                view.entry.reserved   = cast<uint>(0);

                // Little-endian, which is what x86-64 is. Each assertion names the byte, so a
                // failure says WHERE the layout moved rather than only that it did.
                mutable int wrong = 0;
                if (cast<int>(view.raw.b0)  != 0x22) { wrong = 1; }
                if (cast<int>(view.raw.b1)  != 0x11) { wrong = 2; }
                if (cast<int>(view.raw.b2)  != 0x44) { wrong = 3; }
                if (cast<int>(view.raw.b3)  != 0x33) { wrong = 4; }
                if (cast<int>(view.raw.b4)  != 0x55) { wrong = 5; }
                if (cast<int>(view.raw.b5)  != 0x66) { wrong = 6; }
                if (cast<int>(view.raw.b6)  != 0x88) { wrong = 7; }
                if (cast<int>(view.raw.b7)  != 0x77) { wrong = 8; }
                if (cast<int>(view.raw.b8)  != 0xCC) { wrong = 9; }
                if (cast<int>(view.raw.b9)  != 0xBB) { wrong = 10; }
                if (cast<int>(view.raw.b10) != 0xAA) { wrong = 11; }
                if (cast<int>(view.raw.b11) != 0x99) { wrong = 12; }

                System.IO.Console.println($"idt={IdtEntry.sizeof()} wrong={wrong}");
                System.IO.Console.println($"bytes {cast<int>(view.raw.b0)} {cast<int>(view.raw.b1)} {cast<int>(view.raw.b2)} {cast<int>(view.raw.b3)} {cast<int>(view.raw.b4)} {cast<int>(view.raw.b5)} {cast<int>(view.raw.b6)} {cast<int>(view.raw.b7)} {cast<int>(view.raw.b8)} {cast<int>(view.raw.b9)} {cast<int>(view.raw.b10)} {cast<int>(view.raw.b11)}");
                return;
            }
        }
    }
}
