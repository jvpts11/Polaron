import System.IO.Console;
program UnqualifiedCallBad;

// Regression: LDP3 has no free functions, so a bare `sum(...)` call must fail with a diagnostic that
// names the cause and the fix (the qualified/instance form), not a bare "unknown call".
public bundle main {
    public namespace app {
        public class Main {
            public static method sum(int a, int b) returns int { return a + b; }
            public static method main(string[] args) returns void {
                int a = sum(5, 7);
                System.IO.Console.printf("%d\n", a);
                return;
            }
        }
    }
}
