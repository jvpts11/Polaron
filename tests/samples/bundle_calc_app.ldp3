import System.IO.Console;
import calc.math.Calc;
program CalcApp;

// Consumes the separately-compiled `calc` bundle: type-checks against its .ldh, calls the static
// method Calc.square, and links the implementation from the .ldb's CODE.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int r = Calc.square(7);
                System.IO.Console.printf("square = %d\n", r);
                return;
            }
        }
    }
}
