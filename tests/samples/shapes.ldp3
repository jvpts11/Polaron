program Shapes;

// Release 0.1 polymorphism north-star: an interface, an abstract class, two
// concrete subclasses with overrides, dispatched virtually through a base-typed
// variable. Expected output:
//   Square area: 16
//   Circle area: 12

public bundle main {
    public namespace geo {

        public interface Drawable {
            method describe() returns void;
        }

        public abstract class Shape implements Drawable {
            public abstract method area() returns int;
        }

        public class Square extends Shape {
            private int side;

            public constructor Square(int s) {
                this.side = s;
            }

            public override method area() returns int {
                return this.side * this.side;
            }

            public override method describe() returns void {
                System.IO.println($"Square area: {this.area()}");
                return;
            }
        }

        public class Circle extends Shape {
            private int radius;

            public constructor Circle(int r) {
                this.radius = r;
            }

            public override method area() returns int {
                return 3 * this.radius * this.radius;
            }

            public override method describe() returns void {
                System.IO.println($"Circle area: {this.area()}");
                return;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Shape s1 = new Square(4);   // static type Shape, dynamic type Square
                Shape s2 = new Circle(2);
                s1.describe();              // -> Square area: 16
                s2.describe();              // -> Circle area: 12
                return;
            }
        }
    }
}
