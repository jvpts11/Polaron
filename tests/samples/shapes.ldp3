program Shapes;

// Release 0.1 closing north-star: brings the whole OOP core together in one
// program -- an enum, an interface, an abstract class, inheritance, override,
// virtual dispatch through a base-typed variable, and string interpolation.
// Expected output:
//   Square (kind 0) area: 16
//   Circle (kind 1) area: 12

public bundle main {
    import System.IO.Console;
    public namespace geo {

        public enum ShapeKind {
            SQUARE,
            CIRCLE
        }

        public interface Drawable {
            method describe() returns void;
        }

        public abstract class Shape implements Drawable {
            public abstract method area() returns int;
            public abstract method kind() returns ShapeKind;
        }

        public class Square extends Shape {
            private int side;

            public constructor Square(int s) {
                this.side = s;
            }

            public override method area() returns int {
                return this.side * this.side;
            }

            public override method kind() returns ShapeKind {
                return ShapeKind.SQUARE;
            }

            public override method describe() returns void {
                System.IO.Console.println($"Square (kind {this.kind()}) area: {this.area()}");
                return;
            }
        }

        public class Circle extends Shape {
            private int radius;

            public constructor Circle(int r) {
                this.radius = r;
            }

            public override method area() returns int {
                return 3 * this.radius * this.radius;
            }

            public override method kind() returns ShapeKind {
                return ShapeKind.CIRCLE;
            }

            public override method describe() returns void {
                System.IO.Console.println($"Circle (kind {this.kind()}) area: {this.area()}");
                return;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Shape s1 = new Square(4);   // static type Shape, dynamic type Square
                Shape s2 = new Circle(2);
                s1.describe();              // -> Square (kind 0) area: 16
                s2.describe();              // -> Circle (kind 1) area: 12
                return;
            }
        }
    }
}
