import System.IO.Console;
program GenericRangeFor;

// `for (i in 0..n)` INSIDE A GENERIC CLASS -- which crashed the compiler outright.
//
// `cloneExpr` had never been taught `RangeExpr`, so expanding the generic returned null for the
// iterable; the analyzer's foreach then failed its `RangeExpr` cast, fell through to
// `typeOf(*fe->iterable)`, and dereferenced nothing. An access violation, with no message, from a
// program that is perfectly legal.
//
// Eighteen lines reproduced it. The standard library never met it because its own loops are written
// in the classic three-part form, and the language's most idiomatic loop was unusable in exactly the
// place where sharing code across types matters most.
//
// The fallthrough that hid it said "unknown node: should not happen for well-formed input" -- and
// the input was well-formed. It reports itself now, in the function that owns the omission, which is
// the second time in two days the same shape has been paid for: `cloneMember` silently dropped
// `comptime literal` and `fixed`, and produced a missing standard-library import instead of a crash.
public bundle Probe {
    public namespace App {

        public class Tally<T> {
            private mutable T[] kept;
            private mutable int many;

            public constructor Tally() {
                kept = new T[8]();
                many = 0;
            }

            public destructor ~Tally() returns void {
                delete kept;
                return;
            }

            public method put(T item) returns void {
                kept[many] = item;
                many = many + 1;
                return;
            }

            // Inclusive and exclusive, and one with a step -- all three are ranges, and all three
            // went through the clone that did not know what a range was.
            public method sum() returns int {
                mutable int total = 0;
                for (int i in 0..many) {
                    total = total + 1;
                }
                for (int i in 1..=3) {
                    total = total + 10;
                }
                for (int i in 0..10 step 5) {
                    total = total + 100;
                }
                return total;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Tally<int> t = new Tally<int>() on stack;
                t.put(4);
                t.put(5);
                System.IO.Console.printf("total=%d\n", t.sum());
                return;
            }
        }
    }
}
