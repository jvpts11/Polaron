import System.IO.Console;
program FfiExtern;

// FFI (spec 26): `extern <cdecl|stdcall|fastcall> method name(params) returns T;` declares an
// external C function (no body) that resolves to a C-linkage symbol. Here two libc functions are
// declared and called directly -- the basis for talking to the OS / hardware libraries (and, in
// freestanding, to functions the kernel provides). On x64 the calling conventions converge on the
// C ABI.

public bundle main {
    public namespace app {
        extern cdecl method abs(int x) returns int;
        extern cdecl method labs(long x) returns long;
        public class Main {
            public static method main(string[] args) returns void {
                int a = abs(-42);
                long b = labs(cast<long>(-1000000));
                System.IO.Console.printf("abs=%d labs=%d\n", a, cast<int>(b));  // 42 1000000
                return;
            }
        }
    }
}
