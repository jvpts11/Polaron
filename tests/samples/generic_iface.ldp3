program GenericIface;

public bundle main {
    import System.IO.Console;
    public namespace app {
        public interface Describable {
            method describe() returns int;
        }
        public class Box<T> implements Describable {
            private T v;
            public constructor Box(T v) { this.v = v; }
            public override method describe() returns int { return this.v; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Describable* d = new Box<int>(9) on heap;   // generic upcast to an interface
                System.IO.Console.println($"describe = {d.describe()}");   // virtual -> 9
                delete d;
                return;
            }
        }
    }
}
