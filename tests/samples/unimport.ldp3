program Unimport;

// Unimport (spec 30, "unloading agressivo"): `unimport Dog` both marks the class dead
// (alive flag) AND physically overwrites its machine code in RAM with int3 traps -- the
// instructions are ripped from memory. Using the type afterwards (new, or a method call
// on a surviving instance) throws UnimportedTypeException via the alive guard, so we never
// branch into the destroyed code. Method.firstByte() shows the code is gone (0xCC = 204).
//
// Physical unload is irreversible here: an AOT executable cannot reload code from disk, so
// reimport can re-enable the flag but not restore the ripped-out machine code.

public bundle main {
    public namespace app {
        public class Dog {
            public constructor Dog() {}
            public method bark() returns void { Console.println("Woof!"); }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Dog a = new Dog() on heap;
                a.bark();                                        // Woof!
                Type t = reflect.typeOf<Dog>();
                Method m = t.method("bark");
                unimport Dog;
                System.IO.printf("byte=%d\n", m.firstByte());    // 204 -- code physically overwritten
                try {
                    Dog b = new Dog() on heap;
                    Console.println("should not reach");
                } catch (UnimportedTypeException e) {
                    Console.println("new caught");
                }
                try {
                    a.bark();                                    // surviving instance: code is gone
                    Console.println("should not reach");
                } catch (UnimportedTypeException e) {
                    Console.println("call caught");
                }
                return;
            }
        }
    }
}
