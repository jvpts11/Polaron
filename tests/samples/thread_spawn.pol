import System.IO.Console;
import System.Concurrency.Thread;
import System.Commands.Action;
program ThreadSpawn;

// An OS thread (spec 20.1): new Thread(work).start()/.join(). The worker is an `Action` -- a command
// that takes nothing and answers nothing -- carrying `n`; join makes the output deterministic (the
// worker runs to completion before main's final line). Prints "worker n=42" then "main done".
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int n = 21;
                Action* work = command () carries (int seed = n) into pack returns void {
                    System.IO.Console.printf("worker n=%d\n", pack.seed * 2);
                };
                Thread t = new Thread(work) on heap;
                t.start();
                t.join();
                System.IO.Console.printf("main done\n");
                return;
            }
        }
    }
}
