import System.IO.Console;
program StaticAssertComptime;

// static_assert (spec 28.2) shares the one comptime evaluator, so its condition
// may use named consts and `comptime` method calls. These all hold, so the
// program compiles and runs.

public bundle main {
    public namespace app {
        public class Math {
            public static comptime method fib(int n) returns int {
                if (n < 2) { return n; }
                return Math.fib(n - 1) + Math.fib(n - 2);
            }

            public static fixed int N = 10;
            public static fixed int LIMIT = 1 << 16;   // 65536
        }

        public class Main {
            public static method main(string[] args) returns void {
                demand Math.fib(Math.N) == 55 otherwise "fib(10) must be 55";
                demand Math.N * Math.N < Math.LIMIT otherwise "N squared must fit";
                System.IO.Console.printf("demands met\n");
                return;
            }
        }
    }
}
