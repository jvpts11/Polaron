import System.IO.Console;
import System.Text.Rpn;
import System.Text.ShuntingYard;
program RpnDemo;

// RPN evaluation and shunting-yard infix->RPN (spec 34) in pure LDP3. Prints:
//   rpn=35 rpn2=2
//   shunt=1 2 + 3 * eval=9
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("rpn=%d rpn2=%d\n",
                    Rpn.eval("3 4 + 5 *"), Rpn.eval("10 2 / 3 -"));
                String r = ShuntingYard.toRpn("( 1 + 2 ) * 3");
                System.IO.Console.printf("shunt=%s eval=%d\n", r, Rpn.eval(r));
                return;
            }
        }
    }
}
