import System.IO.Console;
import System.Math.Sieve;
import System.Collections.BloomFilter;
import System.Collections.Deque;
program SieveBloomDeque;

// A prime sieve, a Bloom filter, and a double-ended queue (spec 34): primes up to 30, a membership test that
// never misses, and add/remove at both ends.
// Prints: p2=1 p15=0 cnt=10 cat=1 fish=0 pf=0 pb=2 front=1 sz=1.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable Sieve si = new Sieve(30) on heap;
                mutable BloomFilter bf = new BloomFilter(256) on heap;
                bf.add("cat");
                bf.add("dog");
                mutable Deque<int> dq = new Deque<int>() on heap;
                dq.addLast(1);
                dq.addLast(2);
                dq.addFirst(0);
                int pf = dq.removeFirst();
                int pb = dq.removeLast();
                int front = dq.toArray()[0];
                System.IO.Console.printf("p2=%d p15=%d cnt=%d cat=%d fish=%d pf=%d pb=%d front=%d sz=%d\n",
                    si.isPrime(2), si.isPrime(15), si.count(), bf.mightContain("cat"),
                    bf.mightContain("fish"), pf, pb, front, dq.size());
                return;
            }
        }
    }
}
