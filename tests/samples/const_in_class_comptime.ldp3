import System.IO.Console;
program ConstInClassComptime;

// A class-level const is usable in compile-time contexts (spec 28.1): static_assert reads it, and a
// const may reference a sibling const through the owner (Cfg.MAX). Both fold at compile time.

public bundle main {
    public namespace app {
        public class Cfg {
            public static const int MAX = 100;
            public static const int DOUBLED = Cfg.MAX * 2;
        }
        public class Main {
            public static method main(string[] args) returns void {
                static_assert(Cfg.MAX > 50, "max too small");
                System.IO.Console.printf("d=%d\n", Cfg.DOUBLED);   // 200
                return;
            }
        }
    }
}
