import System.IO.Console;
import System.Errors.Result;
import System.Errors.Option;
program ValueResult;

// Value Result<T,E> / Option<T> (spec 21, value form): written WITHOUT a `*`, they are tagged-union
// VALUES -- Ok/Err/Some/None allocate nothing, `match` reads a tag, and there is no `delete`. (The `*`
// form stays the boxed heap class; see result_option.pol.) A hot loop of value Results is malloc-free.
// Prints: ok 21 / err 1 / some 5 / loopsum=499500.
public bundle main {
    public namespace app {
        public class Main {
            private static method validate(int i, int poison) returns Result<int, int> {
                if (i == poison) { return Err(1); }
                return Ok(i);
            }
            private static method half(int x) returns Option<int> {
                if (x % 2 == 0) { return Some(x / 2); }
                return None();
            }
            private static method loopSum(int n) returns long {
                mutable long acc = cast<long>(0);
                mutable int i = 0;
                while (i < n) {                                  // no allocation per iteration
                    match (Main.validate(i, -1)) {
                        case Ok(int v) { acc = acc + cast<long>(v); }
                        case Err(int e) { acc = acc + cast<long>(e); }
                    }
                    i = i + 1;
                }
                return acc;
            }
            public static method main(string[] args) returns void {
                Result<int, int> r = Main.validate(21, 99);      // Ok(21)
                match (r) {
                    case Ok(int v) { System.IO.Console.printf("ok %d\n", v); }
                    case Err(int e) { System.IO.Console.printf("err %d\n", e); }
                }
                match (Main.validate(7, 7)) {                    // Err(1)
                    case Ok(int v) { System.IO.Console.printf("ok %d\n", v); }
                    case Err(int e) { System.IO.Console.printf("err %d\n", e); }
                }
                match (Main.half(10)) {                          // Some(5)
                    case Some(int v) { System.IO.Console.printf("some %d\n", v); }
                    case None() { System.IO.Console.printf("none\n"); }
                }
                System.IO.Console.printf("loopsum=%d\n", cast<int>(Main.loopSum(1000)));  // 499500
                return;
            }
        }
    }
}
