import System.IO.Console;
import System.Runtime.UnimportedTypeException;
program CascadeUnimport;

// `cascade unimport X` (spec 37.1) unimports X together with its subclasses (and any
// monomorphizations). After unimporting Animal, the subclass Dog is also gone, so a call on a
// Dog instance raises UnimportedTypeException.

public bundle main {
    public namespace app {
        public class Animal {
            public constructor Animal() {}
            public method speak() returns void { System.IO.Console.println("animal"); }
        }
        public class Dog extends Animal {
            public constructor Dog() {}
            public override method speak() returns void { System.IO.Console.println("woof"); }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Dog* d = new Dog() on heap;
                d.speak();                  // woof
                delete d;                   // the rip is refused while an instance is alive
                cascade unimport Animal;    // unimports Animal and its subclass Dog
                try {
                    // Was `d.speak()` on the surviving object -- a scenario the live-instance rule
                    // no longer lets arise. The guard that refuses is the same one either way.
                    Dog* gone = new Dog() on heap;
                } catch (UnimportedTypeException e) {
                    System.IO.Console.println("dog is dead");
                }
                return;
            }
        }
    }
}
