import System.IO.Console;
import System.Runtime.DivideByZeroException;
import System.Runtime.ArithmeticException;
program ArithFaultsCatchable;

// Arithmetic that has no correct answer is an EXCEPTION in a hosted program, so a caller can decide what
// a bad divisor means for it, and a PANIC in freestanding, where there is no exception machinery
// (spec 36.3). Same failure, different reporting -- exactly as for a bad downcast.
//
// Before this, both terminated the process through `__ldp3_panic` even in a hosted program, so a division
// whose divisor came from input could not be handled at all: the only defence was to test every divisor
// by hand, and forgetting one killed the process.
//
// The second block also checks that the BASE class catches the specific one: `checked()` overflow raises
// OverflowException, and a handler for ArithmeticException must see it. Both blocks must be reached, and
// the program must survive both -- surviving is the whole point.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int zero = 0;         // through a variable, so it cannot be folded away
                try {
                    int q = 10 / zero;
                    System.IO.Console.printf("unreachable: %d\n", q);
                } catch (DivideByZeroException e) {
                    System.IO.Console.printf("div: %s\n", e.message());
                }

                mutable int big = 2147483647;
                try {
                    int s = checked(big + big);
                    System.IO.Console.printf("unreachable: %d\n", s);
                } catch (ArithmeticException e) {       // the BASE class catches OverflowException
                    System.IO.Console.printf("ovf: %s\n", e.message());
                }

                System.IO.Console.printf("survived\n");
                return;
            }
        }
    }
}
