import System.IO.Console;
import System.Memory.Raw;
program SizeofComptime;

// `Raw.sizeof(T)` as a COMPILE-TIME constant (spec 28.2 + issue #7). A size is a question about
// memory, so it is asked of the stdlib class that owns memory -- not by a bare `sizeof` the language
// would have to reserve as a keyword. It folds against the target's data layout, so a struct can
// carry a byte budget the build enforces, and the same expression at run time must agree with what
// the assertion checked.
//
// Regression cover for defects found sizing a hot 20-byte struct:
//   * a size could not take part in a constant expression at all ("not a constant expression")
//   * the size of a vec2 answered 4 for an 8-byte vector
//   * primitives had no size: `float`/`short` did not even parse as the argument

public bundle Main {
    public namespace App {

        public struct Packed {
            public mutable float x;
            public mutable float y;
            public mutable int   herd;
            public mutable short stamina;
            public mutable short age;
            public mutable int   species : 5;
            public mutable int   state   : 3;
            public constructor Packed() {
                this.x = 0.0;
                this.y = 0.0;
                this.herd = 0;
                this.stamina = 0;
                this.age = 0;
                this.species = 0;
                this.state = 0;
            }

            // A byte budget belongs in a method of the type it constrains -- a fact about a type
            // lives with the type. NOTHING CALLS THIS, deliberately: the property that makes the
            // placement worth anything is that the assertion is still checked. A budget that went
            // unchecked the moment nobody called it would be a trap wearing a guard's clothes.
            public static method budget() returns void {
                static_assert(Packed.sizeof() == 20, "Packed must stay three to a cache line");
                return;
            }
        }

        // Two bit fields share one storage unit, so the struct is a byte -- not eight.
        public struct TwoNibbles {
            public mutable int a : 4;
            public mutable int b : 4;
            public constructor TwoNibbles() {
                this.a = 0;
                this.b = 0;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                static_assert(Raw.sizeof(Packed) == 20, "Packed must stay 20 bytes");
                static_assert(Raw.sizeof(Packed) <= 24, "Packed must not outgrow its budget");
                static_assert(Raw.sizeof(TwoNibbles) == 1, "adjacent bit fields share a unit");
                static_assert(Raw.sizeof(vec2) == 8, "a vec2 is two float32 lanes");
                static_assert(Raw.sizeof(float) == 4 && Raw.sizeof(short) == 2,
                              "primitives have sizes too");
                static_assert(Raw.sizeof(Packed) > Raw.sizeof(TwoNibbles),
                              "sizes compare like any int");

                // What the assertions checked must be what the program actually has.
                System.IO.Console.println($"Packed = {Raw.sizeof(Packed)}");
                System.IO.Console.println($"TwoNibbles = {Raw.sizeof(TwoNibbles)}");
                System.IO.Console.println($"vec2 = {Raw.sizeof(vec2)}");
                System.IO.Console.println($"vec4 = {Raw.sizeof(vec4)}");
                System.IO.Console.println($"float = {Raw.sizeof(float)}");
                System.IO.Console.println($"short = {Raw.sizeof(short)}");
                System.IO.Console.println($"long = {Raw.sizeof(long)}");

                // A size over an EXPRESSION still measures that expression's type.
                mutable long n = 7;
                System.IO.Console.println($"local long = {Raw.sizeof(n)}");
                return;
            }
        }
    }
}
