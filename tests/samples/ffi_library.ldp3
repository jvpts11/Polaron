import System.IO.Console;
program FfiLibrary;

// A class groups several external C functions under one calling convention (spec 26): each is a
// static extern method. Here libc's abs is declared and called through the class.

public bundle main {
    public namespace app {
        public class libc {
            public extern cdecl static method abs(int x) returns int;
        }
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("%d\n", libc.abs(0 - 5));  // 5
                return;
            }
        }
    }
}
