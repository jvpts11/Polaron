import System.IO.Console;
import System.Text.Humanize;
program HumanizeDemo;

// Human-friendly byte sizes and ordinals (spec 34) in pure Polaron. Prints:
//   b1=500 B b2=1.5 KB b3=1.0 MB b4=5.0 GB
//   o1=1st o2=2nd o3=3rd o11=11th o21=21st o112=112th
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("b1=%s b2=%s b3=%s b4=%s\n",
                    Humanize.bytes(500), Humanize.bytes(1536), Humanize.bytes(1048576), Humanize.bytes(5368709120));
                System.IO.Console.printf("o1=%s o2=%s o3=%s o11=%s o21=%s o112=%s\n",
                    Humanize.ordinal(1), Humanize.ordinal(2), Humanize.ordinal(3),
                    Humanize.ordinal(11), Humanize.ordinal(21), Humanize.ordinal(112));
                return;
            }
        }
    }
}
