import System.IO.Console;
program Literals;

public bundle main {
    public namespace app {

        // A comptime literal suffix is a member of a class (spec 17.10), called through the owner.
        public class Units {
            public comptime literal kib(int x) returns long {
                return cast<long>(x) * 1024;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                long size = Units.kib(64);
                System.IO.Console.println($"size = {size}");   // 65536
                return;
            }
        }
    }
}
