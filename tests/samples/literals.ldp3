import System.IO.Console;
program Literals;

public bundle main {
    public namespace app {

        // A namespace-level comptime literal suffix function (spec 17.10).
        // For now it is called explicitly; the `64 kib` suffix syntax and import
        // arrive in the next slice.
        public comptime literal kib(int x) returns long {
            return cast<long>(x) * 1024;
        }

        public class Main {
            public static method main(string[] args) returns void {
                long size = kib(64);
                System.IO.Console.println($"size = {size}");   // 65536
                return;
            }
        }
    }
}
