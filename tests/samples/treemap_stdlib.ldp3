import System.IO.Console;
import System.Collections.TreeMap;
import System.Collections.TreeSet;
program TreeMapStdlib;

// TreeMap<K,V> + TreeSet<T> (spec 34.1): ordered, backed by a binary search tree with
// self-referential generic pointer nodes. Keys are Comparable<K> -- the int family and String
// satisfy it via compiler builtins (key.compareTo()). Exercises a key update, an absent-key get
// (returns 0), String keys, and set de-duplication.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                TreeMap<int, int> m = new TreeMap<int, int>() on heap;
                m.put(5, 50); m.put(2, 20); m.put(8, 80); m.put(2, 22);   // key 2 updated to 22
                System.IO.Console.printf("size=%d g2=%d g5=%d g8=%d has3=%d has8=%d gNone=%d\n",
                    m.size(), m.get(2), m.get(5), m.get(8), m.containsKey(3), m.containsKey(8), m.get(99));

                TreeMap<String, int> sm = new TreeMap<String, int>() on heap;
                sm.put("banana", 2); sm.put("apple", 1); sm.put("cherry", 3);
                System.IO.Console.printf("str size=%d apple=%d cherry=%d hasX=%d\n",
                    sm.size(), sm.get("apple"), sm.get("cherry"), sm.containsKey("x"));

                TreeSet<int> s = new TreeSet<int>() on heap;
                s.add(5); s.add(5); s.add(1); s.add(9);
                System.IO.Console.printf("set size=%d has5=%d has7=%d\n",
                    s.size(), s.contains(5), s.contains(7));
                return;
            }
        }
    }
}
