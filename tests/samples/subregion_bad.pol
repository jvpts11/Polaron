import System.IO.Console;
import System.Memory.Units.kilobytes;
program SubregionBad;

// A SUB-REGION'S MEMORY IS PART OF ITS PARENT'S, so the parent cannot go first.
//
// `region frame = itself.allocate(1 kilobytes) in region world;` carves the frame's block out of the
// world's, which is the point: releasing the world reclaims every arena inside it in one stroke,
// with no second allocation and no walk. What it also means is that releasing the world while the
// frame is still live hands the frame's storage back to the allocator underneath it -- and the
// frame's own `release`, arriving later, reads a block that now belongs to somebody else.
//
// Nesting by SCOPE was always possible, and §10 already ordered the lifetimes of two independent
// regions. This makes the order physical rather than merely lexical, so it gets a rule of its own:
// the bytes come back with the parent either way, which is exactly why there is no reason to
// release it early.
public bundle Main {
    public namespace App {
        public class Dog {
            private int years;
            public constructor Dog(int years) { this.years = years; }
            public method getAge() returns int { return this.years; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                region world = itself.allocate(8 kilobytes);
                region frame = itself.allocate(1 kilobytes) in region world;
                Dog* scratch = new Dog(2) in region frame;
                System.IO.Console.println($"frame {scratch.getAge()}");
                release region world;      // the frame is still live, and lives INSIDE this
                release region frame;
                return;
            }
        }
    }
}
