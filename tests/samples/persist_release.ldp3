program PersistRelease;

// A non-eternal persistent field (spec 18.15) must be released somewhere in the
// program. Here `release persistent c.slot` satisfies that obligation, so this
// compiles and runs.

public bundle main {
    public namespace app {
        public class Cache {
            public persistent mutable int slot = 0;
            public constructor Cache() {}
            public method use() returns void { this.slot = this.slot + 1; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Cache c = new Cache() on heap;
                c.use();
                c.use();
                System.IO.printf("slot=%d\n", c.slot);
                release persistent c.slot;     // satisfies the release obligation
                delete c;
                return;
            }
        }
    }
}
