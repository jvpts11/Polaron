program PersistDag;

// Shared object (DAG): a and b point at the SAME Shared. With object ids the serializer writes
// it once and the second reference is a back-ref, so on reload a and b are still the same object
// -- incrementing via a is visible via b. Without ids, b would be a duplicate. a=1 b=2 c=3 then
// a=4 b=5 c=6 across runs.
public bundle main {
    public namespace app {
        public class Shared {
            public mutable int v = 0;
            public constructor Shared() {}
        }
        public class Holder {
            public persistent mutable Shared* a;
            public persistent mutable Shared* b;
            public constructor Holder() {}
        }
        public class Main {
            public static method tick() returns int {
                Holder h = new Holder() on heap;
                if (h.a == null) {
                    Shared* s = new Shared() on heap;
                    h.a = s;
                    h.b = s;
                }
                h.a.v = h.a.v + 1;
                int r = h.b.v;
                delete h;
                return r;
            }
            public static method main(string[] args) returns void {
                System.IO.println($"a={Main.tick()} b={Main.tick()} c={Main.tick()}");
                return;
            }
        }
    }
}
