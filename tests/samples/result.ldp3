program ResultTest;

// Either<T, E> -- two type parameters + generic inheritance + virtual dispatch. (Named Either/Left/
// Right rather than Result/Ok/Err, which are now built-in prelude types; this is a generics demo.)
public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Either<T, E> {
            public constructor Either() {}
            public method isOk() returns boolean { return false; }
        }
        public class Left<T, E> extends Either<T, E> {
            private T value;
            public constructor Left(T value) { this.value = value; }
            public override method isOk() returns boolean { return true; }
            public method get() returns T { return this.value; }
        }
        public class Right<T, E> extends Either<T, E> {
            private E error;
            public constructor Right(E error) { this.error = error; }
            public method code() returns E { return this.error; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Left<int, int>* ok = new Left<int, int>(7) on heap;
                Right<int, int>* err = new Right<int, int>(404) on heap;
                System.IO.Console.println($"ok: {ok.isOk()} {ok.get()}");      // 1 7
                System.IO.Console.println($"err: {err.isOk()} {err.code()}");  // 0 404
                delete ok;
                delete err;
                return;
            }
        }
    }
}
