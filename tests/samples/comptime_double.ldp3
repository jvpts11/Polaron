import System.IO.Console;
program ComptimeDouble;

// `comptime` methods may return floating-point values (spec 28.3): the evaluator
// is numeric (int/double), so a mixed-type body (int counter, double accumulator)
// folds at compile time into a `const double`.

public bundle main {
    public namespace app {
        public class Math {
            public static comptime method scale(int n, double factor) returns double {
                mutable double acc = 0.0;
                for (mutable int i = 0; i < n; i++) {
                    acc = acc + factor;
                }
                return acc;
            }
            public static comptime method half(int x) returns double { return x * 0.5; }

            public static fixed double TOTAL = Math.scale(3, 1.5);   // 4.5
            public static fixed double H = Math.half(7);             // 3.5
        }

        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("total=%d half=%d\n",
                                 cast<int>(Math.TOTAL * 100.0), cast<int>(Math.H * 100.0));
                return;
            }
        }
    }
}
