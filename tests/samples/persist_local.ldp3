program PersistLocal;

// A `persistent` LOCAL variable (spec 18: persistent applies to internal variables too).
// It lives in a process-lifetime global, so it keeps its value across CALLS within a run --
// it reattaches instead of reinitializing. 3 calls -> a=1 b=2 c=3.
public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Main {
            public static method counter() returns int {
                persistent mutable int n = 0;
                n = n + 1;
                return n;
            }
            public static method main(string[] args) returns void {
                System.IO.Console.println($"a={Main.counter()} b={Main.counter()} c={Main.counter()}");
                return;
            }
        }
    }
}
