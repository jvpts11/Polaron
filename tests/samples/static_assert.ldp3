program StaticAssert;

public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                // Compile-time checks (spec 28.2): these all hold, so the program builds.
                static_assert(2 + 2 == 4, "math is broken");
                static_assert(16 * 1024 < 65536, "buffer does not fit");
                static_assert(!(1 > 2), "logic is broken");
                System.IO.Console.println($"checks passed = {1}");
                return;
            }
        }
    }
}
