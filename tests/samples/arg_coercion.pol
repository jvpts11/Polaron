import System.IO.Console;
program ArgCoercion;

// Call arguments are coerced to the callee's parameter type, so a method,
// constructor, static call, or virtual dispatch taking a non-i32-width parameter
// (long/float/double/...) can be called with a differently-typed value (e.g.
// an i32 literal into an long param, or an int into a float param).

public bundle main {
    public namespace app {

        public class Calc {
            private long base;

            public constructor Calc(long b) {   // i32 literal 5 -> long param
                this.base = b;
            }

            public method addWide(long x, double d) returns long {
                return this.base + x;            // long arithmetic; d unused
            }

            public method scaleF(float f) returns float {
                return f;                        // i32 3 -> float param
            }

            public static method bigStatic(long n) returns long {
                return n;                        // i32 7 -> long static param
            }
        }

        public abstract class Shape {
            public abstract method shift(long by) returns long;
        }

        public class Box extends Shape {
            public override method shift(long by) returns long {
                return by + 1;                   // virtual call: i32 40 -> long param
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Calc c = new Calc(5) on heap;
                long r = c.addWide(10, 2);          // 5 + 10 = 15
                float f = c.scaleF(3);             // 3.0
                long s = Calc.bigStatic(7);         // 7
                Shape* sh = new Box() on heap;
                long v = sh.shift(40);              // 41, through a vtable
                System.IO.Console.printf("%d %d %d %d\n",
                                 cast<int>(r), cast<int>(f), cast<int>(s), cast<int>(v));
                delete c;
                delete sh;
                return;
            }
        }
    }
}
