import System.IO.Console;
program BitwiseCompound;

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int x = 12;   // 1100
                x &= 10;              // & 1010 = 1000 = 8
                x |= 1;               // | 0001 = 1001 = 9
                x ^= 3;               // ^ 0011 = 1010 = 10
                x <<= 2;              // 40
                x >>= 1;              // 20
                System.IO.Console.println($"x = {x}");   // 20
                return;
            }
        }
    }
}
