import System.IO.Console;
import System.Collections.SpatialGrid;
program SpatialGridDemo;

// A 2D spatial hash grid (spec 34.1) in pure Polaron. Prints:
//   box20=3 box9=2 far=1 all=5
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable SpatialGrid g = new SpatialGrid(10, 16) on heap;
                g.insert(5, 5); g.insert(15, 15); g.insert(25, 25); g.insert(6, 6); g.insert(100, 100);
                System.IO.Console.printf("box20=%d box9=%d far=%d all=%d\n",
                    g.queryRect(0, 0, 20, 20),
                    g.queryRect(0, 0, 9, 9),
                    g.queryRect(90, 90, 110, 110),
                    g.queryRect(0, 0, 200, 200));
                return;
            }
        }
    }
}
