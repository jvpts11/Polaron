import System.IO.Console;
program FfiStruct;

// FFI struct by value (spec 26): a small value-type struct is passed to and returned from a C
// function by value. On Win64 a 1/2/4/8-byte struct travels in a register, so the compiler loads
// its bytes as an integer for the call and stores the returned bytes back into a fresh struct.
// Point { int x; int y; } is 8 bytes and matches the C `struct Ldp3Point` in the runtime.

public bundle main {
    public namespace app {
        public struct Point {
            public mutable int x;
            public mutable int y;
            public constructor Point(int x, int y) {
                this.x = x;
                this.y = y;
            }
        }
        extern cdecl method ldp3_point_sum(Point p) returns int;
        extern cdecl method ldp3_point_scale(Point p, int k) returns Point;
        public class Main {
            public static method main(string[] args) returns void {
                Point p = new Point(3, 4);
                int s = ldp3_point_sum(p);              // 7
                Point q = ldp3_point_scale(p, 10);      // {30, 40}
                System.IO.Console.printf("s=%d qx=%d qy=%d\n", s, q.x, q.y);
                return;
            }
        }
    }
}
