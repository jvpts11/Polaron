import System.IO.Console;
program PersistDemo;

// A static persistent field is run-lifetime storage (spec 18, in-process): like a static field,
// it holds its value for the duration of the run. bump() is called 3x -> runs = 3.
// It is `eternal` (spec 18.13): intended to live the whole run, so no release is required.
public bundle main {
    public namespace app {
        public class Counter {
            public eternal static persistent mutable int runs = 0;
            public static method bump() returns void { Counter.runs = Counter.runs + 1; }
            public static method get() returns int { return Counter.runs; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Counter.bump();
                Counter.bump();
                Counter.bump();
                System.IO.Console.println($"runs = {Counter.get()}");
                return;
            }
        }
    }
}
