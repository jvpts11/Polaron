import System.IO.Console;
import System.Time.Calendar;
program CalendarDemo;

// Calendar arithmetic (spec 34) in pure Polaron. Prints:
//   y2000sat=6 y2024mon=1 leap2000=1 leap1900=0 feb2024=29 doy=61
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("y2000sat=%d y2024mon=%d leap2000=%d leap1900=%d feb2024=%d doy=%d\n",
                    Calendar.dayOfWeek(2000, 1, 1),
                    Calendar.dayOfWeek(2024, 1, 1),
                    Calendar.isLeapYear(2000),
                    Calendar.isLeapYear(1900),
                    Calendar.daysInMonth(2024, 2),
                    Calendar.dayOfYear(2024, 3, 1));
                return;
            }
        }
    }
}
