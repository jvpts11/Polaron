import System.IO.Console;
import System.Test.Assert;
import System.Test.TestRunner;
program TestFrameworkDemo;

// The System.Test unit-test framework (spec 34) in pure Polaron. Prints PASS lines then:
//   4 passed, 0 failed
//   all=1
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable TestRunner t = new TestRunner() on heap;
                t.check("int equal", Assert.eq(2 + 2, 4));
                t.check("string equal", Assert.eqStr("ab".concat("c"), "abc"));
                t.check("double near", Assert.near(0.1 + 0.2, 0.3, 0.0001));
                t.check("boolean", Assert.isTrue(5 > 3));
                t.report();
                System.IO.Console.printf("all=%d\n", t.allPassed());
                return;
            }
        }
    }
}
