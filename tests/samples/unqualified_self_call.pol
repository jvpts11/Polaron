import System.IO.Console;
program UnqualifiedSelfCall;

// Polaron has no free functions, but the `this.` / `ClassName.` receiver on a *same-class* method call is
// optional: a bare `name(...)` inside a class resolves to `this.name(...)` (instance) or
// `ClassName.name(...)` (static), exactly as if the receiver were written. This covers the classic slip
// for anyone coming from C -- `int a = sum(x, y);` next to `method sum(...)` -- which now just works.
public bundle main {
    public namespace app {
        public class Calc {
            private mutable int base;
            public constructor Calc(int b) {
                this.base = clamp(b);            // ctor -> same-class instance method, unqualified
            }
            public method clamp(int x) returns int {
                if (x < 0) { return 0; }
                return x;
            }
            public method addToBase(int y) returns int { return this.base + y; }
            public method combine(int y) returns int {
                return addToBase(y) + clamp(y);  // instance -> two same-class instance methods, unqualified
            }
        }
        public class Main {
            public static method sum(int a, int b) returns int { return a + b; }
            public static method twice(int a) returns int { return sum(a, a); }  // static -> static, unqualified
            public static method main(string[] args) returns void {
                Calc c = new Calc(-5) on stack;  // clamp(-5) -> 0
                System.IO.Console.printf("self=%d %d %d\n", sum(3, 4), twice(10), c.combine(7));
                return;
            }
        }
    }
}
