program MultiFile;

// Part A of a program split across two .ldp3 files (spec 2.5): defines a class
// used by the Main in part B. The compiler merges files of the same program.
public bundle main {
    public namespace app {
        public class Greeter {
            private int value;
            public constructor Greeter(int value) { this.value = value; }
            public method greet() returns int { return this.value; }
        }
    }
}
