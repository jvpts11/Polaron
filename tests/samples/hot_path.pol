import System.IO.Console;
program HotPath;

// Two explicit escape hatches, both named and opt-in -- Polaron hands out no undefined behaviour, but it
// does hand you the cannon when you ask for it by name.
//
//  * `[[no_bounds_check]]` (spec 36.4): the method's array indexing drops the runtime bounds check.
//    For a hot path whose bounds the author has already established.
//  * `wrappingDiv` / `uncheckedDiv` (spec 3.6): division that wraps on its ONE overflow case,
//    INT_MIN / -1, instead of trapping. A zero divisor still panics -- that is not overflow.

public bundle main {
    public namespace app {

        public class Hot {
            [[no_bounds_check]]
            public static method sum(int[] a, int n) returns int {
                mutable int s = 0;
                mutable int i = 0;
                while (i < n) {
                    s = s + a[i];
                    i = i + 1;
                }
                return s;
            }

            // The same loop, with the checks the language gives you by default.
            public static method sumChecked(int[] a, int n) returns int {
                mutable int s = 0;
                mutable int i = 0;
                while (i < n) {
                    s = s + a[i];
                    i = i + 1;
                }
                return s;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                int[] xs = new int[4]();
                mutable int i = 0;
                while (i < 4) {
                    xs[i] = i + 1;
                    i = i + 1;
                }
                System.IO.Console.printf("hot=%d checked=%d\n", Hot.sum(xs, 4), Hot.sumChecked(xs, 4));

                // Ordinary division of the most negative int by -1 has no representable quotient, so it
                // traps. wrappingDiv wraps it (to INT_MIN itself) rather than trapping.
                int lo = -2147483648;
                System.IO.Console.printf("wrapDiv=%d uncheckedDiv=%d\n", lo.wrappingDiv(-1),
                    lo.uncheckedDiv(-1));
                System.IO.Console.printf("plainDiv=%d\n", lo.wrappingDiv(2));

                delete xs;
                return;
            }
        }
    }
}
