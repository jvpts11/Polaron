import System.IO.Console;
program CollectionsBasic;

// Array-backed collections (spec 34.1): Stack (LIFO), Queue (FIFO ring buffer), Deque (both ends).
// Pure-LDP3 generic classes in System.Collections, like ArrayList. (Generic stdlib types are used
// without an explicit import for now -- importing a generic by base name is a separate fix.)

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                Stack<int> s = new Stack<int>() on heap;
                s.push(1); s.push(2); s.push(3);
                System.IO.Console.printf("stack=%d %d\n", s.pop(), s.pop());      // 3 2

                Queue<int> q = new Queue<int>() on heap;
                q.enqueue(10); q.enqueue(20); q.enqueue(30);
                System.IO.Console.printf("queue=%d %d\n", q.dequeue(), q.dequeue());  // 10 20

                Deque<int> d = new Deque<int>() on heap;
                d.addLast(1); d.addFirst(0); d.addLast(2);
                System.IO.Console.printf("deque=%d %d %d\n",
                                         d.removeFirst(), d.removeFirst(), d.removeLast());  // 0 1 2
                return;
            }
        }
    }
}
