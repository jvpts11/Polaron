import System.IO.Console;
program PolhModifierOrder;

// A GENERATED HEADER MUST PARSE WITH THE PARSER THAT GENERATED IT.
//
// The `.polh` a bundle carries is Polaron source written by this compiler and read back by it, so the
// emitter is bound by every rule the grammar has -- including the modifier order of spec 37.9. It
// wrote `static extern` where the parser demands `extern static`, and nothing noticed until a
// program imported a bundle with an external static method: the failure arrived far from its cause,
// as "failed to parse the header of bundle X" about a file nobody had written by hand.
//
// This is the shape that catches it: a bundle whose public API needs two modifier groups at once.
// `extern` is foreignness and `static` is binding, and they are the pair the emitter had backwards.
public bundle Lib {
    public namespace Api {

        public class Clock {
            // Foreignness before binding. Both are needed for the ordering to be observable at all.
            public extern cdecl static method time(long ptr) returns long;

            public static method twice(int n) returns int {
                return n + n;
            }
        }
    }
}
