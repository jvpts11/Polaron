import System.IO.Console;
program Scoped;

// Fase D: `using` disposes a resource at the block's end; `defer` runs at the
// end of the method, in LIFO order. Expected output:
//   inside using
//   closing 3
//   body
//   deferred 2
//   deferred 1

public bundle main {
    public namespace app {

        public class Resource {
            public mutable int id;

            public constructor Resource(int n) {
                this.id = n;
            }

            public destructor ~Resource() returns void {
                System.IO.Console.println($"closing {this.id}");
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                using (Resource r = new Resource(3) on heap) {
                    System.IO.Console.println("inside using");
                }   // r disposed here -> closing 3

                defer { System.IO.Console.println("deferred 1"); }
                defer { System.IO.Console.println("deferred 2"); }
                System.IO.Console.println("body");
                return;   // defers run LIFO: deferred 2, then deferred 1
            }
        }
    }
}
