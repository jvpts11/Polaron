import System.Errors.Result;
import System.Concurrency.Task;

program AsyncValueResultBad;

// A value Result/Option travels through the Task's result slot, which is not yet sized for the
// { tag, payload } struct, so an async method returning the VALUE form must fail with a clear
// diagnostic (pointing at the boxed form) rather than silently corrupt the result. The boxed form
// `Result<T,E>*` is the supported way to return a Result from an async method today.
public bundle main {
    public namespace app {
        public class Main {
            public static async method compute(int x) returns Result<int, int> {   // value form: rejected
                return Ok(x * 2);
            }
            public static method main(string[] args) returns void {
                return;
            }
        }
    }
}
