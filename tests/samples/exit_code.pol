import System.IO.Console;
import System.OS.Exit;
program ExitCode;

// A PROGRAM CAN FAIL ON PURPOSE. `main` returns `void`, so until now every Polaron program exited 0 --
// one that printed "I do not know that command" and one that did exactly what it was asked were the
// same run to a script, a build, or a gate. `System.OS.Exit` is the program's half of the
// conversation the operating system starts with a signal.
//
// `exit` and not `_exit`: what was printed is flushed first, so the last thing said actually reaches
// whoever is reading. This sample prints, then fails, and both must be observable.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.println("refused: I do not know that command");
                Exit.now(3);
                // Unreachable: the line below would print if `Exit.now` returned, which is exactly
                // what this sample is here to prove it does not.
                System.IO.Console.println("this must not be printed");
                return;
            }
        }
    }
}
