program CatalogExtends;

// Catalogs extending catalogs (spec 12.3): the contract is transitive. An enum
// implementing `Derived` must also satisfy `Base` (its values and methods), and
// is a subtype of both. byCatalog must list the full transitive value set.

public bundle main {
    public namespace app {

        public catalog Base {
            a,
            b

            method foo() returns int;
        }

        public catalog Derived extends Base {
            c

            method bar() returns int;
        }

        public enum E extends Derived {
            own

            byCatalog {
                a,
                b,
                c
            }

            public method foo() returns int { return 7; }
            public method bar() returns int { return 9; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                E e = E.own;
                Base bz = E.own;   // subtype of the grandparent catalog too
                System.IO.printf("own=%d a=%d c=%d foo=%d bar=%d count=%d\n",
                                 E.own, E.a, E.c, e.foo(), e.bar(), E.count());
                return;
            }
        }
    }
}
