program CascadeInherited;

// `cascade delete` (spec 37.1) also frees objects owned by composition through
// INHERITED value fields: `owned` is declared in Base, but cascade-deleting a
// Derived still runs ~Leaf for it.

public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Leaf {
            public constructor Leaf() {}
            public destructor ~Leaf() returns void { System.IO.Console.printf("~Leaf\n"); }
        }
        public class Base {
            private mutable Leaf owned;
            public constructor Base() { this.owned = new Leaf() on heap; }
            public destructor ~Base() returns void { System.IO.Console.printf("~Base\n"); }
        }
        public class Derived extends Base {
            public constructor Derived() {}
            public override destructor ~Derived() returns void { System.IO.Console.printf("~Derived\n"); }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Derived d = new Derived() on heap;
                cascade delete d;      // ~Derived -> ~Base (chained), then inherited owned -> ~Leaf
                System.IO.Console.printf("done\n");
                return;
            }
        }
    }
}
