program Loops;

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                // break and continue in a for loop (spec 7).
                mutable int sum = 0;
                for (mutable int i = 0; i < 10; i++) {
                    if (i == 5) { break; }      // stop at 5
                    if (i == 2) { continue; }   // skip 2
                    sum = sum + i;
                }
                System.IO.println($"for sum = {sum}");        // 0+1+3+4 = 8

                // break and continue in a while loop.
                mutable int n = 0;
                mutable int total = 0;
                while (n < 100) {
                    n = n + 1;
                    if (n == 3) { continue; }   // skip 3
                    if (n == 6) { break; }      // stop at 6
                    total = total + n;
                }
                System.IO.println($"while total = {total}");  // 1+2+4+5 = 12
                return;
            }
        }
    }
}
