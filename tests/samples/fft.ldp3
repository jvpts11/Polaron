import System.IO.Console;
import System.Math.Fft;
program FftDemo;

// Radix-2 FFT (spec 34.6) in pure LDP3. Prints:
//   dc_re=4.0000 dc_im=0.0000
//   back0=1.0000 back1=1.0000 back4=0.0000
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable double[] re = new double[8]();
                mutable double[] im = new double[8]();
                re[0]=1.0; re[1]=1.0; re[2]=1.0; re[3]=1.0; re[4]=0.0; re[5]=0.0; re[6]=0.0; re[7]=0.0;
                Fft.forward(re, im, 8);
                System.IO.Console.printf("dc_re=%.4f dc_im=%.4f\n", re[0], im[0]);
                Fft.inverse(re, im, 8);
                System.IO.Console.printf("back0=%.4f back1=%.4f back4=%.4f\n", re[0], re[1], re[4]);
                return;
            }
        }
    }
}
