program LifecycleOnUnload;

// onClassUnload (spec 32.5): runs when the class is unimported (spec 30). Now that unimport
// exists, the hook fires -- right before the class is marked dead and its code is ripped
// from RAM.

public bundle main {
    public namespace app {
        public class Cache {
            onClassUnload { Console.println("cache unloaded"); }
            public constructor Cache() {}
            public method use() returns void { Console.println("using cache"); }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Cache c = new Cache() on heap;
                c.use();                 // using cache
                unimport Cache;          // fires onClassUnload -> cache unloaded
                Console.println("done");
                return;
            }
        }
    }
}
