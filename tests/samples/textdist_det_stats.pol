import System.IO.Console;
import System.Text.TextDistance;
import System.Math.Matrix;
import System.Math.Stats;
program TextDistDetStats;

// Edit distance, exact integer determinant, and descriptive stats (spec 4 / 34.6): Levenshtein of
// kitten/sitting is 3, det[[1,2],[3,4]] is -2, and sum/range/mode of [1,2,2,3,3,3].
// Prints: lev=3 det=-2 sum=14 range=2 mode=3.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable Matrix a = new Matrix(2, 2) on heap;
                a.set(0, 0, 1);
                a.set(0, 1, 2);
                a.set(1, 0, 3);
                a.set(1, 1, 4);
                mutable int[] xs = new int[6]();
                xs[0] = 1;
                xs[1] = 2;
                xs[2] = 2;
                xs[3] = 3;
                xs[4] = 3;
                xs[5] = 3;
                System.IO.Console.printf("lev=%d det=%d sum=%d range=%d mode=%d\n",
                    TextDistance.levenshtein("kitten", "sitting"), a.determinant(),
                    Stats.sum(xs), Stats.range(xs), Stats.mode(xs));
                return;
            }
        }
    }
}
