program StaticAssertComptime;

// static_assert (spec 28.2) shares the one comptime evaluator, so its condition
// may use named consts and `comptime` method calls. These all hold, so the
// program compiles and runs.

public bundle main {
    public namespace app {
        public class Math {
            public static comptime method fib(int n) returns int {
                if (n < 2) { return n; }
                return Math.fib(n - 1) + Math.fib(n - 2);
            }
        }
        public const int N = 10;
        public const int LIMIT = 1 << 16;   // 65536

        public class Main {
            public static method main(string[] args) returns void {
                static_assert(Math.fib(N) == 55, "fib(10) must be 55");
                static_assert(N * N < LIMIT, "N squared must fit");
                System.IO.printf("static asserts passed\n");
                return;
            }
        }
    }
}
