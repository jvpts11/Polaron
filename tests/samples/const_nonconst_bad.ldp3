import System.IO.Console;
program ConstNonConstBad;

// A `const` initializer must be a compile-time constant. Referencing something
// that is not a known const (here an undeclared name) is rejected (spec 28.1).

public bundle main {
    public namespace app {
        public class Cfg {
            public static fixed int OK = 10;
            public static fixed int BAD = Cfg.OK + mystery;   // 'mystery' is not a constant
        }

        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("%d\n", Cfg.BAD);
                return;
            }
        }
    }
}
