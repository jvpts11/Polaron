import System.IO.Console;
import System.Security.Sha1;
import System.Text.Ini;
program Sha1Ini;

// SHA-1 (FIPS 180-1) and a minimal INI parser, both pure Polaron. Prints:
//   sha1abc=a9993e364706816aba3e25717850c26c9cd0d89d
//   sha1empty=da39a3ee5e6b4b0d3255bfef95601890afd80709
//   host=localhost port=8080 db=polaron missing=0
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("sha1abc=%s\n", Sha1.digest("abc"));
                System.IO.Console.printf("sha1empty=%s\n", Sha1.digest(""));
                String cfg = "[server]\nhost = localhost\nport = 8080\n; a comment\n[db]\nname=polaron";
                mutable Ini ini = new Ini(cfg) on heap;
                System.IO.Console.printf("host=%s port=%s db=%s missing=%d\n",
                    ini.get("server", "host"), ini.get("server", "port"),
                    ini.get("db", "name"), ini.has("server", "nope"));
                return;
            }
        }
    }
}
