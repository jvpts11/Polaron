import System.IO.Console;
program EscapeInteriorPointerBad;

// A POINTER TO A FIELD OF A FRAME VALUE, HANDED BACK.
//
// `return p` was refused and `return &p.a` was not, which is the same escape one dot along: the
// frame is gone either way, and the caller reads what used to be in it. The analysis was placing a
// member access as "the region of the object p" -- and two objects are incomparable, so it compared
// against nothing and said nothing.
//
// A field of something in this frame is in this frame. That is the whole fix, and it is also what
// makes `&here[0]` over a frame array answerable.
//
// Refused with Polaron-1721.
public bundle Main {
    public namespace App {
        public struct Pair {
            public mutable int a;
            public mutable int b;
        }
        public class Main {
            static method pick() returns int* {
                Pair p = new Pair() on stack;
                p.a = 1;
                return &p.a;
            }
            public static method main(string[] args) returns void {
                int* q = Main.pick();
                System.IO.Console.println($"{q[0]}");
                return;
            }
        }
    }
}
