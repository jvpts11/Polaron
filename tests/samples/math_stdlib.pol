import System.IO.Console;
import System.Math.Math;
import System.Math.Random;
program MathStdlib;

// Math + Random (spec 34.6). Math is a compiler builtin whose functions lower to LLVM intrinsics
// (sqrt/sin/cos/abs/floor/ceil/round/trunc/exp/log on double; pow/min/max binary) -- no FFI.
// Random is a pure-Polaron xorshift64 PRNG; seed 42 is deterministic.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("sqrt=%d pow=%d max=%d floor=%d\n",
                                         cast<int>(Math.sqrt(16.0)), cast<int>(Math.pow(2.0, 10.0)),
                                         cast<int>(Math.max(3.0, 7.0)), cast<int>(Math.floor(3.7)));
                Random rng = new Random(cast<ulong>(42)) on heap;
                System.IO.Console.printf("rand=%d %d %d\n", rng.nextIntMax(100), rng.nextIntMax(100),
                                         rng.nextIntMax(100));
                return;
            }
        }
    }
}
