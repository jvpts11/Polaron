import System.IO.Console;
import System.Text.CsvWriter;
program CsvWriterDemo;

// CSV row writing (RFC 4180, spec 34) in pure Polaron. Prints:
//   row=a,"b,c","d""e"
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable String[] cells = new String[3]();
                cells[0] = "a";
                cells[1] = "b,c";
                cells[2] = "d\"e";
                System.IO.Console.printf("row=%s\n", CsvWriter.buildRow(cells, 3));
                return;
            }
        }
    }
}
