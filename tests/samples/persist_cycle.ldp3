program PersistCycle;

// Self-cycle: c.next = c. Object ids break the cycle on save (the second visit to c is a
// back-reference, not infinite recursion) and rebuild it on load. So head.next is head again:
// a=1 b=2 c=3, then a=4 b=5 c=6 across runs.
public bundle main {
    public namespace app {
        public class Cell {
            public mutable int v = 0;
            public mutable Cell* next;
            public constructor Cell() {}
        }
        public class Ring {
            public persistent mutable Cell* head;
            public constructor Ring() {}
        }
        public class Main {
            public static method tick() returns int {
                Ring r = new Ring() on heap;
                if (r.head == null) {
                    Cell* c = new Cell() on heap;
                    c.next = c;
                    r.head = c;
                }
                r.head.v = r.head.v + 1;
                int x = r.head.next.v;
                delete r;
                return x;
            }
            public static method main(string[] args) returns void {
                System.IO.println($"a={Main.tick()} b={Main.tick()} c={Main.tick()}");
                return;
            }
        }
    }
}
