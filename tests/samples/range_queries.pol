import System.IO.Console;
import System.Algorithms.Fenwick;
import System.Algorithms.SegmentTree;
import System.Algorithms.SparseTable;
program RangeQueries;

// Range-query structures (spec 34.1) in pure Polaron. Prints:
//   fw_pre7=46 fw_r2to5=28
//   seg_q1=19 seg_q2=38
//   min_0to5=1 min_2to4=1 min_4to5=3
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable Fenwick fw = new Fenwick(8) on heap;
                for (mutable int i = 0; i < 8; i++) { fw.add(i, i + 1); }   // values 1..8
                fw.add(3, 10);                                              // index 3 -> 4+10 = 14
                System.IO.Console.printf("fw_pre7=%d fw_r2to5=%d\n", fw.prefixSum(7), fw.rangeSum(2, 5));

                mutable int[] data = new int[6]();
                data[0]=5; data[1]=2; data[2]=7; data[3]=1; data[4]=9; data[5]=3;
                mutable SegmentTree st = new SegmentTree(data) on heap;
                int q1 = st.query(1, 4);                                    // 2+7+1+9 = 19
                st.update(3, 20);                                           // index 3 -> 20
                int q2 = st.query(1, 4);                                    // 2+7+20+9 = 38
                System.IO.Console.printf("seg_q1=%d seg_q2=%d\n", q1, q2);

                mutable SparseTable sp = new SparseTable(data) on heap;
                System.IO.Console.printf("min_0to5=%d min_2to4=%d min_4to5=%d\n",
                    sp.queryMin(0, 5), sp.queryMin(2, 4), sp.queryMin(4, 5));
                return;
            }
        }
    }
}
