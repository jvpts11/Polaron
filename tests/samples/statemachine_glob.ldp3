import System.IO.Console;
import System.Text.StateMachine;
import System.Text.Glob;
program StateMachineGlob;

// A finite state machine and glob/wildcard matching (spec 34), both pure LDP3. Prints:
//   t1=1 t2=0 mid=unlocked end=locked
//   g1=1 g2=1 g3=0 g4=1 g5=1
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable StateMachine sm = new StateMachine("locked") on heap;
                sm.addTransition("locked", "coin", "unlocked");
                sm.addTransition("unlocked", "push", "locked");
                boolean t1 = sm.fire("coin");        // -> unlocked
                boolean t2 = sm.fire("coin");        // no transition from unlocked on coin
                String s1 = sm.state();
                sm.fire("push");                     // -> locked
                System.IO.Console.printf("t1=%d t2=%d mid=%s end=%s\n", t1, t2, s1, sm.state());

                System.IO.Console.printf("g1=%d g2=%d g3=%d g4=%d g5=%d\n",
                    Glob.matches("a*c", "abbbc"),
                    Glob.matches("a?c", "abc"),
                    Glob.matches("a*c", "abd"),
                    Glob.matches("*.txt", "file.txt"),
                    Glob.matches("h*o?world", "hello world"));
                return;
            }
        }
    }
}
