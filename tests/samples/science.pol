import System.IO.Console;
import System.Science.Special;
import System.Science.Normal;
import System.Science.Poisson;
import System.Science.Binomial;
import System.Science.ChiSquare;
import System.Science.StudentT;
import System.Science.Roots;
import System.Science.Calculus;
import System.Science.Ode;
import System.Science.Optimize;
import System.Science.Decompose;
import System.Science.Hypothesis;
program ScienceSample;

// `Stats` could say what a sample LOOKED like -- mean, median, percentile -- and nothing could say
// whether it was SURPRISING, which is the question statistics exists to answer. `Fft`, `Matrix`,
// `Polynomial` and a forward-mode `Dual` were here; distributions, special functions, root finding,
// integration, ODE solvers, optimisation and matrix decompositions were not.
//
// Every number below is checked against a closed form or a value that can be looked up, because an
// approximation that is subtly wrong is the failure mode of all of this -- it returns a plausible
// number on every input and there is nothing to notice.
//
//   gamma(5)      = 4! = 24                    erf(1)     = 0.842701
//   Normal cdf at 1 sigma = 0.841345           its inverse comes back to 1
//   Poisson(k<=2, mean 2)   = 0.676676         Binomial(k<=5, n=10, p=0.5) = 0.623047
//   root of x^2-2 on [0,2]  = sqrt 2           d/dx x^3 at 2 = 12
//   integral of x^2 on [0,3] = 9               y'=y from 1 over [0,1] -> e
//   minimum of (x-3)^2      = 3                det[[4,3],[6,3]] = -6
//   solve [[2,1],[1,3]]x=[5,10] -> (1, 3)      eigenvalues of [[2,1],[1,2]] = 1 and 3
//
// Prints: gamma=24.0000 erf=0.842701 ncdf=0.841345 nq=1.000000 pois=0.676676 binom=0.623047
//         root=1.414214 deriv=12.000000 integral=9.000000 ode=2.718282 min=3.000000
//         det=-6.000000 solve=1.000000,3.000000 eig=1.000000,3.000000 p=0.000009
//
// (The last two are worth stating: the eigenvalues come out in the order Jacobi leaves them, and the
// p-value is 9.3e-6 -- a t of 28.3 on four degrees of freedom, which is what five values within 0.2
// of 10 look like against a claim of 8.)
public bundle Main {
    public namespace App {
        public class Main {
            public static method main(string[] args) returns void {
                // Special functions.
                System.IO.Console.printf("gamma=%.4f erf=%.6f ",
                                         Special.gamma(5.0), Special.erf(1.0));

                // The normal, there and back: the quantile of the cdf of 1 must be 1 again.
                double c = Normal.cdf(1.0, 0.0, 1.0);
                System.IO.Console.printf("ncdf=%.6f nq=%.6f ", c, Normal.quantile(c, 0.0, 1.0));

                // Discrete distributions, through logs so a large mean does not overflow.
                System.IO.Console.printf("pois=%.6f binom=%.6f ",
                                         Poisson.cdf(2, 2.0), Binomial.cdf(5, 10, 0.5));

                // Brent finds sqrt(2) as the root of x^2 - 2.
                System.IO.Console.printf("root=%.6f ",
                    Roots.brent(lambda(double x) returns double { return x * x - 2.0; },
                                0.0, 2.0, 0.000000001));

                // A central difference and an adaptive Simpson, on functions whose answers are exact.
                System.IO.Console.printf("deriv=%.6f integral=%.6f ",
                    Calculus.derivative(lambda(double x) returns double { return x * x * x; }, 2.0),
                    Calculus.integrate(lambda(double x) returns double { return x * x; },
                                       0.0, 3.0, 0.000000001));

                // y' = y from y(0)=1 over [0,1] is e, which is the standard way to see an integrator
                // work: RK4 gets six digits in ten steps where Euler gets one.
                System.IO.Console.printf("ode=%.6f ",
                    Ode.rk4(lambda(double t, double y) returns double { return y; },
                            0.0, 1.0, 1.0, 20));

                System.IO.Console.printf("min=%.6f ",
                    Optimize.minimize(lambda(double x) returns double {
                        return (x - 3.0) * (x - 3.0);
                    }, 0.0, 10.0, 0.0000001));

                // Linear algebra: a determinant, a solve, and symmetric eigenvalues.
                mutable double[] m = new double[4]();
                m[0] = 4.0; m[1] = 3.0; m[2] = 6.0; m[3] = 3.0;
                System.IO.Console.printf("det=%.6f ", Decompose.determinant(m, 2));

                mutable double[] a = new double[4]();
                a[0] = 2.0; a[1] = 1.0; a[2] = 1.0; a[3] = 3.0;
                mutable double[] b = new double[2]();
                b[0] = 5.0; b[1] = 10.0;
                mutable double[] x = Decompose.solve(a, 2, b);
                System.IO.Console.printf("solve=%.6f,%.6f ", x[0], x[1]);

                mutable double[] s = new double[4]();
                s[0] = 2.0; s[1] = 1.0; s[2] = 1.0; s[3] = 2.0;
                mutable double[] eig = Decompose.symmetricEigenvalues(s, 2);
                System.IO.Console.printf("eig=%.6f,%.6f ", eig[0], eig[1]);

                // And the point of all of it: a sample, and how surprised to be by it. Five values
                // near 10 tested against a claim of 8 -- clearly inconsistent, and the p-value says
                // by how much rather than merely that.
                mutable double[] sample = new double[5]();
                sample[0] = 9.8; sample[1] = 10.1; sample[2] = 10.0; sample[3] = 9.9; sample[4] = 10.2;
                System.IO.Console.printf("p=%.6f\n", Hypothesis.tTestOneSample(sample, 8.0));

                delete m; delete a; delete b; delete x; delete s; delete eig; delete sample;
                return;
            }
        }
    }
}
