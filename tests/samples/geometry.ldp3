import System.IO.Console;
import System.Math.Polygon;
import System.Math.ConvexHull;
program Geometry;

// Computational geometry (spec 34.6) in pure LDP3: shoelace area, point-in-polygon, convex hull. Prints:
//   area2=32 in=1 out=0
//   hull=4
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int[] sx = new int[4]();
                mutable int[] sy = new int[4]();
                sx[0]=0; sy[0]=0; sx[1]=4; sy[1]=0; sx[2]=4; sy[2]=4; sx[3]=0; sy[3]=4;
                System.IO.Console.printf("area2=%d in=%d out=%d\n",
                    Polygon.area2(sx, sy, 4), Polygon.contains(sx, sy, 4, 2, 2), Polygon.contains(sx, sy, 4, 5, 5));

                mutable int[] hx = new int[6]();
                mutable int[] hy = new int[6]();
                hx[0]=0; hy[0]=0; hx[1]=4; hy[1]=0; hx[2]=4; hy[2]=4; hx[3]=0; hy[3]=4; hx[4]=2; hy[4]=2; hx[5]=1; hy[5]=1;
                System.IO.Console.printf("hull=%d\n", ConvexHull.size(hx, hy, 6));
                return;
            }
        }
    }
}
