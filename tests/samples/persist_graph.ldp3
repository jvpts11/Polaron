program PersistGraph;

// Graph serialization (spec 18, step C): `engine` is a persistent POINTER. The pointed-to
// Engine is followed and serialized along with the Car's block, so it survives `delete c` and
// reattaches across runs. tick() creates the engine once then bumps its power: run 1 prints
// a=1 b=2 c=3, run 2 continues a=4 b=5 c=6.
public bundle main {
    public namespace app {
        public class Engine {
            public mutable int power = 0;
            public constructor Engine() {}
        }
        public class Car {
            public persistent mutable boolean built = false;
            public persistent mutable Engine* engine;
            public constructor Car() {}
        }
        public class Main {
            public static method tick() returns int {
                Car c = new Car() on heap;
                if (!c.built) {
                    c.engine = new Engine() on heap;
                    c.built = true;
                }
                c.engine.power = c.engine.power + 1;
                int r = c.engine.power;
                delete c;
                return r;
            }
            public static method main(string[] args) returns void {
                System.IO.println($"a={Main.tick()} b={Main.tick()} c={Main.tick()}");
                return;
            }
        }
    }
}
