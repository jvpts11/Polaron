import System.IO.Console;
import System.Collections.ArrayList;
import reflect;
program ReflectMethodsList;

// Reflection collections (spec 31): Type.methods() returns ArrayList<Method> and Type.fields()
// returns ArrayList<Field>; each token exposes name() (a Method also supports invoke()).

public bundle main {
    public namespace app {
        public class Dog {
            private int age;
            public constructor Dog() { this.age = 0; }
            public method bark() returns void { return; }
            public method sit() returns void { return; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Type t = reflect.typeOf<Dog>();
                ArrayList<Method> ms = t.methods();
                System.IO.Console.printf("methods size=%d\n", ms.size());
                for (mutable int i = 0; i < ms.size(); i++) {
                    Method m = ms.get(i);
                    System.IO.Console.println(m.name());
                }
                ArrayList<Field> fs = t.fields();
                System.IO.Console.printf("fields size=%d\n", fs.size());
                for (mutable int i = 0; i < fs.size(); i++) {
                    Field f = fs.get(i);
                    System.IO.Console.println(f.name());
                }
                return;
            }
        }
    }
}
