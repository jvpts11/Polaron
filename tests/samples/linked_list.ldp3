program LinkedList;

public bundle main {
    import System.IO.Console;
    public namespace app {

        // A pointer field (Node* next) -- enables linked structures. Assigning to a
        // pointer field stores the pointer; chained access (a.next.val) reads through it.
        public class Node {
            public mutable int val;
            public mutable Node* next;
            public constructor Node(int v) { this.val = v; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Node a = new Node(1) on stack;
                Node b = new Node(2) on stack;
                Node c = new Node(3) on stack;
                a.next = &b;   // pointer-field assignment
                b.next = &c;

                // Chained member access through the pointer fields.
                int total = a.val + a.next.val + a.next.next.val;
                System.IO.Console.println($"total = {total}");   // 1 + 2 + 3 = 6
                return;
            }
        }
    }
}
