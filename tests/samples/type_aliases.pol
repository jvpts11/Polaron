import System.IO.Console;
import System.Collections.ArrayList;
program TypeAliases;

// Type aliases and newtype (spec 24). `typealias` is transparent -- the alias and its target are
// fully interchangeable. `newtype` is a distinct nominal type over the same representation: it does
// not implicitly convert to or from the underlying type, so crossing the boundary needs a cast.

public bundle main {
    public namespace app {

        public typealias Celsius = int;               // transparent: Celsius == int
        public typealias IntFn = function<int, int>;  // a function-type alias

        public newtype OrderId = long;                // distinct: needs a cast to/from long
        public newtype UserId = long;                 // distinct from OrderId as well
        public newtype Batch = uint;                // unsigned, to prove the printer reads through

        // A RECORD MAY HAVE A NEWTYPE FIELD, and a collection may hold one. Both used to be refused
        // and neither error named a line the author wrote: a record's synthesized `toString` asks
        // each field for one, and a list asks its element type for `equalsKey`. `toString`, `hash`,
        // `equalsKey` and `compareTo` are questions about the REPRESENTATION, and a newtype shares
        // its underlying's -- the distinctness lives in assignment, and none of it is given up.
        public record Line(OrderId order, Batch batch) { }

        public class Main {
            public static method apply(IntFn f, int v) returns int { return f(v); }

            // A `fixed` MAY HAVE A NEWTYPE TYPE. It asks what the value is made of, and a newtype is
            // its underlying type in every way that question means. Refused, a program that gave its
            // ids a type of their own still had to write the id meaning "none" as a bare number --
            // the very assignment `newtype` is there to stop.
            public static fixed OrderId NO_ORDER = cast<OrderId>(cast<long>(0 - 1));
            // The two the printer used to get wrong: a 64-bit one read the wrong half of itself,
            // an unsigned one printed negative. Neither shows in a newtype over a plain int.
            public static fixed OrderId BIG = cast<OrderId>(cast<long>(5000000000));
            public static fixed Batch BATCH = cast<Batch>(cast<uint>(4000000000));

            public static method main(string[] args) returns void {
                // typealias: Celsius and int are the same type, so arithmetic just works.
                Celsius t = 20;
                int sum = t + 5;                      // 25
                IntFn inc = lambda(int x) returns int { return x + 1; };
                int r = Main.apply(inc, sum);         // 26

                // newtype: a distinct identity; cast across the boundary to use the raw value.
                OrderId o = cast<OrderId>(cast<long>(1000));
                long raw = cast<long>(o) + 7;         // 1007 (cast out, compute, cast back)
                OrderId o2 = cast<OrderId>(raw);

                System.IO.Console.printf("t=%d r=%d order=%d\n", t, r, cast<int>(cast<long>(o2)));

                // AND A NEWTYPE PRINTS AS WHAT IT IS MADE OF, with the right specifier for it --
                // no cast out to the underlying type first, which is the ceremony that made the
                // feature not worth having at the one place an id is most wanted: the line that
                // says which one it is.
                System.IO.Console.println($"big={Main.BIG} batch={Main.BATCH} none={Main.NO_ORDER}");

                // The record, and a list of ids: both are declarations that did not compile before.
                Line one = new Line(o2, Main.BATCH);
                ArrayList<OrderId>* orders = new ArrayList<OrderId>() on heap;
                orders.add(o2);
                System.IO.Console.println($"line={one.order} held={orders.indexOf(o2)}");
                delete orders;
                return;
            }
        }
    }
}
