import System.IO.Console;
import System.Collections.Fenwick2D;
import System.Text.Fletcher;
program Fenwick2dFletcher;

// A 2D Fenwick tree (range sums on a grid) and Fletcher-16 checksum (spec 34.1/4), pure LDP3. Prints:
//   total=11 mid=8 row0=3
//   fl=51440
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable Fenwick2D f = new Fenwick2D(3, 3) on heap;
                f.update(0, 0, 1); f.update(1, 1, 5); f.update(2, 2, 3); f.update(0, 2, 2);
                System.IO.Console.printf("total=%d mid=%d row0=%d\n",
                    f.rangeSum(0, 0, 2, 2), f.rangeSum(1, 1, 2, 2), f.rangeSum(0, 0, 0, 2));
                System.IO.Console.printf("fl=%d\n", Fletcher.fletcher16("abcde"));
                return;
            }
        }
    }
}
