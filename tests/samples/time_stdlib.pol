import System.IO.Console;
import System.Time.Time;
program TimeStdlib;

// Time (spec 34): monotonic clock (millis/nanos), wall clock (unixMillis), and sleep. Values aren't
// deterministic, so the test checks invariants: sleeping advances the monotonic clock, nanos is
// non-decreasing, and the wall clock is past year 2001.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                long t1 = Time.millis();
                Time.sleep(50);
                long t2 = Time.millis();
                boolean slept = (t2 - t1) >= 40;
                long n1 = Time.nanos();
                long n2 = Time.nanos();
                boolean nanoOk = n2 >= n1;
                boolean unixOk = Time.unixMillis() > 1000000000000;
                System.IO.Console.printf("slept=%d nanoOk=%d unixOk=%d\n", slept, nanoOk, unixOk);
                return;
            }
        }
    }
}
