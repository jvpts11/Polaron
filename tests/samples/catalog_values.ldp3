program Catalogs;

// Catalogs (spec 12.3/12.4), value contract: a `catalog` is an interface for
// enums declaring the values an implementing enum must provide. The enum
// `extends` the catalog and supplies those values in a `byCatalog` block, which
// also documents their provenance. Own constants come first (ordinals 0..2),
// catalog-provided ones continue (3..5). The enum is a subtype of the catalog.

public bundle main {
    import System.IO.Console;
    public namespace app {

        public catalog TipoMotor {
            combustao,
            h2,
            eletrico
        }

        public enum Motor extends TipoMotor {
            v8,
            v12,
            doisPistoes

            byCatalog {
                combustao,
                h2,
                eletrico
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                // Own constants: 0, 1, 2.
                System.IO.Console.printf("%d %d %d\n", Motor.v8, Motor.v12, Motor.doisPistoes);
                // Catalog-provided constants continue the ordinals: 3, 4, 5.
                System.IO.Console.printf("%d %d %d\n", Motor.combustao, Motor.h2, Motor.eletrico);
                // The enum is a subtype of the catalog: a Motor value fits a TipoMotor slot.
                TipoMotor t = Motor.eletrico;
                System.IO.Console.printf("%d\n", t);
                // Built-in count() sees all six values.
                System.IO.Console.printf("%d\n", Motor.count());
                return;
            }
        }
    }
}
