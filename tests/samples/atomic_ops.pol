import System.IO.Console;
import System.Concurrency.atomic;
program AtomicOps;

// atomic<T> operators (spec 20.6): ++, --, += and -= on an atomic cell lower to lock-free
// atomicrmw add/sub; a plain `counter = v` lowers to an atomic store. (The method form --
// get/set/add/increment/compareAndSet -- is in atomic_counter.pol.)

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                atomic<int> c = new atomic<int>(5) on heap;
                c++;          // 6
                c += 4;       // 10
                c--;          // 9
                c -= 2;       // 7
                int v = c.get();
                c = 100;      // atomic store
                System.IO.Console.printf("v=%d set=%d\n", v, c.get());
                return;
            }
        }
    }
}
