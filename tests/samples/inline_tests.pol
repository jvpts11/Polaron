import System.IO.Console;
import System.Test.Test;
program InlineTests;

// Inline tests (spec 32.11): tests live next to the code they test, as `@Test` methods that call the
// stdlib `Test` assertions. There are no `tests`/`assert` keywords -- it is all annotations, static
// methods and classes. `polc --test` (and `polaron test`) discovers them, runs each one, and reports.
//
// A `@Test` method may return `boolean` (it is its own verdict) or `void`, in which case the verdict
// comes from its assertions: the runner resets the failure counter around each test and reads it back.

public bundle main {
    public namespace app {

        public class MathUtils {
            public static method add(int a, int b) returns int {
                return a + b;
            }

            public static method half(int a) returns double {
                return cast<double>(a) / 2.0;
            }

            @Test
            public static method add_basic() returns void {
                Test.assertEqual(MathUtils.add(2, 2), 4);
                Test.assertEqual(MathUtils.add(0, 0), 0);
                Test.assertEqual(MathUtils.add(-1, 1), 0);
            }

            @Test
            public static method predicates_and_tolerance() returns void {
                Test.assertTrue(MathUtils.add(1, 1) == 2);
                Test.assertFalse(MathUtils.add(1, 1) == 3);
                Test.assertWithin(MathUtils.half(1), 0.5, 0.0001);
                Test.assertEqualString("ab" + "c", "abc");
                Test.assertEqualLong(cast<long>(2) * cast<long>(3), cast<long>(6));
            }

            // The old boolean form still works: the test IS its verdict.
            @Test
            public static method still_boolean() returns boolean {
                return MathUtils.add(20, 22) == 42;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("2+2=%d\n", MathUtils.add(2, 2));
                return;
            }
        }
    }
}
