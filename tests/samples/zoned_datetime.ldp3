import System.IO.Console;
import System.Time.Instant;
import System.Time.ZoneOffset;
import System.Time.ZonedDateTime;
program ZonedDateTimeDemo;

// ZonedDateTime (spec 34): an Instant read at a fixed UTC offset. Epoch 0 is 1970-01-01T00:00:00 at UTC,
// and 1969-12-31T21:00:00 at -03:00. Prints:
//   a=1970-1-1 0
//   b=1969-12-31 21
//   1969-12-31T21:00:00-03:00
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                ZonedDateTime a = ZonedDateTime.ofInstant(
                    Instant.ofEpochMillis(cast<long>(0)), ZoneOffset.utc());
                ZonedDateTime b = ZonedDateTime.ofInstant(
                    Instant.ofEpochMillis(cast<long>(0)), ZoneOffset.ofHours(0 - 3));
                System.IO.Console.printf("a=%d-%d-%d %d\n", a.year(), a.month(), a.day(), a.hour());
                System.IO.Console.printf("b=%d-%d-%d %d\n", b.year(), b.month(), b.day(), b.hour());
                System.IO.Console.println(b.toString());
                return;
            }
        }
    }
}
