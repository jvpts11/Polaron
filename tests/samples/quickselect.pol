import System.IO.Console;
import System.Algorithms.QuickSelect;
program QuickSelectDemo;

// Quickselect k-th smallest (spec 34.1) in pure Polaron. Prints:
//   min=1 k3=3 max=9
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int[] a = new int[8]();
                a[0]=3; a[1]=1; a[2]=4; a[3]=1; a[4]=5; a[5]=9; a[6]=2; a[7]=6;
                int mn = QuickSelect.select(a, 8, 0);
                mutable int[] b = new int[8]();
                b[0]=3; b[1]=1; b[2]=4; b[3]=1; b[4]=5; b[5]=9; b[6]=2; b[7]=6;
                int med = QuickSelect.select(b, 8, 3);
                mutable int[] c = new int[8]();
                c[0]=3; c[1]=1; c[2]=4; c[3]=1; c[4]=5; c[5]=9; c[6]=2; c[7]=6;
                int mx = QuickSelect.select(c, 8, 7);
                System.IO.Console.printf("min=%d k3=%d max=%d\n", mn, med, mx);
                return;
            }
        }
    }
}
