program ShapeLib;

// A library with a small polymorphic hierarchy. Compiled with `ldp3c --lib`, its .ldb records the
// vtable slot layout so a consumer's virtual call on an imported Square (through a Shape pointer)
// hits the same slot the bundle's baked-in vtable uses.
public bundle shapes {
    public namespace geo {

        public class Shape {
            public method area() returns int {
                return 0;
            }
        }

        public class Square extends Shape {
            private int side;

            public constructor Square(int side) {
                this.side = side;
            }

            public override method area() returns int {
                return this.side * this.side;
            }
        }
    }
}
