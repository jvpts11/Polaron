import System.IO.Console;
import System.Collections.ArrayList;
import System.Collections.HashMap;
import System.Collections.TreeSet;
program CollectionsIterStdlib;

// Collection iteration (spec 34.1): every collection exposes toArray() (sets/lists) so it can be
// walked with `for (var x in coll.toArray())`; maps expose keyArray()/valueArray(). Tree variants
// return elements in sorted (in-order) order.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                ArrayList<int> a = new ArrayList<int>() on heap;
                a.add(1); a.add(2); a.add(3);
                mutable int sum = 0;
                for (var x in a.toArray()) { sum = sum + x; }

                TreeSet<int> ts = new TreeSet<int>() on heap;
                ts.add(5); ts.add(1); ts.add(3); ts.add(1);   // de-duplicates; toArray() is sorted
                int[] sorted = ts.toArray();

                HashMap<int, int> m = new HashMap<int, int>() on heap;
                m.put(10, 100); m.put(20, 200);
                mutable int ksum = 0;
                mutable int vsum = 0;
                for (var k in m.keyArray()) { ksum = ksum + k; }
                for (var v in m.valueArray()) { vsum = vsum + v; }

                System.IO.Console.printf("sum=%d tslen=%d s0=%d s1=%d s2=%d ksum=%d vsum=%d\n",
                    sum, sorted.length(), sorted[0], sorted[1], sorted[2], ksum, vsum);
                return;
            }
        }
    }
}
