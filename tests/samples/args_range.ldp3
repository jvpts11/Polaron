import System.IO.Console;
import System.IO.Args;
import System.Collections.Range;
import System.Collections.ArrayList;
program ArgsRange;

// Args parses command-line options (has/value), Range builds integer lists (upTo/between/stepBy) (spec 34).
// Prints: hasN=1 n=42 up=5 r0=0 r3=9 rn=4.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable String[] a = new String[3]();
                a[0] = "--n";
                a[1] = "42";
                a[2] = "x";
                mutable Args p = new Args(a) on heap;
                ArrayList<int> r = Range.stepBy(0, 10, 3);
                System.IO.Console.printf("hasN=%d n=%s up=%d r0=%d r3=%d rn=%d\n",
                    p.has("--n"), p.value("--n"), Range.upTo(5).size(), r.get(0), r.get(3), r.size());
                return;
            }
        }
    }
}
