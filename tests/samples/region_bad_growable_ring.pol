import System.Memory.Units.kilobytes;
program RegionBadGrowableRing;

public bundle main {
    public namespace app {

        public class Log {
            public mutable int id;
            public constructor Log(int i) {
                this.id = i;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                growable ring region h = itself.allocate(1 kilobytes).accepts({Log});  // Polaron-1712
                release region h;
                return;
            }
        }
    }
}
