program LambdaChar;

// Lambda returning char, with control flow (if) in the body -- confirms a lambda runs full
// statements, not just a single return expression. Prints g=A h=B.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                function<char, int> grade = lambda(int n) returns char {
                    if (n >= 90) { return 'A'; }
                    return 'B';
                };
                System.IO.printf("g=%c h=%c\n", grade(95), grade(70));
                return;
            }
        }
    }
}
