import System.IO.Console;
program BitWidths;

// Wide integers: long / long hold values beyond 32 bits; a smaller int widens
// to a wider one. Expected output: big=10000000000 sum=10000000005 wide=200

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                long big = 10000000000;   // 10^10 -- needs 64 bits
                long sum = big + 5;
                int n = 200;
                long wide = n;             // int widened to a 64-bit long
                System.IO.Console.println($"big={big} sum={sum} wide={wide}");
                return;
            }
        }
    }
}
