import System.IO.Console;
import System.Collections.SlotMap;
import System.Collections.IntHeap;
import System.Collections.UnionFind;
program ArenaHeapUf;

// A generational arena, a min-heap, and union-find (spec 17 / 34.1): a stale handle is rejected after its
// slot is reused, the heap pops the smallest first, and union-find counts disjoint sets.
// Prints: sm1=10 stale2=0 sm3=99 pop=1 c02=1 grp=3.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable SlotMap<int> sm = new SlotMap<int>() on heap;
                int h1 = sm.insert(10);
                int h2 = sm.insert(20);
                sm.remove(h2);
                int h3 = sm.insert(99);
                mutable IntHeap hp = new IntHeap() on heap;
                hp.push(5);
                hp.push(3);
                hp.push(8);
                hp.push(1);
                mutable UnionFind uf = new UnionFind(6) on heap;
                uf.merge(0, 1);
                uf.merge(1, 2);
                uf.merge(3, 4);
                System.IO.Console.printf("sm1=%d stale2=%d sm3=%d pop=%d c02=%d grp=%d\n",
                    sm.get(h1), sm.containsHandle(h2), sm.get(h3), hp.pop(), uf.connected(0, 2), uf.groups());
                return;
            }
        }
    }
}
