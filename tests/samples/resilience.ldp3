import System.IO.Console;
import System.App.CircuitBreaker;
import System.App.TokenBucket;
program Resilience;

// Resilience patterns (spec 34) in pure LDP3, with explicit time. Prints:
//   open=1 blocked=0 half=1 halfstate=2 closed=0
//   acquired=5 empty=0 refilled=1
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable CircuitBreaker cb = new CircuitBreaker(2, 100) on heap;
                cb.recordFailure(0); cb.recordFailure(0);   // trips open
                boolean blocked = cb.allow(50);             // still open -> false
                boolean half = cb.allow(100);               // cooldown passed -> half-open true
                int s2 = cb.getState();
                cb.recordSuccess();
                System.IO.Console.printf("open=%d blocked=%d half=%d halfstate=%d closed=%d\n",
                    1, blocked, half, s2, cb.getState());

                mutable TokenBucket tb = new TokenBucket(5.0, 0.001) on heap;
                mutable int ok = 0;
                for (mutable int i = 0; i < 5; i++) { if (tb.tryAcquire(0, 1)) { ok = ok + 1; } }
                boolean empty = tb.tryAcquire(0, 1);        // 6th -> false
                boolean refilled = tb.tryAcquire(1000, 1);  // +1 token -> true
                System.IO.Console.printf("acquired=%d empty=%d refilled=%d\n", ok, empty, refilled);
                return;
            }
        }
    }
}
