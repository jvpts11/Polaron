import System.IO.Console;
import System.Collections.Knapsack;
import System.Collections.Lcs;
import System.Collections.IntervalScheduler;
program Algorithms;

// Classic algorithms (spec 34.1) in pure LDP3: 0/1 knapsack, LCS, interval scheduling. Prints:
//   knap=9 lcs=4 sched=4
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int[] wt = new int[4]();
                wt[0]=1; wt[1]=3; wt[2]=4; wt[3]=5;
                mutable int[] val = new int[4]();
                val[0]=1; val[1]=4; val[2]=5; val[3]=7;
                int knap = Knapsack.maxValue(wt, val, 4, 7);
                int lcs = Lcs.length("ABCBDAB", "BDCAB");

                mutable int[] st = new int[7]();
                mutable int[] en = new int[7]();
                st[0]=1; en[0]=3; st[1]=2; en[1]=4; st[2]=3; en[2]=5; st[3]=0; en[3]=6;
                st[4]=5; en[4]=7; st[5]=8; en[5]=9; st[6]=5; en[6]=9;
                int sched = IntervalScheduler.maxNonOverlapping(st, en, 7);

                System.IO.Console.printf("knap=%d lcs=%d sched=%d\n", knap, lcs, sched);
                return;
            }
        }
    }
}
