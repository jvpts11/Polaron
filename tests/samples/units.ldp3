import System.IO.Console;
import System.Memory.Units.ByteSize;
import System.Memory.Units.kilobytes;
import System.Memory.Units.megabytes;
program Units;

public bundle main {


    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                // The unit suffixes and ByteSize come from the embedded prelude.
                ByteSize a = 64 kilobytes;
                ByteSize b = 2 megabytes;
                System.IO.Console.println($"a = {a.bytes} b = {b.bytes}");   // 65536 / 2097152
                return;
            }
        }
    }
}
