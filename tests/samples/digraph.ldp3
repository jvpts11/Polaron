import System.IO.Console;
import System.Collections.DiGraph;
program DiGraphDemo;

// Directed graph (spec 34.1) in pure LDP3: topological sort and cycle detection. Prints:
//   order=0,1,2,3 cnt=4 cycle=0
//   cycleNow=1
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable DiGraph g = new DiGraph(4) on heap;
                g.addEdge(0,1); g.addEdge(0,2); g.addEdge(1,3); g.addEdge(2,3);
                mutable int[] order = new int[4]();
                int cnt = g.topoSort(order);
                System.IO.Console.printf("order=%d,%d,%d,%d cnt=%d cycle=%d\n",
                    order[0], order[1], order[2], order[3], cnt, g.hasCycle());
                g.addEdge(3, 0);   // introduce a cycle
                System.IO.Console.printf("cycleNow=%d\n", g.hasCycle());
                return;
            }
        }
    }
}
