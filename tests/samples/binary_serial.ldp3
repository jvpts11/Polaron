import System.IO.Console;
import System.Text.VarInt;
import System.Text.BitWriter;
import System.Text.BitReader;
import System.Collections.ArrayList;
program BinarySerial;

// Binary serialization (spec 4) in pure LDP3: LEB128 varints and MSB-first bit packing. Prints:
//   vlen=2 b0=172 b1=2 val=300 big=123456789
//   bits=8 a=5 b=1 c=10
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                ArrayList<int> enc = VarInt.encode(300);
                System.IO.Console.printf("vlen=%d b0=%d b1=%d val=%d big=%d\n",
                    enc.size(), enc.get(0), enc.get(1),
                    cast<int>(VarInt.decode(enc)),
                    cast<int>(VarInt.decode(VarInt.encode(123456789))));

                mutable BitWriter w = new BitWriter() on heap;
                w.writeBits(5, 3);       // 101
                w.writeBit(1);           // 1
                w.writeBits(10, 4);      // 1010
                int[] bytes = w.toBytes();
                mutable BitReader r = new BitReader(bytes) on heap;
                int a = r.readBits(3);
                int b = r.readBit();
                int c = r.readBits(4);
                System.IO.Console.printf("bits=%d a=%d b=%d c=%d\n", w.bitCount(), a, b, c);
                return;
            }
        }
    }
}
