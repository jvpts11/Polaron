import System.IO.Console;
import System.Collections.MinStack;
import System.Collections.SlidingWindowMax;
program MinStackWindow;

// A min-tracking stack and sliding-window maximum (spec 34.1) in pure LDP3. Prints:
//   min1=1 popped=1 min2=2 size=3
//   w=3,3,5,5,6,7
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable MinStack st = new MinStack(8) on heap;
                st.push(3); st.push(5); st.push(2); st.push(1);
                int m1 = st.getMin();
                int p = st.pop();
                int m2 = st.getMin();
                System.IO.Console.printf("min1=%d popped=%d min2=%d size=%d\n", m1, p, m2, st.size());

                mutable int[] a = new int[8]();
                a[0]=1; a[1]=3; a[2]=0-1; a[3]=0-3; a[4]=5; a[5]=3; a[6]=6; a[7]=7;
                int[] w = SlidingWindowMax.maxOfEach(a, 8, 3);
                System.IO.Console.printf("w=%d,%d,%d,%d,%d,%d\n", w[0], w[1], w[2], w[3], w[4], w[5]);
                return;
            }
        }
    }
}
