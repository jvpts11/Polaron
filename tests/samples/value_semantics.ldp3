program ValueSemantics;

// Fase A2: classes have value semantics by default. `Box b = a` makes an
// independent deep copy; `Box* p = &a` shares the same object.
// Expected output:
//   after copy: a=1 b=99
//   after share: a=42 p=42

public bundle main {
    import System.IO.Console;
    public namespace app {

        public class Box {
            public mutable int value;

            public constructor Box(int v) {
                this.value = v;
            }

            public method set(int v) returns void {
                this.value = v;
                return;
            }

            public method get() returns int {
                return this.value;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Box a = new Box(1) on stack;
                Box b = a;            // deep copy -> b is independent
                b.set(99);
                System.IO.Console.println($"after copy: a={a.get()} b={b.get()}");   // a=1 b=99

                Box* p = &a;          // share -> p and a are the same object
                p.set(42);
                System.IO.Console.println($"after share: a={a.get()} p={p.get()}");  // a=42 p=42
                return;
            }
        }
    }
}
