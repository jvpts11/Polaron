import System.IO.Console;
import System.Memory.Units.kilobytes;
program RegionDtor;

// Releasing a region runs the destructors of the objects allocated in it before freeing the arena
// (spec 17.7), in reverse order and with no use-after-free. The same teardown happens at the end of
// the region's scope via RAII when there is no explicit release.

public bundle main {
    public namespace app {
        public class Dog {
            public mutable int id;
            public constructor Dog(int id) { this.id = id; }
            public destructor ~Dog() returns void {
                System.IO.Console.printf("~Dog %d\n", this.id);
            }
        }
        public class Main {
            public static method main(string[] args) returns void {
                region pen = itself.allocate(1 kilobytes);
                Dog* a = new Dog(1) in region pen;
                Dog* b = new Dog(2) in region pen;
                System.IO.Console.println("before");
                release region pen;          // ~Dog 2 then ~Dog 1 run here, before the free
                System.IO.Console.println("after");
                return;
            }
        }
    }
}
