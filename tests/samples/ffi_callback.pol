import System.IO.Console;
program FfiCallback;

// FFI callback (spec 26): a capture-free lambda passed to a C function is lowered to a raw C
// function pointer (no environment), so the C side can call it directly. polaron_apply_cb is a C
// helper `int polaron_apply_cb(int (*f)(int), int x) { return f(x); }`.

public bundle main {
    public namespace app {
        public class Cb {
            public extern cdecl static method polaron_apply_cb(function<int, int> f, int x) returns int;
        }
        public class Main {
            public static method main(string[] args) returns void {
                int r = Cb.polaron_apply_cb(lambda(int n) returns int { return n * n; }, 7);
                System.IO.Console.printf("r=%d\n", r);   // 49
                return;
            }
        }
    }
}
