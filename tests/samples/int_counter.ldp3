import System.IO.Console;
import System.Collections.IntCounter;
program IntCounterDemo;

// A frequency counter / multiset of ints (spec 34.1) in pure LDP3. Prints:
//   c3=3 c2=2 c9=0 common=3 max=3 total=6 distinct=3
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable IntCounter c = new IntCounter() on heap;
                c.add(1); c.add(2); c.add(2); c.add(3); c.add(3); c.add(3);
                System.IO.Console.printf("c3=%d c2=%d c9=%d common=%d max=%d total=%d distinct=%d\n",
                    c.count(3), c.count(2), c.count(9), c.mostCommon(), c.maxCount(), c.total(), c.distinct());
                return;
            }
        }
    }
}
