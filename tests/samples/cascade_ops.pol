import System.IO.Console;
program CascadeOps;

// `cascade validate(X)` checks the invariant of every node in X's owned graph, and
// `cascade Console.println(X)` calls describe() on every node (spec 37.1). Both reuse the
// owned-graph walk with cycle detection, so they visit each node exactly once.

public bundle main {
    public namespace app {
        public class Node {
            public mutable int id;
            public mutable nullable Node* next;
            invariant this.id >= 0;
            public constructor Node() {
                this.id = 0;
                this.next = null;
            }
            public method describe() returns void {
                System.IO.Console.println($"Node {this.id}");
            }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Node* a = new Node() on heap; a.id = 1;
                Node* b = new Node() on heap; b.id = 2;
                a.next = b;
                cascade validate(a);          // both ids >= 0: passes silently
                cascade Console.println(a);   // Node 1, Node 2
                cascade delete a;
                System.IO.Console.println("done");
                return;
            }
        }
    }
}
