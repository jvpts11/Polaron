program GenericInherit;

public bundle main {
    public namespace app {
        public class Base<T> {
            public constructor Base() {}
            public method baseVal() returns int { return 10; }
        }
        public class Derived<T> extends Base<T> {
            public constructor Derived() {}
            public method derivedVal() returns int { return 20; }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Derived<int> d = new Derived<int>() on stack;
                int total = d.baseVal() + d.derivedVal();   // inherited + own = 10 + 20
                System.IO.println($"total = {total}");       // 30
                return;
            }
        }
    }
}
