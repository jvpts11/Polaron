import System.IO.Console;
program ArrayLiterals;

// Array literals `[a, b, c]` (spec 25). The element type is inferred from the first element.
// Nested literals build a multi-dimensional array (an array of arrays), indexed `m[i][j]`.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int[] a = [10, 20, 30];
                char[] cs = ['x', 'y', 'z'];
                var m = [[1, 2], [3, 4]];
                System.IO.Console.printf("%d %d len=%d %c %d %d\n",
                    a[0], a[2], a.length(), cs[1], m[0][1], m[1][1]);  // 10 30 len=3 y 2 4
                delete a;
                delete cs;
                return;
            }
        }
    }
}
