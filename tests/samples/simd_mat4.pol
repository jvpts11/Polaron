import System.IO.Console;

// mat4: a SIMD 4x4 matrix (<16 x float>, row-major). identity(), matrix*matrix (multiply), and
// matrix*vector (transform). A translation matrix moves the origin to its last column.
program SimdMat4;

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mat4 id = mat4.identity();
                vec4 p = vec4(1.0, 2.0, 3.0, 1.0);
                vec4 tp = id.transform(p);        // identity * p = p
                mat4 t = mat4(1.0, 0.0, 0.0, 5.0,
                              0.0, 1.0, 0.0, 6.0,
                              0.0, 0.0, 1.0, 7.0,
                              0.0, 0.0, 0.0, 1.0);
                vec4 q = t.transform(vec4(0.0, 0.0, 0.0, 1.0));   // origin -> (5,6,7)
                mat4 m2 = id.multiply(t);         // id * t = t
                System.IO.Console.printf("tp=%d%d%d q=%d%d%d m2=%d\n",
                    cast<int>(tp.x), cast<int>(tp.y), cast<int>(tp.z),
                    cast<int>(q.x), cast<int>(q.y), cast<int>(q.z), cast<int>(m2[3]));
                return;
            }
        }
    }
}
