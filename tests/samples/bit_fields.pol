import System.IO.Console;
program BitFields;

// Bit-fields (spec 11.1): `field : N` constrains the stored value to N bits, so a
// value that overflows N bits is truncated on store. Adjacent bit fields also share
// a storage unit, so the struct shrinks: `struct { int a : 4; int b : 4; }` measures
// one byte, not eight.
//
// THE OVERFLOWING VALUES ARRIVE THROUGH VARIABLES, and that is the whole distinction the
// compiler draws (2026-08-13). Truncation is for a value it cannot read -- a count, a sum,
// anything computed -- and that is what is tested here. A LITERAL that does not fit is
// refused instead: `f.a = 20` written out is not a truncation somebody wanted, it is a
// mistake the compiler can see with nothing to run, and it is an error. Writing this sample
// with literals would be testing the diagnostic rather than the semantics.

public bundle main {
    public namespace app {
        public struct Flags {
            public mutable int a : 4;    // 0..15
            public mutable int b : 4;
            public mutable int c : 12;   // 0..4095
            public constructor Flags() {
                this.a = 0;
                this.b = 0;
                this.c = 0;
            }
        }
        public class Main {
            public static method main(string[] args) returns void {
                Flags f = new Flags();
                mutable int wide = 20;
                mutable int wider = 5000;
                f.a = wide;   // 20 & 0xF  = 4
                f.b = 7;      // fits, and stays 7
                f.c = wider;  // 5000 & 0xFFF = 904
                System.IO.Console.printf("a=%d b=%d c=%d\n", f.a, f.b, f.c);
                return;
            }
        }
    }
}
