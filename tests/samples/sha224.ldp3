import System.IO.Console;
import System.Text.Sha224;
program Sha224Demo;

// SHA-224 (FIPS 180-4) in pure LDP3, verified against the "abc" and "" reference vectors. Prints:
//   abc=23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7
//   empty=d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("abc=%s\n", Sha224.digest("abc"));
                System.IO.Console.printf("empty=%s\n", Sha224.digest(""));
                return;
            }
        }
    }
}
