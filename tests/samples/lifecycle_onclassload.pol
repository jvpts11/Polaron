import System.IO.Console;
program LifecycleOnClassLoad;

// `onClassLoad` (spec 32.5): a class-level hook that runs once at program start,
// before main, for class-level setup. Here Server's hook prints before main's body
// even though Server is never instantiated.

public bundle main {
    public namespace app {
        public class Server {
            onClassLoad {
                System.IO.Console.printf("Server loaded\n");
            }
        }
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("main start\n");
                return;
            }
        }
    }
}
