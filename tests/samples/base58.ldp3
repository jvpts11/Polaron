import System.IO.Console;
import System.Text.Base58;
program Base58Demo;

// Base58 (Bitcoin alphabet, spec 4) in pure LDP3, encode/decode round-trip. Prints:
//   enc=9Ajdvzr roundtrip=1 zeros=111
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                mutable int[] data = new int[5]();
                data[0]=72; data[1]=101; data[2]=108; data[3]=108; data[4]=111;   // "Hello"
                String enc = Base58.encode(data, 5);
                int[] dec = Base58.decode(enc);
                String enc2 = Base58.encode(dec, dec.length());
                mutable int[] z = new int[3]();
                System.IO.Console.printf("enc=%s roundtrip=%d zeros=%s\n",
                    enc, enc.equals(enc2), Base58.encode(z, 3));
                return;
            }
        }
    }
}
