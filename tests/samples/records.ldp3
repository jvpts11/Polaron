import System.IO.Console;
program Records;

public bundle main {
    public namespace app {

        // Compact form: the parameters are the (immutable) fields.
        public record Point(int x, int y) {
            public method sum() returns int { return this.x + this.y; }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Point p = new Point(3, 4);
                Point q = new Point(3, 4);
                Point r = new Point(5, 6);
                System.IO.Console.println($"sum = {p.sum()}");                           // 7
                System.IO.Console.println($"p==q {p.equals(q)} p==r {p.equals(r)}");     // 1 / 0
                return;
            }
        }
    }
}
