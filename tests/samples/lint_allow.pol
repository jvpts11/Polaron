import System.IO.Console;
import System.Runtime.Allow;

program LintAllow;

// `[Allow(code:, why:)]` -- THE ESCAPE VALVE, and the two halves that make it worth having.
//
// Advice is a rule about a shape, and a shape can be right for a reason the compiler cannot see.
// Without a way to say so the first honest disagreement makes the whole set noise. What keeps the
// valve from becoming the noise instead: `why` is required, so a suppression nobody can review does
// not compile -- and an `[Allow]` that stops suppressing anything says so, because a stale one is a
// claim about the code that has quietly become untrue.
public bundle Main {
    public namespace App {

        public class Kept {
            // On the METHOD: the shape is deliberate here, and the reason is where the reader is.
            [Allow(code: "Polaron-0B0D", why: "kept mutable to match the shape of the other three arms")]
            public static method deliberate() returns int {
                mutable int slot = 3;
                return slot;
            }

            // No allow, so the same shape reports: the suppression is a decision per declaration,
            // not a switch somebody flipped for the file.
            public static method plain() returns int {
                mutable int other = 4;
                return other;
            }
        }

        // On the CLASS: one word, one level out, covering every method inside it.
        [Allow(code: "Polaron-0B0D", why: "this table is filled in by a generated pass, field by field")]
        public class Whole {
            public static method first() returns int {
                mutable int a = 1;
                return a;
            }
            public static method second() returns int {
                mutable int b = 2;
                return b;
            }
        }

        // FIRES (0B0C): nothing in here reports that code, so the note describes a shape that is not
        // present. Kept in the sample because a stale suppression is the failure mode the valve
        // itself introduces, and it has to be caught.
        public class Stale {
            [Allow(code: "Polaron-0B0E", why: "there used to be an empty catch in this method")]
            public static method noneOfThat() returns int {
                return 5;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.println($"{Kept.deliberate()} {Kept.plain()} {Whole.first()} {Whole.second()} {Stale.noneOfThat()}");
                return;
            }
        }
    }
}
