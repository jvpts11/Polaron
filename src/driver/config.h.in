#pragma once
// Generated by CMake from config.h.in. Compile-time default paths for the driver.
//
// This is what the shipped driver calls when nothing else says otherwise -- not necessarily the clang
// this build used. A distributable build configures with -DPOLARON_DEFAULT_CLANG=clang so the answer is
// resolved through the installer's PATH rather than naming a path on the build machine.
#define POLARON_DEFAULT_CLANG "@POLARON_DEFAULT_CLANG@"
