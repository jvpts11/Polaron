#pragma once
// Generated by CMake from runtime/polaron_alloc_core.hpp -- do not edit.
//
// The driver writes this text out next to the objects it builds and compiles it for the target, so a
// program with no C library underneath gets the SAME heap the hosted runtime links: the same size
// classes, the same sixteen-byte header, the same double-free stamp. Only the block underneath
// differs, and that is a backend class the shim supplies.
//
// Embedded rather than read from disk at run time because `polaron` must work from an install that
// ships binaries only, and a heap that silently went missing would fail at the link with a message
// about a symbol the programmer never wrote.
namespace polaron {
// Several adjacent raw literals, not one: MSVC caps a literal at 16380 bytes. Adjacent literals
// concatenate, so the value is the file, byte for byte. See CMakeLists.txt.
inline const char* kAllocCoreSource =
@POLARON_ALLOC_CORE_SRC@;
}  // namespace polaron
