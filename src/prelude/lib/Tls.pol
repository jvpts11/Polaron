    public namespace Net.Tls {
        // TRANSPORT LAYER SECURITY, and the reason it lives in the standard library rather than
        // beside it.
        //
        // The library already ships `HttpClient`. There are two coherent places to draw the line --
        // both the client and the transport inside (Go, Python, Java, C#), or both outside (C++,
        // Rust, whose standard libraries stop at sockets) -- and shipping the client WITHOUT the
        // transport is neither. It produced exactly what that position always produces: a request to
        // an `https://` URL answered with a synthetic response rather than a connection or a failure.
        //
        // Three things settle it here. The toolchain bootstraps on this -- if TLS were a package,
        // fetching the first package would need the package that cannot be fetched yet. The
        // primitives are already inside: AES, SHA-256, HMAC and a secure random live in
        // System.Security, so keeping the dangerous parts in and the assembly out is an arbitrary
        // line. And the usual objection -- that everybody pays for what few use -- does not apply to
        // this compiler: emission is reachability-driven, so a program that never opens a socket
        // emits none of this.
        //
        // ENCRYPTION IS NOT AUTHENTICATION, and that distinction is the whole design of what follows.
        // A handshake that agrees a key with whoever answered the socket protects against somebody
        // listening and not at all against somebody answering in the server's place -- while looking
        // identical to the caller. So the public way in validates, always; the certificate chain, the
        // dates and the hostname are checked before a single byte of application data moves, and the
        // way to skip that has a name that says what it costs.

        // ---- DER: the tag-length-value encoding every X.509 structure is written in. ------------
        //
        // Promoted out of the certificate reader because a chain, an extension and a signature
        // algorithm are all navigated the same way, and three copies of "how long is this field"
        // is how one of them ends up disagreeing with the others.
        public class Der {
            // Bytes the length field occupies beyond the first (0 for the short form).
            public static method lengthExtra(int[] d, int off) returns int {
                int first = d[off + 1] & 255;
                if (first < 128) { return 0; }
                return first & 127;
            }
            // The content length of the value at `off`.
            public static method contentLength(int[] d, int off) returns int {
                int first = d[off + 1] & 255;
                if (first < 128) { return first; }
                int n = first & 127;
                mutable int len = 0;
                mutable int i = 0;
                while (i < n) {
                    len = (len << 8) | (d[off + 2 + i] & 255);
                    i = i + 1;
                }
                return len;
            }
            // Where the content starts, past the tag and the length.
            public static method contentOffset(int[] d, int off) returns int {
                return off + 2 + Der.lengthExtra(d, off);
            }
            // Where the next value at the same level starts.
            public static method nextOffset(int[] d, int off) returns int {
                return Der.contentOffset(d, off) + Der.contentLength(d, off);
            }
            // Total bytes the value at `off` occupies, tag and length included -- which is what a
            // signature is computed over, so it has to be exact.
            public static method totalLength(int[] d, int off) returns int {
                return 2 + Der.lengthExtra(d, off) + Der.contentLength(d, off);
            }
            public static method tag(int[] d, int off) returns int {
                return d[off] & 255;
            }
            // Whether the bytes at `off` are exactly this object identifier's encoding. OIDs are how
            // DER names an algorithm or an extension, and comparing them by bytes is both the
            // simplest way and the only one that cannot mis-parse.
            public static method oidEquals(int[] d, int off, int[] oid, int oidLen) returns boolean {
                if (Der.tag(d, off) != 6) { return false; }
                if (Der.contentLength(d, off) != oidLen) { return false; }
                int c = Der.contentOffset(d, off);
                mutable int i = 0;
                while (i < oidLen) {
                    if ((d[c + i] & 255) != (oid[i] & 255)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            // The bytes of a value, copied out -- for a signature, a modulus or a key.
            public static method copy(int[] d, int from, int len) returns int[] {
                int[] out = new int[len > 0 ? len : 1]();
                mutable int i = 0;
                while (i < len) {
                    out[i] = d[from + i] & 255;
                    i = i + 1;
                }
                return out;
            }

            // PROVING THE STRUCTURE BEFORE READING IT, which is the only safe order.
            //
            // Every length above is a number the DER itself supplied, and a certificate arrives from
            // whoever answered the socket. A reader that indexes wherever the length field points can
            // be walked off the end of the buffer by the bytes it is reading -- which is what happened
            // here the first time, caught by the bounds check as `index = 686, length = 48`. That is a
            // clean stop rather than corruption, and it is still the wrong answer: a malformed
            // certificate must be REFUSED, not kill the program that received it.
            //
            // So the whole tree is walked once, checking that every tag, every length field and every
            // content run lies inside the buffer, before a single accessor reads anything. After this
            // returns true the offsets are known good and the rest can index freely.
            //
            // The depth bound is part of it: nesting is what an attacker controls for free, and a
            // recursive descent with no floor turns a hundred bytes into a stack overflow.
            public static method wellFormed(int[] d, int len, int off, int end, int depth)
                                            returns boolean {
                if (depth <= 0) { return false; }
                mutable int at = off;
                while (at < end) {
                    if (at + 2 > len || at + 2 > end) { return false; }   // room for a tag and a length
                    int first = d[at + 1] & 255;
                    mutable int extra = 0;
                    if (first >= 128) {
                        extra = first & 127;
                        if (extra == 0 || extra > 4) { return false; }    // indefinite, or absurdly wide
                        if (at + 2 + extra > len) { return false; }
                    }
                    mutable int contentLen = first;
                    if (extra > 0) {
                        contentLen = 0;
                        mutable int i = 0;
                        while (i < extra) {
                            contentLen = (contentLen << 8) | (d[at + 2 + i] & 255);
                            i = i + 1;
                        }
                        if (contentLen < 0) { return false; }             // a length that overflowed
                    }
                    int content = at + 2 + extra;
                    if (content > len || contentLen > len - content) { return false; }
                    int after = content + contentLen;
                    if (after > end) { return false; }
                    // A constructed value (bit 0x20) holds more values; a primitive one holds bytes.
                    if (((d[at] & 255) & 32) != 0) {
                        if (!Der.wellFormed(d, len, content, after, depth - 1)) { return false; }
                    }
                    at = after;
                }
                return at == end;
            }
        }

        // The object identifiers this library recognises, as byte arrays because that is how they
        // appear on the wire. Built once and handed out, rather than re-created at every comparison.
        public class Oid {
            // AN OID BACK IN THE FORM IT IS PUBLISHED IN: "1.2.840.113549.1.1.5". Needed because
            // "an algorithm this program cannot check" is a sentence with the useful half missing --
            // the reader cannot tell an obsolete SHA-1 authority, which should be refused, from
            // something modern that is simply absent here, which is a gap to close. The number is
            // searchable; the sentence is not.
            //
            // The first byte packs the first two arcs as 40*a + b, and every arc after it is
            // base-128 with the top bit set on all but the last byte.
            public static method dotted(int[] der, int off, int length) returns String {
                if (length <= 0) { return ""; }
                int first = der[off] & 255;
                StringBuilder out = new StringBuilder() on stack;
                out.appendInt(first / 40);
                out.appendChar('.');
                out.appendInt(first % 40);
                mutable int value = 0;
                mutable int i = 1;
                while (i < length) {
                    int b = der[off + i] & 255;
                    value = (value << 7) | (b & 127);
                    if ((b & 128) == 0) {
                        out.appendChar('.');
                        out.appendInt(value);
                        value = 0;
                    }
                    i = i + 1;
                }
                String text = out.toString();
                return text;
            }

            // 1.2.840.113549.1.1.11 -- sha256WithRSAEncryption
            public static method sha256Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 11;
                return o;
            }
            // 1.2.840.113549.1.1.12 -- sha384WithRSAEncryption. Counted on a real trust store, twelve
            // of sixty-eight roots use this and only one uses SHA-512: leaving it out costs more
            // coverage than any other single omission.
            public static method sha384Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 12;
                return o;
            }
            // 1.2.840.113549.1.1.13 -- sha512WithRSAEncryption
            public static method sha512Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 13;
                return o;
            }
            // 1.2.840.10045.4.3.3 -- ecdsa-with-SHA384
            public static method ecdsaSha384() returns int[] {
                int[] o = new int[8]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 4; o[6] = 3; o[7] = 3;
                return o;
            }
            // 1.2.840.113549.1.1.10 -- RSASSA-PSS
            public static method rsaPss() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 10;
                return o;
            }
            // 1.2.840.10045.4.3.2 -- ecdsa-with-SHA256
            public static method ecdsaSha256() returns int[] {
                int[] o = new int[8]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 4; o[6] = 3; o[7] = 2;
                return o;
            }
            // 1.2.840.113549.1.1.1 -- rsaEncryption (a public key, not a signature)
            public static method rsaKey() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 1;
                return o;
            }
            // 1.2.840.10045.2.1 -- id-ecPublicKey
            public static method ecKey() returns int[] {
                int[] o = new int[7]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 2; o[6] = 1;
                return o;
            }
            // 2.5.29.17 -- subjectAltName
            public static method subjectAltName() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 29; o[2] = 17;
                return o;
            }
            // 2.5.29.19 -- basicConstraints
            public static method basicConstraints() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 29; o[2] = 19;
                return o;
            }
            // 2.5.4.3 -- commonName
            public static method commonName() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 4; o[2] = 3;
                return o;
            }
        }

        // An RSA public key: the big-endian modulus and the public exponent, which is small enough
        // for an int.
        public class RsaPublicKey {
            public int[] modulus;
            public int modLength;
            public int exponent;
            public constructor RsaPublicKey(int[] modulus, int modLength, int exponent) {
                this.modulus = modulus;
                this.modLength = modLength;
                this.exponent = exponent;
            }
            public destructor ~RsaPublicKey() returns void {
                delete this.modulus;
            }
        }

        // WHAT THE SERVER SAID IT IS -- a parsed X.509 certificate.
        //
        // The reader this replaces pulled out the public key and nothing else, which is enough to
        // check a signature and not enough to know WHOSE signature it is. Everything a client has to
        // ask before trusting a key is here: who issued it, who it is for, when it is valid, whether
        // it may sign other certificates, which names it covers, and the exact bytes its issuer
        // signed.
        //
        // Parsed once in the constructor. The DER stays -- a signature is computed over the bytes as
        // they arrived, so re-encoding what was parsed would be both slower and wrong.
        public class Certificate {
            private mutable int[] der;
            private mutable int derLength;
            private mutable boolean wellFormed;
            // Offsets into `der`, all discovered once.
            private mutable int tbsOffset;        // the signed body, tag included
            private mutable int tbsTotal;
            private mutable int issuerOffset;
            private mutable int subjectOffset;
            private mutable int validityOffset;
            private mutable int spkiOffset;
            private mutable int extensionsOffset;   // -1 when absent
            private mutable int sigAlgOffset;
            private mutable int sigValueOffset;

            public constructor Certificate(int[] der, int length) {
                this.der = der;
                this.derLength = length;
                this.wellFormed = false;
                this.tbsOffset = 0;
                this.tbsTotal = 0;
                this.issuerOffset = 0;
                this.subjectOffset = 0;
                this.validityOffset = 0;
                this.spkiOffset = 0;
                this.extensionsOffset = 0 - 1;
                this.sigAlgOffset = 0;
                this.sigValueOffset = 0;
                this.parse();
            }

            // Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
            private method parse() returns void {
                if (this.derLength < 8 || Der.tag(this.der, 0) != 48) { return; }
                // THE WHOLE TREE IS PROVEN TO FIT BEFORE ANYTHING IS READ. Everything below indexes
                // by offsets the DER supplied, and the DER came from whoever answered the socket --
                // so it is checked once, here, and refused as a whole rather than trusted a field at
                // a time. 32 is far more nesting than a certificate has and far less than a stack
                // can take.
                int outer = Der.totalLength(this.der, 0);
                if (outer <= 0 || outer > this.derLength) { return; }   // it must fit what arrived
                if (!Der.wellFormed(this.der, this.derLength, 0, outer, 32)) { return; }
                this.tbsOffset = Der.contentOffset(this.der, 0);
                if (Der.tag(this.der, this.tbsOffset) != 48) { return; }
                this.tbsTotal = Der.totalLength(this.der, this.tbsOffset);
                this.sigAlgOffset = Der.nextOffset(this.der, this.tbsOffset);
                this.sigValueOffset = Der.nextOffset(this.der, this.sigAlgOffset);

                mutable int off = Der.contentOffset(this.der, this.tbsOffset);
                // [0] EXPLICIT version, optional -- present on every certificate anybody issues now,
                // absent on a v1 one, so it is tested rather than assumed.
                if (Der.tag(this.der, off) == 160) { off = Der.nextOffset(this.der, off); }
                off = Der.nextOffset(this.der, off);      // serialNumber
                off = Der.nextOffset(this.der, off);      // signature (repeated inside the body)
                this.issuerOffset = off;
                off = Der.nextOffset(this.der, off);
                this.validityOffset = off;
                off = Der.nextOffset(this.der, off);
                this.subjectOffset = off;
                off = Der.nextOffset(this.der, off);
                this.spkiOffset = off;
                off = Der.nextOffset(this.der, off);

                // The optional trailing fields, of which only [3] extensions matters here.
                int tbsEnd = this.tbsOffset + this.tbsTotal;
                while (off + 1 < tbsEnd) {
                    int t = Der.tag(this.der, off);
                    if (t == 163) {
                        this.extensionsOffset = Der.contentOffset(this.der, off);
                        off = tbsEnd;
                    } else if (t == 161 || t == 162) {
                        off = Der.nextOffset(this.der, off);
                    } else {
                        off = tbsEnd;
                    }
                }
                this.wellFormed = true;
                return;
            }

            // False when the bytes are not a certificate this reader understands. Every accessor
            // below answers emptily in that case, and the validator refuses -- a certificate that
            // could not be read is not a certificate that checks out.
            public method isWellFormed() returns boolean { return this.wellFormed; }

            // The exact bytes the issuer signed: tbsCertificate, tag and length included.
            public method signedBody() returns int[] {
                return Der.copy(this.der, this.tbsOffset, this.tbsTotal);
            }
            public method signedBodyLength() returns int { return this.tbsTotal; }

            // The signature over that body, with the BIT STRING's unused-bits byte dropped.
            public method signature() returns int[] {
                int c = Der.contentOffset(this.der, this.sigValueOffset);
                int n = Der.contentLength(this.der, this.sigValueOffset);
                return Der.copy(this.der, c + 1, n - 1);
            }
            public method signatureLength() returns int {
                return Der.contentLength(this.der, this.sigValueOffset) - 1;
            }

            // Which algorithm signed it:
            //   1 = RSA PKCS#1 v1.5 with SHA-256      4 = the same with SHA-384
            //   2 = RSA-PSS with SHA-256              5 = the same with SHA-512
            //   3 = ECDSA with SHA-256                6 = ECDSA with SHA-384
            //   0 = something this library does not verify
            //
            // SHA-1, MD5 and MD2 are deliberately absent and answer 0. They are broken -- a collision
            // in the digest is a forged certificate -- so a modern client must refuse them, and
            // "cannot check" is exactly the right answer to give about a signature nobody should
            // accept. Twenty-nine of this machine's sixty-eight roots use one of the three; refusing
            // them is not a coverage gap.
            public method signatureAlgorithm() returns int {
                int algOid = Der.contentOffset(this.der, this.sigAlgOffset);
                int[] rsa256 = Oid.sha256Rsa();
                int[] rsa384 = Oid.sha384Rsa();
                int[] rsa512 = Oid.sha512Rsa();
                int[] pss = Oid.rsaPss();
                int[] ec256 = Oid.ecdsaSha256();
                int[] ec384 = Oid.ecdsaSha384();
                mutable int which = 0;
                if (Der.oidEquals(this.der, algOid, rsa256, 9)) { which = 1; }
                else if (Der.oidEquals(this.der, algOid, pss, 9)) { which = 2; }
                else if (Der.oidEquals(this.der, algOid, ec256, 8)) { which = 3; }
                else if (Der.oidEquals(this.der, algOid, rsa384, 9)) { which = 4; }
                else if (Der.oidEquals(this.der, algOid, rsa512, 9)) { which = 5; }
                else if (Der.oidEquals(this.der, algOid, ec384, 8)) { which = 6; }
                delete ec384;
                delete ec256;
                delete pss;
                delete rsa512;
                delete rsa384;
                delete rsa256;
                return which;
            }

            // What the certificate SAYS it was signed with, named where the name is known and given
            // as its OID where it is not. The known ones here are the obsolete digests, on purpose:
            // they are the answer to "why was this refused", and a client that refuses them without
            // saying SHA-1 leaves the reader unable to tell a deliberate refusal from a missing
            // feature.
            public method signatureAlgorithmName() returns String {
                // The AlgorithmIdentifier is a SEQUENCE whose first element is the OID, so this
                // reaches in twice: once past the sequence, once past the OID's own tag and length.
                // Reaching in once decoded the tag and the trailing NULL parameters as arcs, and
                // produced "0.6.9.42.840..." -- a number that looks like an answer and is not one.
                int algOid = Der.contentOffset(this.der, this.sigAlgOffset);
                String dotted = Oid.dotted(this.der, Der.contentOffset(this.der, algOid),
                                           Der.contentLength(this.der, algOid));
                if (dotted.equals("1.2.840.113549.1.1.5")) { return "RSA with SHA-1"; }
                if (dotted.equals("1.2.840.113549.1.1.4")) { return "RSA with MD5"; }
                if (dotted.equals("1.2.840.113549.1.1.2")) { return "RSA with MD2"; }
                if (dotted.equals("1.2.840.10045.4.1")) { return "ECDSA with SHA-1"; }
                if (dotted.equals("1.2.840.10045.4.3.4")) { return "ECDSA with SHA-512"; }
                if (dotted.equals("1.3.101.112")) { return "Ed25519"; }
                if (dotted.equals("1.3.101.113")) { return "Ed448"; }
                if (dotted.equals("1.2.840.113549.1.1.11")) { return "RSA with SHA-256"; }
                if (dotted.equals("1.2.840.113549.1.1.12")) { return "RSA with SHA-384"; }
                if (dotted.equals("1.2.840.113549.1.1.13")) { return "RSA with SHA-512"; }
                if (dotted.equals("1.2.840.113549.1.1.10")) { return "RSA-PSS"; }
                if (dotted.equals("1.2.840.10045.4.3.2")) { return "ECDSA with SHA-256"; }
                if (dotted.equals("1.2.840.10045.4.3.3")) { return "ECDSA with SHA-384"; }
                return "OID ".concat(dotted);
            }

            // The RSA public key, or null when the certificate carries an elliptic-curve one --
            // which the caller has to handle rather than be handed a zero key that verifies nothing.
            public method rsaPublicKey() returns nullable RsaPublicKey* {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                int[] want = Oid.rsaKey();
                boolean isRsa = Der.oidEquals(this.der, algOid, want, 9);
                delete want;
                if (!isRsa) { return null; }

                int bitString = Der.nextOffset(this.der, algSeq);
                int rsaSeq = Der.contentOffset(this.der, bitString) + 1;   // past the unused-bits byte
                int modInt = Der.contentOffset(this.der, rsaSeq);
                mutable int mOff = Der.contentOffset(this.der, modInt);
                mutable int mLen = Der.contentLength(this.der, modInt);
                if ((this.der[mOff] & 255) == 0) {         // the sign-preserving leading zero
                    mOff = mOff + 1;
                    mLen = mLen - 1;
                }
                int[] modulus = Der.copy(this.der, mOff, mLen);
                int expInt = Der.nextOffset(this.der, modInt);
                int eOff = Der.contentOffset(this.der, expInt);
                int eLen = Der.contentLength(this.der, expInt);
                mutable int e = 0;
                mutable int j = 0;
                while (j < eLen) {
                    e = (e << 8) | (this.der[eOff + j] & 255);
                    j = j + 1;
                }
                return new RsaPublicKey(modulus, mLen, e) on heap;
            }

            // WHICH CURVE the key is on: "P-256", "P-384", "P-521", or "" when the certificate does
            // not carry an elliptic-curve key at all.
            //
            // This exists so that "I cannot check this" and "this does not check out" stay different
            // answers. A P-384 root refused by a P-256 verifier is the verifier behaving correctly,
            // and reporting it as a bad signature sends somebody hunting a bug that is not there.
            // The curve is named by an OID inside the key's algorithm parameters.
            public method ecCurveName() returns String {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                int[] want = Oid.ecKey();
                boolean isEc = Der.oidEquals(this.der, algOid, want, 7);
                delete want;
                if (!isEc) { return ""; }
                int curveOid = Der.nextOffset(this.der, algOid);
                if (Der.tag(this.der, curveOid) != 6) { return ""; }
                int c = Der.contentOffset(this.der, curveOid);
                int n = Der.contentLength(this.der, curveOid);
                // 1.2.840.10045.3.1.7 -- prime256v1
                if (n == 8 && (this.der[c] & 255) == 42 && (this.der[c + 6] & 255) == 1 &&
                    (this.der[c + 7] & 255) == 7) {
                    return "P-256";
                }
                // 1.3.132.0.34 -- secp384r1
                if (n == 5 && (this.der[c] & 255) == 43 && (this.der[c + 4] & 255) == 34) {
                    return "P-384";
                }
                // 1.3.132.0.35 -- secp521r1
                if (n == 5 && (this.der[c] & 255) == 43 && (this.der[c + 4] & 255) == 35) {
                    return "P-521";
                }
                return "unknown curve";
            }

            // The uncompressed elliptic-curve point, or an empty array for an RSA certificate.
            // 65 bytes for P-256: 0x04 then x then y.
            public method ecPublicKey() returns int[] {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                int[] want = Oid.ecKey();
                boolean isEc = Der.oidEquals(this.der, algOid, want, 7);
                delete want;
                if (!isEc) { return new int[1](); }
                int bitString = Der.nextOffset(this.der, algSeq);
                int c = Der.contentOffset(this.der, bitString) + 1;
                int n = Der.contentLength(this.der, bitString) - 1;
                return Der.copy(this.der, c, n);
            }

            // ---- Validity. Both bounds, as instants, so the comparison is arithmetic. ----
            public method notBefore() returns long {
                return this.timeAt(Der.contentOffset(this.der, this.validityOffset));
            }
            public method notAfter() returns long {
                int first = Der.contentOffset(this.der, this.validityOffset);
                return this.timeAt(Der.nextOffset(this.der, first));
            }
            // Is it valid at this moment, in seconds since the epoch? Both bounds inclusive, as RFC
            // 5280 defines them. Asked separately from `CertificateValidator.check` because a program
            // may want to report how long it has left -- a certificate about to expire is something
            // to warn about while it still works, and there is no way to do that from a refusal.
            public method isValidAt(long seconds) returns boolean {
                return seconds >= this.notBefore() && seconds <= this.notAfter();
            }

            // UTCTime is "YYMMDDHHMMSSZ" and GeneralizedTime is "YYYYMMDDHHMMSSZ" -- the two-digit
            // year pivots at 50, by RFC 5280. A certificate written for 2049 and one written for
            // 1950 are the same six digits, and the pivot is the only thing that separates them.
            private method timeAt(int off) returns long {
                int t = Der.tag(this.der, off);
                int c = Der.contentOffset(this.der, off);
                mutable int i = c;
                mutable int year = 0;
                if (t == 24) {                                  // GeneralizedTime
                    year = this.number(i, 4);
                    i = i + 4;
                } else {                                        // UTCTime
                    int yy = this.number(i, 2);
                    year = yy >= 50 ? 1900 + yy : 2000 + yy;
                    i = i + 2;
                }
                int month = this.number(i, 2);
                int day = this.number(i + 2, 2);
                int hour = this.number(i + 4, 2);
                int minute = this.number(i + 6, 2);
                int second = this.number(i + 8, 2);
                Instant at = Instant.ofUtc(year, month, day, hour, minute, second);
                long secs = at.toEpochSeconds();
                delete at;
                return secs;
            }
            private method number(int off, int digits) returns int {
                mutable int v = 0;
                mutable int i = 0;
                while (i < digits) {
                    v = v * 10 + ((this.der[off + i] & 255) - 48);
                    i = i + 1;
                }
                return v;
            }

            // ---- Extensions. ----

            // May this certificate sign others? A leaf that says yes to this is a leaf that could
            // issue certificates for anybody, which is why a chain checks it at every step above the
            // end entity. Absent means no, by RFC 5280.
            public method isCertificateAuthority() returns boolean {
                int ext = this.extension(Oid.basicConstraints(), 3);
                if (ext < 0) { return false; }
                // BasicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE, ... }
                if (Der.tag(this.der, ext) != 48) { return false; }
                int inner = Der.contentOffset(this.der, ext);
                if (Der.contentLength(this.der, ext) == 0) { return false; }
                if (Der.tag(this.der, inner) != 1) { return false; }      // no cA field -> FALSE
                return (this.der[Der.contentOffset(this.der, inner)] & 255) != 0;
            }

            // Every dNSName the certificate covers. This -- not the common name -- is what a client
            // matches a hostname against: the common name has been deprecated for that since 2000
            // and browsers stopped reading it years ago, so a certificate whose only name is in the
            // subject covers nothing.
            public method dnsNames() returns ArrayList<String> {
                ArrayList<String> names = new ArrayList<String>() on heap;
                int ext = this.extension(Oid.subjectAltName(), 3);
                if (ext < 0) { return names; }
                if (Der.tag(this.der, ext) != 48) { return names; }
                int end = ext + Der.totalLength(this.der, ext);
                mutable int off = Der.contentOffset(this.der, ext);
                while (off + 1 < end) {
                    if (Der.tag(this.der, off) == 130) {        // [2] IMPLICIT dNSName
                        int c = Der.contentOffset(this.der, off);
                        int n = Der.contentLength(this.der, off);
                        StringBuilder name = new StringBuilder() on heap;
                        mutable int i = 0;
                        while (i < n) {
                            name.appendChar(cast<char>(this.der[c + i] & 255));
                            i = i + 1;
                        }
                        names.add(name.toString());
                    }
                    off = Der.nextOffset(this.der, off);
                }
                return names;
            }

            // Where an extension's value starts, or -1 when the certificate does not carry it.
            // Extension ::= SEQUENCE { extnID OID, critical BOOLEAN DEFAULT FALSE, extnValue OCTET STRING }
            private method extension(int[] oid, int oidLen) returns int {
                // The caller builds the OID and hands it over; this method owns it from here, and
                // there are three ways out. Written once, at the top, where a reader sees it before
                // the returns rather than having to find all three and check they agree.
                defer { delete oid; }
                if (this.extensionsOffset < 0) {
                    return 0 - 1;
                }
                int seq = this.extensionsOffset;
                if (Der.tag(this.der, seq) != 48) {
                    return 0 - 1;
                }
                int end = seq + Der.totalLength(this.der, seq);
                mutable int off = Der.contentOffset(this.der, seq);
                mutable int found = 0 - 1;
                while (off + 1 < end && found < 0) {
                    int inner = Der.contentOffset(this.der, off);
                    if (Der.oidEquals(this.der, inner, oid, oidLen)) {
                        mutable int v = Der.nextOffset(this.der, inner);
                        if (Der.tag(this.der, v) == 1) { v = Der.nextOffset(this.der, v); }  // critical
                        found = Der.contentOffset(this.der, v);      // inside the OCTET STRING
                    }
                    off = Der.nextOffset(this.der, off);
                }
                return found;
            }

            // ---- Identity, for chain building. ----

            // The issuer and subject as raw DER. A chain links when one certificate's issuer field
            // is byte-for-byte the next one's subject field -- comparing the DECODED names instead
            // is where implementations disagree about encodings and let the wrong certificate in.
            public method issuerBytes() returns int[] {
                return Der.copy(this.der, this.issuerOffset,
                                Der.totalLength(this.der, this.issuerOffset));
            }
            public method subjectBytes() returns int[] {
                return Der.copy(this.der, this.subjectOffset,
                                Der.totalLength(this.der, this.subjectOffset));
            }
            public method issuerLength() returns int {
                return Der.totalLength(this.der, this.issuerOffset);
            }
            public method subjectLength() returns int {
                return Der.totalLength(this.der, this.subjectOffset);
            }
            // Was this issued by that one? Byte equality of the two names, as above.
            public method isIssuedBy(Certificate& issuer) returns boolean {
                if (this.issuerLength() != issuer.subjectLength()) { return false; }
                int[] mine = this.issuerBytes();
                int[] theirs = issuer.subjectBytes();
                mutable boolean same = true;
                mutable int i = 0;
                while (i < this.issuerLength()) {
                    if ((mine[i] & 255) != (theirs[i] & 255)) { same = false; }
                    i = i + 1;
                }
                delete theirs;
                delete mine;
                return same;
            }
            // Self-issued: what a root looks like, and the point at which a chain walk stops.
            //
            // Compared field to field rather than by calling `isIssuedBy(&this)`: `this` is already
            // the reference to the object, so `&this` is the address of the slot HOLDING it -- a
            // pointer to a pointer, whose fields read as whatever the pointer's bytes happen to say.
            // Here that came out as a length of hundreds of millions and an allocation that never
            // returned.
            public method isSelfIssued() returns boolean {
                if (this.issuerLength() != this.subjectLength()) { return false; }
                int[] issuer = this.issuerBytes();
                int[] subject = this.subjectBytes();
                mutable boolean same = true;
                mutable int i = 0;
                int n = this.issuerLength();
                while (i < n) {
                    if ((issuer[i] & 255) != (subject[i] & 255)) { same = false; }
                    i = i + 1;
                }
                delete subject;
                delete issuer;
                return same;
            }

            // The subject's common name, for a message a person reads. NOT for matching a
            // hostname -- see dnsNames.
            public method subjectCommonName() returns String {
                return this.commonNameIn(this.subjectOffset);
            }
            public method issuerCommonName() returns String {
                return this.commonNameIn(this.issuerOffset);
            }
            // Name ::= SEQUENCE OF SET OF SEQUENCE { type OID, value }
            private method commonNameIn(int nameOff) returns String {
                if (Der.tag(this.der, nameOff) != 48) { return ""; }
                int end = nameOff + Der.totalLength(this.der, nameOff);
                mutable int rdn = Der.contentOffset(this.der, nameOff);
                int[] cn = Oid.commonName();
                mutable String found = "";
                while (rdn + 1 < end && found.length() == 0) {
                    mutable int pair = Der.contentOffset(this.der, rdn);      // into the SET
                    int pairEnd = rdn + Der.totalLength(this.der, rdn);
                    while (pair + 1 < pairEnd && found.length() == 0) {
                        int typeOff = Der.contentOffset(this.der, pair);
                        if (Der.oidEquals(this.der, typeOff, cn, 3)) {
                            int valOff = Der.nextOffset(this.der, typeOff);
                            int c = Der.contentOffset(this.der, valOff);
                            int n = Der.contentLength(this.der, valOff);
                            StringBuilder text = new StringBuilder() on heap;
                            mutable int i = 0;
                            while (i < n) {
                                text.appendChar(cast<char>(this.der[c + i] & 255));
                                i = i + 1;
                            }
                            found = text.toString();
                        }
                        pair = Der.nextOffset(this.der, pair);
                    }
                    rdn = Der.nextOffset(this.der, rdn);
                }
                delete cn;
                return found;
            }

            // A certificate as it is written down rather than as it travels: PEM is the DER in
            // base64 between two marker lines, and it is how every trust store, every configuration
            // file and every export button hands one over. Whitespace and the markers are dropped,
            // and anything before the first marker or after the last is ignored -- a bundle file
            // carries dozens of these separated by commentary.
            public static method fromPem(String pem) returns Certificate* {
                StringBuilder body = new StringBuilder() on heap;
                ArrayList<String> lines = Strings.split(pem, "\n");
                mutable boolean inside = false;
                mutable int i = 0;
                while (i < lines.size()) {
                    String line = lines.get(i).trim();
                    if (line.startsWith("-----BEGIN")) {
                        inside = true;
                    } else if (line.startsWith("-----END")) {
                        inside = false;
                    } else if (inside) {
                        body.append(line);
                    }
                    i = i + 1;
                }
                delete lines;
                String raw = Base64.decode(body.toString());
                int[] der = new int[raw.length() > 0 ? raw.length() : 1]();
                mutable int j = 0;
                while (j < raw.length()) {
                    der[j] = cast<int>(raw.charAt(j)) & 255;
                    j = j + 1;
                }
                return new Certificate(der, raw.length()) on heap;
            }

            public destructor ~Certificate() returns void {
                delete this.der;
            }
        }

        // WHICH HASH, as a value rather than as a name baked into a method.
        //
        // A signature scheme names two things -- the padding and the digest -- and the digest is the
        // half that varies. Written as `verifyPssSha256`, the padding code and the choice of hash are
        // welded together, so SHA-384 means a second copy of a delicate routine; and a second copy is
        // how one of them ends up with the salt-length check and the other without it. Passing the
        // hash in leaves exactly one PSS.
        //
        // NOT called `Digest`, which it was for an hour: System.Security already has one, meaning a
        // non-cryptographic hash for hash tables, and two classes of one name in a library that
        // imports nothing is a name that resolves by declaration order. `Collections.BloomFilter`
        // started calling into this one and failed with "unknown static method 'fnv1a'" -- pointing
        // at a class that has it. The compiler now refuses that rather than choosing; the name still
        // had to go, because the reader deserves to know which of the two is meant.
        public class Sha {
            private mutable int width;      // bytes

            public constructor Sha(int width) { this.width = width; }
            public static method sha256() returns Sha* { return new Sha(32) on heap; }
            public static method sha384() returns Sha* { return new Sha(48) on heap; }
            public static method sha512() returns Sha* { return new Sha(64) on heap; }
            // The digest a signature algorithm identifier calls for: 1 and 2 are RSA and PSS over
            // SHA-256, 3 is ECDSA over it, 4 and 6 are SHA-384, 5 is SHA-512.
            public static method forAlgorithm(int alg) returns Sha* {
                if (alg == 4 || alg == 6) { return Sha.sha384(); }
                if (alg == 5) { return Sha.sha512(); }
                return Sha.sha256();
            }

            public method size() returns int { return this.width; }
            public method of(int[] data, int length) returns int[] {
                if (this.width == 48) { return Sha384.digestRaw(data, length); }
                if (this.width == 64) { return Sha512.digestRaw(data, length); }
                return Sha256.digestRaw(data, length);
            }
        }

        // RSA PKCS#1 v1.5 signature verification (RFC 8017) -- what almost every certificate in a
        // chain is signed with. Big-endian buffers throughout; the modular exponentiation rides the
        // standard library's BigInteger, and the public exponent is small (65537 as a rule), so
        // square-and-multiply over its bits is cheap.
        public class Rsa {
            // RSASSA-PSS with MGF1 over the same hash (RFC 8017 §9.1.2) -- what TLS 1.3 requires for
            // the server's CertificateVerify, and increasingly what certificates are signed with.
            //
            // PSS exists because PKCS#1 v1.5 padding is a fixed pattern, and a fixed pattern is
            // something an attacker can aim at. Here the encoded message is masked with a hash of
            // itself, so there is nothing constant to forge toward. The cost is that verification has
            // real steps rather than a memcmp, and every one of them has to be checked: skipping the
            // trailing 0xBC, or the zero prefix, or the salt reconstruction turns this into a
            // function that accepts almost anything.
            public static method verifyPss(int[] sig, int sigLength, int[] modulus,
                                           int modLength, int e, int[] hash,
                                           Sha* digest) returns boolean {
                int[] em = Rsa.recover(sig, sigLength, modulus, modLength, e);
                int emLen = modLength;
                int hLen = digest.size();
                int sLen = hLen;                                // salt length = hash length
                if (emLen < hLen + sLen + 2) { return false; }
                if ((em[emLen - 1] & 255) != 188) { return false; }   // the trailing 0xBC

                int dbLen = emLen - hLen - 1;
                int[] h = Der.copy(em, dbLen, hLen);
                int[] db = Der.copy(em, 0, dbLen);
                int[] mask = Rsa.mgf1(h, hLen, dbLen, digest);
                mutable int i = 0;
                while (i < dbLen) {
                    db[i] = (db[i] ^ mask[i]) & 255;
                    i = i + 1;
                }
                // The top bits of the first byte are not part of the message: the modulus is not a
                // whole number of bytes, and they must be cleared before the pattern is read.
                db[0] = db[0] & 127;

                // DB must be zeros, then a single 0x01, then the salt.
                mutable int j = 0;
                while (j < dbLen - sLen - 1) {
                    if ((db[j] & 255) != 0) { return false; }
                    j = j + 1;
                }
                if ((db[dbLen - sLen - 1] & 255) != 1) { return false; }

                // H' = hash(eight zero bytes || mHash || salt), compared against the H carried in
                // the signature.
                int[] input = new int[8 + hLen + sLen]();
                mutable int k = 0;
                while (k < 8) { input[k] = 0; k = k + 1; }
                while (k < 8 + hLen) { input[k] = hash[k - 8] & 255; k = k + 1; }
                while (k < 8 + hLen + sLen) {
                    input[k] = db[dbLen - sLen + (k - 8 - hLen)] & 255;
                    k = k + 1;
                }
                int[] expected = digest.of(input, 8 + hLen + sLen);
                mutable boolean same = true;
                mutable int c = 0;
                while (c < hLen) {
                    if ((expected[c] & 255) != (h[c] & 255)) { same = false; }
                    c = c + 1;
                }
                delete expected;
                delete input;
                delete mask;
                delete db;
                delete h;
                delete em;
                return same;
            }

            // MGF1 (RFC 8017 B.2.1): hash the seed with a counter appended, over and over, until
            // there are enough bytes.
            private static method mgf1(int[] seed, int seedLen, int wanted,
                                       Sha& digest) returns int[] {
                int[] out = new int[wanted > 0 ? wanted : 1]();
                mutable int produced = 0;
                mutable int counter = 0;
                while (produced < wanted) {
                    int[] input = new int[seedLen + 4]();
                    mutable int i = 0;
                    while (i < seedLen) { input[i] = seed[i] & 255; i = i + 1; }
                    input[seedLen] = (counter >> 24) & 255;
                    input[seedLen + 1] = (counter >> 16) & 255;
                    input[seedLen + 2] = (counter >> 8) & 255;
                    input[seedLen + 3] = counter & 255;
                    int[] block = digest.of(input, seedLen + 4);
                    mutable int j = 0;
                    while (j < digest.size() && produced < wanted) {
                        out[produced] = block[j] & 255;
                        produced = produced + 1;
                        j = j + 1;
                    }
                    delete block;
                    delete input;
                    counter = counter + 1;
                }
                return out;
            }

            // Is `sig` a valid PKCS#1 v1.5 signature over `hash` under (modulus, e)? `hashLength`
            // selects the digest -- 32, 48 or 64 for SHA-256, SHA-384 and SHA-512.
            public static method verifyPkcs1(int[] sig, int sigLength, int[] modulus, int modLength,
                                             int e, int[] hash, int hashLength) returns boolean {
                int[] encoded = Rsa.recover(sig, sigLength, modulus, modLength, e);
                boolean ok = Rsa.checkPkcs1(encoded, modLength, hash, hashLength);
                delete encoded;
                return ok;
            }

            // s^e mod n, as big-endian bytes of exactly `modLength` -- the operation both padding
            // schemes start from.
            //
            // ON THE LIMB ARITHMETIC AND NOT ON BigInteger. That type keeps one DECIMAL DIGIT per
            // slot, which makes a 2048-bit modular exponentiation cost 2.3 seconds -- measured
            // against a real trust store, where the two or three verifications of a single handshake
            // would have taken most of ten seconds. The same Montgomery code the curve uses answers
            // this in milliseconds; only the limb count differs.
            private static method recover(int[] sig, int sigLength, int[] modulus, int modLength,
                                          int e) returns int[] {
                int limbs = U256.limbsForBytes(modLength);
                long[] n = Rsa.toLimbs(modulus, modLength, limbs);
                long[] s = Rsa.toLimbs(sig, sigLength, limbs);
                Mont f = new Mont(n) on stack;
                long[] m = f.powSmall(s, e);
                int[] out = Rsa.fromLimbs(m, modLength);
                delete m;
                delete s;
                delete n;
                return out;
            }
            private static method toLimbs(int[] be, int len, int limbs) returns long[] {
                long[] out = U256.zeroOf(limbs);
                mutable int i = 0;
                while (i < len) {
                    int value = be[len - 1 - i] & 255;
                    int limb = i / 2;
                    if (limb < limbs) {
                        out[limb] = out[limb] | (cast<long>(value) << ((i % 2) * 8));
                    }
                    i = i + 1;
                }
                return out;
            }
            private static method fromLimbs(long[] a, int bytes) returns int[] {
                int[] out = new int[bytes]();
                mutable int i = 0;
                while (i < bytes) {
                    int limb = i / 2;
                    long v = limb < a.length() ? a[limb] : cast<long>(0);
                    out[bytes - 1 - i] = cast<int>((v >> ((i % 2) * 8)) & cast<long>(255));
                    i = i + 1;
                }
                return out;
            }
            // The SHA-256 case by name, which is what most callers mean.
            public static method verifySha256(int[] sig, int sigLength, int[] modulus, int modLength,
                                              int e, int[] hash) returns boolean {
                return Rsa.verifyPkcs1(sig, sigLength, modulus, modLength, e, hash, 32);
            }

            private static method fromBigEndian(int[] bytes, int length) returns BigInteger {
                BigInteger base = new BigInteger(cast<long>(256)) on heap;
                mutable BigInteger acc = new BigInteger(cast<long>(0)) on heap;
                mutable int i = 0;
                while (i < length) {
                    BigInteger digit = new BigInteger(cast<long>(bytes[i] & 255)) on heap;
                    acc = acc.multiply(base).add(digit);
                    i = i + 1;
                }
                return acc;
            }

            private static method toBigEndian(BigInteger a, int k) returns int[] {
                BigInteger base = new BigInteger(cast<long>(256)) on heap;
                mutable BigInteger v = a;
                int[] out = new int[k]();
                mutable int i = k - 1;
                while (i >= 0) {
                    out[i] = v.remainder(base).toString().toInt();
                    v = v.divide(base);
                    i = i - 1;
                }
                return out;
            }

            private static method modPow(BigInteger base, int e, BigInteger mod) returns BigInteger {
                mutable BigInteger result = new BigInteger(cast<long>(1)) on heap;
                BigInteger b = base.remainder(mod);
                mutable int bit = 30;
                while (bit >= 0) {
                    result = result.multiply(result).remainder(mod);
                    if (((e >> bit) & 1) == 1) {
                        result = result.multiply(b).remainder(mod);
                    }
                    bit = bit - 1;
                }
                return result;
            }

            // The recovered block must be 0x00 0x01, at least eight 0xFF bytes, 0x00, the SHA-256
            // DigestInfo, then the hash. Every one of those is checked: a verifier that only compares
            // the trailing hash accepts a forged signature with anything at all in the padding, which
            // is the Bleichenbacher forgery.
            private static method checkPkcs1(int[] em, int k, int[] hash, int hashLength)
                                             returns boolean {
                if ((em[0] & 255) != 0 || (em[1] & 255) != 1) { return false; }
                mutable int i = 2;
                while (i < k && (em[i] & 255) == 255) { i = i + 1; }
                if (i >= k || (em[i] & 255) != 0) { return false; }
                if ((i - 2) < 8) { return false; }
                i = i + 1;

                // The DigestInfo header names WHICH hash this is, and that is not decoration: without
                // it, a signature over a SHA-256 digest could be presented as one over the leading 32
                // bytes of a SHA-512 digest. The three differ in exactly two bytes -- the algorithm's
                // last identifier byte and the two lengths -- so they are set rather than assumed.
                int[] prefix = new int[19]();
                prefix[0] = 48;   prefix[1] = 49;  prefix[2] = 48;  prefix[3] = 13;  prefix[4] = 6;
                prefix[5] = 9;    prefix[6] = 96;  prefix[7] = 134; prefix[8] = 72;  prefix[9] = 1;
                prefix[10] = 101; prefix[11] = 3;  prefix[12] = 4;  prefix[13] = 2;  prefix[14] = 1;
                prefix[15] = 5;   prefix[16] = 0;  prefix[17] = 4;  prefix[18] = 32;
                if (hashLength == 48) {
                    prefix[1] = 65; prefix[14] = 2; prefix[18] = 48;
                } else if (hashLength == 64) {
                    prefix[1] = 81; prefix[14] = 3; prefix[18] = 64;
                }

                if (i + 19 + hashLength != k) {
                    delete prefix;
                    return false;
                }
                mutable boolean ok = true;
                mutable int j = 0;
                while (j < 19) {
                    if ((em[i + j] & 255) != prefix[j]) { ok = false; }
                    j = j + 1;
                }
                delete prefix;
                mutable int h = 0;
                while (h < hashLength) {
                    if ((em[i + 19 + h] & 255) != (hash[h] & 255)) { ok = false; }
                    h = h + 1;
                }
                return ok;
            }
        }

        // HKDF-SHA256 (RFC 5869): extract-then-expand, the key-derivation function TLS 1.3's whole
        // key schedule is built on.
        //
        //   PRK  = HMAC(salt, keyMaterial)
        //   OKM  = T(1) | T(2) | ... truncated, where T(i) = HMAC(PRK, T(i-1) | info | i)
        //
        // Two operations, and every secret in a TLS 1.3 connection is some arrangement of them.
        public class Hkdf {
            // Fold input key material into a fixed-length pseudorandom key.
            public static method extract(int[] salt, int saltLength, int[] keyMaterial,
                                         int keyLength) returns int[] {
                return Hmac.sha256Raw(salt, saltLength, keyMaterial, keyLength);
            }
            // Stretch that key into as many bytes as are wanted, bound to `info`.
            public static method expand(int[] prk, int prkLength, int[] info, int infoLength,
                                        int length) returns int[] {
                int[] okm = new int[length > 0 ? length : 1]();
                mutable int[] previous = new int[1]();
                mutable int previousLength = 0;                 // T(0) is empty
                mutable int done = 0;
                mutable int counter = 1;
                while (done < length) {
                    int inputLength = previousLength + infoLength + 1;
                    int[] input = new int[inputLength]();
                    mutable int at = 0;
                    for (mutable int i = 0; i < previousLength; i++) {
                        input[at] = previous[i];
                        at = at + 1;
                    }
                    for (mutable int i = 0; i < infoLength; i++) {
                        input[at] = info[i];
                        at = at + 1;
                    }
                    input[at] = counter & 255;
                    int[] block = Hmac.sha256Raw(prk, prkLength, input, inputLength);
                    delete input;
                    delete previous;
                    mutable int k = 0;
                    while (k < 32 && done < length) {
                        okm[done] = block[k];
                        done = done + 1;
                        k = k + 1;
                    }
                    previous = block;                           // T(i) becomes the next T(i-1)
                    previousLength = 32;
                    counter = counter + 1;
                }
                delete previous;
                return okm;
            }
        }

        // THE TLS 1.3 KEY SCHEDULE (RFC 8446 §7.1).
        //
        // Everything hangs off two operations -- Extract to fold in new material, Expand-Label to
        // derive a named output -- arranged into a tree: an early secret, then a handshake secret
        // once the shared key exists, then a master secret, with a traffic secret branching off at
        // each stage and per-record keys derived from those.
        //
        // The point of the arrangement is that each secret is bound to the TRANSCRIPT of everything
        // said so far, so a message altered anywhere changes every key derived after it.
        public class KeySchedule {
            // HKDF-Expand-Label: the structured info string TLS 1.3 specifies.
            //   HkdfLabel = uint16 length || opaque("tls13 " + label) || opaque(context)
            // `name` and not `label`, which is reserved: a bare word before a loop is a loop label.
            public static method expandLabel(int[] secret, int secretLength, String name,
                                             int[] context, int contextLength, int length)
                                             returns int[] {
                int labelLength = 6 + name.length();            // "tls13 " is six bytes
                int infoLength = 3 + labelLength + 1 + contextLength;
                int[] info = new int[infoLength]();
                info[0] = (length >> 8) & 255;
                info[1] = length & 255;
                info[2] = labelLength & 255;
                info[3] = 116; info[4] = 108; info[5] = 115;    // 't' 'l' 's'
                info[6] = 49;  info[7] = 51;  info[8] = 32;     // '1' '3' ' '
                for (mutable int i = 0; i < name.length(); i++) {
                    info[9 + i] = cast<int>(name.charAt(i)) & 255;
                }
                int contextAt = 9 + name.length();
                info[contextAt] = contextLength & 255;
                for (mutable int i = 0; i < contextLength; i++) {
                    info[contextAt + 1 + i] = context[i] & 255;
                }
                int[] out = Hkdf.expand(secret, secretLength, info, infoLength, length);
                delete info;
                return out;
            }
            // A 32-byte secret bound to a transcript hash.
            public static method deriveSecret(int[] secret, int secretLength, String name,
                                              int[] transcript, int transcriptLength) returns int[] {
                return KeySchedule.expandLabel(secret, secretLength, name, transcript,
                                               transcriptLength, 32);
            }
            // The early secret: extract with a zero salt over a zero key, since this client offers
            // no pre-shared key.
            public static method earlySecret() returns int[] {
                int[] zeros = new int[32]();
                int[] out = Hkdf.extract(zeros, 32, zeros, 32);
                delete zeros;
                return out;
            }
            public static method trafficKey(int[] secret, int secretLength) returns int[] {
                int[] empty = new int[1]();
                int[] out = KeySchedule.expandLabel(secret, secretLength, "key", empty, 0, 16);
                delete empty;
                return out;
            }
            public static method trafficIv(int[] secret, int secretLength) returns int[] {
                int[] empty = new int[1]();
                int[] out = KeySchedule.expandLabel(secret, secretLength, "iv", empty, 0, 12);
                delete empty;
                return out;
            }
        }

        // ---- 256-BIT ARITHMETIC, because the standard library's BigInteger cannot do this job. ----
        //
        // `BigInteger` stores ONE DECIMAL DIGIT PER SLOT. That is a reasonable choice for a type whose
        // job is exact arithmetic a person will read, and it is the wrong one underneath a curve:
        // measured, a modular multiplication of two 256-bit numbers costs 0.16 ms there, and verifying
        // one ECDSA signature needs about 6 700 of them -- over a second per signature, for something
        // a TLS handshake does two or three times.
        //
        // So this is purpose-built and stays here rather than replacing BigInteger, which is used
        // elsewhere and is right for what it does.
        //
        // SIXTEEN-BIT LIMBS, not thirty-two. A product of two 32-bit limbs plus an accumulator plus a
        // carry brushes the top of a 64-bit word, and Polaron's `long` is signed -- one carry too many
        // and the value goes negative and the answer is silently wrong. With 16-bit limbs a product is
        // 32 bits and the accumulator never leaves the comfortable middle of the range. It costs four
        // times the limb operations and buys arithmetic that cannot overflow into nonsense, which for
        // code nobody can eyeball is the right trade.
        public class U256 {
            // THE SIZE COMES FROM THE ARRAY, not from the name. This started as 256-bit-only, which
            // was right for a curve and wrong for everything else: RSA needs 2048 bits, and routing
            // that through the standard library's decimal BigInteger cost 2.3 SECONDS per signature
            // -- measured against a real trust store, where a handshake's two or three verifications
            // would have taken most of ten seconds. The same Montgomery code answers both once the
            // limb count stops being a constant.
            public static method zero() returns long[] { return new long[16](); }
            public static method zeroOf(int limbs) returns long[] { return new long[limbs](); }

            // LITTLE-ENDIAN bytes, which is how Curve25519 writes everything and the opposite of how
            // X.509 does. Two functions rather than a flag: a caller that passes the wrong flag gets
            // a wrong answer, and a caller that picks the wrong function gets a name that reads
            // wrongly next to the format it is parsing.
            public static method fromBytesLe(int[] b, int off, int len) returns long[] {
                long[] out = new long[16]();
                mutable int i = 0;
                while (i < len && i < 32) {
                    out[i / 2] = out[i / 2] | (cast<long>(b[off + i] & 255) << ((i % 2) * 8));
                    i = i + 1;
                }
                return out;
            }
            public static method toBytesLe(long[] a) returns int[] {
                int[] out = new int[32]();
                mutable int i = 0;
                while (i < 32) {
                    out[i] = cast<int>((a[i / 2] >> ((i % 2) * 8)) & cast<long>(255));
                    i = i + 1;
                }
                return out;
            }
            // How many limbs a modulus of this many BYTES needs, rounded up.
            public static method limbsForBytes(int bytes) returns int { return (bytes + 1) / 2; }

            // A big-endian hex constant -- how every curve constant is published. THE WIDTH COMES FROM
            // THE TEXT: 64 characters is a 256-bit prime, 96 is a 384-bit one. Fixing it at 16 limbs
            // is what confined the elliptic-curve code to one curve, and a P-384 certificate chain is
            // not exotic -- a third of this machine's trust store is signed that way.
            public static method fromHex(String hex) returns long[] {
                long[] out = new long[(hex.length() + 3) / 4]();
                mutable int i = 0;
                while (i < hex.length()) {
                    int nybble = U256.hexValue(hex.charAt(hex.length() - 1 - i));
                    int limb = i / 4;
                    int shift = (i % 4) * 4;
                    out[limb] = out[limb] | (cast<long>(nybble) << shift);
                    i = i + 1;
                }
                return out;
            }
            private static method hexValue(char c) returns int {
                if (c >= '0' && c <= '9') { return cast<int>(c) - 48; }
                if (c >= 'a' && c <= 'f') { return cast<int>(c) - 87; }
                if (c >= 'A' && c <= 'F') { return cast<int>(c) - 55; }
                return 0;
            }

            // Big-endian bytes, at most 32 of them. Shorter is fine -- a signature integer often has
            // fewer, and DER strips leading zeros.
            public static method fromBytes(int[] b, int off, int len) returns long[] {
                return U256.fromBytesOf(b, off, len, 16);
            }
            // The same, at a width the caller states. Two values compared limb by limb must have the
            // SAME number of limbs: a 24-limb order compared against a 16-limb candidate reads only
            // sixteen of the order's limbs and answers that everything is in range.
            public static method fromBytesOf(int[] b, int off, int len, int limbs) returns long[] {
                long[] out = new long[limbs]();
                mutable int i = 0;
                while (i < len && i < limbs * 2) {
                    int value = b[off + len - 1 - i] & 255;
                    int limb = i / 2;
                    int shift = (i % 2) * 8;
                    out[limb] = out[limb] | (cast<long>(value) << shift);
                    i = i + 1;
                }
                return out;
            }
            public static method toBytes(long[] a) returns int[] { return U256.toBytesOf(a, 32); }
            public static method toBytesOf(long[] a, int bytes) returns int[] {
                int[] out = new int[bytes]();
                mutable int i = 0;
                while (i < bytes) {
                    long limb = i / 2 < a.length() ? a[i / 2] : cast<long>(0);
                    int shift = (i % 2) * 8;
                    out[bytes - 1 - i] = cast<int>((limb >> shift) & cast<long>(255));
                    i = i + 1;
                }
                return out;
            }

            public static method copy(long[] a) returns long[] {
                long[] out = new long[a.length()]();
                for (mutable int i = 0; i < a.length(); i++) { out[i] = a[i]; }
                return out;
            }
            public static method isZero(long[] a) returns boolean {
                for (mutable int i = 0; i < a.length(); i++) {
                    if (a[i] != cast<long>(0)) { return false; }
                }
                return true;
            }
            // -1, 0 or 1. Compared from the top down, which is the only order that terminates early
            // on the common case.
            public static method compare(long[] a, long[] b) returns int {
                for (mutable int i = a.length() - 1; i >= 0; i--) {
                    if (a[i] < b[i]) { return 0 - 1; }
                    if (a[i] > b[i]) { return 1; }
                }
                return 0;
            }
            // `at` and not `index`, which is reserved.
            public static method bit(long[] a, int at) returns int {
                if (at < 0 || at >= a.length() * 16) { return 0; }
                return cast<int>((a[at / 16] >> (at % 16)) & cast<long>(1));
            }
            // a += b, answering the carry out of the top limb.
            public static method addInto(long[] a, long[] b) returns long {
                mutable long carry = cast<long>(0);
                for (mutable int i = 0; i < a.length(); i++) {
                    long sum = a[i] + b[i] + carry;
                    a[i] = sum & cast<long>(65535);
                    carry = sum >> 16;
                }
                return carry;
            }
            // a -= b, answering the borrow.
            public static method subInto(long[] a, long[] b) returns long {
                mutable long borrow = cast<long>(0);
                for (mutable int i = 0; i < a.length(); i++) {
                    long diff = a[i] - b[i] - borrow;
                    if (diff < cast<long>(0)) {
                        a[i] = diff + cast<long>(65536);
                        borrow = cast<long>(1);
                    } else {
                        a[i] = diff;
                        borrow = cast<long>(0);
                    }
                }
                return borrow;
            }
        }

        // MONTGOMERY ARITHMETIC over an odd 256-bit modulus.
        //
        // Multiplying modulo a prime needs a remainder, and a remainder needs division -- the one
        // operation that is genuinely awkward on limbs. Montgomery's trick removes it: numbers are
        // kept multiplied by R = 2^256, and the reduction after a product becomes shifts and
        // multiply-adds. Both moduli this needs (the field prime and the group order) are odd, which
        // is the only condition.
        //
        // Nothing here is constant-time, and that is stated rather than hidden: this verifies
        // signatures with PUBLIC values -- a public key, a signature, a hash -- where a timing channel
        // leaks nothing an observer does not already have. Signing, which touches a private key, is
        // not implemented, and if it ever is it needs different code.
        public class Mont {
            private mutable long[] m;      // the modulus
            private mutable long n0;       // -m^-1 mod 2^16, the per-limb reduction factor
            private mutable long[] rr;     // R^2 mod m, for entering Montgomery form

            public constructor Mont(long[] modulus) {
                this.m = U256.copy(modulus);
                // -m^-1 mod 2^16 by Newton iteration: four doublings take an odd m from 3 correct
                // bits to more than 16.
                mutable long inv = cast<long>(1);
                mutable int i = 0;
                while (i < 5) {
                    inv = (inv * (cast<long>(2) - this.m[0] * inv)) & cast<long>(65535);
                    i = i + 1;
                }
                this.n0 = (cast<long>(65536) - inv) & cast<long>(65535);
                // R^2 mod m, by doubling 1 five hundred and twelve times with a conditional subtract.
                // Doubling avoids needing a division to get here, which is the thing being avoided.
                long[] acc = U256.zeroOf(this.m.length());
                acc[0] = cast<long>(1);
                mutable int d = 0;
                // R = 2^(16*limbs), so R² needs twice that many doublings.
                int doublings = this.m.length() * 32;
                while (d < doublings) {
                    mutable long carry = U256.addInto(acc, acc);
                    if (carry != cast<long>(0) || U256.compare(acc, this.m) >= 0) {
                        U256.subInto(acc, this.m);
                    }
                    d = d + 1;
                }
                this.rr = acc;
            }

            // The Montgomery product: (a * b) / R mod m. Separated operand scanning -- the full
            // 32-limb product first, then one reduction pass per limb.
            public method mul(long[] a, long[] b) returns long[] {
                int n = this.m.length();
                long[] t = new long[2 * n + 2]();
                for (mutable int i = 0; i < n; i++) {
                    mutable long carry = cast<long>(0);
                    for (mutable int j = 0; j < n; j++) {
                        long sum = t[i + j] + a[j] * b[i] + carry;
                        t[i + j] = sum & cast<long>(65535);
                        carry = sum >> 16;
                    }
                    t[i + n] = t[i + n] + carry;
                }
                for (mutable int i = 0; i < n; i++) {
                    long factor = (t[i] * this.n0) & cast<long>(65535);
                    mutable long carry = cast<long>(0);
                    for (mutable int j = 0; j < n; j++) {
                        long sum = t[i + j] + factor * this.m[j] + carry;
                        t[i + j] = sum & cast<long>(65535);
                        carry = sum >> 16;
                    }
                    mutable int k = i + n;
                    while (carry != cast<long>(0) && k < 2 * n + 2) {
                        long sum = t[k] + carry;
                        t[k] = sum & cast<long>(65535);
                        carry = sum >> 16;
                        k = k + 1;
                    }
                }
                long[] out = U256.zeroOf(n);
                for (mutable int i = 0; i < n; i++) { out[i] = t[i + n]; }
                // One conditional subtract: the result is below 2m, never below m by construction.
                if (t[2 * n] != cast<long>(0) || U256.compare(out, this.m) >= 0) {
                    U256.subInto(out, this.m);
                }
                delete t;
                return out;
            }

            public method toMont(long[] a) returns long[] { return this.mul(a, this.rr); }
            public method fromMont(long[] a) returns long[] {
                long[] one = U256.zeroOf(this.m.length());
                one[0] = cast<long>(1);
                long[] r = this.mul(a, one);
                delete one;
                return r;
            }
            // Modular exponentiation with a small public exponent, in one call: a^e mod m, entering
            // and leaving Montgomery form here so callers never see it. This is what makes an RSA
            // verification cost milliseconds instead of the 2.3 SECONDS the decimal BigInteger took.
            public method powSmall(long[] a, int e) returns long[] {
                mutable long[] result = this.toMont(Mont.oneOf(this.m.length()));
                long[] base = this.toMont(a);
                mutable int bit = 30;
                while (bit >= 0) {
                    result = this.mul(result, result);
                    if (((e >> bit) & 1) == 1) { result = this.mul(result, base); }
                    bit = bit - 1;
                }
                delete base;
                long[] out = this.fromMont(result);
                delete result;
                return out;
            }
            private static method oneOf(int limbs) returns long[] {
                long[] one = U256.zeroOf(limbs);
                one[0] = cast<long>(1);
                return one;
            }
            public method addMod(long[] a, long[] b) returns long[] {
                long[] out = U256.copy(a);
                long carry = U256.addInto(out, b);
                if (carry != cast<long>(0) || U256.compare(out, this.m) >= 0) {
                    U256.subInto(out, this.m);
                }
                return out;
            }
            public method subMod(long[] a, long[] b) returns long[] {
                long[] out = U256.copy(a);
                long borrow = U256.subInto(out, b);
                if (borrow != cast<long>(0)) { U256.addInto(out, this.m); }
                return out;
            }
            public method modulus() returns long[] { return this.m; }

            // The inverse, by Fermat: a^(m-2) mod m, square-and-multiply over the exponent's bits.
            // Both operands stay in Montgomery form throughout. Slower than the extended Euclid, and
            // it is the version with no branches on the value -- which costs nothing here and means
            // this stays correct if it is ever reused where that matters.
            public method invMont(long[] aMont) returns long[] {
                long[] e = U256.copy(this.m);
                long[] two = U256.zeroOf(this.m.length());
                two[0] = cast<long>(2);
                U256.subInto(e, two);
                mutable long[] result = this.toMont(Mont.oneOf(this.m.length()));
                mutable long[] base = U256.copy(aMont);
                mutable int i = 0;
                int bits = this.m.length() * 16;
                while (i < bits) {
                    if (U256.bit(e, i) == 1) { result = this.mul(result, base); }
                    base = this.mul(base, base);
                    i = i + 1;
                }
                delete two;
                delete e;
                delete base;
                return result;
            }
            public destructor ~Mont() returns void {
                delete this.rr;
                delete this.m;
            }
        }

        // READING WHOLE RECORDS OFF A SOCKET.
        //
        // A class rather than a function because of what TCP does not promise: it preserves the order
        // of bytes and nothing about where the sender's writes ended. A single read can return half a
        // record, or three of them, so whatever arrives beyond the record being assembled has to be
        // KEPT -- and a leftover buffer that lives in a local variable is a leftover buffer somebody
        // drops between the handshake and the session, taking the first bytes of the reply with it.
        public class Wire {
            private mutable Socket link;
            private mutable String pending;

            public constructor Wire(Socket link) {
                this.link = link;
                this.pending = "";
            }
            // One whole record, or an empty array at the end of the stream.
            public method next() returns int[] {
                while (this.pending.length() < 5) {
                    String more = this.link.receive(16384);
                    if (more.length() == 0) { return new int[1](); }
                    this.pending = this.pending.concat(more);
                }
                int total = 5 + (((cast<int>(this.pending.charAt(3)) & 255) << 8) |
                                 (cast<int>(this.pending.charAt(4)) & 255));
                while (this.pending.length() < total) {
                    String more = this.link.receive(16384);
                    if (more.length() == 0) { return new int[1](); }
                    this.pending = this.pending.concat(more);
                }
                int[] out = new int[total]();
                for (mutable int i = 0; i < total; i++) {
                    out[i] = cast<int>(this.pending.charAt(i)) & 255;
                }
                this.pending = this.pending.substring(total, this.pending.length());
                return out;
            }
            // What has arrived but not yet been consumed -- handed to the session so the first
            // application record is not lost.
            public method leftover() returns String { return this.pending; }
            public method socket() returns Socket { return this.link; }
        }

        // WHAT THE SERVER PICKED: which named group, and its public value. Two fields and not one
        // array, because the value is meaningless without the group -- and the group is exactly what
        // a client stops carrying the moment it decides it only ever offers one.
        public class KeyShare {
            public int group;
            public mutable int[] value;

            public constructor KeyShare(int group, int[] value) {
                this.group = group;
                this.value = value;
            }
            public destructor ~KeyShare() returns void { delete this.value; }
        }

        // THE OTHER THING A SERVER CAN SAY. A TLS peer that will not continue sends an alert: a
        // record of type 21 holding a level and a numbered reason. Naming the number is the whole
        // point -- "handshake failure" and "unrecognised name" and "protocol version" send whoever
        // is debugging in three different directions, and a client that reports none of them sends
        // them nowhere.
        public class Alert {
            // A record as it came off the wire, described. Not just alerts: whatever arrived where a
            // ServerHello was expected, so the caller has one method to ask and always gets a
            // sentence rather than sometimes getting nothing.
            public static method explain(int[] framed) returns String {
                if (framed.length() <= 1) { return "the connection closed with no reply"; }
                int kind = framed[0] & 255;
                if (kind != 21) {
                    return "a record of type ".concat(kind.toString()).concat(" arrived instead");
                }
                if (framed.length() < 7) { return "a truncated alert arrived"; }
                int level = framed[5] & 255;
                int code = framed[6] & 255;
                String what = Alert.describe(code);
                if (level == 1) { return "the server gave notice: ".concat(what); }
                return "the server refused: ".concat(what);
            }

            // RFC 8446 §6.2. Only the ones a client can actually be told; anything else is reported
            // by number, because inventing a name for a code we do not know is how a wrong diagnosis
            // gets written down as a fact.
            public static method describe(int code) returns String {
                if (code == 0) { return "the connection was closed normally"; }
                if (code == 10) { return "unexpected message"; }
                if (code == 20) { return "bad record MAC -- the decryption did not authenticate"; }
                if (code == 22) { return "record overflow"; }
                // The commonest one a TLS 1.3-only client meets, and the commonest cause is not a
                // fault at either end: the server speaks 1.2 and nothing else, so there was no
                // version in common to fail over. Measured against badssl.com, which answers exactly
                // this and which .NET reaches by negotiating TLS 1.2.
                if (code == 40) {
                    return "handshake failure -- nothing offered was acceptable; this client speaks "
                        .concat("only TLS 1.3, and a server limited to 1.2 answers just like this");
                }
                if (code == 42) { return "bad certificate"; }
                if (code == 43) { return "unsupported certificate"; }
                if (code == 44) { return "certificate revoked"; }
                if (code == 45) { return "certificate expired"; }
                if (code == 46) { return "certificate unknown"; }
                if (code == 47) { return "illegal parameter"; }
                if (code == 48) { return "unknown certificate authority"; }
                if (code == 49) { return "access denied"; }
                if (code == 50) { return "decode error -- a message was malformed"; }
                if (code == 51) { return "decrypt error -- a signature or MAC did not check out"; }
                if (code == 70) { return "protocol version -- the server does not speak TLS 1.3"; }
                if (code == 71) { return "insufficient security"; }
                if (code == 80) { return "internal error"; }
                if (code == 86) { return "inappropriate fallback"; }
                if (code == 90) { return "the user cancelled"; }
                if (code == 109) { return "missing extension"; }
                if (code == 110) { return "unsupported extension"; }
                if (code == 112) { return "unrecognised server name"; }
                if (code == 113) { return "bad certificate status response"; }
                if (code == 115) { return "unknown pre-shared key identity"; }
                if (code == 116) { return "a client certificate is required"; }
                if (code == 120) { return "no application protocol in common"; }
                return "alert ".concat(code.toString());
            }
        }

        // THE TLS 1.3 CLIENT: a connection to a named server that is encrypted AND authenticated.
        //
        // The second half of that sentence is the one this library exists for. A handshake that
        // agrees a key with whoever answered the socket stops somebody listening and does nothing
        // about somebody answering in the server's place -- and looks identical to the caller. Three
        // things turn the first into the second, and all three happen here before a single byte of
        // application data moves:
        //
        //   1. The CERTIFICATE CHAIN is checked to a root this machine already trusts, with every
        //      signature verified and every validity window honoured.
        //   2. The HOSTNAME is matched against the certificate's subject alternative names. Skipping
        //      this accepts any valid certificate for any host -- and anybody can buy a valid
        //      certificate for a domain they own. It was the commonest TLS bug in the field for a
        //      decade.
        //   3. CERTIFICATE VERIFY is checked: a signature, by the private key belonging to that
        //      certificate, over everything said so far. Without it the server has shown a
        //      certificate but not shown that it HAS one -- anybody can copy a certificate off the
        //      wire, since they are public by design.
        //
        // Any of the three failing throws. There is no flag to turn them off, and the reason is not
        // paternalism: a connection that skips them is a different thing wearing the same name, and
        // the caller asked for this one.
        public class TlsClient {
            // The machine's trust store, read once. Reading it costs about half a second -- it walks
            // every root the operating system holds and parses each one -- and a client that paid
            // that per request would be a client nobody uses for more than one. Held rather than
            // rebuilt, and never freed: it lives as long as the program does, by definition.
            private static mutable nullable TrustStore* shared;

            public static method systemTrust() returns TrustStore* {
                if (TlsClient.shared == null) { TlsClient.shared = TrustStore.system(); }
                return cast<TrustStore*>(TlsClient.shared);
            }

            // Connect, handshake, authenticate, against the certificates this machine already trusts.
            // The short form, because it is the one that is almost always right: a caller who passes
            // their own store is pinning, and a caller who has no opinion should not have to invent
            // one to make a connection.
            public static method open(String host, int port)
                                      throws(TlsException, CertificateException)
                                      returns TlsSession* {
                return TlsClient.connect(host, port, TlsClient.systemTrust());
            }

            // Connect, handshake, authenticate. Throws rather than returning something unusable.
            public static method connect(String host, int port, TrustStore* trusted)
                                         throws(TlsException, CertificateException)
                                         returns TlsSession* {
                Socket link = Socket.connect(host, port);
                if (!link.isOpen()) {
                    throw new TlsException("could not reach ".concat(host)) on heap;
                }
                return TlsClient.over(link, host, trusted);
            }

            // The handshake over an already-connected socket, so a caller with its own transport --
            // a proxy, a test harness -- can use the same code.
            public static method over(Socket link, String host, TrustStore* trusted)
                                      throws(TlsException, CertificateException)
                                      returns TlsSession* {
                SecureRandom rng = new SecureRandom() on stack;
                int[] privateKey = rng.nextBytes(32);
                int[] publicKey = X25519.publicKey(privateKey);
                // A second ephemeral key, on the curve the standard calls mandatory. Generated
                // whether or not the server ends up choosing it -- an offer with no key behind it is
                // an offer that costs a round trip to honour.
                Curve* nist = Curve.p256();
                int[] nistSeed = rng.nextBytes(32);
                long[] nistPrivate = nist.scalarFrom(nistSeed, 32);
                delete nistSeed;
                int[] nistPublic = nist.publicPoint(nistPrivate);
                int[] random = rng.nextBytes(32);
                int[] sessionId = rng.nextBytes(32);
                ByteWriter transcript = new ByteWriter() on heap;
                int[] empty = new int[1]();

                // ClientHello, sent in the clear -- there are no keys yet.
                int[] hello = ClientHello.build(host, random, sessionId, 32, publicKey,
                                                        nistPublic);
                transcript.bytes(hello, hello.length());
                TlsClient.sendPlain(link, 22, 769, hello, hello.length());
                delete hello;

                Wire* wire = new Wire(link) on heap;
                int[] serverHello = wire.next();
                if (serverHello.length() <= 1 || (serverHello[0] & 255) != 22) {
                    // WHAT DID COME BACK, said out loud. Every non-ServerHello answer used to be the
                    // one sentence "the server did not answer with a ServerHello", which is true and
                    // useless: a server refusing our version, a server refusing the hostname and a
                    // server that hung up are three different problems wearing one message, and
                    // nothing in the sentence says which. The wire tells us -- an alert record
                    // carries a numbered reason -- so the message carries it too.
                    String why = Alert.explain(serverHello);
                    delete serverHello;
                    throw new TlsException("the server did not answer with a ServerHello: "
                                           .concat(why)) on heap;
                }
                KeyShare* peer = TlsClient.serverKeyShare(serverHello);
                for (mutable int i = 5; i < serverHello.length(); i++) {
                    transcript.u8(serverHello[i]);
                }
                delete serverHello;

                // THE SECRET COMES OUT OF THE GROUP THE SERVER NAMED. Both were offered with a key
                // behind them, so either answer is a working handshake; anything else is a server
                // choosing something it was not given, which is not a case to guess through.
                int[] shared = (peer.group == 29 && peer.value.length() == 32)
                    ? X25519.scalarMult(privateKey, peer.value)
                    : ((peer.group == 23 && peer.value.length() == 65)
                        ? nist.agree(peer.value, 65, nistPrivate)
                        : new int[1]());
                boolean agreed = shared.length() == 32;
                delete peer;
                delete nistPublic;
                delete nistPrivate;
                delete nist;
                delete privateKey;
                delete publicKey;
                if (!agreed) {
                    delete shared;
                    throw new TlsException("the server chose a key exchange this client did not offer")
                        on heap;
                }
                int[] afterHellos = TlsClient.transcriptHash(transcript);
                int[] emptyHash = Sha256.digestRaw(empty, 0);
                int[] early = KeySchedule.earlySecret();
                int[] derived = KeySchedule.expandLabel(early, 32, "derived", emptyHash, 32, 32);
                int[] handshakeSecret = Hkdf.extract(derived, 32, shared, 32);
                int[] clientSecret = KeySchedule.deriveSecret(handshakeSecret, 32,
                                                                     "c hs traffic", afterHellos, 32);
                int[] serverSecret = KeySchedule.deriveSecret(handshakeSecret, 32,
                                                                     "s hs traffic", afterHellos, 32);
                int[] serverKey = KeySchedule.trafficKey(serverSecret, 32);
                int[] serverIv = KeySchedule.trafficIv(serverSecret, 32);
                int[] clientKey = KeySchedule.trafficKey(clientSecret, 32);
                int[] clientIv = KeySchedule.trafficIv(clientSecret, 32);

                // The server's encrypted flight: its certificate, its proof of holding the key, and
                // its Finished.
                ByteWriter flight = new ByteWriter() on heap;
                mutable long sequence = cast<long>(0);
                mutable boolean complete = false;
                while (!complete) {
                    int[] chunk = wire.next();
                    if (chunk.length() <= 1) {
                        throw new TlsException("the connection ended during the handshake") on heap;
                    }
                    if ((chunk[0] & 255) == 20) { delete chunk; continue; }   // ChangeCipherSpec
                    // An alert this early is still in the clear: the server gave up before the keys
                    // it would need to encrypt one. Reported for what it is rather than as a failure
                    // to decrypt, which is what it would look like on the way through Record.open.
                    if ((chunk[0] & 255) == 21) {
                        String why = Alert.explain(chunk);
                        delete chunk;
                        throw new TlsException(why) on heap;
                    }
                    int[] inner = Record.open(serverKey, serverIv, sequence, chunk,
                                                      chunk.length());
                    sequence = sequence + cast<long>(1);
                    delete chunk;
                    if (inner.length() <= 1) {
                        throw new TlsException("a handshake record did not authenticate") on heap;
                    }
                    // The real content type is the last byte inside the encrypted record: an alert
                    // sent after the keys exist arrives disguised as application data, and treating
                    // it as handshake bytes leaves the loop waiting for a Finished that is not
                    // coming -- a refusal that reads as a hang.
                    int innerKind = inner[inner.length() - 1] & 255;
                    if (innerKind == 21) {
                        String why = inner.length() >= 3
                            ? ("the server refused: ".concat(Alert.describe(inner[1] & 255)))
                            : "the server refused, without saying why";
                        delete inner;
                        throw new TlsException(why) on heap;
                    }
                    for (mutable int i = 0; i < inner.length() - 1; i++) { flight.u8(inner[i]); }
                    delete inner;
                    complete = TlsClient.hasFinished(flight);
                }

                int[] messages = flight.toArray();
                int total = flight.length();
                ArrayList<Certificate*> chain = new ArrayList<Certificate*>() on stack;
                mutable boolean finishedOk = false;
                mutable boolean verifiedIdentity = false;
                mutable int at = 0;
                while (at + 4 <= total) {
                    int type = messages[at] & 255;
                    int length = ((messages[at + 1] & 255) << 16) |
                                 ((messages[at + 2] & 255) << 8) | (messages[at + 3] & 255);
                    int whole = 4 + length;
                    if (at + whole > total) { at = total; continue; }

                    if (type == 11) {                            // Certificate
                        TlsClient.readChain(messages, at + 4, length, chain);
                    } else if (type == 15) {                     // CertificateVerify
                        // Hashed BEFORE this message is appended: the signature covers everything up
                        // to and including the certificate, and not itself.
                        int[] upToCertificate = TlsClient.transcriptHash(transcript);
                        verifiedIdentity = TlsClient.checkIdentity(chain, messages, at + 4, length,
                                                                   upToCertificate);
                        delete upToCertificate;
                    } else if (type == 20) {                     // Finished
                        int[] upToHere = TlsClient.transcriptHash(transcript);
                        int[] finishedKey = KeySchedule.expandLabel(serverSecret, 32,
                                                                           "finished", empty, 0, 32);
                        int[] expected = Hmac.sha256Raw(finishedKey, 32, upToHere, 32);
                        finishedOk = TlsClient.sameBytes(expected, messages, at + 4, 32);
                        delete expected;
                        delete finishedKey;
                        delete upToHere;
                    }
                    for (mutable int i = 0; i < whole; i++) { transcript.u8(messages[at + i]); }
                    at = at + whole;
                }
                delete messages;

                // Everything the connection rests on, checked before it is used.
                if (chain.size() == 0) {
                    throw new CertificateException("the server sent no certificate") on heap;
                }
                Instant now = Instant.now();
                CertificateValidator.check(chain, host, trusted, now.toEpochSeconds());
                delete now;
                if (!verifiedIdentity) {
                    throw new TlsException(
                        "the server did not prove it holds the key for the certificate it sent")
                        on heap;
                }
                if (!finishedOk) {
                    throw new TlsException("the server's Finished did not verify") on heap;
                }

                // Our own Finished, then the application keys.
                int[] afterServer = TlsClient.transcriptHash(transcript);
                int[] ourFinishedKey = KeySchedule.expandLabel(clientSecret, 32, "finished",
                                                                      empty, 0, 32);
                int[] ourVerify = Hmac.sha256Raw(ourFinishedKey, 32, afterServer, 32);
                ByteWriter finished = new ByteWriter() on heap;
                finished.u8(20);
                finished.u24(32);
                finished.bytes(ourVerify, 32);
                int[] finishedMessage = finished.toArray();
                int[] changeCipher = new int[1]();
                changeCipher[0] = 1;
                TlsClient.sendPlain(link, 20, 771, changeCipher, 1);
                int[] finishedRecord = Record.seal(clientKey, clientIv, cast<long>(0), 22,
                                                           finishedMessage, finished.length());
                TlsClient.sendRaw(link, finishedRecord, finishedRecord.length());

                int[] zeros = new int[32]();
                int[] masterDerived = KeySchedule.expandLabel(handshakeSecret, 32, "derived",
                                                                     emptyHash, 32, 32);
                int[] master = Hkdf.extract(masterDerived, 32, zeros, 32);
                int[] clientApp = KeySchedule.deriveSecret(master, 32, "c ap traffic",
                                                                  afterServer, 32);
                int[] serverApp = KeySchedule.deriveSecret(master, 32, "s ap traffic",
                                                                  afterServer, 32);
                TlsSession* session = new TlsSession(
                    link, wire.leftover(),
                    KeySchedule.trafficKey(clientApp, 32), KeySchedule.trafficIv(clientApp, 32),
                    KeySchedule.trafficKey(serverApp, 32), KeySchedule.trafficIv(serverApp, 32))
                    on heap;
                return session;
            }

            // ---- the pieces ----

            // The server's proof that it holds the private key for the certificate it sent. The
            // signed content is a fixed prefix, a context string and the transcript hash -- the
            // prefix is there so a signature made for one purpose cannot be replayed as another.
            private static method checkIdentity(ArrayList<Certificate*> chain, int[] messages,
                                                int at, int length, int[] transcriptHash)
                                                returns boolean {
                if (chain.size() == 0 || length < 4) { return false; }
                int scheme = ((messages[at] & 255) << 8) | (messages[at + 1] & 255);
                int sigLength = ((messages[at + 2] & 255) << 8) | (messages[at + 3] & 255);
                int[] signature = Der.copy(messages, at + 4, sigLength);

                ByteWriter signed = new ByteWriter() on stack;
                for (mutable int i = 0; i < 64; i++) { signed.u8(32); }        // 64 spaces
                String context = "TLS 1.3, server CertificateVerify";
                for (mutable int i = 0; i < context.length(); i++) {
                    signed.u8(cast<int>(context.charAt(i)) & 255);
                }
                signed.u8(0);
                signed.bytes(transcriptHash, 32);
                int[] content = signed.toArray();

                // THE SCHEME SAYS WHICH HASH AND WHICH CURVE, and the server picks the scheme from
                // what the ClientHello offered. Every scheme offered there is answered here: an
                // advertised scheme that lands in a final `else` is a server told "I accept this" and
                // then refused for using it, which looks to everyone involved like a broken server.
                Sha* digest = TlsClient.schemeDigest(scheme);
                int[] hash = digest.of(content, signed.length());

                Certificate* leaf = chain.get(0);
                mutable boolean ok = false;
                if (scheme == 1027 || scheme == 1283) {          // ecdsa_secp256r1/384r1
                    nullable Curve* known = Curve.named(scheme == 1027 ? "P-256" : "P-384");
                    if (known != null) {
                        Curve* curve = cast<Curve*>(known);
                        int[] point = leaf.ecPublicKey();
                        if (point.length() == curve.pointBytes()) {
                            ok = curve.verify(point, point.length(), signature, sigLength,
                                              hash, digest.size());
                        }
                        delete point;
                        delete curve;
                    }
                } else {
                    nullable RsaPublicKey* key = leaf.rsaPublicKey();
                    if (key != null) {
                        RsaPublicKey* rsa = cast<RsaPublicKey*>(key);
                        if (scheme == 2052 || scheme == 2053 || scheme == 2054) {   // rsa_pss_rsae
                            ok = Rsa.verifyPss(signature, sigLength, rsa.modulus, rsa.modLength,
                                               rsa.exponent, hash, digest);
                        } else {                                                    // rsa_pkcs1
                            ok = Rsa.verifyPkcs1(signature, sigLength, rsa.modulus, rsa.modLength,
                                                 rsa.exponent, hash, digest.size());
                        }
                        delete rsa;
                    }
                }
                delete hash;
                delete digest;
                delete content;
                delete signature;
                return ok;
            }

            // The digest half of a TLS SignatureScheme (RFC 8446 §4.2.3). The classic schemes are a
            // (hash, signature) pair inherited from TLS 1.2 -- 0x0403 is SHA-256 with ECDSA -- so the
            // hash is the HIGH byte. The PSS schemes are opaque code points 0x0804..0x0806, where the
            // same 4/5/6 sits in the LOW byte instead. Reading the wrong byte picks a wrong digest,
            // and a wrong digest looks exactly like a bad signature.
            private static method schemeDigest(int scheme) returns Sha* {
                int code = (scheme >> 8) == 8 ? (scheme & 255) : (scheme >> 8);
                if (code == 5) { return Sha.sha384(); }
                if (code == 6) { return Sha.sha512(); }
                return Sha.sha256();
            }

            // The certificate list: each entry is a three-byte length, the DER, then its extensions.
            private static method readChain(int[] messages, int at, int length,
                                            ArrayList<Certificate*> into) returns void {
                mutable int p = at;
                int end = at + length;
                if (p >= end) { return; }
                p = p + 1 + (messages[p] & 255);                  // the request context, always empty
                p = p + 3;                                        // the list length
                while (p + 3 <= end) {
                    int certLength = ((messages[p] & 255) << 16) | ((messages[p + 1] & 255) << 8) |
                                     (messages[p + 2] & 255);
                    p = p + 3;
                    if (certLength <= 0 || p + certLength > end) { return; }
                    int[] der = Der.copy(messages, p, certLength);
                    into.add(new Certificate(der, certLength) on heap);
                    p = p + certLength;
                    if (p + 2 > end) { return; }
                    p = p + 2 + (((messages[p] & 255) << 8) | (messages[p + 1] & 255));
                }
                return;
            }

            private static method transcriptHash(ByteWriter w) returns int[] {
                int[] so = w.toArray();
                int[] h = Sha256.digestRaw(so, w.length());
                delete so;
                return h;
            }
            private static method sameBytes(int[] a, int[] b, int at, int n) returns boolean {
                mutable boolean same = true;
                for (mutable int i = 0; i < n; i++) {
                    if ((a[i] & 255) != (b[at + i] & 255)) { same = false; }
                }
                return same;
            }
            // A complete Finished somewhere in the buffered flight.
            private static method hasFinished(ByteWriter w) returns boolean {
                int[] b = w.toArray();
                int n = w.length();
                mutable int at = 0;
                mutable boolean found = false;
                while (at + 4 <= n) {
                    int length = ((b[at + 1] & 255) << 16) | ((b[at + 2] & 255) << 8) |
                                 (b[at + 3] & 255);
                    if (at + 4 + length > n) { at = n; }
                    else {
                        if ((b[at] & 255) == 20) { found = true; }
                        at = at + 4 + length;
                    }
                }
                delete b;
                return found;
            }
            // WHICH GROUP THE SERVER PICKED, together with its public value. The group used to be
            // skipped over and only the bytes returned, which worked exactly as long as one group was
            // offered: 32 bytes could be an x25519 point or a truncated P-256 one, and a client that
            // guesses from the length agrees a key with nobody but itself.
            private static method serverKeyShare(int[] wire) returns KeyShare* {
                mutable int p = 5 + 4 + 2 + 32;
                if (p >= wire.length()) { return new KeyShare(0, new int[1]()) on heap; }
                p = p + 1 + (wire[p] & 255);                      // the echoed session id
                p = p + 2 + 1;                                    // cipher suite, compression
                if (p + 2 > wire.length()) { return new KeyShare(0, new int[1]()) on heap; }
                int extensionsLength = ((wire[p] & 255) << 8) | (wire[p + 1] & 255);
                p = p + 2;
                int end = p + extensionsLength;
                while (p + 4 <= end && p + 4 <= wire.length()) {
                    int type = ((wire[p] & 255) << 8) | (wire[p + 1] & 255);
                    int length = ((wire[p + 2] & 255) << 8) | (wire[p + 3] & 255);
                    if (type == 51) {                             // key_share
                        int group = ((wire[p + 4] & 255) << 8) | (wire[p + 5] & 255);
                        int keyLength = ((wire[p + 6] & 255) << 8) | (wire[p + 7] & 255);
                        if (p + 8 + keyLength > wire.length()) {
                            return new KeyShare(0, new int[1]()) on heap;
                        }
                        return new KeyShare(group, Der.copy(wire, p + 8, keyLength)) on heap;
                    }
                    p = p + 4 + length;
                }
                return new KeyShare(0, new int[1]()) on heap;
            }
            private static method sendPlain(Socket link, int type, int version, int[] body, int n)
                                            returns void {
                StringBuilder out = new StringBuilder() on stack;
                out.appendChar(cast<char>(type));
                out.appendChar(cast<char>((version >> 8) & 255));
                out.appendChar(cast<char>(version & 255));
                out.appendChar(cast<char>((n >> 8) & 255));
                out.appendChar(cast<char>(n & 255));
                for (mutable int i = 0; i < n; i++) { out.appendChar(cast<char>(body[i] & 255)); }
                link.send(out.toString());
                return;
            }
            private static method sendRaw(Socket link, int[] data, int n) returns void {
                StringBuilder out = new StringBuilder() on stack;
                for (mutable int i = 0; i < n; i++) { out.appendChar(cast<char>(data[i] & 255)); }
                link.send(out.toString());
                return;
            }
        }

        // Thrown when the handshake itself goes wrong -- as distinct from a certificate that does not
        // check out, which is `CertificateException`. Two exceptions because the answers differ: one
        // means the other end is not speaking the protocol, the other means it is speaking it and
        // lying.
        public class TlsException extends Exception {
            private mutable String detail;
            public constructor TlsException(String detail) { this.detail = detail; }
            public override method message() returns String {
                return "TLS handshake failed: ".concat(this.detail);
            }
        }

        // AN ESTABLISHED CONNECTION: application data in and out, each record sealed under the
        // traffic keys and numbered.
        //
        // The sequence numbers are the reason this is a class and not a pair of functions. Every
        // record's nonce is derived from a counter that neither side transmits, so the two ends stay
        // in step only by both counting correctly -- and a counter that lives in a local variable is
        // a counter somebody eventually forgets to advance.
        public class TlsSession {
            private mutable Socket link;
            private mutable String pending;          // bytes read from the socket, not yet a record
            private mutable int[] sendKey;
            private mutable int[] sendIv;
            private mutable int[] receiveKey;
            private mutable int[] receiveIv;
            private mutable long sendSequence;
            private mutable long receiveSequence;
            private mutable boolean open;

            public constructor TlsSession(Socket link, String pending, int[] sendKey, int[] sendIv,
                                          int[] receiveKey, int[] receiveIv) {
                this.link = link;
                this.pending = pending;
                this.sendKey = sendKey;
                this.sendIv = sendIv;
                this.receiveKey = receiveKey;
                this.receiveIv = receiveIv;
                this.sendSequence = cast<long>(0);
                this.receiveSequence = cast<long>(0);
                this.open = true;
            }

            public method isOpen() returns boolean { return this.open; }

            public method send(String text) returns void {
                int[] data = new int[text.length() > 0 ? text.length() : 1]();
                for (mutable int i = 0; i < text.length(); i++) {
                    data[i] = cast<int>(text.charAt(i)) & 255;
                }
                // `framed` and not `record`, which is reserved.
                int[] framed = Record.seal(this.sendKey, this.sendIv, this.sendSequence, 23,
                                                   data, text.length());
                this.sendSequence = this.sendSequence + cast<long>(1);
                StringBuilder out = new StringBuilder() on stack;
                for (mutable int i = 0; i < framed.length(); i++) {
                    out.appendChar(cast<char>(framed[i] & 255));
                }
                this.link.send(out.toString());
                delete framed;
                delete data;
                return;
            }

            // The next chunk of application data, or "" at the end of the stream. A record that fails
            // to authenticate ends the session rather than being skipped: after a forged record there
            // is no way to know where the stream really is.
            public method receive() returns String {
                while (this.open) {
                    int[] wire = this.nextRecord();
                    if (wire.length() <= 1) {
                        this.open = false;
                        delete wire;
                        return "";
                    }
                    int type = wire[0] & 255;
                    if (type == 20) { delete wire; continue; }      // ChangeCipherSpec, ignored
                    int[] inner = Record.open(this.receiveKey, this.receiveIv,
                                                      this.receiveSequence, wire, wire.length());
                    this.receiveSequence = this.receiveSequence + cast<long>(1);
                    delete wire;
                    if (inner.length() <= 1) {
                        this.open = false;                          // forged or truncated
                        delete inner;
                        return "";
                    }
                    int contentType = inner[inner.length() - 1] & 255;
                    if (contentType == 23) {                        // application_data
                        StringBuilder text = new StringBuilder() on heap;
                        for (mutable int i = 0; i < inner.length() - 1; i++) {
                            text.appendChar(cast<char>(inner[i] & 255));
                        }
                        delete inner;
                        return text.toString();
                    }
                    if (contentType == 21) {                        // an alert: the peer is closing
                        this.open = false;
                        delete inner;
                        return "";
                    }
                    delete inner;                                   // session tickets and the like
                }
                return "";
            }

            // One whole record off the socket: the five-byte header says how much more to wait for.
            private method nextRecord() returns int[] {
                while (this.pending.length() < 5) {
                    String more = this.link.receive(16384);
                    if (more.length() == 0) { return new int[1](); }
                    this.pending = this.pending.concat(more);
                }
                int total = 5 + (((cast<int>(this.pending.charAt(3)) & 255) << 8) |
                                 (cast<int>(this.pending.charAt(4)) & 255));
                while (this.pending.length() < total) {
                    String more = this.link.receive(16384);
                    if (more.length() == 0) { return new int[1](); }
                    this.pending = this.pending.concat(more);
                }
                int[] out = new int[total]();
                for (mutable int i = 0; i < total; i++) {
                    out[i] = cast<int>(this.pending.charAt(i)) & 255;
                }
                this.pending = this.pending.substring(total, this.pending.length());
                return out;
            }

            public method close() returns void {
                if (this.open) {
                    this.open = false;
                    this.link.close();
                }
                return;
            }
            public destructor ~TlsSession() returns void {
                delete this.receiveIv;
                delete this.receiveKey;
                delete this.sendIv;
                delete this.sendKey;
            }
        }

        // A GROWABLE BUFFER FOR WIRE FORMATS: append big-endian integers or raw bytes, and go back to
        // fill in a length once its content is known.
        //
        // That last part is why this exists rather than a StringBuilder. TLS is length-prefixed
        // everywhere, and the length of a field is not known until the field has been written -- so
        // either the caller counts everything twice, or it leaves a hole and patches it. Counting
        // twice is how the two counts end up disagreeing.
        public class ByteWriter {
            private mutable int[] buffer;
            private mutable int used;

            public constructor ByteWriter() {
                this.buffer = new int[64]();
                this.used = 0;
            }
            public method u8(int v) returns void {
                this.ensure(1);
                this.buffer[this.used] = v & 255;
                this.used = this.used + 1;
                return;
            }
            public method u16(int v) returns void {
                this.u8((v >> 8) & 255);
                this.u8(v & 255);
                return;
            }
            public method u24(int v) returns void {
                this.u8((v >> 16) & 255);
                this.u8((v >> 8) & 255);
                this.u8(v & 255);
                return;
            }
            public method bytes(int[] source, int n) returns void {
                this.ensure(n);
                for (mutable int i = 0; i < n; i++) {
                    this.buffer[this.used + i] = source[i] & 255;
                }
                this.used = this.used + n;
                return;
            }
            // Where the next byte will go -- captured to remember where a placeholder length sits.
            public method position() returns int { return this.used; }
            public method patchU16(int at, int v) returns void {
                this.buffer[at] = (v >> 8) & 255;
                this.buffer[at + 1] = v & 255;
                return;
            }
            public method patchU24(int at, int v) returns void {
                this.buffer[at] = (v >> 16) & 255;
                this.buffer[at + 1] = (v >> 8) & 255;
                this.buffer[at + 2] = v & 255;
                return;
            }
            public method length() returns int { return this.used; }
            public method toArray() returns int[] {
                int[] out = new int[this.used > 0 ? this.used : 1]();
                for (mutable int i = 0; i < this.used; i++) { out[i] = this.buffer[i]; }
                return out;
            }
            [Allow(code: "Polaron-0B28", why: "the wire buffer a handshake is assembled in: it IS the growable byte store, and a record is measured in bytes rather than in elements of a list")]
            private method ensure(int extra) returns void {
                if (this.used + extra <= this.buffer.length()) { return; }
                mutable int capacity = this.buffer.length();
                while (capacity < this.used + extra) { capacity = capacity * 2; }
                int[] bigger = new int[capacity]();
                for (mutable int i = 0; i < this.used; i++) { bigger[i] = this.buffer[i]; }
                delete this.buffer;
                this.buffer = bigger;
                return;
            }
            public destructor ~ByteWriter() returns void {
                delete this.buffer;
            }
        }

        // THE FIRST MESSAGE (RFC 8446 §4.1.2): what this client offers.
        //
        // A ClientHello is a list of everything the client can do, and what it leaves out is as much
        // a decision as what it puts in. This one offers x25519 for the key exchange and
        // AES-128-GCM-SHA256 for the records -- both of which the code above actually implements --
        // and a signature-algorithm list that includes the RSA and ECDSA variants the certificate
        // reader can check.
        //
        // The SERVER NAME is in here, and it has to be: one address serves many sites, so without it
        // the server cannot know which certificate to present, and a client would then be validating
        // a name against a certificate chosen for somebody else.
        public class ClientHello {
            public static method build(String host, int[] random, int[] sessionId, int sessionLength,
                                       int[] montgomeryKey, int[] nistKey) returns int[] {
                ByteWriter w = new ByteWriter() on stack;
                w.u8(1);                                      // handshake type: client_hello
                int lengthAt = w.position();
                w.u24(0);                                     // patched once the body is written
                int bodyStart = w.position();
                w.u16(771);                                   // the legacy version field, always 1.2
                w.bytes(random, 32);
                w.u8(sessionLength);
                if (sessionLength > 0) { w.bytes(sessionId, sessionLength); }
                w.u16(6);                                     // three cipher suites
                w.u16(4865);                                  // TLS_AES_128_GCM_SHA256 -- implemented
                w.u16(4867);                                  // ChaCha20-Poly1305, offered for reach
                w.u16(4866);                                  // AES-256-GCM-SHA384
                w.u8(1); w.u8(0);                             // no compression, ever
                int extensionsAt = w.position();
                w.u16(0);
                int extensionsStart = w.position();

                // server_name: which site is being asked for.
                int nameLength = host.length();
                w.u16(0);
                w.u16(5 + nameLength);
                w.u16(3 + nameLength);
                w.u8(0);
                w.u16(nameLength);
                for (mutable int i = 0; i < nameLength; i++) {
                    w.u8(cast<int>(host.charAt(i)) & 255);
                }
                w.u16(65281); w.u16(1); w.u8(0);              // renegotiation_info, empty
                // EXACTLY THE GROUPS THIS CLIENT CAN DO, with a key ready for each. The list used to
                // name nine and carry a key for one, which asks for two different failures: a server
                // preferring a group we cannot do, and a server picking a group we offered but sent
                // no key for -- the second answers with a HelloRetryRequest that this client does not
                // handle. Sending both keys costs 65 bytes and removes the round trip entirely.
                //
                // BOTH, and not just x25519: RFC 8446 makes secp256r1 the group a compliant
                // implementation MUST support and x25519 only a SHOULD, so a client that speaks one
                // curve is betting on a preference rather than on the standard.
                // THE TWO LISTS MUST AGREE. Every group a key_share carries has to appear here as
                // well; sending a share for a group left out of this list is a malformed ClientHello,
                // and github.com answers it with `illegal parameter` while google.com lets it pass --
                // which is exactly the sort of disagreement that makes a bug look like one server's
                // fault.
                w.u16(10);                                    // supported_groups
                w.u16(6); w.u16(4);
                w.u16(29);                                    // x25519, preferred
                w.u16(23);                                    // secp256r1
                w.u16(35); w.u16(0);                          // session_ticket, empty
                w.u16(51);                                    // key_share
                w.u16(107); w.u16(105);
                w.u16(29); w.u16(32);
                w.bytes(montgomeryKey, 32);
                w.u16(23); w.u16(65);
                w.bytes(nistKey, 65);
                w.u16(43); w.u16(3); w.u8(2); w.u16(772);     // supported_versions: TLS 1.3 only
                // EXACTLY THE SCHEMES THIS CLIENT CAN VERIFY, and no more. This list is a promise:
                // the server picks one from it and signs with that, so a scheme offered and not
                // implemented is a handshake that fails at CertificateVerify -- and fails looking
                // like the server's fault. The list used to carry fifteen, including SHA-1, DSA and
                // P-521, none of which are checked anywhere below.
                w.u16(13);                                    // signature_algorithms
                w.u16(18); w.u16(16);
                w.u16(1027); w.u16(1283);                     // ecdsa over P-256 and P-384
                w.u16(2052); w.u16(2053); w.u16(2054);        // rsa_pss_rsae, SHA-256/384/512
                w.u16(1025); w.u16(1281); w.u16(1537);        // rsa_pkcs1, SHA-256/384/512
                w.u16(45); w.u16(2); w.u8(1); w.u8(1);        // psk_key_exchange_modes
                w.u16(28); w.u16(2); w.u16(16385);            // record_size_limit
                int end = w.position();
                w.patchU16(extensionsAt, end - extensionsStart);
                w.patchU24(lengthAt, end - bodyStart);
                int[] out = w.toArray();
                return out;
            }
        }

        // THE TLS 1.3 RECORD LAYER (RFC 8446 §5): how bytes actually cross the wire.
        //
        // Everything after the first two messages travels as a record: a five-byte header, then an
        // AEAD-sealed body. Three details in that sentence are load-bearing, and each of them is a
        // known attack when it is got wrong.
        //
        // THE REAL CONTENT TYPE IS INSIDE the encryption, not in the header -- the header always
        // claims `application_data`. That is what stops an observer telling a handshake message from
        // a request by looking at the outside.
        //
        // THE NONCE IS DERIVED, NEVER SENT: the static IV exclusive-ORed with the record's sequence
        // number. Two records under one key must never share a nonce -- with GCM that recovers the
        // authentication key outright -- and deriving it from a counter neither side transmits means
        // there is nothing for an attacker to replay or reorder.
        //
        // THE HEADER IS THE ASSOCIATED DATA, so the declared length is covered by the tag. Otherwise
        // it could be altered to make the receiver read a different number of bytes.
        public class Record {
            // Seal `content` of the given type into a complete record, ready to write to the socket.
            public static method seal(int[] key, int[] staticIv, long sequence, int contentType,
                                      int[] content, int contentLength) returns int[] {
                int innerLength = contentLength + 1;             // content || its real type
                int[] inner = new int[innerLength]();
                for (mutable int i = 0; i < contentLength; i++) { inner[i] = content[i] & 255; }
                inner[contentLength] = contentType & 255;
                int encryptedLength = innerLength + 16;          // the tag
                int[] header = Record.header(encryptedLength);
                int[] nonce = Record.nonce(staticIv, sequence);
                int[] body = Gcm.seal(key, nonce, header, 5, inner, innerLength);
                int[] out = new int[5 + encryptedLength]();
                for (mutable int i = 0; i < 5; i++) { out[i] = header[i]; }
                for (mutable int i = 0; i < encryptedLength; i++) { out[5 + i] = body[i] & 255; }
                delete body;
                delete nonce;
                delete header;
                delete inner;
                return out;
            }

            // The inner plaintext -- content followed by its real type -- or an EMPTY array when the
            // record does not authenticate. Empty means forged; it does not mean the peer sent
            // nothing, and a caller that confuses the two has discarded the guarantee.
            public static method open(int[] key, int[] staticIv, long sequence, int[] wire,
                                      int wireLength) returns int[] {
                if (wireLength < 6) { return new int[1](); }
                int encryptedLength = ((wire[3] & 255) << 8) | (wire[4] & 255);
                if (5 + encryptedLength > wireLength) { return new int[1](); }
                int[] header = new int[5]();
                for (mutable int i = 0; i < 5; i++) { header[i] = wire[i] & 255; }
                int[] body = new int[encryptedLength]();
                for (mutable int i = 0; i < encryptedLength; i++) { body[i] = wire[5 + i] & 255; }
                int[] nonce = Record.nonce(staticIv, sequence);
                int[] inner = Gcm.open(key, nonce, header, 5, body, encryptedLength);
                delete nonce;
                delete body;
                delete header;
                if (inner.length() <= 1) { return inner; }
                // Trailing zeros are padding the sender may add to hide the true length; the last
                // non-zero byte is the content type.
                mutable int last = inner.length() - 1;
                while (last >= 0 && (inner[last] & 255) == 0) { last = last - 1; }
                int outLength = last + 1;
                int[] out = new int[outLength > 0 ? outLength : 1]();
                for (mutable int i = 0; i < outLength; i++) { out[i] = inner[i] & 255; }
                delete inner;
                return out;
            }

            // The static IV with its low eight bytes exclusive-ORed with the sequence number.
            public static method nonce(int[] staticIv, long sequence) returns int[] {
                int[] n = new int[12]();
                for (mutable int i = 0; i < 12; i++) { n[i] = staticIv[i] & 255; }
                for (mutable int j = 0; j < 8; j++) {
                    int b = cast<int>((sequence >> ((7 - j) * 8)) & cast<long>(255));
                    n[4 + j] = (n[4 + j] ^ b) & 255;
                }
                return n;
            }
            private static method header(int encryptedLength) returns int[] {
                int[] h = new int[5]();
                h[0] = 23;                                       // always application_data
                h[1] = 3; h[2] = 3;                              // the legacy version field
                h[3] = (encryptedLength >> 8) & 255;
                h[4] = encryptedLength & 255;
                return h;
            }
        }

        // AES-128-GCM (NIST SP 800-38D): the authenticated encryption that protects every TLS 1.3
        // record.
        //
        // Two halves that must both hold. Counter mode gives secrecy -- the key stream is AES applied
        // to a counter, XORed with the data. GHASH gives authenticity -- a multiplication in
        // GF(2^128) over the ciphertext and the associated data, which produces a tag nobody without
        // the key can forge.
        //
        // THE TAG IS CHECKED BEFORE THE PLAINTEXT IS PRODUCED, and that order is the whole point.
        // Decrypting first and verifying after means a program can act on bytes an attacker chose;
        // that is the shape of a padding-oracle attack. `open` answers with an empty array on a bad
        // tag, and a caller that treats an empty result as "no data" instead of "forged" has thrown
        // the guarantee away.
        //
        // 96-bit nonces only, which is what TLS uses and the only size with a defined construction.
        public class Gcm {
            // Ciphertext followed by the 16-byte tag.
            public static method seal(int[] key, int[] iv, int[] aad, int aadLength,
                                      int[] plain, int plainLength) returns int[] {
                Aes aes = new Aes(key) on stack;
                int[] zero = new int[16]();
                int[] h = aes.encryptBlock(zero);         // the hash subkey, E(0)
                delete zero;
                int[] j0 = new int[16]();
                for (mutable int i = 0; i < 12; i++) { j0[i] = iv[i] & 255; }
                j0[15] = 1;                                       // J0 = nonce || 1
                int[] out = new int[plainLength + 16]();
                int[] counter = Gcm.copyBlock(j0);
                Gcm.increment(counter);
                mutable int off = 0;
                while (off < plainLength) {
                    int[] stream = aes.encryptBlock(counter);
                    mutable int b = 0;
                    while (b < 16 && off + b < plainLength) {
                        out[off + b] = (plain[off + b] ^ stream[b]) & 255;
                        b = b + 1;
                    }
                    delete stream;
                    Gcm.increment(counter);
                    off = off + 16;
                }
                delete counter;
                int[] s = Gcm.ghash(h, aad, aadLength, out, plainLength);
                int[] mask = aes.encryptBlock(j0);
                for (mutable int i = 0; i < 16; i++) {
                    out[plainLength + i] = (mask[i] ^ s[i]) & 255;
                }
                delete mask;
                delete s;
                delete h;
                delete j0;
                return out;
            }

            // The plaintext when the tag authenticates, and an EMPTY ARRAY when it does not. An empty
            // answer means forged, not "nothing was sent" -- every caller has to tell those apart.
            public static method open(int[] key, int[] iv, int[] aad, int aadLength,
                                      int[] protectedBytes, int totalLength) returns int[] {
                int cipherLength = totalLength - 16;
                if (cipherLength < 0) { return new int[1](); }
                Aes aes = new Aes(key) on stack;
                int[] zero = new int[16]();
                int[] h = aes.encryptBlock(zero);
                delete zero;
                int[] j0 = new int[16]();
                // Both ways out of this method free these two, and the refusal path is the one it
                // would be quietly wrong to forget.
                defer { delete h; delete j0; }
                for (mutable int i = 0; i < 12; i++) { j0[i] = iv[i] & 255; }
                j0[15] = 1;
                int[] s = Gcm.ghash(h, aad, aadLength, protectedBytes, cipherLength);
                int[] mask = aes.encryptBlock(j0);
                mutable boolean authentic = true;
                for (mutable int i = 0; i < 16; i++) {
                    if (((mask[i] ^ s[i]) & 255) != (protectedBytes[cipherLength + i] & 255)) {
                        authentic = false;
                    }
                }
                delete mask;
                delete s;
                if (!authentic) {
                    return new int[1]();        // refused: the caller must not read past this
                }
                int[] plain = new int[cipherLength > 0 ? cipherLength : 1]();
                int[] counter = Gcm.copyBlock(j0);
                Gcm.increment(counter);
                mutable int off = 0;
                while (off < cipherLength) {
                    int[] stream = aes.encryptBlock(counter);
                    mutable int b = 0;
                    while (b < 16 && off + b < cipherLength) {
                        plain[off + b] = (protectedBytes[off + b] ^ stream[b]) & 255;
                        b = b + 1;
                    }
                    delete stream;
                    Gcm.increment(counter);
                    off = off + 16;
                }
                delete counter;
                return plain;
            }

            private static method copyBlock(int[] a) returns int[] {
                int[] b = new int[16]();
                for (mutable int i = 0; i < 16; i++) { b[i] = a[i]; }
                return b;
            }
            // The rightmost 32 bits, modulo 2^32 -- the counter wraps rather than growing into the
            // nonce, which is what keeps the nonce fixed for the record.
            private static method increment(int[] counter) returns void {
                mutable int i = 15;
                mutable int carry = 1;
                while (i >= 12 && carry > 0) {
                    int v = counter[i] + carry;
                    counter[i] = v & 255;
                    carry = (v >> 8) & 255;
                    i = i - 1;
                }
                return;
            }
            // Multiplication in GF(2^128), big-endian bit order, reducing by the GCM polynomial.
            private static method multiply(int[] x, int[] y) returns int[] {
                int[] z = new int[16]();
                int[] v = Gcm.copyBlock(y);
                mutable int i = 0;
                while (i < 128) {
                    if (((x[i / 8] >> (7 - (i % 8))) & 1) == 1) {
                        for (mutable int k = 0; k < 16; k++) { z[k] = (z[k] ^ v[k]) & 255; }
                    }
                    int low = v[15] & 1;
                    mutable int carry = 0;
                    for (mutable int m = 0; m < 16; m++) {
                        int b = v[m];
                        v[m] = ((b >> 1) | (carry << 7)) & 255;
                        carry = b & 1;
                    }
                    if (low == 1) { v[0] = (v[0] ^ 225) & 255; }   // the reduction polynomial
                    i = i + 1;
                }
                delete v;
                return z;
            }
            // GHASH over the associated data, then the ciphertext, then their bit lengths. Including
            // the lengths is what stops an attacker moving bytes between the two.
            private static method ghash(int[] h, int[] aad, int aadLength, int[] c, int cLength)
                                        returns int[] {
                mutable int[] y = new int[16]();
                y = Gcm.absorb(y, h, aad, aadLength);
                y = Gcm.absorb(y, h, c, cLength);
                int[] lengths = new int[16]();
                int aadBits = aadLength * 8;
                int cBits = cLength * 8;
                lengths[4] = (aadBits >> 24) & 255;  lengths[5] = (aadBits >> 16) & 255;
                lengths[6] = (aadBits >> 8) & 255;   lengths[7] = aadBits & 255;
                lengths[12] = (cBits >> 24) & 255;   lengths[13] = (cBits >> 16) & 255;
                lengths[14] = (cBits >> 8) & 255;    lengths[15] = cBits & 255;
                for (mutable int k = 0; k < 16; k++) { y[k] = (y[k] ^ lengths[k]) & 255; }
                delete lengths;
                int[] result = Gcm.multiply(y, h);
                delete y;
                return result;
            }
            private static method absorb(int[] accumulator, int[] h, int[] data, int len)
                                         returns int[] {
                mutable int[] y = accumulator;
                mutable int off = 0;
                while (off < len) {
                    mutable int k = 0;
                    while (k < 16 && off + k < len) {
                        y[k] = (y[k] ^ data[off + k]) & 255;
                        k = k + 1;
                    }
                    int[] next = Gcm.multiply(y, h);
                    delete y;
                    y = next;
                    off = off + 16;
                }
                return y;
            }
        }

        // X25519 (RFC 7748): Diffie-Hellman on Curve25519, and the key exchange every TLS 1.3
        // handshake in practice uses.
        //
        // The Montgomery ladder walks the scalar's bits and does the same work whichever way each
        // bit goes -- the conditional swap exchanges two pairs rather than branching to different
        // code. That is what makes the shape constant-time; this implementation is NOT constant-time
        // in its arithmetic, and that difference matters here in a way it did not for signature
        // verification: the scalar is a PRIVATE key. It is stated rather than hidden, and it is the
        // first thing to fix if this is ever used where an attacker can time it.
        //
        // Written on the same Montgomery arithmetic as the curve above rather than on BigInteger: the
        // ladder is 255 steps of several modular multiplications each, which on decimal digits
        // measured about a quarter of a second per handshake.
        public class X25519 {
            // p = 2^255 - 19.
            private static method fieldPrime() returns long[] {
                long[] p = U256.zero();
                p[0] = cast<long>(65517);                       // 0xffed
                for (mutable int i = 1; i < 15; i++) { p[i] = cast<long>(65535); }
                p[15] = cast<long>(32767);                      // 0x7fff
                return p;
            }

            // The shared u-coordinate from a 32-byte scalar and a 32-byte peer u-coordinate.
            public static method scalarMult(int[] scalar, int[] peer) returns int[] {
                long[] p = X25519.fieldPrime();
                Mont f = new Mont(p) on stack;

                // Clamping (RFC 7748): the low three bits cleared so the scalar is a multiple of the
                // cofactor, the top bit cleared and the next set so every scalar has the same length.
                // Skipping it is the classic small-subgroup mistake.
                int[] e = new int[32]();
                for (mutable int i = 0; i < 32; i++) { e[i] = scalar[i] & 255; }
                e[0] = e[0] & 248;
                e[31] = (e[31] & 127) | 64;

                int[] u = new int[32]();
                for (mutable int i = 0; i < 32; i++) { u[i] = peer[i] & 255; }
                u[31] = u[31] & 127;                            // the top bit is not part of u
                long[] x1 = f.toMont(U256.fromBytesLe(u, 0, 32));

                long[] one = U256.zero();
                one[0] = cast<long>(1);
                mutable long[] x2 = f.toMont(one);
                mutable long[] z2 = U256.zero();        // zero is zero in Montgomery form too
                mutable long[] x3 = U256.copy(x1);
                mutable long[] z3 = f.toMont(one);
                long[] a24 = U256.zero();
                a24[0] = cast<long>(121665);
                long[] a24m = f.toMont(a24);

                mutable int swap = 0;
                mutable int t = 254;
                while (t >= 0) {
                    int bit = (e[t / 8] >> (t % 8)) & 1;
                    if ((swap ^ bit) == 1) {
                        long[] tx = x2; x2 = x3; x3 = tx;
                        long[] tz = z2; z2 = z3; z3 = tz;
                    }
                    swap = bit;
                    long[] a = f.addMod(x2, z2);
                    long[] aa = f.mul(a, a);
                    long[] b = f.subMod(x2, z2);
                    long[] bb = f.mul(b, b);
                    long[] ee = f.subMod(aa, bb);
                    long[] c = f.addMod(x3, z3);
                    long[] d = f.subMod(x3, z3);
                    long[] da = f.mul(d, a);
                    long[] cb = f.mul(c, b);
                    long[] sum = f.addMod(da, cb);
                    x3 = f.mul(sum, sum);
                    long[] difference = f.subMod(da, cb);
                    long[] dsq = f.mul(difference, difference);
                    z3 = f.mul(x1, dsq);
                    x2 = f.mul(aa, bb);
                    long[] scaled = f.mul(a24m, ee);
                    z2 = f.mul(ee, f.addMod(aa, scaled));
                    t = t - 1;
                }
                if (swap == 1) {
                    long[] tx = x2; x2 = x3; x3 = tx;
                    long[] tz = z2; z2 = z3; z3 = tz;
                }
                long[] zinv = f.invMont(z2);
                long[] result = f.fromMont(f.mul(x2, zinv));
                int[] out = U256.toBytesLe(result);
                return out;
            }

            // The public value for a private scalar: the ladder applied to the curve's base point,
            // whose u-coordinate is simply 9.
            public static method publicKey(int[] scalar) returns int[] {
                int[] base = new int[32]();
                base[0] = 9;
                int[] out = X25519.scalarMult(scalar, base);
                delete base;
                return out;
            }
        }

        // A POINT ON A PRIME CURVE, in Jacobian coordinates.
        //
        // Affine (x, y) is what a key is written as, and it is the wrong thing to compute with:
        // adding two affine points needs a modular INVERSION, which costs about as much as 250
        // multiplications. Jacobian coordinates carry a third number and represent the affine point
        // (X/Z², Y/Z³), which lets addition and doubling be pure multiplication -- one inversion at
        // the very end converts back.
        //
        // Every coordinate is in Montgomery form. Mixing forms is the kind of mistake that produces a
        // point that is simply wrong rather than an error, so they never leave it until `toAffineX`.
        public class EcPoint {
            public mutable long[] x;
            public mutable long[] y;
            public mutable long[] z;
            public boolean infinite;   // the identity: no affine coordinates at all

            public constructor EcPoint(long[] x, long[] y, long[] z, boolean infinite) {
                this.x = x;
                this.y = y;
                this.z = z;
                this.infinite = infinite;
            }
            public destructor ~EcPoint() returns void {
                delete this.z;
                delete this.y;
                delete this.x;
            }
        }

        // A NIST PRIME CURVE, and ECDSA verification over it.
        //
        // This is the second half of what makes a TLS certificate chain checkable. RSA alone is not
        // enough: the certificates most of the internet presents today are ECDSA, so a client that
        // verifies only RSA signatures refuses the servers people actually use, or -- worse -- has to
        // treat "I cannot check this" as "this checks out".
        //
        // A CURVE IS AN OBJECT, not a class full of statics. It began as the second: a `P256` class
        // whose constants were static methods and whose arithmetic assumed 256 bits everywhere -- and
        // that shape was itself the reason a P-384 chain could not be checked. Reaching a real server
        // showed it immediately: cloudflare's intermediate is on P-384, so `example.com` was refused
        // by our own gap and not by anything wrong with the certificate. The curve's parameters are
        // parameters; making them fields is what lets one piece of arithmetic answer for both.
        //
        // Both curves here have a = -3, which is why `twice` can use the shortcut below for either.
        //
        // Verification only. Signing touches a private key and would need constant-time code; nothing
        // here is constant-time, because everything it touches is public.
        public class Curve {
            private mutable String curveName;
            private mutable long[] prime;
            private mutable long[] order;
            private mutable long[] bValue;
            private mutable long[] gx;
            private mutable long[] gy;
            private mutable unique Mont* fp;   // arithmetic modulo the field prime: coordinates
            private mutable unique Mont* fn;   // arithmetic modulo the group order: scalars
            private mutable int size;      // bytes per coordinate: 32 for P-256, 48 for P-384
            private mutable int limbs;

            public constructor Curve(String curveName, String primeHex, String orderHex, String bHex,
                                     String gxHex, String gyHex, int size) {
                this.curveName = curveName;
                this.size = size;
                this.limbs = U256.limbsForBytes(size);
                this.prime = U256.fromHex(primeHex);
                this.order = U256.fromHex(orderHex);
                this.bValue = U256.fromHex(bHex);
                this.gx = U256.fromHex(gxHex);
                this.gy = U256.fromHex(gyHex);
                this.fp = new Mont(this.prime) on heap;
                this.fn = new Mont(this.order) on heap;
            }
            public destructor ~Curve() returns void {
                delete this.fn;
                delete this.fp;
                delete this.gy;
                delete this.gx;
                delete this.bValue;
                delete this.order;
                delete this.prime;
            }

            // The published constants, verbatim from FIPS 186-4. Hex because that is how they are
            // published: a constant transcribed into limbs by hand is a constant nobody can check
            // against the standard without doing the transcription again.
            public static method p256() returns Curve* {
                return new Curve("P-256",
                    "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
                    "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
                    "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
                    "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
                    "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
                    32) on heap;
            }
            public static method p384() returns Curve* {
                return new Curve("P-384",
                    "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe"
                        .concat("ffffffff0000000000000000ffffffff"),
                    "ffffffffffffffffffffffffffffffffffffffffffffffff"
                        .concat("c7634d81f4372ddf581a0db248b0a77aecec196accc52973"),
                    "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe814112"
                        .concat("0314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"),
                    "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b98"
                        .concat("59f741e082542a385502f25dbf55296c3a545e3872760ab7"),
                    "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147c"
                        .concat("e9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"),
                    48) on heap;
            }
            // The curve a certificate's key names, or null when this program cannot do that curve.
            // Null and not an exception: the caller's next move is to SAY which curve it was, and an
            // exception carrying that would be caught only to be turned back into the same sentence.
            public static method named(String which) returns nullable Curve* {
                if (which.equals("P-256")) { return Curve.p256(); }
                if (which.equals("P-384")) { return Curve.p384(); }
                return null;
            }

            public method name() returns String { return this.curveName; }
            public method coordinateBytes() returns int { return this.size; }
            public method pointBytes() returns int { return 1 + this.size * 2; }

            // The identity element. Represented by a flag rather than by z = 0, because every formula
            // below would otherwise have to notice that z is zero and none of them naturally does.
            public method infinity() returns EcPoint* {
                return new EcPoint(U256.zeroOf(this.limbs), U256.zeroOf(this.limbs),
                                   U256.zeroOf(this.limbs), true) on heap;
            }

            // An affine point (x, y) entering the computation: z = 1.
            public method fromAffine(long[] x, long[] y) returns EcPoint* {
                long[] one = this.oneRaw();
                long[] zm = this.fp.toMont(one);
                delete one;
                return new EcPoint(this.fp.toMont(x), this.fp.toMont(y), zm, false) on heap;
            }
            private method oneRaw() returns long[] {
                long[] one = U256.zeroOf(this.limbs);
                one[0] = cast<long>(1);
                return one;
            }

            // Is this point actually ON the curve: y² = x³ - 3x + b. A public key that is not on the
            // curve is the invalid-curve attack, and the check costs four multiplications -- cheap
            // enough that skipping it would be a decision, and the wrong one.
            public method isOnCurve(long[] xm, long[] ym) returns boolean {
                long[] bm = this.fp.toMont(this.bValue);
                long[] left = this.fp.mul(ym, ym);
                long[] x2 = this.fp.mul(xm, xm);
                long[] x3 = this.fp.mul(x2, xm);
                long[] three = U256.zeroOf(this.limbs);
                three[0] = cast<long>(3);
                long[] threeM = this.fp.toMont(three);
                long[] tx = this.fp.mul(threeM, xm);
                long[] right = this.fp.addMod(this.fp.subMod(x3, tx), bm);
                boolean same = U256.compare(left, right) == 0;
                delete three;
                return same;
            }

            // Doubling, with the a = -3 shortcut both NIST curves were chosen to allow.
            public method twice(EcPoint& p) returns EcPoint* {
                if (p.infinite || U256.isZero(p.y)) { return this.infinity(); }
                Mont* f = this.fp;
                long[] delta = f.mul(p.z, p.z);
                long[] gamma = f.mul(p.y, p.y);
                long[] beta = f.mul(p.x, gamma);
                long[] sum = f.addMod(p.x, delta);
                long[] diff = f.subMod(p.x, delta);
                long[] prod = f.mul(sum, diff);
                long[] alpha = f.addMod(f.addMod(prod, prod), prod);      // 3*(x-d)*(x+d)
                mutable long[] beta4 = f.addMod(beta, beta);
                beta4 = f.addMod(beta4, beta4);                                   // 4*beta
                long[] x3 = f.subMod(f.mul(alpha, alpha), f.addMod(beta4, beta4));
                long[] yz = f.addMod(p.y, p.z);
                long[] z3 = f.subMod(f.subMod(f.mul(yz, yz), gamma), delta);
                long[] g2 = f.mul(gamma, gamma);
                mutable long[] g8 = f.addMod(g2, g2);
                g8 = f.addMod(g8, g8);
                g8 = f.addMod(g8, g8);                                            // 8*gamma²
                long[] y3 = f.subMod(f.mul(alpha, f.subMod(beta4, x3)), g8);
                return new EcPoint(x3, y3, z3, false) on heap;
            }

            // Addition. The two special cases are the ones that make a naive implementation answer
            // nonsense: equal points need doubling (the formula divides by zero otherwise), and
            // opposite points are the identity.
            public method add(EcPoint* a, EcPoint& b) returns EcPoint* {
                if (a.infinite) {
                    return new EcPoint(U256.copy(b.x), U256.copy(b.y), U256.copy(b.z), b.infinite) on heap;
                }
                if (b.infinite) {
                    return new EcPoint(U256.copy(a.x), U256.copy(a.y), U256.copy(a.z), a.infinite) on heap;
                }
                Mont* f = this.fp;
                long[] z1z1 = f.mul(a.z, a.z);
                long[] z2z2 = f.mul(b.z, b.z);
                long[] u1 = f.mul(a.x, z2z2);
                long[] u2 = f.mul(b.x, z1z1);
                long[] s1 = f.mul(f.mul(a.y, b.z), z2z2);
                long[] s2 = f.mul(f.mul(b.y, a.z), z1z1);
                long[] h = f.subMod(u2, u1);
                long[] rr = f.subMod(s2, s1);
                if (U256.isZero(h)) {
                    if (U256.isZero(rr)) { return this.twice(a); }
                    return this.infinity();
                }
                long[] h2 = f.addMod(h, h);
                long[] i = f.mul(h2, h2);
                long[] j = f.mul(h, i);
                long[] r2 = f.addMod(rr, rr);
                long[] v = f.mul(u1, i);
                long[] x3 = f.subMod(f.subMod(f.mul(r2, r2), j), f.addMod(v, v));
                long[] s1j = f.mul(s1, j);
                long[] y3 = f.subMod(f.mul(r2, f.subMod(v, x3)), f.addMod(s1j, s1j));
                long[] zs = f.addMod(a.z, b.z);
                long[] z3 = f.mul(f.subMod(f.subMod(f.mul(zs, zs), z1z1), z2z2), h);
                return new EcPoint(x3, y3, z3, false) on heap;
            }

            // k*P, double-and-add from the top bit down.
            public method multiply(EcPoint* p, long[] k) returns EcPoint* {
                // The accumulator is replaced every step, and the OLD point is what gets deleted --
                // under its own name. Writing it the other way round (`delete acc; acc = next;`) is
                // a use of a deleted variable, and the compiler says so: a name does not come back
                // to life by being assigned again.
                mutable EcPoint* acc = this.infinity();
                mutable int i = this.limbs * 16 - 1;
                while (i >= 0) {
                    EcPoint* previous = acc;
                    acc = this.twice(previous);
                    delete previous;
                    if (U256.bit(k, i) == 1) {
                        EcPoint* before = acc;
                        acc = this.add(before, p);
                        delete before;
                    }
                    i = i - 1;
                }
                return acc;
            }

            // aP + bQ, both scalars at once -- Shamir's trick. Verification always needs exactly this
            // sum, and doing it as two separate multiplications doubles the doublings, which is where
            // nearly all the time goes. On P-384 that is 384 doublings saved out of 768, and P-384 is
            // where it matters: its limbs are half again as many and each costs 2.25x as much, so the
            // naive form is roughly three and a half times a P-256 verification.
            public method multiplyTwo(EcPoint* p, long[] a, EcPoint* q, long[] b) returns EcPoint* {
                EcPoint* both = this.add(p, q);
                mutable EcPoint* acc = this.infinity();
                mutable int i = this.limbs * 16 - 1;
                while (i >= 0) {
                    EcPoint* previous = acc;
                    acc = this.twice(previous);
                    delete previous;
                    int pick = U256.bit(a, i) * 2 + U256.bit(b, i);
                    if (pick != 0) {
                        EcPoint* before = acc;
                        acc = this.add(before, pick == 3 ? both : (pick == 2 ? p : q));
                        delete before;
                    }
                    i = i - 1;
                }
                delete both;
                return acc;
            }

            // Back to an affine x: X / Z². The one inversion the whole computation needs.
            public method affineX(EcPoint& p) returns long[] {
                if (p.infinite) { return U256.zeroOf(this.limbs); }
                long[] zinv = this.fp.invMont(p.z);
                long[] zinv2 = this.fp.mul(zinv, zinv);
                return this.fp.fromMont(this.fp.mul(p.x, zinv2));
            }
            public method affineY(EcPoint& p) returns long[] {
                if (p.infinite) { return U256.zeroOf(this.limbs); }
                long[] zinv = this.fp.invMont(p.z);
                long[] zinv3 = this.fp.mul(this.fp.mul(zinv, zinv), zinv);
                return this.fp.fromMont(this.fp.mul(p.y, zinv3));
            }

            // ---- Key agreement. Verification checks somebody else's arithmetic; this does our own.
            //
            // TLS 1.3 needs a group both ends can do, and the standard names secp256r1 as the one a
            // compliant implementation MUST support -- x25519 is only a SHOULD. Offering x25519 alone
            // was betting the whole client on a preference, and the same shape of bet as offering
            // fifteen signature schemes and checking three: it works until it meets the server that
            // took the standard literally.

            // A private scalar from random bytes: reduced into [1, n-1], which is where a scalar has
            // to live for the arithmetic to mean anything.
            public method scalarFrom(int[] source, int length) returns long[] {
                int useLen = length > this.size ? this.size : length;
                long[] d = U256.fromBytesOf(source, 0, useLen, this.limbs);
                while (U256.compare(d, this.order) >= 0) { U256.subInto(d, this.order); }
                if (U256.isZero(d)) { d[0] = cast<long>(1); }
                return d;
            }

            // The public half: 0x04 then x then y of d*G, the uncompressed form TLS puts on the wire.
            public method publicPoint(long[] scalar) returns int[] {
                EcPoint* g = this.fromAffine(this.gx, this.gy);
                EcPoint* q = this.multiply(g, scalar);
                long[] x = this.affineX(q);
                long[] y = this.affineY(q);
                int[] xb = U256.toBytesOf(x, this.size);
                int[] yb = U256.toBytesOf(y, this.size);
                int[] out = new int[1 + this.size * 2]();
                out[0] = 4;
                for (mutable int i = 0; i < this.size; i++) {
                    out[1 + i] = xb[i];
                    out[1 + this.size + i] = yb[i];
                }
                delete yb;
                delete xb;
                delete y;
                delete x;
                delete q;
                delete g;
                return out;
            }

            // The shared secret: the x coordinate of scalar*peer, which both sides arrive at from
            // opposite directions. An empty array means the peer's point was refused -- and it is
            // refused for the same reason a signature's key is, because a point off the curve moves
            // the whole exchange into a group the other side chose.
            public method agree(int[] peer, int peerLen, long[] scalar) returns int[] {
                if (peerLen != this.pointBytes() || (peer[0] & 255) != 4) { return new int[1](); }
                long[] px = U256.fromBytesOf(peer, 1, this.size, this.limbs);
                long[] py = U256.fromBytesOf(peer, 1 + this.size, this.size, this.limbs);
                if (U256.compare(px, this.prime) >= 0 || U256.compare(py, this.prime) >= 0) {
                    return new int[1]();
                }
                long[] pxm = this.fp.toMont(px);
                long[] pym = this.fp.toMont(py);
                if (!this.isOnCurve(pxm, pym)) { return new int[1](); }
                long[] one = this.oneRaw();
                EcPoint point = new EcPoint(pxm, pym, this.fp.toMont(one), false) on stack;
                delete one;
                EcPoint* shared = this.multiply(point, scalar);
                long[] x = this.affineX(shared);       // zeros when the product is infinity
                int[] out = shared.infinite ? new int[1]() : U256.toBytesOf(x, this.size);
                delete x;
                delete shared;
                return out;
            }

            // ECDSA (FIPS 186-4). `key` is the uncompressed point from the certificate: 0x04, then x,
            // then y, each `coordinateBytes()` long. `sig` is the DER SEQUENCE { INTEGER r, INTEGER s }.
            // `hash` is the digest of whatever was signed, of whatever length that digest is.
            //
            // Every refusal below is a real attack if it is skipped, which is why each is spelled out
            // rather than folded into one "is it valid" test.
            public method verify(int[] key, int keyLen, int[] sig, int sigLen,
                                 int[] hash, int hashLen) returns boolean {
                if (keyLen != this.pointBytes() || (key[0] & 255) != 4) { return false; }

                // r and s out of the DER, refusing anything outside [1, n-1]: a zero or an
                // out-of-range scalar makes the arithmetic below meaningless and some verifiers
                // accept it.
                if (Der.tag(sig, 0) != 48) { return false; }
                int rInt = Der.contentOffset(sig, 0);
                int sInt = Der.nextOffset(sig, rInt);
                long[] r = this.integerAt(sig, rInt);
                long[] s = this.integerAt(sig, sInt);
                if (U256.isZero(r) || U256.isZero(s)) { return false; }
                if (U256.compare(r, this.order) >= 0 || U256.compare(s, this.order) >= 0) {
                    return false;
                }

                long[] qx = U256.fromBytesOf(key, 1, this.size, this.limbs);
                long[] qy = U256.fromBytesOf(key, 1 + this.size, this.size, this.limbs);
                if (U256.compare(qx, this.prime) >= 0 || U256.compare(qy, this.prime) >= 0) {
                    return false;
                }
                long[] qxm = this.fp.toMont(qx);
                long[] qym = this.fp.toMont(qy);
                if (!this.isOnCurve(qxm, qym)) { return false; }   // invalid-curve attack

                // e = the LEFTMOST bits of the hash, as many as the order is wide, then reduced.
                // A digest wider than the curve is truncated and not folded: SHA-512 under P-256 uses
                // its first 32 bytes, which is what the standard says and what everyone else does.
                int useLen = hashLen > this.size ? this.size : hashLen;
                long[] e = U256.fromBytesOf(hash, 0, useLen, this.limbs);
                if (U256.compare(e, this.order) >= 0) { U256.subInto(e, this.order); }

                Mont* scalars = this.fn;
                long[] w = scalars.fromMont(scalars.invMont(scalars.toMont(s)));
                long[] u1 = scalars.fromMont(
                    scalars.mul(scalars.toMont(e), scalars.toMont(w)));
                long[] u2 = scalars.fromMont(
                    scalars.mul(scalars.toMont(r), scalars.toMont(w)));

                EcPoint* g = this.fromAffine(this.gx, this.gy);
                long[] one = this.oneRaw();
                EcPoint q = new EcPoint(qxm, qym, this.fp.toMont(one), false) on stack;
                delete one;
                EcPoint* sum = this.multiplyTwo(g, u1, q, u2);
                mutable boolean ok = false;
                if (!sum.infinite) {
                    long[] x = this.affineX(sum);
                    if (U256.compare(x, this.order) >= 0) { U256.subInto(x, this.order); }
                    ok = U256.compare(x, r) == 0;
                }

                delete sum;
                delete g;
                return ok;
            }

            // A DER INTEGER at this curve's width, with the sign-preserving leading zero dropped.
            private method integerAt(int[] d, int off) returns long[] {
                mutable int c = Der.contentOffset(d, off);
                mutable int len = Der.contentLength(d, off);
                if (len > 0 && (d[c] & 255) == 0) {
                    c = c + 1;
                    len = len - 1;
                }
                if (len > this.size) { return U256.zeroOf(this.limbs); }
                return U256.fromBytesOf(d, c, len, this.limbs);
            }
        }

        // WHY A CERTIFICATE WAS REFUSED, thrown rather than returned.
        //
        // A boolean can be dropped on the floor without anybody noticing, and a validation result
        // that is dropped is the same program as one that never validated. The failure is not the
        // caller's intention -- their intention was to talk to a server -- so it is not something to
        // hand back for them to remember to inspect. It stops.
        public class CertificateException extends Exception {
            private mutable String detail;
            public constructor CertificateException(String detail) { this.detail = detail; }
            public override method message() returns String {
                return "certificate refused: ".concat(this.detail);
            }
        }

        // THE CERTIFICATES THIS PROGRAM IS WILLING TO START FROM.
        //
        // A chain proves that each certificate was signed by the one above it, and proves nothing at
        // all on its own -- a chain forged from top to bottom is just as self-consistent. What makes
        // it mean something is ending at a key that was trusted for other reasons, and that is what
        // a trust store holds.
        //
        // The roots come from the operating system, which already curates and updates them. That is
        // not delegating the protocol: a root certificate is DATA. Shipping our own bundle inside the
        // compiler would mean a list that goes stale between releases and a revocation nobody acts on.
        // A program may also supply its own -- for a private authority, or for a test.
        public class TrustStore {
            private mutable unique ArrayList<Certificate*> roots;

            public constructor TrustStore() {
                this.roots = new ArrayList<Certificate*>() on heap;
            }
            // A TRUST STORE OWNS ITS ROOTS. `system()` parses hundreds of certificates off the
            // machine and every one of them was leaked, along with the list holding them -- there was
            // no destructor at all, so opening one TLS connection lost the whole operating system
            // trust store. The region binder found it the way it finds all of these: with nothing
            // saying the store frees them, `roots.add(root)` is a reference nobody can prove safe,
            // and the complaint was about the missing sentence rather than about the store.
            public destructor ~TrustStore() returns void {
                for (mutable int i = 0; i < this.roots.size(); i++) {
                    delete this.roots.get(i);
                }
                delete this.roots;
            }
            public method add(Certificate* root) returns void {
                this.roots.add(root);
                return;
            }
            public method count() returns int { return this.roots.size(); }

            // The roots this machine already trusts, read from the operating system. Windows
            // enumerates its ROOT store; POSIX reads whichever of the well-known bundle files exists,
            // because distributions disagree about where it lives and there is no API to ask.
            //
            // A certificate that will not parse is SKIPPED rather than fatal: a trust store holds
            // hundreds, some of them old and odd, and refusing to start because one of them uses an
            // encoding this reader does not know would be the wrong failure. What is not skipped is
            // an empty result -- a store with nothing in it trusts nothing, and every chain would
            // then be refused, which is at least honest.
            public static method system() returns TrustStore* {
                TrustStore* store = new TrustStore() on heap;
                String all = System.Net.__systemRoots();
                ArrayList<String> lines = Strings.split(all, "\n");
                StringBuilder current = new StringBuilder() on stack;
                mutable boolean inside = false;
                mutable int i = 0;
                while (i < lines.size()) {
                    String line = lines.get(i).trim();
                    if (line.startsWith("-----BEGIN CERTIFICATE")) {
                        inside = true;
                        current.clear();
                        current.append(line);
                        current.append("\n");
                    } else if (line.startsWith("-----END CERTIFICATE")) {
                        if (inside) {
                            current.append(line);
                            current.append("\n");
                            Certificate* one = Certificate.fromPem(current.toString());
                            if (one.isWellFormed()) {
                                store.add(one);
                            } else {
                                delete one;
                            }
                        }
                        inside = false;
                    } else if (inside) {
                        current.append(line);
                        current.append("\n");
                    }
                    i = i + 1;
                }
                delete lines;
                return store;
            }

            // The roots themselves, for a program that wants to report what it trusts -- a tool
            // showing its configuration, or a test checking the store loaded at all. Handed out
            // rather than copied: the store owns them and outlives the caller's look.
            public method certificates() returns ArrayList<Certificate*> {
                return this.roots;
            }

            // The root that issued `cert`, or null when this store does not vouch for it.
            public method issuerOf(Certificate& cert) returns nullable Certificate* {
                mutable int i = 0;
                while (i < this.roots.size()) {
                    Certificate* root = this.roots.get(i);
                    if (cert.isIssuedBy(root)) { return root; }
                    i = i + 1;
                }
                return null;
            }
            public destructor ~TrustStore() returns void {
                delete this.roots;
            }
        }

        // CHECKING THE CHAIN, THE DATES AND THE NAME -- in that order, and refusing at the first
        // thing that does not hold.
        //
        // Three separate questions that a single "is this certificate valid?" runs together, and all
        // three have to be answered:
        //   - was each certificate signed by the next, up to a key we already trusted?
        //   - is every certificate in that path valid TODAY?
        //   - does the leaf cover the host we asked for?
        //
        // A client that checks the signature and not the name accepts any valid certificate for any
        // host -- and anybody can buy a valid certificate for a domain they own. That was the
        // commonest TLS bug in the field for a decade, and it is why the name is checked here rather
        // than left as something the caller may add.
        public class CertificateValidator {
            // Refuses by throwing, naming what failed. `chain` is leaf first, as TLS sends it.
            public static method check(ArrayList<Certificate*> chain, String host,
                                       TrustStore& trusted, long nowSeconds)
                                       throws(CertificateException) returns void {
                if (chain.size() == 0) {
                    throw new CertificateException("the server sent no certificate") on heap;
                }
                Certificate* leaf = chain.get(0);
                if (!leaf.isWellFormed()) {
                    throw new CertificateException("the certificate could not be read") on heap;
                }
                if (!CertificateValidator.covers(leaf, host)) {
                    throw new CertificateException(
                        "it is not for '".concat(host).concat("' -- it covers ")
                            .concat(CertificateValidator.namesOf(leaf))) on heap;
                }
                CertificateValidator.checkDates(leaf, nowSeconds, "the server's certificate");

                // Walk up. Each step must be signed by the next, and each signer must be allowed to
                // sign -- a leaf that signs another leaf is a leaf that could issue for anybody.
                mutable int i = 0;
                mutable boolean reachedTrust = false;
                while (i < chain.size() && !reachedTrust) {
                    Certificate* current = chain.get(i);
                    mutable nullable Certificate* issuer = null;
                    if (i + 1 < chain.size() && current.isIssuedBy(chain.get(i + 1))) {
                        issuer = chain.get(i + 1);
                    } else {
                        issuer = trusted.issuerOf(current);
                        if (issuer != null) { reachedTrust = true; }
                    }
                    if (issuer == null) {
                        throw new CertificateException(
                            "the chain stops at '".concat(current.issuerCommonName())
                                .concat("', which is not one this program trusts")) on heap;
                    }
                    Certificate* signer = cast<Certificate*>(issuer);
                    if (!signer.isCertificateAuthority()) {
                        throw new CertificateException(
                            "'".concat(signer.subjectCommonName())
                                .concat("' signed another certificate and is not allowed to")) on heap;
                    }
                    CertificateValidator.checkDates(signer, nowSeconds,
                        "the issuer '".concat(signer.subjectCommonName()).concat("'"));
                    // Said separately from a failed check, and before it: a client that cannot do
                    // the arithmetic must not report the server as dishonest.
                    String cannot = CertificateValidator.unsupportedReason(current, signer);
                    if (cannot.length() > 0) {
                        throw new CertificateException(
                            "'".concat(current.subjectCommonName()).concat("' cannot be checked: ")
                                .concat(cannot)) on heap;
                    }
                    if (!CertificateValidator.signedBy(current, signer)) {
                        throw new CertificateException(
                            "'".concat(current.subjectCommonName())
                                .concat("' does not carry a valid signature from '")
                                .concat(signer.subjectCommonName()).concat("'")) on heap;
                    }
                    i = i + 1;
                }
                if (!reachedTrust) {
                    throw new CertificateException(
                        "the chain never reaches a certificate this program trusts") on heap;
                }
                return;
            }

            private static method checkDates(Certificate& cert, long nowSeconds, String who)
                                             throws(CertificateException) returns void {
                if (nowSeconds < cert.notBefore()) {
                    throw new CertificateException(who.concat(" is not valid yet")) on heap;
                }
                if (nowSeconds > cert.notAfter()) {
                    throw new CertificateException(who.concat(" has expired")) on heap;
                }
                return;
            }

            // WHY THIS SIGNATURE CANNOT EVEN BE ATTEMPTED, or "" when it can.
            //
            // Refusing and being unable to check are different outcomes with the same consequence,
            // and telling them apart is the difference between "this server is lying to you" and
            // "this client is not finished". Measured against the machine's own trust store: of 18
            // roots sampled, 17 verify and the eighteenth is on P-384 -- a curve this library does
            // not implement, which is a gap in us and not a fault in the certificate.
            public static method unsupportedReason(Certificate& cert, Certificate& issuer)
                                                   returns String {
                int alg = cert.signatureAlgorithm();
                if (alg == 0) {
                    return "it is signed with ".concat(cert.signatureAlgorithmName())
                        .concat(", which this program does not check");
                }
                if (alg == 3 || alg == 6) {
                    String curve = issuer.ecCurveName();
                    nullable Curve* known = Curve.named(curve);
                    if (known == null) {
                        return "its issuer's key is on ".concat(curve.length() > 0 ? curve : "an unknown curve")
                            .concat(", and this program can check only P-256 and P-384");
                    }
                    delete cast<Curve*>(known);
                }
                return "";
            }

            // Does the issuer's key verify the signature over the signed body? Only algorithms this
            // library can actually check answer true -- an unknown one is refused rather than waved
            // through, because "I could not check it" and "it checks out" must not be the same answer.
            public static method signedBy(Certificate& cert, Certificate& issuer) returns boolean {
                int alg = cert.signatureAlgorithm();
                if (alg == 0) { return false; }   // an algorithm this library cannot check is refused
                int[] body = cert.signedBody();
                int bodyLen = cert.signedBodyLength();
                // THE DIGEST FOLLOWS THE ALGORITHM. Hashing with the wrong one produces a mismatch
                // rather than a wrong acceptance, so this is not a security hole -- but it would
                // reject every SHA-384 chain while blaming the certificate, which is the failure mode
                // this whole class of message exists to avoid.
                Sha* digest = Sha.forAlgorithm(alg);
                int[] hash = digest.of(body, bodyLen);
                int hashLen = digest.size();
                int[] sig = cert.signature();
                mutable boolean ok = false;

                if (alg == 3 || alg == 6) {       // ECDSA, on whichever curve the issuer's key is on
                    nullable Curve* known = Curve.named(issuer.ecCurveName());
                    if (known != null) {
                        Curve* curve = cast<Curve*>(known);
                        int[] point = issuer.ecPublicKey();
                        if (point.length() == curve.pointBytes()) {
                            ok = curve.verify(point, point.length(), sig, cert.signatureLength(),
                                              hash, hashLen);
                        }
                        delete point;
                        delete curve;
                    }
                } else {
                    nullable RsaPublicKey* key = issuer.rsaPublicKey();
                    if (key != null) {
                        RsaPublicKey* rsa = cast<RsaPublicKey*>(key);
                        if (alg == 2) {
                            ok = Rsa.verifyPss(sig, cert.signatureLength(), rsa.modulus,
                                               rsa.modLength, rsa.exponent, hash, digest);
                        } else {
                            ok = Rsa.verifyPkcs1(sig, cert.signatureLength(), rsa.modulus,
                                                 rsa.modLength, rsa.exponent, hash, hashLen);
                        }
                        delete rsa;
                    }
                }
                delete sig;
                delete hash;
                delete digest;
                delete body;
                return ok;
            }

            // RFC 6125 hostname matching, against the subject alternative names and nothing else.
            // The common name has not been valid for this since browsers stopped reading it, and a
            // client that falls back to it accepts certificates the issuing rules never checked.
            public static method covers(Certificate& cert, String host) returns boolean {
                ArrayList<String> names = cert.dnsNames();
                mutable boolean hit = false;
                mutable int i = 0;
                while (i < names.size()) {
                    if (CertificateValidator.nameMatches(names.get(i), host)) { hit = true; }
                    i = i + 1;
                }
                delete names;
                return hit;
            }

            // A wildcard sits in the LEFTMOST label only, replaces exactly one label, and never
            // matches the bare domain: `*.example.com` covers `api.example.com` and neither
            // `example.com` nor `a.b.example.com`. Everything else is an exact, case-insensitive
            // comparison.
            public static method nameMatches(String pattern, String host) returns boolean {
                String p = pattern.toLower();
                String h = host.toLower();
                if (!p.startsWith("*.")) { return p.equals(h); }
                String suffix = p.substring(1, p.length());        // ".example.com"
                if (!h.endsWith(suffix)) { return false; }
                // What the wildcard stood for must be exactly one label: non-empty, and no dot.
                int cut = h.length() - suffix.length();
                if (cut <= 0) { return false; }                    // the bare domain
                mutable int i = 0;
                while (i < cut) {
                    if (h.charAt(i) == '.') { return false; }
                    i = i + 1;
                }
                return true;
            }

            // For the refusal message: what the certificate actually covers, so a reader can see the
            // mismatch instead of being told there is one.
            private static method namesOf(Certificate& cert) returns String {
                ArrayList<String> names = cert.dnsNames();
                defer { delete names; }
                if (names.size() == 0) {
                    return "no host names at all";
                }
                StringBuilder out = new StringBuilder() on stack;
                mutable int i = 0;
                while (i < names.size() && i < 4) {
                    if (i > 0) { out.append(", "); }
                    out.append(names.get(i));
                    i = i + 1;
                }
                if (names.size() > 4) { out.append(", and more"); }
                return out.toString();
            }
        }
    }

