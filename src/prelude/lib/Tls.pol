    public namespace Net.Tls {
        // TRANSPORT LAYER SECURITY, and the reason it lives in the standard library rather than
        // beside it.
        //
        // The library already ships `HttpClient`. There are two coherent places to draw the line --
        // both the client and the transport inside (Go, Python, Java, C#), or both outside (C++,
        // Rust, whose standard libraries stop at sockets) -- and shipping the client WITHOUT the
        // transport is neither. It produced exactly what that position always produces: a request to
        // an `https://` URL answered with a synthetic response rather than a connection or a failure.
        //
        // Three things settle it here. The toolchain bootstraps on this -- if TLS were a package,
        // fetching the first package would need the package that cannot be fetched yet. The
        // primitives are already inside: AES, SHA-256, HMAC and a secure random live in
        // System.Security, so keeping the dangerous parts in and the assembly out is an arbitrary
        // line. And the usual objection -- that everybody pays for what few use -- does not apply to
        // this compiler: emission is reachability-driven, so a program that never opens a socket
        // emits none of this.
        //
        // ENCRYPTION IS NOT AUTHENTICATION, and that distinction is the whole design of what follows.
        // A handshake that agrees a key with whoever answered the socket protects against somebody
        // listening and not at all against somebody answering in the server's place -- while looking
        // identical to the caller. So the public way in validates, always; the certificate chain, the
        // dates and the hostname are checked before a single byte of application data moves, and the
        // way to skip that has a name that says what it costs.

        // ---- DER: the tag-length-value encoding every X.509 structure is written in. ------------
        //
        // Promoted out of the certificate reader because a chain, an extension and a signature
        // algorithm are all navigated the same way, and three copies of "how long is this field"
        // is how one of them ends up disagreeing with the others.
        public class Der {
            // Bytes the length field occupies beyond the first (0 for the short form).
            public static method lengthExtra(int[] d, int off) returns int {
                int first = d[off + 1] & 255;
                if (first < 128) { return 0; }
                return first & 127;
            }
            // The content length of the value at `off`.
            public static method contentLength(int[] d, int off) returns int {
                int first = d[off + 1] & 255;
                if (first < 128) { return first; }
                int n = first & 127;
                mutable int len = 0;
                mutable int i = 0;
                while (i < n) {
                    len = (len << 8) | (d[off + 2 + i] & 255);
                    i = i + 1;
                }
                return len;
            }
            // Where the content starts, past the tag and the length.
            public static method contentOffset(int[] d, int off) returns int {
                return off + 2 + Der.lengthExtra(d, off);
            }
            // Where the next value at the same level starts.
            public static method nextOffset(int[] d, int off) returns int {
                return Der.contentOffset(d, off) + Der.contentLength(d, off);
            }
            // Total bytes the value at `off` occupies, tag and length included -- which is what a
            // signature is computed over, so it has to be exact.
            public static method totalLength(int[] d, int off) returns int {
                return 2 + Der.lengthExtra(d, off) + Der.contentLength(d, off);
            }
            public static method tag(int[] d, int off) returns int {
                return d[off] & 255;
            }
            // Whether the bytes at `off` are exactly this object identifier's encoding. OIDs are how
            // DER names an algorithm or an extension, and comparing them by bytes is both the
            // simplest way and the only one that cannot mis-parse.
            public static method oidEquals(int[] d, int off, int[] oid, int oidLen) returns boolean {
                if (Der.tag(d, off) != 6) { return false; }
                if (Der.contentLength(d, off) != oidLen) { return false; }
                int c = Der.contentOffset(d, off);
                mutable int i = 0;
                while (i < oidLen) {
                    if ((d[c + i] & 255) != (oid[i] & 255)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            // The bytes of a value, copied out -- for a signature, a modulus or a key.
            public static method copy(int[] d, int from, int len) returns int[] {
                int[] out = new int[len > 0 ? len : 1]();
                mutable int i = 0;
                while (i < len) {
                    out[i] = d[from + i] & 255;
                    i = i + 1;
                }
                return out;
            }

            // PROVING THE STRUCTURE BEFORE READING IT, which is the only safe order.
            //
            // Every length above is a number the DER itself supplied, and a certificate arrives from
            // whoever answered the socket. A reader that indexes wherever the length field points can
            // be walked off the end of the buffer by the bytes it is reading -- which is what happened
            // here the first time, caught by the bounds check as `index = 686, length = 48`. That is a
            // clean stop rather than corruption, and it is still the wrong answer: a malformed
            // certificate must be REFUSED, not kill the program that received it.
            //
            // So the whole tree is walked once, checking that every tag, every length field and every
            // content run lies inside the buffer, before a single accessor reads anything. After this
            // returns true the offsets are known good and the rest can index freely.
            //
            // The depth bound is part of it: nesting is what an attacker controls for free, and a
            // recursive descent with no floor turns a hundred bytes into a stack overflow.
            public static method wellFormed(int[] d, int len, int off, int end, int depth)
                                            returns boolean {
                if (depth <= 0) { return false; }
                mutable int at = off;
                while (at < end) {
                    if (at + 2 > len || at + 2 > end) { return false; }   // room for a tag and a length
                    int first = d[at + 1] & 255;
                    mutable int extra = 0;
                    if (first >= 128) {
                        extra = first & 127;
                        if (extra == 0 || extra > 4) { return false; }    // indefinite, or absurdly wide
                        if (at + 2 + extra > len) { return false; }
                    }
                    mutable int contentLen = first;
                    if (extra > 0) {
                        contentLen = 0;
                        mutable int i = 0;
                        while (i < extra) {
                            contentLen = (contentLen << 8) | (d[at + 2 + i] & 255);
                            i = i + 1;
                        }
                        if (contentLen < 0) { return false; }             // a length that overflowed
                    }
                    int content = at + 2 + extra;
                    if (content > len || contentLen > len - content) { return false; }
                    int after = content + contentLen;
                    if (after > end) { return false; }
                    // A constructed value (bit 0x20) holds more values; a primitive one holds bytes.
                    if (((d[at] & 255) & 32) != 0) {
                        if (!Der.wellFormed(d, len, content, after, depth - 1)) { return false; }
                    }
                    at = after;
                }
                return at == end;
            }
        }

        // The object identifiers this library recognises, as byte arrays because that is how they
        // appear on the wire. Built once and handed out, rather than re-created at every comparison.
        public class Oid {
            // 1.2.840.113549.1.1.11 -- sha256WithRSAEncryption
            public static method sha256Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 11;
                return o;
            }
            // 1.2.840.113549.1.1.12 -- sha384WithRSAEncryption. Counted on a real trust store, twelve
            // of sixty-eight roots use this and only one uses SHA-512: leaving it out costs more
            // coverage than any other single omission.
            public static method sha384Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 12;
                return o;
            }
            // 1.2.840.113549.1.1.13 -- sha512WithRSAEncryption
            public static method sha512Rsa() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 13;
                return o;
            }
            // 1.2.840.10045.4.3.3 -- ecdsa-with-SHA384
            public static method ecdsaSha384() returns int[] {
                int[] o = new int[8]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 4; o[6] = 3; o[7] = 3;
                return o;
            }
            // 1.2.840.113549.1.1.10 -- RSASSA-PSS
            public static method rsaPss() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 10;
                return o;
            }
            // 1.2.840.10045.4.3.2 -- ecdsa-with-SHA256
            public static method ecdsaSha256() returns int[] {
                int[] o = new int[8]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 4; o[6] = 3; o[7] = 2;
                return o;
            }
            // 1.2.840.113549.1.1.1 -- rsaEncryption (a public key, not a signature)
            public static method rsaKey() returns int[] {
                int[] o = new int[9]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 134; o[4] = 247;
                o[5] = 13; o[6] = 1; o[7] = 1; o[8] = 1;
                return o;
            }
            // 1.2.840.10045.2.1 -- id-ecPublicKey
            public static method ecKey() returns int[] {
                int[] o = new int[7]();
                o[0] = 42; o[1] = 134; o[2] = 72; o[3] = 206; o[4] = 61;
                o[5] = 2; o[6] = 1;
                return o;
            }
            // 2.5.29.17 -- subjectAltName
            public static method subjectAltName() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 29; o[2] = 17;
                return o;
            }
            // 2.5.29.19 -- basicConstraints
            public static method basicConstraints() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 29; o[2] = 19;
                return o;
            }
            // 2.5.4.3 -- commonName
            public static method commonName() returns int[] {
                int[] o = new int[3]();
                o[0] = 85; o[1] = 4; o[2] = 3;
                return o;
            }
        }

        // An RSA public key: the big-endian modulus and the public exponent, which is small enough
        // for an int.
        public class RsaPublicKey {
            public mutable int[] modulus;
            public mutable int modLength;
            public mutable int exponent;
            public constructor RsaPublicKey(int[] modulus, int modLength, int exponent) {
                this.modulus = modulus;
                this.modLength = modLength;
                this.exponent = exponent;
            }
            public destructor ~RsaPublicKey() returns void {
                delete this.modulus;
            }
        }

        // WHAT THE SERVER SAID IT IS -- a parsed X.509 certificate.
        //
        // The reader this replaces pulled out the public key and nothing else, which is enough to
        // check a signature and not enough to know WHOSE signature it is. Everything a client has to
        // ask before trusting a key is here: who issued it, who it is for, when it is valid, whether
        // it may sign other certificates, which names it covers, and the exact bytes its issuer
        // signed.
        //
        // Parsed once in the constructor. The DER stays -- a signature is computed over the bytes as
        // they arrived, so re-encoding what was parsed would be both slower and wrong.
        public class Certificate {
            private mutable int[] der;
            private mutable int derLength;
            private mutable boolean wellFormed;
            // Offsets into `der`, all discovered once.
            private mutable int tbsOffset;        // the signed body, tag included
            private mutable int tbsTotal;
            private mutable int issuerOffset;
            private mutable int subjectOffset;
            private mutable int validityOffset;
            private mutable int spkiOffset;
            private mutable int extensionsOffset;   // -1 when absent
            private mutable int sigAlgOffset;
            private mutable int sigValueOffset;

            public constructor Certificate(int[] der, int length) {
                this.der = der;
                this.derLength = length;
                this.wellFormed = false;
                this.tbsOffset = 0;
                this.tbsTotal = 0;
                this.issuerOffset = 0;
                this.subjectOffset = 0;
                this.validityOffset = 0;
                this.spkiOffset = 0;
                this.extensionsOffset = 0 - 1;
                this.sigAlgOffset = 0;
                this.sigValueOffset = 0;
                this.parse();
            }

            // Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
            private method parse() returns void {
                if (this.derLength < 8 || Der.tag(this.der, 0) != 48) { return; }
                // THE WHOLE TREE IS PROVEN TO FIT BEFORE ANYTHING IS READ. Everything below indexes
                // by offsets the DER supplied, and the DER came from whoever answered the socket --
                // so it is checked once, here, and refused as a whole rather than trusted a field at
                // a time. 32 is far more nesting than a certificate has and far less than a stack
                // can take.
                int outer = Der.totalLength(this.der, 0);
                if (outer <= 0 || outer > this.derLength) { return; }   // it must fit what arrived
                if (!Der.wellFormed(this.der, this.derLength, 0, outer, 32)) { return; }
                this.tbsOffset = Der.contentOffset(this.der, 0);
                if (Der.tag(this.der, this.tbsOffset) != 48) { return; }
                this.tbsTotal = Der.totalLength(this.der, this.tbsOffset);
                this.sigAlgOffset = Der.nextOffset(this.der, this.tbsOffset);
                this.sigValueOffset = Der.nextOffset(this.der, this.sigAlgOffset);

                mutable int off = Der.contentOffset(this.der, this.tbsOffset);
                // [0] EXPLICIT version, optional -- present on every certificate anybody issues now,
                // absent on a v1 one, so it is tested rather than assumed.
                if (Der.tag(this.der, off) == 160) { off = Der.nextOffset(this.der, off); }
                off = Der.nextOffset(this.der, off);      // serialNumber
                off = Der.nextOffset(this.der, off);      // signature (repeated inside the body)
                this.issuerOffset = off;
                off = Der.nextOffset(this.der, off);
                this.validityOffset = off;
                off = Der.nextOffset(this.der, off);
                this.subjectOffset = off;
                off = Der.nextOffset(this.der, off);
                this.spkiOffset = off;
                off = Der.nextOffset(this.der, off);

                // The optional trailing fields, of which only [3] extensions matters here.
                int tbsEnd = this.tbsOffset + this.tbsTotal;
                while (off + 1 < tbsEnd) {
                    int t = Der.tag(this.der, off);
                    if (t == 163) {
                        this.extensionsOffset = Der.contentOffset(this.der, off);
                        off = tbsEnd;
                    } else if (t == 161 || t == 162) {
                        off = Der.nextOffset(this.der, off);
                    } else {
                        off = tbsEnd;
                    }
                }
                this.wellFormed = true;
                return;
            }

            // False when the bytes are not a certificate this reader understands. Every accessor
            // below answers emptily in that case, and the validator refuses -- a certificate that
            // could not be read is not a certificate that checks out.
            public method isWellFormed() returns boolean { return this.wellFormed; }

            // The exact bytes the issuer signed: tbsCertificate, tag and length included.
            public method signedBody() returns int[] {
                return Der.copy(this.der, this.tbsOffset, this.tbsTotal);
            }
            public method signedBodyLength() returns int { return this.tbsTotal; }

            // The signature over that body, with the BIT STRING's unused-bits byte dropped.
            public method signature() returns int[] {
                int c = Der.contentOffset(this.der, this.sigValueOffset);
                int n = Der.contentLength(this.der, this.sigValueOffset);
                return Der.copy(this.der, c + 1, n - 1);
            }
            public method signatureLength() returns int {
                return Der.contentLength(this.der, this.sigValueOffset) - 1;
            }

            // Which algorithm signed it:
            //   1 = RSA PKCS#1 v1.5 with SHA-256      4 = the same with SHA-384
            //   2 = RSA-PSS with SHA-256              5 = the same with SHA-512
            //   3 = ECDSA with SHA-256                6 = ECDSA with SHA-384
            //   0 = something this library does not verify
            //
            // SHA-1, MD5 and MD2 are deliberately absent and answer 0. They are broken -- a collision
            // in the digest is a forged certificate -- so a modern client must refuse them, and
            // "cannot check" is exactly the right answer to give about a signature nobody should
            // accept. Twenty-nine of this machine's sixty-eight roots use one of the three; refusing
            // them is not a coverage gap.
            public method signatureAlgorithm() returns int {
                int algOid = Der.contentOffset(this.der, this.sigAlgOffset);
                mutable int[] rsa256 = Oid.sha256Rsa();
                mutable int[] rsa384 = Oid.sha384Rsa();
                mutable int[] rsa512 = Oid.sha512Rsa();
                mutable int[] pss = Oid.rsaPss();
                mutable int[] ec256 = Oid.ecdsaSha256();
                mutable int[] ec384 = Oid.ecdsaSha384();
                mutable int which = 0;
                if (Der.oidEquals(this.der, algOid, rsa256, 9)) { which = 1; }
                else if (Der.oidEquals(this.der, algOid, pss, 9)) { which = 2; }
                else if (Der.oidEquals(this.der, algOid, ec256, 8)) { which = 3; }
                else if (Der.oidEquals(this.der, algOid, rsa384, 9)) { which = 4; }
                else if (Der.oidEquals(this.der, algOid, rsa512, 9)) { which = 5; }
                else if (Der.oidEquals(this.der, algOid, ec384, 8)) { which = 6; }
                delete ec384;
                delete ec256;
                delete pss;
                delete rsa512;
                delete rsa384;
                delete rsa256;
                return which;
            }

            // The RSA public key, or null when the certificate carries an elliptic-curve one --
            // which the caller has to handle rather than be handed a zero key that verifies nothing.
            public method rsaPublicKey() returns nullable RsaPublicKey* {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                mutable int[] want = Oid.rsaKey();
                boolean isRsa = Der.oidEquals(this.der, algOid, want, 9);
                delete want;
                if (!isRsa) { return null; }

                int bitString = Der.nextOffset(this.der, algSeq);
                int rsaSeq = Der.contentOffset(this.der, bitString) + 1;   // past the unused-bits byte
                int modInt = Der.contentOffset(this.der, rsaSeq);
                mutable int mOff = Der.contentOffset(this.der, modInt);
                mutable int mLen = Der.contentLength(this.der, modInt);
                if ((this.der[mOff] & 255) == 0) {         // the sign-preserving leading zero
                    mOff = mOff + 1;
                    mLen = mLen - 1;
                }
                int[] modulus = Der.copy(this.der, mOff, mLen);
                int expInt = Der.nextOffset(this.der, modInt);
                int eOff = Der.contentOffset(this.der, expInt);
                int eLen = Der.contentLength(this.der, expInt);
                mutable int e = 0;
                mutable int j = 0;
                while (j < eLen) {
                    e = (e << 8) | (this.der[eOff + j] & 255);
                    j = j + 1;
                }
                return new RsaPublicKey(modulus, mLen, e) on heap;
            }

            // WHICH CURVE the key is on: "P-256", "P-384", "P-521", or "" when the certificate does
            // not carry an elliptic-curve key at all.
            //
            // This exists so that "I cannot check this" and "this does not check out" stay different
            // answers. A P-384 root refused by a P-256 verifier is the verifier behaving correctly,
            // and reporting it as a bad signature sends somebody hunting a bug that is not there.
            // The curve is named by an OID inside the key's algorithm parameters.
            public method ecCurveName() returns String {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                mutable int[] want = Oid.ecKey();
                boolean isEc = Der.oidEquals(this.der, algOid, want, 7);
                delete want;
                if (!isEc) { return ""; }
                int curveOid = Der.nextOffset(this.der, algOid);
                if (Der.tag(this.der, curveOid) != 6) { return ""; }
                int c = Der.contentOffset(this.der, curveOid);
                int n = Der.contentLength(this.der, curveOid);
                // 1.2.840.10045.3.1.7 -- prime256v1
                if (n == 8 && (this.der[c] & 255) == 42 && (this.der[c + 6] & 255) == 1 &&
                    (this.der[c + 7] & 255) == 7) {
                    return "P-256";
                }
                // 1.3.132.0.34 -- secp384r1
                if (n == 5 && (this.der[c] & 255) == 43 && (this.der[c + 4] & 255) == 34) {
                    return "P-384";
                }
                // 1.3.132.0.35 -- secp521r1
                if (n == 5 && (this.der[c] & 255) == 43 && (this.der[c + 4] & 255) == 35) {
                    return "P-521";
                }
                return "unknown curve";
            }

            // The uncompressed elliptic-curve point, or an empty array for an RSA certificate.
            // 65 bytes for P-256: 0x04 then x then y.
            public method ecPublicKey() returns int[] {
                int algSeq = Der.contentOffset(this.der, this.spkiOffset);
                int algOid = Der.contentOffset(this.der, algSeq);
                mutable int[] want = Oid.ecKey();
                boolean isEc = Der.oidEquals(this.der, algOid, want, 7);
                delete want;
                if (!isEc) { return new int[1](); }
                int bitString = Der.nextOffset(this.der, algSeq);
                int c = Der.contentOffset(this.der, bitString) + 1;
                int n = Der.contentLength(this.der, bitString) - 1;
                return Der.copy(this.der, c, n);
            }

            // ---- Validity. Both bounds, as instants, so the comparison is arithmetic. ----
            public method notBefore() returns long {
                return this.timeAt(Der.contentOffset(this.der, this.validityOffset));
            }
            public method notAfter() returns long {
                int first = Der.contentOffset(this.der, this.validityOffset);
                return this.timeAt(Der.nextOffset(this.der, first));
            }
            // Is it valid at this moment, in seconds since the epoch? Both bounds inclusive, as RFC
            // 5280 defines them. Asked separately from `CertificateValidator.check` because a program
            // may want to report how long it has left -- a certificate about to expire is something
            // to warn about while it still works, and there is no way to do that from a refusal.
            public method isValidAt(long seconds) returns boolean {
                return seconds >= this.notBefore() && seconds <= this.notAfter();
            }

            // UTCTime is "YYMMDDHHMMSSZ" and GeneralizedTime is "YYYYMMDDHHMMSSZ" -- the two-digit
            // year pivots at 50, by RFC 5280. A certificate written for 2049 and one written for
            // 1950 are the same six digits, and the pivot is the only thing that separates them.
            private method timeAt(int off) returns long {
                int t = Der.tag(this.der, off);
                int c = Der.contentOffset(this.der, off);
                mutable int i = c;
                mutable int year = 0;
                if (t == 24) {                                  // GeneralizedTime
                    year = this.number(i, 4);
                    i = i + 4;
                } else {                                        // UTCTime
                    int yy = this.number(i, 2);
                    year = yy >= 50 ? 1900 + yy : 2000 + yy;
                    i = i + 2;
                }
                int month = this.number(i, 2);
                int day = this.number(i + 2, 2);
                int hour = this.number(i + 4, 2);
                int minute = this.number(i + 6, 2);
                int second = this.number(i + 8, 2);
                mutable Instant at = Instant.ofUtc(year, month, day, hour, minute, second);
                long secs = at.toEpochSeconds();
                delete at;
                return secs;
            }
            private method number(int off, int digits) returns int {
                mutable int v = 0;
                mutable int i = 0;
                while (i < digits) {
                    v = v * 10 + ((this.der[off + i] & 255) - 48);
                    i = i + 1;
                }
                return v;
            }

            // ---- Extensions. ----

            // May this certificate sign others? A leaf that says yes to this is a leaf that could
            // issue certificates for anybody, which is why a chain checks it at every step above the
            // end entity. Absent means no, by RFC 5280.
            public method isCertificateAuthority() returns boolean {
                int ext = this.extension(Oid.basicConstraints(), 3);
                if (ext < 0) { return false; }
                // BasicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE, ... }
                if (Der.tag(this.der, ext) != 48) { return false; }
                int inner = Der.contentOffset(this.der, ext);
                if (Der.contentLength(this.der, ext) == 0) { return false; }
                if (Der.tag(this.der, inner) != 1) { return false; }      // no cA field -> FALSE
                return (this.der[Der.contentOffset(this.der, inner)] & 255) != 0;
            }

            // Every dNSName the certificate covers. This -- not the common name -- is what a client
            // matches a hostname against: the common name has been deprecated for that since 2000
            // and browsers stopped reading it years ago, so a certificate whose only name is in the
            // subject covers nothing.
            public method dnsNames() returns ArrayList<String> {
                mutable ArrayList<String> names = new ArrayList<String>() on heap;
                int ext = this.extension(Oid.subjectAltName(), 3);
                if (ext < 0) { return names; }
                if (Der.tag(this.der, ext) != 48) { return names; }
                int end = ext + Der.totalLength(this.der, ext);
                mutable int off = Der.contentOffset(this.der, ext);
                while (off + 1 < end) {
                    if (Der.tag(this.der, off) == 130) {        // [2] IMPLICIT dNSName
                        int c = Der.contentOffset(this.der, off);
                        int n = Der.contentLength(this.der, off);
                        mutable StringBuilder name = new StringBuilder() on heap;
                        mutable int i = 0;
                        while (i < n) {
                            name.appendChar(cast<char>(this.der[c + i] & 255));
                            i = i + 1;
                        }
                        names.add(name.toString());
                    }
                    off = Der.nextOffset(this.der, off);
                }
                return names;
            }

            // Where an extension's value starts, or -1 when the certificate does not carry it.
            // Extension ::= SEQUENCE { extnID OID, critical BOOLEAN DEFAULT FALSE, extnValue OCTET STRING }
            private method extension(int[] oid, int oidLen) returns int {
                if (this.extensionsOffset < 0) {
                    delete oid;
                    return 0 - 1;
                }
                int seq = this.extensionsOffset;
                if (Der.tag(this.der, seq) != 48) {
                    delete oid;
                    return 0 - 1;
                }
                int end = seq + Der.totalLength(this.der, seq);
                mutable int off = Der.contentOffset(this.der, seq);
                mutable int found = 0 - 1;
                while (off + 1 < end && found < 0) {
                    int inner = Der.contentOffset(this.der, off);
                    if (Der.oidEquals(this.der, inner, oid, oidLen)) {
                        mutable int v = Der.nextOffset(this.der, inner);
                        if (Der.tag(this.der, v) == 1) { v = Der.nextOffset(this.der, v); }  // critical
                        found = Der.contentOffset(this.der, v);      // inside the OCTET STRING
                    }
                    off = Der.nextOffset(this.der, off);
                }
                delete oid;
                return found;
            }

            // ---- Identity, for chain building. ----

            // The issuer and subject as raw DER. A chain links when one certificate's issuer field
            // is byte-for-byte the next one's subject field -- comparing the DECODED names instead
            // is where implementations disagree about encodings and let the wrong certificate in.
            public method issuerBytes() returns int[] {
                return Der.copy(this.der, this.issuerOffset,
                                Der.totalLength(this.der, this.issuerOffset));
            }
            public method subjectBytes() returns int[] {
                return Der.copy(this.der, this.subjectOffset,
                                Der.totalLength(this.der, this.subjectOffset));
            }
            public method issuerLength() returns int {
                return Der.totalLength(this.der, this.issuerOffset);
            }
            public method subjectLength() returns int {
                return Der.totalLength(this.der, this.subjectOffset);
            }
            // Was this issued by that one? Byte equality of the two names, as above.
            public method isIssuedBy(Certificate* issuer) returns boolean {
                if (this.issuerLength() != issuer.subjectLength()) { return false; }
                mutable int[] mine = this.issuerBytes();
                mutable int[] theirs = issuer.subjectBytes();
                mutable boolean same = true;
                mutable int i = 0;
                while (i < this.issuerLength()) {
                    if ((mine[i] & 255) != (theirs[i] & 255)) { same = false; }
                    i = i + 1;
                }
                delete theirs;
                delete mine;
                return same;
            }
            // Self-issued: what a root looks like, and the point at which a chain walk stops.
            //
            // Compared field to field rather than by calling `isIssuedBy(&this)`: `this` is already
            // the reference to the object, so `&this` is the address of the slot HOLDING it -- a
            // pointer to a pointer, whose fields read as whatever the pointer's bytes happen to say.
            // Here that came out as a length of hundreds of millions and an allocation that never
            // returned.
            public method isSelfIssued() returns boolean {
                if (this.issuerLength() != this.subjectLength()) { return false; }
                mutable int[] issuer = this.issuerBytes();
                mutable int[] subject = this.subjectBytes();
                mutable boolean same = true;
                mutable int i = 0;
                int n = this.issuerLength();
                while (i < n) {
                    if ((issuer[i] & 255) != (subject[i] & 255)) { same = false; }
                    i = i + 1;
                }
                delete subject;
                delete issuer;
                return same;
            }

            // The subject's common name, for a message a person reads. NOT for matching a
            // hostname -- see dnsNames.
            public method subjectCommonName() returns String {
                return this.commonNameIn(this.subjectOffset);
            }
            public method issuerCommonName() returns String {
                return this.commonNameIn(this.issuerOffset);
            }
            // Name ::= SEQUENCE OF SET OF SEQUENCE { type OID, value }
            private method commonNameIn(int nameOff) returns String {
                if (Der.tag(this.der, nameOff) != 48) { return ""; }
                int end = nameOff + Der.totalLength(this.der, nameOff);
                mutable int rdn = Der.contentOffset(this.der, nameOff);
                mutable int[] cn = Oid.commonName();
                mutable String found = "";
                while (rdn + 1 < end && found.length() == 0) {
                    mutable int pair = Der.contentOffset(this.der, rdn);      // into the SET
                    int pairEnd = rdn + Der.totalLength(this.der, rdn);
                    while (pair + 1 < pairEnd && found.length() == 0) {
                        int typeOff = Der.contentOffset(this.der, pair);
                        if (Der.oidEquals(this.der, typeOff, cn, 3)) {
                            int valOff = Der.nextOffset(this.der, typeOff);
                            int c = Der.contentOffset(this.der, valOff);
                            int n = Der.contentLength(this.der, valOff);
                            mutable StringBuilder text = new StringBuilder() on heap;
                            mutable int i = 0;
                            while (i < n) {
                                text.appendChar(cast<char>(this.der[c + i] & 255));
                                i = i + 1;
                            }
                            found = text.toString();
                        }
                        pair = Der.nextOffset(this.der, pair);
                    }
                    rdn = Der.nextOffset(this.der, rdn);
                }
                delete cn;
                return found;
            }

            // A certificate as it is written down rather than as it travels: PEM is the DER in
            // base64 between two marker lines, and it is how every trust store, every configuration
            // file and every export button hands one over. Whitespace and the markers are dropped,
            // and anything before the first marker or after the last is ignored -- a bundle file
            // carries dozens of these separated by commentary.
            public static method fromPem(String pem) returns Certificate* {
                mutable StringBuilder body = new StringBuilder() on heap;
                mutable ArrayList<String> lines = Strings.split(pem, "\n");
                mutable boolean inside = false;
                mutable int i = 0;
                while (i < lines.size()) {
                    String line = lines.get(i).trim();
                    if (line.startsWith("-----BEGIN")) {
                        inside = true;
                    } else if (line.startsWith("-----END")) {
                        inside = false;
                    } else if (inside) {
                        body.append(line);
                    }
                    i = i + 1;
                }
                delete lines;
                String raw = Base64.decode(body.toString());
                int[] der = new int[raw.length() > 0 ? raw.length() : 1]();
                mutable int j = 0;
                while (j < raw.length()) {
                    der[j] = cast<int>(raw.charAt(j)) & 255;
                    j = j + 1;
                }
                return new Certificate(der, raw.length()) on heap;
            }

            public destructor ~Certificate() returns void {
                delete this.der;
            }
        }

        // RSA PKCS#1 v1.5 signature verification (RFC 8017) -- what almost every certificate in a
        // chain is signed with. Big-endian buffers throughout; the modular exponentiation rides the
        // standard library's BigInteger, and the public exponent is small (65537 as a rule), so
        // square-and-multiply over its bits is cheap.
        public class Rsa {
            // RSASSA-PSS with SHA-256 and MGF1-SHA256 (RFC 8017 §9.1.2) -- what TLS 1.3 requires for
            // the server's CertificateVerify, and increasingly what certificates are signed with.
            //
            // PSS exists because PKCS#1 v1.5 padding is a fixed pattern, and a fixed pattern is
            // something an attacker can aim at. Here the encoded message is masked with a hash of
            // itself, so there is nothing constant to forge toward. The cost is that verification has
            // real steps rather than a memcmp, and every one of them has to be checked: skipping the
            // trailing 0xBC, or the zero prefix, or the salt reconstruction turns this into a
            // function that accepts almost anything.
            public static method verifyPssSha256(int[] sig, int sigLength, int[] modulus,
                                                 int modLength, int e, int[] hash) returns boolean {
                mutable int[] em = Rsa.recover(sig, sigLength, modulus, modLength, e);
                int emLen = modLength;
                int hLen = 32;
                int sLen = 32;                                  // salt length = hash length
                if (emLen < hLen + sLen + 2) { return false; }
                if ((em[emLen - 1] & 255) != 188) { return false; }   // the trailing 0xBC

                int dbLen = emLen - hLen - 1;
                mutable int[] h = Der.copy(em, dbLen, hLen);
                mutable int[] db = Der.copy(em, 0, dbLen);
                mutable int[] mask = Rsa.mgf1(h, hLen, dbLen);
                mutable int i = 0;
                while (i < dbLen) {
                    db[i] = (db[i] ^ mask[i]) & 255;
                    i = i + 1;
                }
                // The top bits of the first byte are not part of the message: the modulus is not a
                // whole number of bytes, and they must be cleared before the pattern is read.
                db[0] = db[0] & 127;

                // DB must be zeros, then a single 0x01, then the salt.
                mutable int j = 0;
                while (j < dbLen - sLen - 1) {
                    if ((db[j] & 255) != 0) { return false; }
                    j = j + 1;
                }
                if ((db[dbLen - sLen - 1] & 255) != 1) { return false; }

                // H' = SHA-256(eight zero bytes || mHash || salt), compared against the H carried in
                // the signature.
                mutable int[] input = new int[8 + hLen + sLen]();
                mutable int k = 0;
                while (k < 8) { input[k] = 0; k = k + 1; }
                while (k < 8 + hLen) { input[k] = hash[k - 8] & 255; k = k + 1; }
                while (k < 8 + hLen + sLen) {
                    input[k] = db[dbLen - sLen + (k - 8 - hLen)] & 255;
                    k = k + 1;
                }
                mutable int[] expected = Sha256.digestRaw(input, 8 + hLen + sLen);
                mutable boolean same = true;
                mutable int c = 0;
                while (c < hLen) {
                    if ((expected[c] & 255) != (h[c] & 255)) { same = false; }
                    c = c + 1;
                }
                delete expected;
                delete input;
                delete mask;
                delete db;
                delete h;
                delete em;
                return same;
            }

            // MGF1 with SHA-256 (RFC 8017 B.2.1): hash the seed with a counter appended, over and
            // over, until there are enough bytes.
            private static method mgf1(int[] seed, int seedLen, int wanted) returns int[] {
                mutable int[] out = new int[wanted > 0 ? wanted : 1]();
                mutable int produced = 0;
                mutable int counter = 0;
                while (produced < wanted) {
                    mutable int[] input = new int[seedLen + 4]();
                    mutable int i = 0;
                    while (i < seedLen) { input[i] = seed[i] & 255; i = i + 1; }
                    input[seedLen] = (counter >> 24) & 255;
                    input[seedLen + 1] = (counter >> 16) & 255;
                    input[seedLen + 2] = (counter >> 8) & 255;
                    input[seedLen + 3] = counter & 255;
                    mutable int[] block = Sha256.digestRaw(input, seedLen + 4);
                    mutable int j = 0;
                    while (j < 32 && produced < wanted) {
                        out[produced] = block[j] & 255;
                        produced = produced + 1;
                        j = j + 1;
                    }
                    delete block;
                    delete input;
                    counter = counter + 1;
                }
                return out;
            }

            // Is `sig` a valid PKCS#1 v1.5 signature over `hash` under (modulus, e)? `hashLength`
            // selects the digest -- 32, 48 or 64 for SHA-256, SHA-384 and SHA-512.
            public static method verifyPkcs1(int[] sig, int sigLength, int[] modulus, int modLength,
                                             int e, int[] hash, int hashLength) returns boolean {
                mutable int[] encoded = Rsa.recover(sig, sigLength, modulus, modLength, e);
                boolean ok = Rsa.checkPkcs1(encoded, modLength, hash, hashLength);
                delete encoded;
                return ok;
            }

            // s^e mod n, as big-endian bytes of exactly `modLength` -- the operation both padding
            // schemes start from.
            //
            // ON THE LIMB ARITHMETIC AND NOT ON BigInteger. That type keeps one DECIMAL DIGIT per
            // slot, which makes a 2048-bit modular exponentiation cost 2.3 seconds -- measured
            // against a real trust store, where the two or three verifications of a single handshake
            // would have taken most of ten seconds. The same Montgomery code the curve uses answers
            // this in milliseconds; only the limb count differs.
            private static method recover(int[] sig, int sigLength, int[] modulus, int modLength,
                                          int e) returns int[] {
                int limbs = U256.limbsForBytes(modLength);
                mutable long[] n = Rsa.toLimbs(modulus, modLength, limbs);
                mutable long[] s = Rsa.toLimbs(sig, sigLength, limbs);
                mutable Mont* f = new Mont(n) on heap;
                mutable long[] m = f.powSmall(s, e);
                int[] out = Rsa.fromLimbs(m, modLength);
                delete m;
                delete f;
                delete s;
                delete n;
                return out;
            }
            private static method toLimbs(int[] be, int len, int limbs) returns long[] {
                mutable long[] out = U256.zeroOf(limbs);
                mutable int i = 0;
                while (i < len) {
                    int value = be[len - 1 - i] & 255;
                    int limb = i / 2;
                    if (limb < limbs) {
                        out[limb] = out[limb] | (cast<long>(value) << ((i % 2) * 8));
                    }
                    i = i + 1;
                }
                return out;
            }
            private static method fromLimbs(long[] a, int bytes) returns int[] {
                int[] out = new int[bytes]();
                mutable int i = 0;
                while (i < bytes) {
                    int limb = i / 2;
                    long v = limb < a.length() ? a[limb] : cast<long>(0);
                    out[bytes - 1 - i] = cast<int>((v >> ((i % 2) * 8)) & cast<long>(255));
                    i = i + 1;
                }
                return out;
            }
            // The SHA-256 case by name, which is what most callers mean.
            public static method verifySha256(int[] sig, int sigLength, int[] modulus, int modLength,
                                              int e, int[] hash) returns boolean {
                return Rsa.verifyPkcs1(sig, sigLength, modulus, modLength, e, hash, 32);
            }

            private static method fromBigEndian(int[] bytes, int length) returns BigInteger {
                BigInteger base = new BigInteger(cast<long>(256)) on heap;
                mutable BigInteger acc = new BigInteger(cast<long>(0)) on heap;
                mutable int i = 0;
                while (i < length) {
                    BigInteger digit = new BigInteger(cast<long>(bytes[i] & 255)) on heap;
                    acc = acc.multiply(base).add(digit);
                    i = i + 1;
                }
                return acc;
            }

            private static method toBigEndian(BigInteger a, int k) returns int[] {
                BigInteger base = new BigInteger(cast<long>(256)) on heap;
                mutable BigInteger v = a;
                int[] out = new int[k]();
                mutable int i = k - 1;
                while (i >= 0) {
                    out[i] = v.remainder(base).toString().toInt();
                    v = v.divide(base);
                    i = i - 1;
                }
                return out;
            }

            private static method modPow(BigInteger base, int e, BigInteger mod) returns BigInteger {
                mutable BigInteger result = new BigInteger(cast<long>(1)) on heap;
                mutable BigInteger b = base.remainder(mod);
                mutable int bit = 30;
                while (bit >= 0) {
                    result = result.multiply(result).remainder(mod);
                    if (((e >> bit) & 1) == 1) {
                        result = result.multiply(b).remainder(mod);
                    }
                    bit = bit - 1;
                }
                return result;
            }

            // The recovered block must be 0x00 0x01, at least eight 0xFF bytes, 0x00, the SHA-256
            // DigestInfo, then the hash. Every one of those is checked: a verifier that only compares
            // the trailing hash accepts a forged signature with anything at all in the padding, which
            // is the Bleichenbacher forgery.
            private static method checkPkcs1(int[] em, int k, int[] hash, int hashLength)
                                             returns boolean {
                if ((em[0] & 255) != 0 || (em[1] & 255) != 1) { return false; }
                mutable int i = 2;
                while (i < k && (em[i] & 255) == 255) { i = i + 1; }
                if (i >= k || (em[i] & 255) != 0) { return false; }
                if ((i - 2) < 8) { return false; }
                i = i + 1;

                // The DigestInfo header names WHICH hash this is, and that is not decoration: without
                // it, a signature over a SHA-256 digest could be presented as one over the leading 32
                // bytes of a SHA-512 digest. The three differ in exactly two bytes -- the algorithm's
                // last identifier byte and the two lengths -- so they are set rather than assumed.
                int[] prefix = new int[19]();
                prefix[0] = 48;   prefix[1] = 49;  prefix[2] = 48;  prefix[3] = 13;  prefix[4] = 6;
                prefix[5] = 9;    prefix[6] = 96;  prefix[7] = 134; prefix[8] = 72;  prefix[9] = 1;
                prefix[10] = 101; prefix[11] = 3;  prefix[12] = 4;  prefix[13] = 2;  prefix[14] = 1;
                prefix[15] = 5;   prefix[16] = 0;  prefix[17] = 4;  prefix[18] = 32;
                if (hashLength == 48) {
                    prefix[1] = 65; prefix[14] = 2; prefix[18] = 48;
                } else if (hashLength == 64) {
                    prefix[1] = 81; prefix[14] = 3; prefix[18] = 64;
                }

                if (i + 19 + hashLength != k) {
                    delete prefix;
                    return false;
                }
                mutable boolean ok = true;
                mutable int j = 0;
                while (j < 19) {
                    if ((em[i + j] & 255) != prefix[j]) { ok = false; }
                    j = j + 1;
                }
                delete prefix;
                mutable int h = 0;
                while (h < hashLength) {
                    if ((em[i + 19 + h] & 255) != (hash[h] & 255)) { ok = false; }
                    h = h + 1;
                }
                return ok;
            }
        }

        // ---- 256-BIT ARITHMETIC, because the standard library's BigInteger cannot do this job. ----
        //
        // `BigInteger` stores ONE DECIMAL DIGIT PER SLOT. That is a reasonable choice for a type whose
        // job is exact arithmetic a person will read, and it is the wrong one underneath a curve:
        // measured, a modular multiplication of two 256-bit numbers costs 0.16 ms there, and verifying
        // one ECDSA signature needs about 6 700 of them -- over a second per signature, for something
        // a TLS handshake does two or three times.
        //
        // So this is purpose-built and stays here rather than replacing BigInteger, which is used
        // elsewhere and is right for what it does.
        //
        // SIXTEEN-BIT LIMBS, not thirty-two. A product of two 32-bit limbs plus an accumulator plus a
        // carry brushes the top of a 64-bit word, and Polaron's `long` is signed -- one carry too many
        // and the value goes negative and the answer is silently wrong. With 16-bit limbs a product is
        // 32 bits and the accumulator never leaves the comfortable middle of the range. It costs four
        // times the limb operations and buys arithmetic that cannot overflow into nonsense, which for
        // code nobody can eyeball is the right trade.
        public class U256 {
            // THE SIZE COMES FROM THE ARRAY, not from the name. This started as 256-bit-only, which
            // was right for a curve and wrong for everything else: RSA needs 2048 bits, and routing
            // that through the standard library's decimal BigInteger cost 2.3 SECONDS per signature
            // -- measured against a real trust store, where a handshake's two or three verifications
            // would have taken most of ten seconds. The same Montgomery code answers both once the
            // limb count stops being a constant.
            public static method zero() returns long[] { return new long[16](); }
            public static method zeroOf(int limbs) returns long[] { return new long[limbs](); }
            // How many limbs a modulus of this many BYTES needs, rounded up.
            public static method limbsForBytes(int bytes) returns int { return (bytes + 1) / 2; }

            // 64 hex characters, big-endian -- how every curve constant is published.
            public static method fromHex(String hex) returns long[] {
                mutable long[] out = new long[16]();
                mutable int i = 0;
                while (i < 64 && i < hex.length()) {
                    int nybble = U256.hexValue(hex.charAt(hex.length() - 1 - i));
                    int limb = i / 4;
                    int shift = (i % 4) * 4;
                    out[limb] = out[limb] | (cast<long>(nybble) << shift);
                    i = i + 1;
                }
                return out;
            }
            private static method hexValue(char c) returns int {
                if (c >= '0' && c <= '9') { return cast<int>(c) - 48; }
                if (c >= 'a' && c <= 'f') { return cast<int>(c) - 87; }
                if (c >= 'A' && c <= 'F') { return cast<int>(c) - 55; }
                return 0;
            }

            // Big-endian bytes, at most 32 of them. Shorter is fine -- a signature integer often has
            // fewer, and DER strips leading zeros.
            public static method fromBytes(int[] b, int off, int len) returns long[] {
                mutable long[] out = new long[16]();
                mutable int i = 0;
                while (i < len && i < 32) {
                    int value = b[off + len - 1 - i] & 255;
                    int limb = i / 2;
                    int shift = (i % 2) * 8;
                    out[limb] = out[limb] | (cast<long>(value) << shift);
                    i = i + 1;
                }
                return out;
            }
            public static method toBytes(long[] a) returns int[] {
                int[] out = new int[32]();
                mutable int i = 0;
                while (i < 32) {
                    long limb = a[i / 2];
                    int shift = (i % 2) * 8;
                    out[31 - i] = cast<int>((limb >> shift) & cast<long>(255));
                    i = i + 1;
                }
                return out;
            }

            public static method copy(long[] a) returns long[] {
                mutable long[] out = new long[a.length()]();
                for (mutable int i = 0; i < a.length(); i++) { out[i] = a[i]; }
                return out;
            }
            public static method isZero(long[] a) returns boolean {
                for (mutable int i = 0; i < a.length(); i++) {
                    if (a[i] != cast<long>(0)) { return false; }
                }
                return true;
            }
            // -1, 0 or 1. Compared from the top down, which is the only order that terminates early
            // on the common case.
            public static method compare(long[] a, long[] b) returns int {
                for (mutable int i = a.length() - 1; i >= 0; i--) {
                    if (a[i] < b[i]) { return 0 - 1; }
                    if (a[i] > b[i]) { return 1; }
                }
                return 0;
            }
            // `at` and not `index`, which is reserved.
            public static method bit(long[] a, int at) returns int {
                if (at < 0 || at >= a.length() * 16) { return 0; }
                return cast<int>((a[at / 16] >> (at % 16)) & cast<long>(1));
            }
            // a += b, answering the carry out of the top limb.
            public static method addInto(long[] a, long[] b) returns long {
                mutable long carry = cast<long>(0);
                for (mutable int i = 0; i < a.length(); i++) {
                    long sum = a[i] + b[i] + carry;
                    a[i] = sum & cast<long>(65535);
                    carry = sum >> 16;
                }
                return carry;
            }
            // a -= b, answering the borrow.
            public static method subInto(long[] a, long[] b) returns long {
                mutable long borrow = cast<long>(0);
                for (mutable int i = 0; i < a.length(); i++) {
                    long diff = a[i] - b[i] - borrow;
                    if (diff < cast<long>(0)) {
                        a[i] = diff + cast<long>(65536);
                        borrow = cast<long>(1);
                    } else {
                        a[i] = diff;
                        borrow = cast<long>(0);
                    }
                }
                return borrow;
            }
        }

        // MONTGOMERY ARITHMETIC over an odd 256-bit modulus.
        //
        // Multiplying modulo a prime needs a remainder, and a remainder needs division -- the one
        // operation that is genuinely awkward on limbs. Montgomery's trick removes it: numbers are
        // kept multiplied by R = 2^256, and the reduction after a product becomes shifts and
        // multiply-adds. Both moduli this needs (the field prime and the group order) are odd, which
        // is the only condition.
        //
        // Nothing here is constant-time, and that is stated rather than hidden: this verifies
        // signatures with PUBLIC values -- a public key, a signature, a hash -- where a timing channel
        // leaks nothing an observer does not already have. Signing, which touches a private key, is
        // not implemented, and if it ever is it needs different code.
        public class Mont {
            private mutable long[] m;      // the modulus
            private mutable long n0;       // -m^-1 mod 2^16, the per-limb reduction factor
            private mutable long[] rr;     // R^2 mod m, for entering Montgomery form

            public constructor Mont(long[] modulus) {
                this.m = U256.copy(modulus);
                // -m^-1 mod 2^16 by Newton iteration: four doublings take an odd m from 3 correct
                // bits to more than 16.
                mutable long inv = cast<long>(1);
                mutable int i = 0;
                while (i < 5) {
                    inv = (inv * (cast<long>(2) - this.m[0] * inv)) & cast<long>(65535);
                    i = i + 1;
                }
                this.n0 = (cast<long>(65536) - inv) & cast<long>(65535);
                // R^2 mod m, by doubling 1 five hundred and twelve times with a conditional subtract.
                // Doubling avoids needing a division to get here, which is the thing being avoided.
                mutable long[] acc = U256.zeroOf(this.m.length());
                acc[0] = cast<long>(1);
                mutable int d = 0;
                // R = 2^(16*limbs), so R² needs twice that many doublings.
                int doublings = this.m.length() * 32;
                while (d < doublings) {
                    mutable long carry = U256.addInto(acc, acc);
                    if (carry != cast<long>(0) || U256.compare(acc, this.m) >= 0) {
                        U256.subInto(acc, this.m);
                    }
                    d = d + 1;
                }
                this.rr = acc;
            }

            // The Montgomery product: (a * b) / R mod m. Separated operand scanning -- the full
            // 32-limb product first, then one reduction pass per limb.
            public method mul(long[] a, long[] b) returns long[] {
                int n = this.m.length();
                mutable long[] t = new long[2 * n + 2]();
                for (mutable int i = 0; i < n; i++) {
                    mutable long carry = cast<long>(0);
                    for (mutable int j = 0; j < n; j++) {
                        long sum = t[i + j] + a[j] * b[i] + carry;
                        t[i + j] = sum & cast<long>(65535);
                        carry = sum >> 16;
                    }
                    t[i + n] = t[i + n] + carry;
                }
                for (mutable int i = 0; i < n; i++) {
                    long factor = (t[i] * this.n0) & cast<long>(65535);
                    mutable long carry = cast<long>(0);
                    for (mutable int j = 0; j < n; j++) {
                        long sum = t[i + j] + factor * this.m[j] + carry;
                        t[i + j] = sum & cast<long>(65535);
                        carry = sum >> 16;
                    }
                    mutable int k = i + n;
                    while (carry != cast<long>(0) && k < 2 * n + 2) {
                        long sum = t[k] + carry;
                        t[k] = sum & cast<long>(65535);
                        carry = sum >> 16;
                        k = k + 1;
                    }
                }
                mutable long[] out = U256.zeroOf(n);
                for (mutable int i = 0; i < n; i++) { out[i] = t[i + n]; }
                // One conditional subtract: the result is below 2m, never below m by construction.
                if (t[2 * n] != cast<long>(0) || U256.compare(out, this.m) >= 0) {
                    U256.subInto(out, this.m);
                }
                delete t;
                return out;
            }

            public method toMont(long[] a) returns long[] { return this.mul(a, this.rr); }
            public method fromMont(long[] a) returns long[] {
                mutable long[] one = U256.zeroOf(this.m.length());
                one[0] = cast<long>(1);
                long[] r = this.mul(a, one);
                delete one;
                return r;
            }
            // Modular exponentiation with a small public exponent, in one call: a^e mod m, entering
            // and leaving Montgomery form here so callers never see it. This is what makes an RSA
            // verification cost milliseconds instead of the 2.3 SECONDS the decimal BigInteger took.
            public method powSmall(long[] a, int e) returns long[] {
                mutable long[] result = this.toMont(Mont.oneOf(this.m.length()));
                mutable long[] base = this.toMont(a);
                mutable int bit = 30;
                while (bit >= 0) {
                    result = this.mul(result, result);
                    if (((e >> bit) & 1) == 1) { result = this.mul(result, base); }
                    bit = bit - 1;
                }
                delete base;
                long[] out = this.fromMont(result);
                delete result;
                return out;
            }
            private static method oneOf(int limbs) returns long[] {
                mutable long[] one = U256.zeroOf(limbs);
                one[0] = cast<long>(1);
                return one;
            }
            public method addMod(long[] a, long[] b) returns long[] {
                mutable long[] out = U256.copy(a);
                long carry = U256.addInto(out, b);
                if (carry != cast<long>(0) || U256.compare(out, this.m) >= 0) {
                    U256.subInto(out, this.m);
                }
                return out;
            }
            public method subMod(long[] a, long[] b) returns long[] {
                mutable long[] out = U256.copy(a);
                long borrow = U256.subInto(out, b);
                if (borrow != cast<long>(0)) { U256.addInto(out, this.m); }
                return out;
            }
            public method modulus() returns long[] { return this.m; }

            // The inverse, by Fermat: a^(m-2) mod m, square-and-multiply over the exponent's bits.
            // Both operands stay in Montgomery form throughout. Slower than the extended Euclid, and
            // it is the version with no branches on the value -- which costs nothing here and means
            // this stays correct if it is ever reused where that matters.
            public method invMont(long[] aMont) returns long[] {
                mutable long[] e = U256.copy(this.m);
                mutable long[] two = U256.zeroOf(this.m.length());
                two[0] = cast<long>(2);
                U256.subInto(e, two);
                mutable long[] result = this.toMont(Mont.oneOf(this.m.length()));
                mutable long[] base = U256.copy(aMont);
                mutable int i = 0;
                int bits = this.m.length() * 16;
                while (i < bits) {
                    if (U256.bit(e, i) == 1) { result = this.mul(result, base); }
                    base = this.mul(base, base);
                    i = i + 1;
                }
                delete two;
                delete e;
                delete base;
                return result;
            }
            public destructor ~Mont() returns void {
                delete this.rr;
                delete this.m;
            }
        }

        // A POINT ON P-256, in Jacobian coordinates.
        //
        // Affine (x, y) is what a key is written as, and it is the wrong thing to compute with:
        // adding two affine points needs a modular INVERSION, which costs about as much as 250
        // multiplications. Jacobian coordinates carry a third number and represent the affine point
        // (X/Z², Y/Z³), which lets addition and doubling be pure multiplication -- one inversion at
        // the very end converts back.
        //
        // Every coordinate is in Montgomery form. Mixing forms is the kind of mistake that produces a
        // point that is simply wrong rather than an error, so they never leave it until `toAffineX`.
        public class EcPoint {
            public mutable long[] x;
            public mutable long[] y;
            public mutable long[] z;
            public mutable boolean infinite;   // the identity: no affine coordinates at all

            public constructor EcPoint(long[] x, long[] y, long[] z, boolean infinite) {
                this.x = x;
                this.y = y;
                this.z = z;
                this.infinite = infinite;
            }
            public destructor ~EcPoint() returns void {
                delete this.z;
                delete this.y;
                delete this.x;
            }
        }

        // THE NIST P-256 CURVE, and ECDSA verification over it.
        //
        // This is the second half of what makes a TLS certificate chain checkable. RSA alone is not
        // enough: the certificates most of the internet presents today are ECDSA, so a client that
        // verifies only RSA signatures refuses the servers people actually use, or -- worse -- has to
        // treat "I cannot check this" as "this checks out".
        //
        // Verification only. Signing touches a private key and would need constant-time code; nothing
        // here is constant-time, because everything it touches is public.
        public class P256 {
            // The published constants. Hex because that is how they are published, and reading them
            // back out in a test is how a typo in one of them is caught.
            public static method primeHex() returns String {
                return "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
            }
            public static method orderHex() returns String {
                return "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551";
            }
            public static method bHex() returns String {
                return "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b";
            }
            public static method gxHex() returns String {
                return "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296";
            }
            public static method gyHex() returns String {
                return "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5";
            }

            // The identity element. Represented by a flag rather than by z = 0, because every formula
            // below would otherwise have to notice that z is zero and none of them naturally does.
            public static method infinity(Mont* f) returns EcPoint* {
                return new EcPoint(U256.zero(), U256.zero(), U256.zero(), true) on heap;
            }

            // An affine point (x, y) entering the computation: z = 1.
            public static method fromAffine(Mont* f, long[] x, long[] y) returns EcPoint* {
                mutable long[] one = U256.zero();
                one[0] = cast<long>(1);
                mutable long[] zm = f.toMont(one);
                delete one;
                return new EcPoint(f.toMont(x), f.toMont(y), zm, false) on heap;
            }

            // Is this point actually ON the curve: y² = x³ - 3x + b. A public key that is not on the
            // curve is the invalid-curve attack, and the check costs four multiplications -- cheap
            // enough that skipping it would be a decision, and the wrong one.
            public static method isOnCurve(Mont* f, long[] xm, long[] ym) returns boolean {
                mutable long[] bm = f.toMont(U256.fromHex(P256.bHex()));
                mutable long[] left = f.mul(ym, ym);
                mutable long[] x2 = f.mul(xm, xm);
                mutable long[] x3 = f.mul(x2, xm);
                mutable long[] three = U256.zero();
                three[0] = cast<long>(3);
                mutable long[] threeM = f.toMont(three);
                mutable long[] tx = f.mul(threeM, xm);
                mutable long[] right = f.addMod(f.subMod(x3, tx), bm);
                boolean same = U256.compare(left, right) == 0;
                delete three;
                return same;
            }

            // Doubling, with the a = -3 shortcut the curve was chosen to allow.
            public static method twice(Mont* f, EcPoint* p) returns EcPoint* {
                if (p.infinite || U256.isZero(p.y)) { return P256.infinity(f); }
                mutable long[] delta = f.mul(p.z, p.z);
                mutable long[] gamma = f.mul(p.y, p.y);
                mutable long[] beta = f.mul(p.x, gamma);
                mutable long[] sum = f.addMod(p.x, delta);
                mutable long[] diff = f.subMod(p.x, delta);
                mutable long[] prod = f.mul(sum, diff);
                mutable long[] alpha = f.addMod(f.addMod(prod, prod), prod);      // 3*(x-d)*(x+d)
                mutable long[] beta4 = f.addMod(beta, beta);
                beta4 = f.addMod(beta4, beta4);                                   // 4*beta
                mutable long[] x3 = f.subMod(f.mul(alpha, alpha), f.addMod(beta4, beta4));
                mutable long[] yz = f.addMod(p.y, p.z);
                mutable long[] z3 = f.subMod(f.subMod(f.mul(yz, yz), gamma), delta);
                mutable long[] g2 = f.mul(gamma, gamma);
                mutable long[] g8 = f.addMod(g2, g2);
                g8 = f.addMod(g8, g8);
                g8 = f.addMod(g8, g8);                                            // 8*gamma²
                mutable long[] y3 = f.subMod(f.mul(alpha, f.subMod(beta4, x3)), g8);
                return new EcPoint(x3, y3, z3, false) on heap;
            }

            // Addition. The two special cases are the ones that make a naive implementation answer
            // nonsense: equal points need doubling (the formula divides by zero otherwise), and
            // opposite points are the identity.
            public static method add(Mont* f, EcPoint* a, EcPoint* b) returns EcPoint* {
                if (a.infinite) {
                    return new EcPoint(U256.copy(b.x), U256.copy(b.y), U256.copy(b.z), b.infinite) on heap;
                }
                if (b.infinite) {
                    return new EcPoint(U256.copy(a.x), U256.copy(a.y), U256.copy(a.z), a.infinite) on heap;
                }
                mutable long[] z1z1 = f.mul(a.z, a.z);
                mutable long[] z2z2 = f.mul(b.z, b.z);
                mutable long[] u1 = f.mul(a.x, z2z2);
                mutable long[] u2 = f.mul(b.x, z1z1);
                mutable long[] s1 = f.mul(f.mul(a.y, b.z), z2z2);
                mutable long[] s2 = f.mul(f.mul(b.y, a.z), z1z1);
                mutable long[] h = f.subMod(u2, u1);
                mutable long[] rr = f.subMod(s2, s1);
                if (U256.isZero(h)) {
                    if (U256.isZero(rr)) { return P256.twice(f, a); }
                    return P256.infinity(f);
                }
                mutable long[] h2 = f.addMod(h, h);
                mutable long[] i = f.mul(h2, h2);
                mutable long[] j = f.mul(h, i);
                mutable long[] r2 = f.addMod(rr, rr);
                mutable long[] v = f.mul(u1, i);
                mutable long[] x3 = f.subMod(f.subMod(f.mul(r2, r2), j), f.addMod(v, v));
                mutable long[] s1j = f.mul(s1, j);
                mutable long[] y3 = f.subMod(f.mul(r2, f.subMod(v, x3)), f.addMod(s1j, s1j));
                mutable long[] zs = f.addMod(a.z, b.z);
                mutable long[] z3 = f.mul(f.subMod(f.subMod(f.mul(zs, zs), z1z1), z2z2), h);
                return new EcPoint(x3, y3, z3, false) on heap;
            }

            // k*P, double-and-add from the top bit down.
            public static method multiply(Mont* f, EcPoint* p, long[] k) returns EcPoint* {
                // The accumulator is replaced every step, and the OLD point is what gets deleted --
                // under its own name. Writing it the other way round (`delete acc; acc = next;`) is
                // a use of a deleted variable, and the compiler says so: a name does not come back
                // to life by being assigned again.
                mutable EcPoint* acc = P256.infinity(f);
                mutable int i = 255;
                while (i >= 0) {
                    mutable EcPoint* previous = acc;
                    acc = P256.twice(f, previous);
                    delete previous;
                    if (U256.bit(k, i) == 1) {
                        mutable EcPoint* before = acc;
                        acc = P256.add(f, before, p);
                        delete before;
                    }
                    i = i - 1;
                }
                return acc;
            }

            // Back to an affine x: X / Z². The one inversion the whole computation needs.
            public static method affineX(Mont* f, EcPoint* p) returns long[] {
                if (p.infinite) { return U256.zero(); }
                mutable long[] zinv = f.invMont(p.z);
                mutable long[] zinv2 = f.mul(zinv, zinv);
                return f.fromMont(f.mul(p.x, zinv2));
            }

            // ECDSA-with-SHA-256 (FIPS 186-4). `key` is the uncompressed point from the certificate:
            // 0x04 then 32 bytes of x then 32 of y. `sig` is the DER SEQUENCE { INTEGER r, INTEGER s }.
            //
            // Every refusal below is a real attack if it is skipped, which is why each is spelled out
            // rather than folded into one "is it valid" test.
            public static method verify(int[] key, int keyLen, int[] sig, int sigLen,
                                        int[] hash) returns boolean {
                if (keyLen != 65 || (key[0] & 255) != 4) { return false; }   // only uncompressed
                mutable long[] p = U256.fromHex(P256.primeHex());
                mutable long[] n = U256.fromHex(P256.orderHex());
                mutable Mont* fp = new Mont(p) on heap;
                mutable Mont* fn = new Mont(n) on heap;

                // r and s out of the DER, refusing anything outside [1, n-1]: a zero or an
                // out-of-range scalar makes the arithmetic below meaningless and some verifiers
                // accept it.
                if (Der.tag(sig, 0) != 48) { return false; }
                int rInt = Der.contentOffset(sig, 0);
                int sInt = Der.nextOffset(sig, rInt);
                mutable long[] r = P256.integerAt(sig, rInt);
                mutable long[] s = P256.integerAt(sig, sInt);
                if (U256.isZero(r) || U256.isZero(s)) { return false; }
                if (U256.compare(r, n) >= 0 || U256.compare(s, n) >= 0) { return false; }

                mutable long[] qx = U256.fromBytes(key, 1, 32);
                mutable long[] qy = U256.fromBytes(key, 33, 32);
                if (U256.compare(qx, p) >= 0 || U256.compare(qy, p) >= 0) { return false; }
                mutable long[] qxm = fp.toMont(qx);
                mutable long[] qym = fp.toMont(qy);
                if (!P256.isOnCurve(fp, qxm, qym)) { return false; }   // invalid-curve attack

                // e = the hash as an integer, reduced. SHA-256 is exactly the order's width, so no
                // truncation is needed -- only the reduction, which matters when the hash exceeds n.
                mutable long[] e = U256.fromBytes(hash, 0, 32);
                if (U256.compare(e, n) >= 0) { U256.subInto(e, n); }

                mutable long[] w = fn.fromMont(fn.invMont(fn.toMont(s)));
                mutable long[] u1 = fn.fromMont(fn.mul(fn.toMont(e), fn.toMont(w)));
                mutable long[] u2 = fn.fromMont(fn.mul(fn.toMont(r), fn.toMont(w)));

                mutable EcPoint* g = P256.fromAffine(fp, U256.fromHex(P256.gxHex()),
                                                        U256.fromHex(P256.gyHex()));
                mutable EcPoint* q = new EcPoint(qxm, qym, fp.toMont(P256.oneRaw()), false) on heap;
                mutable EcPoint* a = P256.multiply(fp, g, u1);
                mutable EcPoint* b = P256.multiply(fp, q, u2);
                mutable EcPoint* sum = P256.add(fp, a, b);
                if (sum.infinite) { return false; }

                mutable long[] x = P256.affineX(fp, sum);
                if (U256.compare(x, n) >= 0) { U256.subInto(x, n); }
                boolean ok = U256.compare(x, r) == 0;

                delete sum;
                delete b;
                delete a;
                delete q;
                delete g;
                delete fn;
                delete fp;
                return ok;
            }

            private static method oneRaw() returns long[] {
                mutable long[] one = U256.zero();
                one[0] = cast<long>(1);
                return one;
            }
            // A DER INTEGER as a 256-bit value, with the sign-preserving leading zero dropped.
            private static method integerAt(int[] d, int off) returns long[] {
                mutable int c = Der.contentOffset(d, off);
                mutable int len = Der.contentLength(d, off);
                if (len > 0 && (d[c] & 255) == 0) {
                    c = c + 1;
                    len = len - 1;
                }
                if (len > 32) { return U256.zero(); }
                return U256.fromBytes(d, c, len);
            }
        }

        // WHY A CERTIFICATE WAS REFUSED, thrown rather than returned.
        //
        // A boolean can be dropped on the floor without anybody noticing, and a validation result
        // that is dropped is the same program as one that never validated. The failure is not the
        // caller's intention -- their intention was to talk to a server -- so it is not something to
        // hand back for them to remember to inspect. It stops.
        public class CertificateException extends Exception {
            private mutable String detail;
            public constructor CertificateException(String detail) { this.detail = detail; }
            public override method message() returns String {
                return "certificate refused: ".concat(this.detail);
            }
        }

        // THE CERTIFICATES THIS PROGRAM IS WILLING TO START FROM.
        //
        // A chain proves that each certificate was signed by the one above it, and proves nothing at
        // all on its own -- a chain forged from top to bottom is just as self-consistent. What makes
        // it mean something is ending at a key that was trusted for other reasons, and that is what
        // a trust store holds.
        //
        // The roots come from the operating system, which already curates and updates them. That is
        // not delegating the protocol: a root certificate is DATA. Shipping our own bundle inside the
        // compiler would mean a list that goes stale between releases and a revocation nobody acts on.
        // A program may also supply its own -- for a private authority, or for a test.
        public class TrustStore {
            private mutable ArrayList<Certificate*> roots;

            public constructor TrustStore() {
                this.roots = new ArrayList<Certificate*>() on heap;
            }
            public method add(Certificate* root) returns void {
                this.roots.add(root);
                return;
            }
            public method count() returns int { return this.roots.size(); }

            // The roots this machine already trusts, read from the operating system. Windows
            // enumerates its ROOT store; POSIX reads whichever of the well-known bundle files exists,
            // because distributions disagree about where it lives and there is no API to ask.
            //
            // A certificate that will not parse is SKIPPED rather than fatal: a trust store holds
            // hundreds, some of them old and odd, and refusing to start because one of them uses an
            // encoding this reader does not know would be the wrong failure. What is not skipped is
            // an empty result -- a store with nothing in it trusts nothing, and every chain would
            // then be refused, which is at least honest.
            public static method system() returns TrustStore* {
                mutable TrustStore* store = new TrustStore() on heap;
                String all = System.Net.__systemRoots();
                mutable ArrayList<String> lines = Strings.split(all, "\n");
                mutable StringBuilder current = new StringBuilder() on heap;
                mutable boolean inside = false;
                mutable int i = 0;
                while (i < lines.size()) {
                    String line = lines.get(i).trim();
                    if (line.startsWith("-----BEGIN CERTIFICATE")) {
                        inside = true;
                        current.clear();
                        current.append(line);
                        current.append("\n");
                    } else if (line.startsWith("-----END CERTIFICATE")) {
                        if (inside) {
                            current.append(line);
                            current.append("\n");
                            mutable Certificate* one = Certificate.fromPem(current.toString());
                            if (one.isWellFormed()) {
                                store.add(one);
                            } else {
                                delete one;
                            }
                        }
                        inside = false;
                    } else if (inside) {
                        current.append(line);
                        current.append("\n");
                    }
                    i = i + 1;
                }
                delete current;
                delete lines;
                return store;
            }

            // The roots themselves, for a program that wants to report what it trusts -- a tool
            // showing its configuration, or a test checking the store loaded at all. Handed out
            // rather than copied: the store owns them and outlives the caller's look.
            public method certificates() returns ArrayList<Certificate*> {
                return this.roots;
            }

            // The root that issued `cert`, or null when this store does not vouch for it.
            public method issuerOf(Certificate* cert) returns nullable Certificate* {
                mutable int i = 0;
                while (i < this.roots.size()) {
                    Certificate* root = this.roots.get(i);
                    if (cert.isIssuedBy(root)) { return root; }
                    i = i + 1;
                }
                return null;
            }
            public destructor ~TrustStore() returns void {
                delete this.roots;
            }
        }

        // CHECKING THE CHAIN, THE DATES AND THE NAME -- in that order, and refusing at the first
        // thing that does not hold.
        //
        // Three separate questions that a single "is this certificate valid?" runs together, and all
        // three have to be answered:
        //   - was each certificate signed by the next, up to a key we already trusted?
        //   - is every certificate in that path valid TODAY?
        //   - does the leaf cover the host we asked for?
        //
        // A client that checks the signature and not the name accepts any valid certificate for any
        // host -- and anybody can buy a valid certificate for a domain they own. That was the
        // commonest TLS bug in the field for a decade, and it is why the name is checked here rather
        // than left as something the caller may add.
        public class CertificateValidator {
            // Refuses by throwing, naming what failed. `chain` is leaf first, as TLS sends it.
            public static method check(ArrayList<Certificate*> chain, String host,
                                       TrustStore* trusted, long nowSeconds)
                                       throws(CertificateException) returns void {
                if (chain.size() == 0) {
                    throw new CertificateException("the server sent no certificate") on heap;
                }
                Certificate* leaf = chain.get(0);
                if (!leaf.isWellFormed()) {
                    throw new CertificateException("the certificate could not be read") on heap;
                }
                if (!CertificateValidator.covers(leaf, host)) {
                    throw new CertificateException(
                        "it is not for '".concat(host).concat("' -- it covers ")
                            .concat(CertificateValidator.namesOf(leaf))) on heap;
                }
                CertificateValidator.checkDates(leaf, nowSeconds, "the server's certificate");

                // Walk up. Each step must be signed by the next, and each signer must be allowed to
                // sign -- a leaf that signs another leaf is a leaf that could issue for anybody.
                mutable int i = 0;
                mutable boolean reachedTrust = false;
                while (i < chain.size() && !reachedTrust) {
                    Certificate* current = chain.get(i);
                    mutable nullable Certificate* issuer = null;
                    if (i + 1 < chain.size() && current.isIssuedBy(chain.get(i + 1))) {
                        issuer = chain.get(i + 1);
                    } else {
                        issuer = trusted.issuerOf(current);
                        if (issuer != null) { reachedTrust = true; }
                    }
                    if (issuer == null) {
                        throw new CertificateException(
                            "the chain stops at '".concat(current.issuerCommonName())
                                .concat("', which is not one this program trusts")) on heap;
                    }
                    Certificate* signer = cast<Certificate*>(issuer);
                    if (!signer.isCertificateAuthority()) {
                        throw new CertificateException(
                            "'".concat(signer.subjectCommonName())
                                .concat("' signed another certificate and is not allowed to")) on heap;
                    }
                    CertificateValidator.checkDates(signer, nowSeconds,
                        "the issuer '".concat(signer.subjectCommonName()).concat("'"));
                    // Said separately from a failed check, and before it: a client that cannot do
                    // the arithmetic must not report the server as dishonest.
                    String cannot = CertificateValidator.unsupportedReason(current, signer);
                    if (cannot.length() > 0) {
                        throw new CertificateException(
                            "'".concat(current.subjectCommonName()).concat("' cannot be checked: ")
                                .concat(cannot)) on heap;
                    }
                    if (!CertificateValidator.signedBy(current, signer)) {
                        throw new CertificateException(
                            "'".concat(current.subjectCommonName())
                                .concat("' does not carry a valid signature from '")
                                .concat(signer.subjectCommonName()).concat("'")) on heap;
                    }
                    i = i + 1;
                }
                if (!reachedTrust) {
                    throw new CertificateException(
                        "the chain never reaches a certificate this program trusts") on heap;
                }
                return;
            }

            private static method checkDates(Certificate* cert, long nowSeconds, String who)
                                             throws(CertificateException) returns void {
                if (nowSeconds < cert.notBefore()) {
                    throw new CertificateException(who.concat(" is not valid yet")) on heap;
                }
                if (nowSeconds > cert.notAfter()) {
                    throw new CertificateException(who.concat(" has expired")) on heap;
                }
                return;
            }

            // WHY THIS SIGNATURE CANNOT EVEN BE ATTEMPTED, or "" when it can.
            //
            // Refusing and being unable to check are different outcomes with the same consequence,
            // and telling them apart is the difference between "this server is lying to you" and
            // "this client is not finished". Measured against the machine's own trust store: of 18
            // roots sampled, 17 verify and the eighteenth is on P-384 -- a curve this library does
            // not implement, which is a gap in us and not a fault in the certificate.
            public static method unsupportedReason(Certificate* cert, Certificate* issuer)
                                                   returns String {
                int alg = cert.signatureAlgorithm();
                if (alg == 0) {
                    return "it is signed with an algorithm this program cannot check";
                }
                if (alg == 3 || alg == 6) {
                    String curve = issuer.ecCurveName();
                    if (!curve.equals("P-256")) {
                        return "its issuer's key is on ".concat(curve.length() > 0 ? curve : "an unknown curve")
                            .concat(", and this program can only check P-256");
                    }
                }
                return "";
            }

            // Does the issuer's key verify the signature over the signed body? Only algorithms this
            // library can actually check answer true -- an unknown one is refused rather than waved
            // through, because "I could not check it" and "it checks out" must not be the same answer.
            public static method signedBy(Certificate* cert, Certificate* issuer) returns boolean {
                int alg = cert.signatureAlgorithm();
                if (alg == 0) { return false; }   // an algorithm this library cannot check is refused
                mutable int[] body = cert.signedBody();
                int bodyLen = cert.signedBodyLength();
                // THE DIGEST FOLLOWS THE ALGORITHM. Hashing with the wrong one produces a mismatch
                // rather than a wrong acceptance, so this is not a security hole -- but it would
                // reject every SHA-384 chain while blaming the certificate, which is the failure mode
                // this whole class of message exists to avoid.
                mutable int[] hash = (alg == 4 || alg == 6) ? Sha384.digestRaw(body, bodyLen)
                                   : (alg == 5 ? Sha512.digestRaw(body, bodyLen)
                                               : Sha256.digestRaw(body, bodyLen));
                int hashLen = (alg == 4 || alg == 6) ? 48 : (alg == 5 ? 64 : 32);
                mutable int[] sig = cert.signature();
                mutable boolean ok = false;

                if (alg == 3 || alg == 6) {       // ECDSA, over P-256 only
                    mutable int[] point = issuer.ecPublicKey();
                    if (point.length() == 65) {
                        ok = P256.verify(point, 65, sig, cert.signatureLength(), hash);
                    }
                    delete point;
                } else {
                    mutable nullable RsaPublicKey* key = issuer.rsaPublicKey();
                    if (key != null) {
                        RsaPublicKey* rsa = cast<RsaPublicKey*>(key);
                        if (alg == 2) {
                            ok = Rsa.verifyPssSha256(sig, cert.signatureLength(), rsa.modulus,
                                                     rsa.modLength, rsa.exponent, hash);
                        } else {
                            ok = Rsa.verifyPkcs1(sig, cert.signatureLength(), rsa.modulus,
                                                 rsa.modLength, rsa.exponent, hash, hashLen);
                        }
                        delete rsa;
                    }
                }
                delete sig;
                delete hash;
                delete body;
                return ok;
            }

            // RFC 6125 hostname matching, against the subject alternative names and nothing else.
            // The common name has not been valid for this since browsers stopped reading it, and a
            // client that falls back to it accepts certificates the issuing rules never checked.
            public static method covers(Certificate* cert, String host) returns boolean {
                mutable ArrayList<String> names = cert.dnsNames();
                mutable boolean hit = false;
                mutable int i = 0;
                while (i < names.size()) {
                    if (CertificateValidator.nameMatches(names.get(i), host)) { hit = true; }
                    i = i + 1;
                }
                delete names;
                return hit;
            }

            // A wildcard sits in the LEFTMOST label only, replaces exactly one label, and never
            // matches the bare domain: `*.example.com` covers `api.example.com` and neither
            // `example.com` nor `a.b.example.com`. Everything else is an exact, case-insensitive
            // comparison.
            public static method nameMatches(String pattern, String host) returns boolean {
                String p = pattern.toLower();
                String h = host.toLower();
                if (!p.startsWith("*.")) { return p.equals(h); }
                String suffix = p.substring(1, p.length());        // ".example.com"
                if (!h.endsWith(suffix)) { return false; }
                // What the wildcard stood for must be exactly one label: non-empty, and no dot.
                int cut = h.length() - suffix.length();
                if (cut <= 0) { return false; }                    // the bare domain
                mutable int i = 0;
                while (i < cut) {
                    if (h.charAt(i) == '.') { return false; }
                    i = i + 1;
                }
                return true;
            }

            // For the refusal message: what the certificate actually covers, so a reader can see the
            // mismatch instead of being told there is one.
            private static method namesOf(Certificate* cert) returns String {
                mutable ArrayList<String> names = cert.dnsNames();
                if (names.size() == 0) {
                    delete names;
                    return "no host names at all";
                }
                mutable StringBuilder out = new StringBuilder() on heap;
                mutable int i = 0;
                while (i < names.size() && i < 4) {
                    if (i > 0) { out.append(", "); }
                    out.append(names.get(i));
                    i = i + 1;
                }
                if (names.size() > 4) { out.append(", and more"); }
                delete names;
                return out.toString();
            }
        }
    }

