    public namespace Net {
        // A blocking TCP socket (spec 34) wrapping an OS handle (or -1 on failure). Build a client with
        // Socket.connect(host, port); a ServerSocket.accept() also hands back a Socket. send/receive/
        // close lower to runtime winsock helpers.
        public class Socket {
            private mutable long handle;
            public constructor Socket(long handle) { this.handle = handle; }
            public static method connect(String host, int port) returns Socket {
                return new Socket(Net.connect(host, port)) on heap;
            }
            public method isOpen() returns boolean { return this.handle >= cast<long>(0); }
            public method send(String data) returns long { return Net.send(this.handle, data); }
            public method receive(int max) returns String { return Net.recv(this.handle, max); }
            public method close() returns void { Net.close(this.handle); }
        }
        // A listening TCP server socket (spec 34): bind+listen on a port, then accept() blocks for the
        // next connection and returns a Socket for it.
        public class ServerSocket {
            private mutable long handle;
            public constructor ServerSocket(int port) { this.handle = Net.listen(port); }
            public method isOpen() returns boolean { return this.handle >= cast<long>(0); }
            public method accept() returns Socket { return new Socket(Net.accept(this.handle)) on heap; }
            public method close() returns void { Net.close(this.handle); }
        }
        // A received datagram (spec 34): its payload plus the sender's address, so a server can reply.
        public record Datagram(String data, String host, int port) {}
        // A UDP socket (spec 34): connectionless datagrams. Open with port 0 for an ephemeral client port,
        // or a fixed port to receive on. send addresses each datagram; receive returns the payload together
        // with the sender's address (via the runtime's last-sender record) for request/reply exchanges.
        public class UdpSocket {
            private mutable long handle;
            public constructor UdpSocket(int port) { this.handle = Net.udpOpen(port); }
            public method isOpen() returns boolean { return this.handle >= cast<long>(0); }
            public method send(String host, int port, String data) returns long {
                return Net.udpSend(this.handle, host, port, data);
            }
            public method receive(int max) returns Datagram {
                String payload = Net.udpRecv(this.handle, max);
                return new Datagram(payload, Net.udpPeerHost(), Net.udpPeerPort()) on heap;
            }
            public method close() returns void { Net.udpClose(this.handle); }
        }
        // A URL, taken apart (RFC 3986). The library had `UrlCodec` and `QueryString` for escaping and
        // for a query's pairs, and nothing that could read `https://host:8443/a/b?x=1#top` -- so every
        // caller of `Http.get` had to have already split the host from the path by hand, which is
        // exactly the kind of parsing that is easy to do nearly right.
        //
        // The port is the SCHEME'S DEFAULT when the URL does not say -- 80 or 443 -- because a caller
        // that has to remember which is which is a caller that will one day connect to port 0.
        public class Url {
            private mutable String schemePart;
            private mutable String hostPart;
            private mutable int portPart;
            private mutable String pathPart;
            private mutable String queryPart;
            private mutable String fragmentPart;

            public constructor Url(String scheme, String host, int port, String path, String query,
                                   String fragment) {
                this.schemePart = scheme;
                this.hostPart = host;
                this.portPart = port;
                this.pathPart = path;
                this.queryPart = query;
                this.fragmentPart = fragment;
            }

            public static method parse(String text) returns Url {
                mutable String rest = text;
                mutable String scheme = "";
                int colon = rest.indexOf("://");
                if (colon >= 0) {
                    scheme = rest.substring(0, colon);
                    rest = rest.substring(colon + 3, rest.length());
                }
                // The fragment goes first: it is never sent, and it may contain a '?' or a '/' that
                // would otherwise be read as part of the query or the path.
                mutable String fragment = "";
                int hash = rest.indexOf("#");
                if (hash >= 0) {
                    fragment = rest.substring(hash + 1, rest.length());
                    rest = rest.substring(0, hash);
                }
                mutable String query = "";
                int q = rest.indexOf("?");
                if (q >= 0) {
                    query = rest.substring(q + 1, rest.length());
                    rest = rest.substring(0, q);
                }
                mutable String path = "/";
                int slash = rest.indexOf("/");
                if (slash >= 0) {
                    path = rest.substring(slash, rest.length());
                    rest = rest.substring(0, slash);
                }
                mutable String host = rest;
                mutable int port = scheme.equals("https") ? 443 : 80;
                int pc = host.indexOf(":");
                if (pc >= 0) {
                    String digits = host.substring(pc + 1, host.length());
                    host = host.substring(0, pc);
                    mutable int n = 0;
                    mutable boolean any = false;
                    for (mutable int i = 0; i < digits.length(); i++) {
                        char c = digits.charAt(i);
                        if (c >= '0' && c <= '9') { n = n * 10 + cast<int>(c - '0'); any = true; }
                    }
                    if (any) { port = n; }
                }
                if (path.length() == 0) { path = "/"; }
                return new Url(scheme, host, port, path, query, fragment) on heap;
            }

            public method scheme() returns String { return this.schemePart; }
            public method host() returns String { return this.hostPart; }
            public method port() returns int { return this.portPart; }
            public method path() returns String { return this.pathPart; }
            public method query() returns String { return this.queryPart; }
            public method fragment() returns String { return this.fragmentPart; }
            public method isSecure() returns boolean { return this.schemePart.equals("https"); }

            // What goes on the request line: the path with its query, and never the fragment.
            public method requestTarget() returns String {
                if (this.queryPart.length() == 0) { return this.pathPart; }
                return this.pathPart.concat("?").concat(this.queryPart);
            }
            // What goes in the Host header: the port is included only when it is not the scheme's
            // default, which is what a server compares against its own configuration.
            public method authority() returns String {
                boolean standard = (this.portPart == 80 && !this.isSecure()) ||
                                   (this.portPart == 443 && this.isSecure());
                if (standard) { return this.hostPart; }
                return this.hostPart.concat(":").concat(this.portPart.toString());
            }
            public method toText() returns String {
                StringBuilder sb = new StringBuilder() on heap;
                if (this.schemePart.length() > 0) { sb.append(this.schemePart); sb.append("://"); }
                sb.append(this.authority());
                sb.append(this.pathPart);
                if (this.queryPart.length() > 0) { sb.append("?"); sb.append(this.queryPart); }
                if (this.fragmentPart.length() > 0) { sb.append("#"); sb.append(this.fragmentPart); }
                return sb.toString();
            }
            // A `Location:` header may be absolute or relative, and a client that follows redirects
            // has to handle both. Relative-from-root replaces the path; anything else is resolved
            // against the base's directory.
            public method resolve(String reference) returns Url {
                if (reference.indexOf("://") >= 0) { return Url.parse(reference); }
                if (reference.length() > 0 && reference.charAt(0) == '/') {
                    return new Url(this.schemePart, this.hostPart, this.portPart, reference, "", "")
                               on heap;
                }
                mutable int cut = this.pathPart.length();
                while (cut > 0 && this.pathPart.charAt(cut - 1) != '/') { cut = cut - 1; }
                String base = this.pathPart.substring(0, cut);
                return new Url(this.schemePart, this.hostPart, this.portPart,
                               base.concat(reference), "", "") on heap;
            }
        }

        // A parsed HTTP response (spec 34): the raw text is kept and queried lazily. status reads the code
        // from the start line, header returns a field's value, and body is everything after the blank line.
        public class HttpResponse {
            private mutable String raw;
            public constructor HttpResponse(String raw) { this.raw = raw; }
            public method raw() returns String { return this.raw; }
            public method status() returns int {
                int sp = this.raw.indexOf(" ");
                if (sp < 0) { return 0; }
                mutable int n = 0;
                mutable int i = sp + 1;
                while (i < this.raw.length() && this.raw.charAt(i) >= '0' && this.raw.charAt(i) <= '9') {
                    n = n * 10 + (cast<int>(this.raw.charAt(i)) - cast<int>('0'));
                    i = i + 1;
                }
                return n;
            }
            public method body() returns String {
                int idx = this.raw.indexOf("\r\n\r\n");
                if (idx < 0) { return ""; }
                String b = this.raw.substring(idx + 4, this.raw.length());
                // `Transfer-Encoding: chunked` is what an HTTP/1.1 server sends when it does not know
                // the length in advance, which is most of them for anything generated. Returning the
                // chunked framing as though it were the body hands the caller its own content with
                // hex lengths sprinkled through it -- text that looks almost right, which is the worst
                // kind of wrong.
                if (this.header("Transfer-Encoding").indexOf("chunked") >= 0) {
                    return HttpResponse.dechunk(b);
                }
                return b;
            }
            // HEADERS ARE SEARCHED IN THE HEADER SECTION ONLY. This used to scan the whole response,
            // so a body that happened to contain `Content-Type: ` -- an email, a code sample, a
            // proxied response quoted inside another -- answered as if it were a header of this one.
            public method header(String name) returns String {
                int end = this.raw.indexOf("\r\n\r\n");
                String head = end < 0 ? this.raw : this.raw.substring(0, end);
                String key = name.concat(": ");
                // From a line start, so `X-Rate: 1` is not found by asking for `Rate`.
                mutable int at = 0;
                while (at < head.length()) {
                    mutable int lineEnd = at;
                    while (lineEnd < head.length() && head.charAt(lineEnd) != '\r') {
                        lineEnd = lineEnd + 1;
                    }
                    String line = head.substring(at, lineEnd);
                    if (line.length() >= key.length() &&
                        Strings.equalsIgnoreCase(line.substring(0, key.length()), key)) {
                        return line.substring(key.length(), line.length());
                    }
                    at = lineEnd + 2;
                }
                return "";
            }
            public method hasHeader(String name) returns boolean {
                return this.header(name).length() > 0;
            }
            // Each chunk is a hex length on its own line, then that many bytes, until a zero length.
            private static method dechunk(String b) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                mutable int at = 0;
                mutable boolean more = true;
                while (more && at < b.length()) {
                    mutable int lineEnd = at;
                    while (lineEnd < b.length() && b.charAt(lineEnd) != '\r') { lineEnd = lineEnd + 1; }
                    String sizeText = b.substring(at, lineEnd);
                    mutable int size = 0;
                    for (mutable int i = 0; i < sizeText.length(); i++) {
                        char c = sizeText.charAt(i);
                        mutable int d = -1;
                        if (c >= '0' && c <= '9') { d = cast<int>(c - '0'); }
                        if (c >= 'a' && c <= 'f') { d = 10 + cast<int>(c - 'a'); }
                        if (c >= 'A' && c <= 'F') { d = 10 + cast<int>(c - 'A'); }
                        if (d < 0) { i = sizeText.length(); } else { size = size * 16 + d; }
                    }
                    at = lineEnd + 2;
                    if (size == 0) { more = false; }
                    else {
                        mutable int stop = at + size;
                        if (stop > b.length()) { stop = b.length(); }
                        sb.append(b.substring(at, stop));
                        at = stop + 2;                   // past the chunk's own trailing CRLF
                    }
                }
                return sb.toString();
            }
        }
        // A REQUEST YOU CAN BUILD BEFORE YOU SEND IT.
        //
        // `Http.get(host, port, path)` was the entire client: one verb, no headers you could set, no
        // body you could send. So nothing could authenticate, post a form, send JSON, or set an
        // Accept -- which is nearly everything an HTTP client is for. This is the request as a value,
        // so it can be built, inspected and tested without a socket anywhere near it.
        public class HttpRequest {
            private mutable String verbPart;
            private mutable Url target;
            private mutable ArrayList<String> headerNames;
            private mutable ArrayList<String> headerValues;
            private mutable String bodyPart;

            public constructor HttpRequest(String verb, Url* url) {
                this.verbPart = verb;
                this.target = url;
                this.headerNames = new ArrayList<String>() on heap;
                this.headerValues = new ArrayList<String>() on heap;
                this.bodyPart = "";
            }
            public static method of(String verb, String url) returns HttpRequest {
                return new HttpRequest(verb, Url.parse(url)) on heap;
            }
            public static method get(String url) returns HttpRequest { return HttpRequest.of("GET", url); }
            public static method post(String url) returns HttpRequest { return HttpRequest.of("POST", url); }
            public static method put(String url) returns HttpRequest { return HttpRequest.of("PUT", url); }
            public static method patch(String url) returns HttpRequest { return HttpRequest.of("PATCH", url); }
            public static method remove(String url) returns HttpRequest {  // `delete` is a keyword
                return HttpRequest.of("DELETE", url);
            }
            public static method head(String url) returns HttpRequest { return HttpRequest.of("HEAD", url); }

            public method url() returns Url { return this.target; }
            public method verb() returns String { return this.verbPart; }
            public method body() returns String { return this.bodyPart; }

            public method setHeader(String name, String value) returns void {
                for (mutable int i = 0; i < this.headerNames.size(); i++) {
                    if (Strings.equalsIgnoreCase(this.headerNames.get(i), name)) {
                        this.headerValues.set(i, value);
                        return;
                    }
                }
                this.headerNames.add(name);
                this.headerValues.add(value);
                return;
            }
            public method header(String name) returns String {
                for (mutable int i = 0; i < this.headerNames.size(); i++) {
                    if (Strings.equalsIgnoreCase(this.headerNames.get(i), name)) { return this.headerValues.get(i); }
                }
                return "";
            }
            // A body implies its length, so `Content-Length` is set here rather than left to the
            // caller: a request whose body and length disagree is one a server will hang waiting on.
            public method setBody(String value) returns void {
                this.bodyPart = value;
                this.setHeader("Content-Length", value.length().toString());
                return;
            }
            public method setJson(String value) returns void {
                this.setHeader("Content-Type", "application/json");
                this.setBody(value);
                return;
            }
            public method setForm(String encoded) returns void {
                this.setHeader("Content-Type", "application/x-www-form-urlencoded");
                this.setBody(encoded);
                return;
            }
            // HTTP Basic, which is the one scheme that is pure string work. Bearer tokens and the rest
            // are `setHeader("Authorization", ...)` and need nothing from here.
            public method setBasicAuth(String user, String password) returns void {
                String pair = user.concat(":").concat(password);
                this.setHeader("Authorization", "Basic ".concat(Base64.encode(pair)));
                return;
            }

            // The bytes that go on the wire. Pure: no socket, no clock, nothing that can fail -- which
            // is what lets a test assert on a request without a server to send it to.
            public method toWire() returns String {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(this.verbPart);
                sb.append(" ");
                sb.append(this.target.requestTarget());
                sb.append(" HTTP/1.1\r\nHost: ");
                sb.append(this.target.authority());
                sb.append("\r\n");
                for (mutable int i = 0; i < this.headerNames.size(); i++) {
                    sb.append(this.headerNames.get(i));
                    sb.append(": ");
                    sb.append(this.headerValues.get(i));
                    sb.append("\r\n");
                }
                // Connection: close last and unconditional -- this client reads until the socket ends,
                // so a keep-alive reply would leave it waiting for bytes nobody is going to send.
                sb.append("Connection: close\r\n\r\n");
                sb.append(this.bodyPart);
                return sb.toString();
            }
        }

        // The client: one round trip, and the redirects if you ask for them.
        public class HttpClient {
            public static method send(HttpRequest* request) returns HttpResponse {
                Url u = request.url();
                if (u.isSecure()) { return HttpClient.sendSecure(request, u); }
                Socket s = new Socket(Net.connect(u.host(), u.port())) on heap;
                if (!s.isOpen()) {
                    return new HttpResponse("HTTP/1.1 000 Connection failed\r\n\r\n") on heap;
                }
                s.send(request.toWire());
                StringBuilder sb = new StringBuilder() on heap;
                mutable boolean more = true;
                while (more) {
                    String chunk = s.receive(4096);
                    if (chunk.length() == 0) { more = false; } else { sb.append(chunk); }
                }
                s.close();
                return new HttpResponse(sb.toString()) on heap;
            }

            // An https URL: the same request, over a connection that is encrypted AND authenticated.
            //
            // THE FAILURES BECOME STATUS LINES, and only here. Everywhere else in this library a
            // refusal is thrown, because a boolean can be dropped and a status line the caller does
            // not read is a certificate error treated as a page. But `send` already answers a
            // synthetic response when a plain connection fails, and one method that sometimes throws
            // and sometimes does not is worse than either: the caller who checks `status()` for one
            // failure would have to also catch for the other. The distinct codes are what keeps the
            // reason legible -- 526 is the certificate, 525 is the handshake, matching what the
            // proxies that invented those codes mean by them.
            private static method sendSecure(HttpRequest& request, Url u) returns HttpResponse {
                mutable nullable TlsSession* session = null;
                try {
                    session = TlsClient.open(u.host(), u.port());
                } catch (CertificateException e) {
                    return new HttpResponse("HTTP/1.1 526 ".concat(e.message())
                                            .concat("\r\n\r\n")) on heap;
                } catch (TlsException e) {
                    return new HttpResponse("HTTP/1.1 525 ".concat(e.message())
                                            .concat("\r\n\r\n")) on heap;
                }
                TlsSession* live = cast<TlsSession*>(session);
                live.send(request.toWire());
                StringBuilder sb = new StringBuilder() on stack;
                mutable boolean more = true;
                while (more) {
                    String chunk = live.receive();
                    if (chunk.length() == 0) { more = false; } else { sb.append(chunk); }
                }
                live.close();
                String text = sb.toString();
                delete live;
                return new HttpResponse(text) on heap;
            }

            // Follows 301/302/303/307/308 up to `limit` hops. Bounded because a server may point at
            // itself, and a client that follows forever is a client that hangs rather than fails.
            // 303 and 302 become GET, which is what every browser does and what servers expect.
            public static method sendFollowing(HttpRequest* request, int limit) returns HttpResponse {
                mutable HttpRequest* current = request;
                mutable int hops = 0;
                while (hops <= limit) {
                    HttpResponse r = HttpClient.send(current);
                    int code = r.status();
                    boolean redirect = code == 301 || code == 302 || code == 303 || code == 307 ||
                                       code == 308;
                    if (!redirect) { return r; }
                    String where = r.header("Location");
                    if (where.length() == 0) { return r; }
                    Url next = current.url().resolve(where);
                    String verb = (code == 303 || code == 302) ? "GET" : current.verb();
                    current = new HttpRequest(verb, next) on heap;
                    hops = hops + 1;
                }
                return new HttpResponse("HTTP/1.1 000 Too many redirects\r\n\r\n") on heap;
            }
        }

        // A minimal HTTP/1.1 client over Socket (spec 34). Kept as it was: `Http.get` is what existing
        // programs call, and it is still the shortest way to fetch a page. `HttpRequest`/`HttpClient`
        // above are for everything it cannot express.
        public class Http {
            public static method buildRequest(String verb, String host, String path) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(verb);
                sb.append(" ");
                sb.append(path);
                sb.append(" HTTP/1.1\r\nHost: ");
                sb.append(host);
                sb.append("\r\nConnection: close\r\n\r\n");
                return sb.toString();
            }
            public static method get(String host, int port, String path) returns HttpResponse {
                Socket s = new Socket(Net.connect(host, port)) on heap;
                s.send(Http.buildRequest("GET", host, path));
                StringBuilder sb = new StringBuilder() on heap;
                mutable boolean more = true;
                while (more) {
                    String chunk = s.receive(4096);
                    if (chunk.length() == 0) { more = false; } else { sb.append(chunk); }
                }
                s.close();
                return new HttpResponse(sb.toString()) on heap;
            }
            // The whole URL in one call, which is how a caller thinks of it.
            public static method fetch(String url) returns HttpResponse {
                HttpRequest* r = HttpRequest.get(url);
                return HttpClient.sendFollowing(r, 5);
            }
        }

        // ---- THE SERVER SIDE, which was the half that was missing. ----
        //
        // `HttpRequest` BUILDS a request and `HttpResponse` READS one: both are the client's view.
        // A server has the mirror job -- read the request off the wire, decide what answers it, write
        // the response -- and had only `ServerSocket.accept()`, which hands back a socket and leaves
        // every byte after that to the program.
        //
        // Named `ServerRequest`/`ServerResponse` rather than `Request`/`Response` for the reason
        // `Schema` is not `Shape`: those two are among the likeliest names in anybody's own program,
        // and a standard library that takes them makes every such program build with a warning about
        // something its author did nothing wrong to cause.

        // A request as it arrived: verb, path, query, headers, body -- and the path parameters the
        // router filled in from the pattern that matched.
        public class ServerRequest {
            private mutable String verbPart;
            private mutable String pathPart;
            private mutable String queryPart;
            private mutable String bodyPart;
            private mutable HashMap<String, String> headerMap;
            private mutable HashMap<String, String> paramMap;

            public constructor ServerRequest(String verb, String path, String query, String body) {
                this.verbPart = verb;
                this.pathPart = path;
                this.queryPart = query;
                this.bodyPart = body;
                this.headerMap = new HashMap<String, String>() on heap;
                this.paramMap = new HashMap<String, String>() on heap;
            }

            // `verb` and not `method`, which is a keyword -- the same choice `HttpRequest` made.
            public method verb() returns String { return this.verbPart; }
            public method path() returns String { return this.pathPart; }
            public method queryString() returns String { return this.queryPart; }
            public method body() returns String { return this.bodyPart; }
            // Header names are matched WITHOUT case, because the wire does not agree on it: a client
            // may send `Content-Type` or `content-type` and both mean the same header.
            public method header(String name) returns String {
                return this.headerMap.getOrDefault(name.toLower(), "");
            }
            public method hasHeader(String name) returns boolean {
                return this.headerMap.containsKey(name.toLower());
            }
            public method setHeader(String name, String value) returns void {
                this.headerMap.put(name.toLower(), value);
            }
            public method query(String name) returns String {
                HashMap<String, String> q = QueryString.parse(this.queryPart);
                String v = q.getOrDefault(name, "");
                delete q;
                return v;
            }
            // A segment captured by the route pattern: `/users/{id}` matching `/users/42` gives
            // `param("id")` = "42". Filled by the router, empty for anything it did not capture.
            public method param(String name) returns String {
                return this.paramMap.getOrDefault(name, "");
            }
            public method setParam(String name, String value) returns void {
                this.paramMap.put(name, value);
            }

            // FROM THE WIRE. `GET /users/42?full=1 HTTP/1.1`, then headers, then a blank line, then
            // the body. Tolerates `\n` as well as `\r\n`, because a hand-written client sends either
            // and refusing one of them makes the server look broken to a person testing it by hand.
            public static method parse(String raw) returns ServerRequest {
                String text = Strings.replace(raw, "\r\n", "\n");
                int split = text.indexOf("\n\n");
                mutable String head = text;
                mutable String body = "";
                if (split >= 0) {
                    head = text.substring(0, split);
                    body = text.substring(split + 2, text.length());
                }
                ArrayList<String> lines = Strings.split(head, "\n");
                mutable String verb = "GET";
                mutable String target = "/";
                if (lines.size() > 0) {
                    ArrayList<String> parts = Strings.split(lines.get(0), " ");
                    if (parts.size() > 0) { verb = parts.get(0); }
                    if (parts.size() > 1) { target = parts.get(1); }
                    delete parts;
                }
                mutable String path = target;
                mutable String query = "";
                int q = target.indexOf("?");
                if (q >= 0) {
                    path = target.substring(0, q);
                    query = target.substring(q + 1, target.length());
                }
                ServerRequest r = new ServerRequest(verb, path, query, body) on heap;
                for (mutable int i = 1; i < lines.size(); i++) {
                    String line = lines.get(i);
                    int colon = line.indexOf(":");
                    if (colon > 0) {
                        r.setHeader(line.substring(0, colon),
                                    line.substring(colon + 1, line.length()).trim());
                    }
                }
                delete lines;
                return r;
            }
        }

        // A response being built. Fluent, because a handler writes one in a line and a builder that
        // needs four statements is a builder people work around.
        public class ServerResponse {
            private mutable int statusCode;
            private mutable String bodyPart;
            private mutable HashMap<String, String> headerMap;

            public constructor ServerResponse(int status, String body) {
                this.statusCode = status;
                this.bodyPart = body;
                this.headerMap = new HashMap<String, String>() on heap;
            }
            public static method of(int status, String body) returns ServerResponse {
                return new ServerResponse(status, body) on heap;
            }
            public static method ok(String body) returns ServerResponse {
                return new ServerResponse(200, body) on heap;
            }
            public static method json(String body) returns ServerResponse {
                ServerResponse r = new ServerResponse(200, body) on heap;
                r.setHeader("Content-Type", "application/json");
                return r;
            }
            public static method notFound() returns ServerResponse {
                return new ServerResponse(404, "not found") on heap;
            }
            public method status() returns int { return this.statusCode; }
            public method body() returns String { return this.bodyPart; }
            public method setHeader(String name, String value) returns void {
                this.headerMap.put(name, value);
            }
            public method header(String name) returns String {
                return this.headerMap.getOrDefault(name, "");
            }

            // The bytes to put on the wire. `Content-Length` is written from the body rather than
            // trusted from a header: a wrong length is a hang at the other end, which is the worst
            // way for this to be wrong.
            public method toRaw() returns String {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("HTTP/1.1 ");
                sb.appendInt(this.statusCode);
                sb.append(" ");
                sb.append(ServerResponse.reason(this.statusCode));
                sb.append("\r\n");
                ArrayList<String> names = this.headerMap.keys();
                for (mutable int i = 0; i < names.size(); i++) {
                    sb.append(names.get(i));
                    sb.append(": ");
                    sb.append(this.headerMap.get(names.get(i)));
                    sb.append("\r\n");
                }
                delete names;
                sb.append("Content-Length: ");
                sb.appendInt(this.bodyPart.length());
                sb.append("\r\n\r\n");
                sb.append(this.bodyPart);
                return sb.toString();
            }
            public static method reason(int code) returns String {
                if (code == 200) { return "OK"; }
                if (code == 201) { return "Created"; }
                if (code == 204) { return "No Content"; }
                if (code == 400) { return "Bad Request"; }
                if (code == 401) { return "Unauthorized"; }
                if (code == 403) { return "Forbidden"; }
                if (code == 404) { return "Not Found"; }
                if (code == 405) { return "Method Not Allowed"; }
                if (code == 500) { return "Internal Server Error"; }
                return "Unknown";
            }
        }

        // One route: a verb, a pattern and what answers it.
        public class Route {
            public String verb;
            public String pattern;
            public function<ServerResponse*, ServerRequest*> handler;
            public constructor Route(String verb, String pattern,
                                     function<ServerResponse*, ServerRequest*> handler) {
                this.verb = verb;
                this.pattern = pattern;
                this.handler = handler;
            }
        }

        // WHICH HANDLER ANSWERS A REQUEST. Patterns are path segments, with `{name}` capturing one:
        // `/users/{id}/posts` matches `/users/42/posts` and gives `param("id")` = "42".
        //
        // First match wins, in the order the routes were added -- which is the rule that lets a
        // program put a specific route before a general one and have it mean something. A table that
        // sorted by "most specific" would be cleverer and would make the order in the file a lie.
        public class Router {
            private mutable ArrayList<Route> routes;
            public constructor Router() {
                this.routes = new ArrayList<Route>() on heap;
            }
            public method add(String verb, String pattern,
                              function<ServerResponse*, ServerRequest*> handler) returns void {
                this.routes.add(new Route(verb, pattern, handler) on heap);
            }
            public method get(String pattern,
                              function<ServerResponse*, ServerRequest*> handler) returns void {
                this.add("GET", pattern, handler);
            }
            public method post(String pattern,
                               function<ServerResponse*, ServerRequest*> handler) returns void {
                this.add("POST", pattern, handler);
            }
            public method size() returns int { return this.routes.size(); }

            // The answer, or 404 when no pattern matches -- and 405 when a pattern matches under a
            // DIFFERENT verb, because "you asked the wrong way" and "there is nothing here" are
            // different answers and telling them apart is most of what makes an API debuggable.
            public method dispatch(ServerRequest* request) returns ServerResponse* {
                mutable boolean pathMatched = false;
                for (mutable int i = 0; i < this.routes.size(); i++) {
                    Route r = this.routes.get(i);
                    if (!Router.matches(r.pattern, request.path(), request)) { continue; }
                    pathMatched = true;
                    if (!r.verb.equals(request.verb())) { continue; }
                    return r.handler(request);
                }
                if (pathMatched) { return ServerResponse.of(405, "method not allowed"); }
                return ServerResponse.notFound();
            }

            // Segment by segment. A `{name}` segment captures whatever is in that position; anything
            // else must be equal. Different lengths never match, so `/a` does not answer `/a/b`.
            public static method matches(String pattern, String path, ServerRequest& into) returns boolean {
                ArrayList<String> want = Strings.split(pattern, "/");
                ArrayList<String> got = Strings.split(path, "/");
                mutable boolean ok = want.size() == got.size();
                if (ok) {
                    for (mutable int i = 0; i < want.size(); i++) {
                        String w = want.get(i);
                        if (w.length() > 2 && w.charAt(0) == '{' && w.charAt(w.length() - 1) == '}') {
                            into.setParam(w.substring(1, w.length() - 1), got.get(i));
                            continue;
                        }
                        if (!w.equals(got.get(i))) { ok = false; }
                    }
                }
                delete got;
                delete want;
                return ok;
            }
        }
    }
