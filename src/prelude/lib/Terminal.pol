    public namespace Terminal {
        // WRITING TO A TERMINAL, which is what a compiler, a test runner and every command-line tool
        // spend their output on -- and the library had `Console.println` and nothing else. Colour and
        // alignment were left to each program to reinvent, which is why every one of them reinvents
        // them slightly differently.
        //
        // TWO PIECES, and they are separate on purpose: `Style` decides what a piece of text LOOKS
        // like, `TextTable` decides where it GOES. Mixing them is how a table ends up unable to hold
        // coloured text, because the width of `[31mred[0m` is 3 and its length is 13.
        // `TextTable` measures with `Style.width`, so a cell may be styled and still line up.

        // ANSI styling, as escape sequences. Every one of these is a no-op when styling is off, so a
        // program does not grow an `if` at every call site -- see `Style.enabled`.
        public class Style {
            // OFF BY DEFAULT WHEN THE OUTPUT IS NOT A TERMINAL is the rule this exists to make easy,
            // and the decision belongs to the program: a library cannot see where its output goes,
            // and guessing is how escape codes end up in a log file or a test's expected output.
            // `styling` and not `on`, which is a reserved word (`new X() on heap`).
            private static mutable boolean styling = true;
            public static method enabled() returns boolean { return Style.styling; }
            public static method enable(boolean value) returns void { Style.styling = value; }

            private static method wrap(String code, String text) returns String {
                if (!Style.styling) { return text; }
                mutable StringBuilder sb = new StringBuilder() on heap;
                sb.appendChar(cast<char>(27));
                sb.append("[");
                sb.append(code);
                sb.append("m");
                sb.append(text);
                sb.appendChar(cast<char>(27));
                sb.append("[0m");
                return sb.toString();
            }

            public static method red(String s) returns String { return Style.wrap("31", s); }
            public static method green(String s) returns String { return Style.wrap("32", s); }
            public static method yellow(String s) returns String { return Style.wrap("33", s); }
            public static method blue(String s) returns String { return Style.wrap("34", s); }
            public static method magenta(String s) returns String { return Style.wrap("35", s); }
            public static method cyan(String s) returns String { return Style.wrap("36", s); }
            public static method grey(String s) returns String { return Style.wrap("90", s); }
            public static method bold(String s) returns String { return Style.wrap("1", s); }
            public static method dim(String s) returns String { return Style.wrap("2", s); }
            public static method underline(String s) returns String { return Style.wrap("4", s); }
            // 24-bit colour, for a program that already has one packed (see System.Text.Colors).
            public static method rgb(int r, int g, int b, String s) returns String {
                mutable StringBuilder code = new StringBuilder() on heap;
                code.append("38;2;");
                code.appendInt(r & 255);
                code.append(";");
                code.appendInt(g & 255);
                code.append(";");
                code.appendInt(b & 255);
                return Style.wrap(code.toString(), s);
            }

            // HOW WIDE THIS IS ON SCREEN, which is not its length: an escape sequence occupies no
            // columns. Anything that aligns text has to ask this and not `length()`, or a coloured
            // cell pushes its whole row out of line -- the single commonest bug in hand-written
            // terminal output.
            public static method width(String s) returns int {
                mutable int w = 0;
                mutable boolean inEscape = false;
                for (mutable int i = 0; i < s.length(); i++) {
                    char c = s.charAt(i);
                    if (inEscape) {
                        if (c == 'm') { inEscape = false; }
                        continue;
                    }
                    if (c == cast<char>(27)) {
                        inEscape = true;
                        continue;
                    }
                    w = w + 1;
                }
                return w;
            }
            // The same text with every escape sequence removed -- for a log file, or for comparing
            // output in a test.
            public static method strip(String s) returns String {
                mutable StringBuilder sb = new StringBuilder() on heap;
                mutable boolean inEscape = false;
                for (mutable int i = 0; i < s.length(); i++) {
                    char c = s.charAt(i);
                    if (inEscape) {
                        if (c == 'm') { inEscape = false; }
                        continue;
                    }
                    if (c == cast<char>(27)) {
                        inEscape = true;
                        continue;
                    }
                    sb.appendChar(c);
                }
                return sb.toString();
            }
        }

        // A TABLE THAT LINES UP. Columns are sized from their widest cell -- measured on screen, so a
        // styled cell counts for what it shows -- and each may be aligned left or right, because a
        // column of numbers that is not right-aligned is a column nobody can scan.
        //
        // `TextTable` and not `Table`, and the reason is sharper than the usual one about common
        // names: a class's symbols carry its PATH when the name is shared, so adding a `Table` here
        // renamed the symbols of a program that already had one -- `Table.probe` became
        // `main.app.Table.probe`, and a test looking for the first stopped finding it. Taking a
        // common name in the library does not merely warn somebody; it changes their build.
        public class TextTable {
            private mutable ArrayList<String> headers;
            private mutable ArrayList<int> aligns;      // 0 = left, 1 = right
            private mutable ArrayList<ArrayList<String>> rows;

            public constructor TextTable() {
                this.headers = new ArrayList<String>() on heap;
                this.aligns = new ArrayList<int>() on heap;
                this.rows = new ArrayList<ArrayList<String>>() on heap;
            }
            public method column(String title, boolean rightAligned) returns void {
                this.headers.add(title);
                this.aligns.add(rightAligned ? 1 : 0);
            }
            public method row(ArrayList<String> cells) returns void {
                mutable ArrayList<String> copy = new ArrayList<String>() on heap;
                copy.addAll(cells);
                this.rows.add(copy);
            }
            public method rowCount() returns int { return this.rows.size(); }

            // The whole thing as text, one line per row, header and a rule first. Returns rather than
            // prints, because a caller may want it in a file, in a string, or coloured further -- and
            // a renderer that prints is a renderer that can only ever do one of those.
            public method render() returns String {
                mutable ArrayList<int> widths = new ArrayList<int>() on heap;
                for (mutable int c = 0; c < this.headers.size(); c++) {
                    widths.add(Style.width(this.headers.get(c)));
                }
                for (mutable int r = 0; r < this.rows.size(); r++) {
                    mutable ArrayList<String> cells = this.rows.get(r);
                    for (mutable int c = 0; c < cells.size() && c < widths.size(); c++) {
                        int w = Style.width(cells.get(c));
                        if (w > widths.get(c)) { widths.set(c, w); }
                    }
                }
                // A POINTER, and it has to be: assignment and argument passing are a COPY here, so a
                // helper taking a `StringBuilder` would append to a duplicate and the caller would
                // get back an empty string -- which is exactly what happened, and it fails quietly
                // rather than loudly.
                mutable StringBuilder* sb = new StringBuilder() on heap;
                this.line(sb, this.headers, widths);
                mutable ArrayList<String> rule = new ArrayList<String>() on heap;
                for (mutable int c = 0; c < widths.size(); c++) {
                    mutable StringBuilder dashes = new StringBuilder() on heap;
                    for (mutable int i = 0; i < widths.get(c); i++) { dashes.append("-"); }
                    rule.add(dashes.toString());
                }
                this.line(sb, rule, widths);
                for (mutable int r = 0; r < this.rows.size(); r++) {
                    this.line(sb, this.rows.get(r), widths);
                }
                delete rule;
                delete widths;
                return sb.toString();
            }

            private method line(StringBuilder* sb, ArrayList<String> cells, ArrayList<int> widths) returns void {
                for (mutable int c = 0; c < widths.size(); c++) {
                    String cell = c < cells.size() ? cells.get(c) : "";
                    int pad = widths.get(c) - Style.width(cell);
                    boolean right = c < this.aligns.size() && this.aligns.get(c) == 1;
                    if (right) { TextTable.spaces(sb, pad); }
                    sb.append(cell);
                    if (!right && c + 1 < widths.size()) { TextTable.spaces(sb, pad); }
                    if (c + 1 < widths.size()) { sb.append("  "); }
                }
                sb.append("\n");
            }
            private static method spaces(StringBuilder* sb, int n) returns void {
                for (mutable int i = 0; i < n; i++) { sb.append(" "); }
            }
        }
    }
