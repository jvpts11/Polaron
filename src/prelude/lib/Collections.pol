            public method size() returns int {
                mutable int n = 0;
                mutable int i = this.start;
                while (this.inRange(i)) { n = n + 1; i = i + this.stride; }
                return n;
            }
            public method contains(int v) returns boolean {
                mutable int i = this.start;
                while (this.inRange(i)) { if (i == v) { return true; } i = i + this.stride; }
                return false;
            }
