    public namespace Collections {
        // A cursor over a sequence: hasNext reports whether another element remains, next yields the
        // current one and advances (spec 34). Iterable is anything that can hand out a fresh Iterator
        // over its elements, so a generic algorithm can walk any collection through these two interfaces.
        public interface Iterator<T> {
            method hasNext() returns boolean;
            method next() returns T;
        }
        public interface Iterable<T> {
            method iterator() returns Iterator<T>;
        }
        // A growable list backed by a dynamic array that doubles on overflow (spec 31 uses
        // ArrayList<Method>/ArrayList<Field>; also a general-purpose collection).
        public class ArrayList<T> implements Iterable<T> {
            // WHAT IS ALWAYS TRUE OF A LIST, said to the compiler rather than only to the reader.
            //
            // The library declared preconditions (`requires`) in 29 places and never once declared a
            // postcondition or an invariant -- which is backwards for a LIBRARY: a caller can check
            // its own arguments and cannot check ours. These two clauses are the entire contract of a
            // growable array. The count never goes negative, and it never runs past the storage that
            // holds it; essentially every bug this class could have violates one of them.
            //
            // Not free in principle, free in practice: contracts are real runtime checks, and the
            // optimizer deletes the ones it can prove. `coll_list` sits at parity with std::vector
            // and is the benchmark that would show it if they cost anything.
            invariant this.count >= 0;
            invariant this.count <= this.data.length();
            private mutable T[] data;
            private mutable int count;
            public constructor ArrayList() {
                this.data = new T[4]();
                this.count = 0;
            }
            public destructor ~ArrayList() returns void {
                delete this.data;
            }
            public method add(T item) returns void
                // The one thing a caller is entitled to assume, now stated: adding grows the list by
                // exactly one. `old(...)` is the value at entry, so this also rules out the mistake
                // a growable array actually makes -- reallocating and losing the count.
                ensures this.count == old(this.count) + 1
            {
                if (this.count >= this.data.length()) {
                    T[] bigger = new T[this.data.length() * 2]();
                    for (mutable int i = 0; i < this.count; i++) {
                        bigger[i] = this.data[i];
                    }
                    delete this.data;
                    this.data = bigger;
                }
                this.data[this.count] = item;
                this.count = this.count + 1;
            }
            // Grow the backing store to hold at least n elements up front, so a known-size fill (a copy,
            // a filter/map/sort output) does not pay repeated doubling reallocations. A no-op when the
            // capacity already suffices; never shrinks.
            public method ensureCapacity(int n) returns void {
                if (n > this.data.length()) {
                    T[] bigger = new T[n]();
                    for (mutable int i = 0; i < this.count; i++) { bigger[i] = this.data[i]; }
                    delete this.data;
                    this.data = bigger;
                }
            }
            public method get(int i) returns T {
                if (i < 0 || i >= this.count) {
                    // Past the logical size but still inside the backing store's spare capacity: the raw
                    // array check would not catch it, so force a clean "array index out of bounds" panic
                    // instead of returning an uninitialized slot (garbage for a value, a wild pointer for
                    // an object). No UB.
                    return this.data[this.data.length()];
                }
                return this.data[i];
            }
            public method set(int i, T item) returns void {
                if (i < 0 || i >= this.count) {
                    this.data[this.data.length()] = item;   // out of bounds -> clean panic, never a silent write
                    return;
                }
                this.data[i] = item;
            }
            public method indexOf(T item) returns int {  // -1 if absent (uses equalsKey)
                for (mutable int i = 0; i < this.count; i++) {
                    if (this.data[i].equalsKey(item)) { return i; }
                }
                return -1;
            }
            public method contains(T item) returns boolean {
                return this.indexOf(item) >= 0;
            }
            public method removeAt(int i) returns void {  // shift the tail left
                if (i < 0 || i >= this.count) {
                    // Out of range would silently decrement count (or leave a gap) without removing
                    // anything. Force a clean "array index out of bounds" panic instead. No UB.
                    T oob = this.data[this.data.length()];
                    return;
                }
                for (mutable int j = i; j < this.count - 1; j++) {
                    this.data[j] = this.data[j + 1];
                }
                this.count = this.count - 1;
            }
            public method insertAt(int i, T item) returns void {  // shift the tail right, insert at i
                if (i < 0 || i > this.count) {   // count itself is valid here -- that is an append
                    this.data[this.data.length()] = item;   // out of bounds -> clean panic, no silent gap
                    return;
                }
                if (this.count >= this.data.length()) {
                    T[] bigger = new T[this.data.length() * 2]();
                    for (mutable int k = 0; k < this.count; k++) { bigger[k] = this.data[k]; }
                    delete this.data;
                    this.data = bigger;
                }
                for (mutable int j = this.count; j > i; j--) {
                    this.data[j] = this.data[j - 1];
                }
                this.data[i] = item;
                this.count = this.count + 1;
            }
            public method remove(T item) returns boolean {  // remove first equal element
                int i = this.indexOf(item);
                if (i < 0) { return false; }
                this.removeAt(i);
                return true;
            }
            public method clear() returns void {
                this.count = 0;
            }
            public method toArray() returns T[] {
                T[] out = new T[this.count]();
                for (mutable int i = 0; i < this.count; i++) { out[i] = this.data[i]; }
                return out;
            }
            public method size() returns int {
                return this.count;
            }
            public method isEmpty() returns boolean {
                return this.count == 0;
            }
            // Functional pipeline (spec 34): run over, and select from, the elements with a lambda.
            public method forEach(function<void, T> action) returns void {
                for (mutable int i = 0; i < this.count; i++) { action(this.data[i]); }
            }
            public method filter(function<boolean, T> keep) returns ArrayList<T> {
                ArrayList<T> out = new ArrayList<T>() on heap;
                out.ensureCapacity(this.count);  // at most `count` kept; size once instead of growing
                for (mutable int i = 0; i < this.count; i++) {
                    if (keep(this.data[i])) { out.add(this.data[i]); }
                }
                return out;
            }
            public method map<R>(function<R, T> transform) returns ArrayList<R> {
                mutable ArrayList<R> out = new ArrayList<R>() on heap;
                out.ensureCapacity(this.count);  // output is exactly `count`; size once, no growth
                for (mutable int i = 0; i < this.count; i++) { out.add(transform(this.data[i])); }
                return out;
            }
            public method reduce<R>(R seed, function<R, R, T> combine) returns R {
                mutable R acc = seed;
                for (mutable int i = 0; i < this.count; i++) { acc = combine(acc, this.data[i]); }
                return acc;
            }
            public method any(function<boolean, T> pred) returns boolean {
                for (mutable int i = 0; i < this.count; i++) {
                    if (pred(this.data[i])) { return true; }
                }
                return false;
            }
            public method all(function<boolean, T> pred) returns boolean {
                for (mutable int i = 0; i < this.count; i++) {
                    if (!pred(this.data[i])) { return false; }
                }
                return true;
            }
            public method count(function<boolean, T> pred) returns int {
                mutable int hits = 0;
                for (mutable int i = 0; i < this.count; i++) {
                    if (pred(this.data[i])) { hits = hits + 1; }
                }
                return hits;
            }
            // Returns a new list with the elements ordered by a comparator (spec 34): compare(a, b) is
            // negative when a comes first, positive when b does. Stable merge sort, leaves this list
            // untouched. The comparator keeps it generic -- the element type needs no ordering of its own.
            // IN PLACE, for when the copy is the waste. `sortedBy` builds a second list and returns
            // it, which is right when the original is still wanted and is a full duplication when it
            // is not -- and "put this list in order" is the commoner of the two. Same stable merge
            // sort; only the copy is gone.
            public method sort(function<int, T, T> compare) returns void {
                if (this.count > 1) {
                    T[] scratch = new T[this.count]();
                    this.mergeSortRange(scratch, 0, this.count - 1, compare);
                    delete scratch;
                }
            }
            // Everything from another list, in its order. Written by hand at every call site
            // otherwise, and the loop is the same loop every time.
            public method addAll(ArrayList<T> other) returns void {
                this.ensureCapacity(this.count + other.size());
                for (mutable int i = 0; i < other.size(); i++) { this.add(other.get(i)); }
            }
            public method reverse() returns void {
                mutable int i = 0;
                mutable int j = this.count - 1;
                while (i < j) {
                    T t = this.data[i];
                    this.data[i] = this.data[j];
                    this.data[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            public method lastIndexOf(T item) returns int {
                for (mutable int i = this.count - 1; i >= 0; i--) {
                    if (this.data[i].equalsKey(item)) { return i; }
                }
                return -1;
            }
            public method sortedBy(function<int, T, T> compare) returns ArrayList<T> {
                ArrayList<T> out = new ArrayList<T>() on heap;
                out.ensureCapacity(this.count);  // the copy is known-size; fill without reallocating
                for (mutable int i = 0; i < this.count; i++) { out.add(this.data[i]); }
                if (out.size() > 1) {
                    T[] scratch = new T[out.size()]();  // O(n) merge buffer, freed below
                    out.mergeSortRange(scratch, 0, out.size() - 1, compare);
                    delete scratch;
                }
                return out;
            }
            // Stable merge sort (O(n log n)) backing sortedBy; `tmp` is an n-element scratch array. Kept
            // internal to the collection. Two standard refinements over the textbook version: small ranges
            // fall back to an in-place insertion sort (no recursion/merge overhead, cache-friendly), and a
            // range whose two sorted halves are already in order skips the merge and its copy-back entirely.
            private method mergeSortRange(T[] tmp, int lo, int hi, function<int, T, T> compare) returns void {
                if (lo >= hi) { return; }
                if (hi - lo < 16) {  // insertion sort; stable -- only shifts strictly-greater elements
                    for (mutable int p = lo + 1; p <= hi; p = p + 1) {
                        T key = this.data[p];
                        mutable int q = p - 1;
                        while (q >= lo && compare(this.data[q], key) > 0) {
                            this.data[q + 1] = this.data[q];
                            q = q - 1;
                        }
                        this.data[q + 1] = key;
                    }
                    return;
                }
                int mid = (lo + hi) / 2;
                this.mergeSortRange(tmp, lo, mid, compare);
                this.mergeSortRange(tmp, mid + 1, hi, compare);
                if (compare(this.data[mid], this.data[mid + 1]) <= 0) { return; }  // already ordered
                mutable int i = lo;
                mutable int j = mid + 1;
                mutable int k = lo;
                while (i <= mid && j <= hi) {
                    if (compare(this.data[i], this.data[j]) <= 0) {
                        tmp[k] = this.data[i];
                        i = i + 1;
                    } else {
                        tmp[k] = this.data[j];
                        j = j + 1;
                    }
                    k = k + 1;
                }
                while (i <= mid) { tmp[k] = this.data[i]; i = i + 1; k = k + 1; }
                while (j <= hi) { tmp[k] = this.data[j]; j = j + 1; k = k + 1; }
                for (mutable int t = lo; t <= hi; t = t + 1) { this.data[t] = tmp[t]; }
            }
            // Search terminals (spec 34): find returns the first element a predicate accepts, min/max the
            // smallest/largest by a comparator. Each returns Option<T> -- Some on a hit, None when the list
            // is empty or nothing matches -- so the empty case is in the type, not a sentinel.
            public method find(function<boolean, T> pred) returns Option<T> {
                for (mutable int i = 0; i < this.count; i++) {
                    if (pred(this.data[i])) { return Some(this.data[i]); }
                }
                return None();
            }
            public method min(function<int, T, T> compare) returns Option<T> {
                if (this.count == 0) { return None(); }
                mutable T best = this.data[0];
                for (mutable int i = 1; i < this.count; i++) {
                    if (compare(this.data[i], best) < 0) { best = this.data[i]; }
                }
                return Some(best);
            }
            public method max(function<int, T, T> compare) returns Option<T> {
                if (this.count == 0) { return None(); }
                mutable T best = this.data[0];
                for (mutable int i = 1; i < this.count; i++) {
                    if (compare(this.data[i], best) > 0) { best = this.data[i]; }
                }
                return Some(best);
            }
            public override method iterator() returns Iterator<T> {
                return new ArrayListIterator<T>(this) on heap;
            }
        }
        // The cursor an ArrayList hands out: walks indices 0..size over the list it was given.
        public class ArrayListIterator<T> implements Iterator<T> {
            private mutable ArrayList<T> list;
            private mutable int pos;
            public constructor ArrayListIterator(ArrayList<T> list) {
                this.list = list;
                this.pos = 0;
            }
            public override method hasNext() returns boolean {
                return this.pos < this.list.size();
            }
            public override method next() returns T {
                T value = this.list.get(this.pos);
                this.pos = this.pos + 1;
                return value;
            }
        }
        // A lazy iterator pipeline (spec 25 / stdlib #25): a Stream is itself an Iterator, and each
        // transform (filter/map) wraps the previous stream and pulls elements on demand -- nothing runs
        // until a terminal op (fold/count/forEach) drives hasNext/next. Build one over any Iterator with
        // `new IteratorStream<T>(collection.iterator())`, then chain. map<R> may change the element type.
        public abstract class Stream<T> implements Iterator<T> {
            public abstract method hasNext() returns boolean;
            public abstract method next() returns T;
            public method filter(function<boolean, T> pred) returns Stream<T> {
                return new FilterStream<T>(this, pred) on heap;
            }
            public method map<R>(function<R, T> fn) returns Stream<R> {
                return new MapStream<T, R>(this, fn) on heap;
            }
            public method fold<R>(R init, function<R, R, T> combine) returns R {
                mutable R acc = init;
                while (this.hasNext()) { acc = combine(acc, this.next()); }
                return acc;
            }
            public method forEach(function<void, T> action) returns void {
                while (this.hasNext()) { action(this.next()); }
            }
            public method count() returns int {
                mutable int c = 0;
                while (this.hasNext()) { this.next(); c = c + 1; }
                return c;
            }
            // HOW A PIPELINE ENDS. `filter`, `map` and `fold` were here and there was no way to get
            // a LIST back out: a lazy chain could be walked with forEach into a list the caller had
            // already made, and that is the one shape every use of a stream has. A pipeline that
            // cannot be materialised is a pipeline nobody writes.
            public method toList() returns ArrayList<T> {
                ArrayList<T> out = new ArrayList<T>() on heap;
                while (this.hasNext()) { out.add(this.next()); }
                return out;
            }
            // THE FIRST `n`, and the point of it is that the REST IS NEVER PULLED. On a stream over
            // something expensive -- a file, a generator, a search -- that is the difference between
            // reading three lines and reading the file.
            public method take(int n) returns Stream<T> {
                return new TakeStream<T>(this, n) on heap;
            }
            // ...and past the first `n`, which is how a header is dropped.
            public method skip(int n) returns Stream<T> {
                return new SkipStream<T>(this, n) on heap;
            }
            // Up to the first element that fails the test, and no further. Different from `filter`
            // in the way that matters on an infinite or expensive source: filter keeps asking, this
            // stops.
            public method takeWhile(function<boolean, T> pred) returns Stream<T> {
                return new TakeWhileStream<T>(this, pred) on heap;
            }
            public method any(function<boolean, T> pred) returns boolean {
                while (this.hasNext()) {
                    if (pred(this.next())) { return true; }
                }
                return false;
            }
            public method all(function<boolean, T> pred) returns boolean {
                while (this.hasNext()) {
                    if (!pred(this.next())) { return false; }
                }
                return true;
            }
        }
        // The first `n` and then nothing: `hasNext` lies as soon as the budget is spent, so the
        // upstream is never asked again. That is the whole value of a lazy take -- an eager one
        // would have pulled everything already.
        public class TakeStream<T> extends Stream<T> {
            private Stream<T> src;
            private mutable int left;
            public constructor TakeStream(Stream<T> src, int n) {
                this.src = src;
                this.left = n;
            }
            public override method hasNext() returns boolean {
                return this.left > 0 && this.src.hasNext();
            }
            public override method next() returns T {
                this.left = this.left - 1;
                return this.src.next();
            }
        }
        // Everything past the first `n`. The skipping happens on the first question asked, not in
        // the constructor, so building the stream still costs nothing.
        public class SkipStream<T> extends Stream<T> {
            private Stream<T> src;
            private mutable int left;
            public constructor SkipStream(Stream<T> src, int n) {
                this.src = src;
                this.left = n;
            }
            public override method hasNext() returns boolean {
                while (this.left > 0 && this.src.hasNext()) {
                    this.src.next();
                    this.left = this.left - 1;
                }
                return this.src.hasNext();
            }
            public override method next() returns T { return this.src.next(); }
        }
        // Up to the first element that fails the test. Caches the look-ahead like FilterStream does,
        // because deciding whether there IS a next one means pulling it.
        public class TakeWhileStream<T> extends Stream<T> {
            private Stream<T> src;
            private function<boolean, T> pred;
            private mutable boolean hasCached;
            private mutable boolean done;
            private mutable T cached;
            public constructor TakeWhileStream(Stream<T> src, function<boolean, T> pred) {
                this.src = src;
                this.pred = pred;
                this.hasCached = false;
                this.done = false;
            }
            public override method hasNext() returns boolean {
                if (this.done) { return false; }
                if (this.hasCached) { return true; }
                if (!this.src.hasNext()) { return false; }
                T v = this.src.next();
                if (!this.pred(v)) {
                    this.done = true;
                    return false;
                }
                this.cached = v;
                this.hasCached = true;
                return true;
            }
            public override method next() returns T {
                this.hasCached = false;
                return this.cached;
            }
        }
        // Adapts a plain Iterator into a Stream (the head of a pipeline). It adds nothing but its type,
        // so it answers nothing itself: `delegate` forwards hasNext and next to the iterator it wraps.
        public class IteratorStream<T> extends Stream<T> {
            private delegate Iterator<T> src;
            public constructor IteratorStream(Iterator<T> src) { this.src = src; }
        }
        // Yields only the upstream elements that satisfy the predicate; caches one look-ahead so hasNext
        // can skip rejected elements without losing the accepted one.
        public class FilterStream<T> extends Stream<T> {
            private Stream<T> src;
            private function<boolean, T> pred;
            private mutable boolean hasCached;
            private mutable T cached;
            public constructor FilterStream(Stream<T> src, function<boolean, T> pred) {
                this.src = src; this.pred = pred; this.hasCached = false;
            }
            public override method hasNext() returns boolean {
                if (this.hasCached) { return true; }
                while (this.src.hasNext()) {
                    T v = this.src.next();
                    if (this.pred(v)) { this.cached = v; this.hasCached = true; return true; }
                }
                return false;
            }
            public override method next() returns T {
                this.hasCached = false;
                return this.cached;
            }
        }
        // Applies a transform to each upstream element as it is pulled, possibly changing the type
        // (T -> R). Extends Stream<R>, so map may be chained with a different element type.
        // A decorator: `hasNext` is the upstream's answer unchanged, so it is delegated; `next` is the
        // one thing this class exists to do, so it is written here and wins over the delegate.
        public class MapStream<T, R> extends Stream<R> {
            private delegate Stream<T> src;
            private function<R, T> fn;
            public constructor MapStream(Stream<T> src, function<R, T> fn) {
                this.src = src; this.fn = fn;
            }
            public override method next() returns R { return this.fn(this.src.next()); }
        }
        // A non-owning window over a [start, start+len) range of an array (spec 34): no copy, just a
        // backing array and an offset. Reads go through the array's own bounds check, so there is no UB;
        // sub returns a narrower window, toArray copies the window out into a fresh array.
        public class Slice<T> {
            private mutable T[] backing;
            private mutable int start;
            private mutable int len;
            public constructor Slice(T[] array, int start, int len) {
                this.backing = array;
                this.start = start;
                this.len = len;
            }
            public method length() returns int {
                return this.len;
            }
            public method get(int i) returns T {
                if (i < 0 || i >= this.len) {
                    // Inside the backing array but outside THIS window: the raw check would not catch it,
                    // so force a clean "array index out of bounds" panic rather than read a neighbour. No UB.
                    return this.backing[this.backing.length()];
                }
                return this.backing[this.start + i];
            }
            public method set(int i, T value) returns void {
                if (i < 0 || i >= this.len) {
                    this.backing[this.backing.length()] = value;   // outside the window -> clean panic
                    return;
                }
                this.backing[this.start + i] = value;
            }
            public method sub(int from, int to) returns Slice<T> {
                return new Slice<T>(this.backing, this.start + from, to - from) on heap;
            }
            public method toArray() returns T[] {
                mutable T[] out = new T[this.len]();
                for (mutable int i = 0; i < this.len; i++) { out[i] = this.backing[this.start + i]; }
                return out;
            }
        }
// Split here only to stay under the MSVC per-string-literal size limit; the two raw chunks concatenate
// into one continuous System.Collections namespace.
        // LIFO stack backed by a doubling array (spec 34.1).
        public class Stack<T> {
            invariant this.count >= 0;
            invariant this.count <= this.data.length();
            private mutable T[] data;
            private mutable int count;
            public constructor Stack() { this.data = new T[4](); this.count = 0; }
            public destructor ~Stack() returns void { delete this.data; }
            public method push(T item) returns void {
                if (this.count >= this.data.length()) {
                    T[] bigger = new T[this.data.length() * 2]();
                    for (mutable int i = 0; i < this.count; i++) { bigger[i] = this.data[i]; }
                    delete this.data;
                    this.data = bigger;
                }
                this.data[this.count] = item;
                this.count = this.count + 1;
            }
            public method pop() returns T {
                this.count = this.count - 1;
                return this.data[this.count];
            }
            public method peek() returns T { return this.data[this.count - 1]; }
            public method toArray() returns T[] {  // bottom-to-top (insertion order)
                T[] out = new T[this.count]();
                for (mutable int i = 0; i < this.count; i++) { out[i] = this.data[i]; }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // FIFO queue backed by a doubling ring buffer (spec 34.1).
        public class Queue<T> {
            // A ring: the head is a position inside the storage and the count never exceeds it.
            // The second clause is what a circular buffer gets wrong when it gets anything wrong.
            invariant this.count >= 0;
            invariant this.count <= this.data.length();
            invariant this.head >= 0;
            invariant this.head < this.data.length();
            private mutable T[] data;
            private mutable int head;
            private mutable int count;
            public constructor Queue() { this.data = new T[4](); this.head = 0; this.count = 0; }
            public destructor ~Queue() returns void { delete this.data; }
            public method enqueue(T item) returns void {
                if (this.count >= this.data.length()) {
                    T[] bigger = new T[this.data.length() * 2]();
                    for (mutable int i = 0; i < this.count; i++) {
                        bigger[i] = this.data[(this.head + i) % this.data.length()];
                    }
                    delete this.data;
                    this.data = bigger;
                    this.head = 0;
                }
                this.data[(this.head + this.count) % this.data.length()] = item;
                this.count = this.count + 1;
            }
            public method dequeue() returns T {
                T v = this.data[this.head];
                this.head = (this.head + 1) % this.data.length();
                this.count = this.count - 1;
                return v;
            }
            public method peek() returns T { return this.data[this.head]; }
            public method toArray() returns T[] {  // front-to-back
                T[] out = new T[this.count]();
                for (mutable int i = 0; i < this.count; i++) {
                    out[i] = this.data[(this.head + i) % this.data.length()];
                }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // Double-ended queue backed by a doubling ring buffer (spec 34.1).
        public class Deque<T> {
            private mutable T[] data;
            private mutable int head;
            private mutable int count;
            public constructor Deque() { this.data = new T[4](); this.head = 0; this.count = 0; }
            public destructor ~Deque() returns void { delete this.data; }
            private method grow() returns void {
                if (this.count < this.data.length()) { return; }
                T[] bigger = new T[this.data.length() * 2]();
                for (mutable int i = 0; i < this.count; i++) {
                    bigger[i] = this.data[(this.head + i) % this.data.length()];
                }
                delete this.data;
                this.data = bigger;
                this.head = 0;
            }
            public method addLast(T item) returns void {
                this.grow();
                this.data[(this.head + this.count) % this.data.length()] = item;
                this.count = this.count + 1;
            }
            public method addFirst(T item) returns void {
                this.grow();
                this.head = (this.head + this.data.length() - 1) % this.data.length();
                this.data[this.head] = item;
                this.count = this.count + 1;
            }
            public method removeFirst() returns T {
                T v = this.data[this.head];
                this.head = (this.head + 1) % this.data.length();
                this.count = this.count - 1;
                return v;
            }
            public method removeLast() returns T {
                this.count = this.count - 1;
                return this.data[(this.head + this.count) % this.data.length()];
            }
            public method toArray() returns T[] {  // front-to-back
                T[] out = new T[this.count]();
                for (mutable int i = 0; i < this.count; i++) {
                    out[i] = this.data[(this.head + i) % this.data.length()];
                }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // Singly-linked list node (helper for LinkedList).
        public class LinkedNode<T> {
            public mutable T value;
            // `weak`, because a node does not OWN the next one -- the list does. As a plain owning
            // pointer, destroying one node cascaded down the whole chain, which is why the nodes
            // could not be moved into a region: the cascade reached slots the region had already
            // taken back and handed them to the allocator. `weak` says the relationship out loud and
            // the cascade stops.
            public mutable weak nullable LinkedNode<T>* next;
            public constructor LinkedNode(T v) { this.value = v; this.next = null; }
        }
        // Linked list (spec 34.1): O(1) append + O(1) head removal, with self-referential generic
        // pointer nodes (LinkedNode<T> holds a LinkedNode<T>* next).
        public class LinkedList<T> {
            // THE NODES LIVE IN A POOL REGION -- the standard library's first, and the reason three
            // compiler bugs are now fixed.
            //
            // A linked list is the case regions were made for: many small objects, all the same size,
            // all dying with the container. `pool` is the flavor that fits rather than `bump`,
            // because `removeFirst` hands a single node back and only a pool can take one back.
            //
            // This replaces a malloc per `add`, a free per `removeFirst`, and a destructor that WALKED
            // THE WHOLE CHAIN freeing node by node, with one `release region`. The `regions` benchmark
            // measures that same difference against malloc/free at 12x.
            //
            // Why no generic container could do this before: MONOMORPHIZATION SILENTLY DROPPED THE
            // REGION. Cloning a `delete` copied only its target, losing `from region` (and `fromHeap`,
            // and the extra targets of `delete a, b, c` -- which leaked); cloning a `new` copied
            // `location` but not `region`. Every container is generic, so every one of them lost both
            // halves, and because the two agreed on the wrong answer nothing ever complained: the
            // region was simply never used. Fixing one half alone is what finally spoke -- the delete
            // went to the region while the allocation was still on the heap, and the region refused a
            // pointer it had never handed out.
            private mutable pool region nodes;
            private mutable nullable LinkedNode<T>* head;
            private mutable nullable LinkedNode<T>* tail;
            private mutable int count;
            public constructor LinkedList() {
                this.nodes = itself.allocate(4096);
                this.head = null; this.tail = null; this.count = 0;
            }
            // ONE statement where there was a walk. Every node lives in the region, so giving the
            // region back gives all of them back at once -- no chain traversal, no free per node.
            public destructor ~LinkedList() returns void {
                this.head = null;
                this.tail = null;
                this.count = 0;
                release region this.nodes;
            }
            public method add(T item) returns void {
                LinkedNode<T>* node = new LinkedNode<T>(item) in region this.nodes;
                if (this.tail == null) { this.head = node; this.tail = node; }
                else { this.tail.next = node; this.tail = node; }
                this.count = this.count + 1;
            }
            // At the FRONT, in constant time -- which is the one thing a linked list can do that an
            // ArrayList cannot, and it was the one thing missing: `add` appends, `removeFirst` takes
            // from the head, and there was no way to put one there. A queue built on this could only
            // ever be a queue.
            public method addFirst(T item) returns void {
                LinkedNode<T>* node = new LinkedNode<T>(item) in region this.nodes;
                node.next = this.head;
                this.head = node;
                if (this.tail == null) { this.tail = node; }
                this.count = this.count + 1;
            }
            public method get(int i) returns T {
                mutable nullable LinkedNode<T>* cur = this.head;
                for (mutable int j = 0; j < i; j++) { cur = cur.next; }
                return cur.value;
            }
            public method removeFirst() returns T {
                nullable LinkedNode<T>* node = this.head;
                T v = node.value;
                this.head = node.next;
                if (this.head == null) { this.tail = null; }
                delete node from region this.nodes;
                this.count = this.count - 1;
                return v;
            }
            public method toArray() returns T[] {  // head-to-tail
                T[] out = new T[this.count]();
                mutable nullable LinkedNode<T>* cur = this.head;
                for (mutable int i = 0; i < this.count; i++) { out[i] = cur.value; cur = cur.next; }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // Keys of HashMap/HashSet implement Hashable<T>; keys of TreeMap/TreeSet implement
        // Comparable<T> (spec 34). The primitive types (int family, String) satisfy these via
        // compiler builtins, so they can be used as keys without boxing.
        public interface Hashable<T> {
            method hash() returns long;
            method equalsKey(T other) returns boolean;
        }
        public interface Comparable<T> {
            method compareTo(T other) returns int;
        }

        // ORDERING, DERIVED. `Comparable` states an obligation and hands nothing back: a type that
        // implements it still writes `a.compareTo(b) < 0` at every call site, forever.
        //
        // This is what `transformer` is for, and the standard library had not used one. The
        // transformer writes the algorithm -- five comparisons, all of them the same mistake waiting
        // to happen -- and the applying type supplies the single part only it can know. `compareTo`
        // below has no body, so it is a SOCKET: a type that applies TComparer and forgets it gets an
        // error on its own `applies` line naming what is missing, which an interface cannot do for a
        // method it never calls.
        //
        // `itself` is the applying type, which does not exist yet when this is written -- that is the
        // difference between a procedure and a method, and the reason the second word exists.
        // ORDERING, DERIVED. `Comparable` states an obligation and hands nothing back: a type that
        // implements it still writes `a.compareTo(b) < 0` at every call site, forever.
        //
        // This is what `transformer` is for. The transformer writes the algorithm -- five
        // comparisons, every one of them the same off-by-a-sign waiting to happen -- and the applying
        // type supplies the single part only it can know. `compareTo` has no body, so it is a SOCKET:
        // a type that applies TComparer and forgets it gets an error on its own `applies` line
        // naming what is missing, which an interface cannot do for a method it never calls.
        //
        // No type parameter: `itself` already IS the applying type, and `transformer T<X>` is
        // rejected for exactly that reason. `itself` in the PARAMETER positions below is what makes
        // the socket expressible at all -- it did not parse until this was written, and the fix was
        // one line in the type parser, because the expansion already knew how to substitute it.
        // ORDERING, DERIVED -- and the standard library's first transformer.
        //
        // `Comparable` states an obligation and hands nothing back: a type that implements it still
        // writes `a.compareTo(b) < 0` at every call site, forever. A transformer is the other half.
        // It writes the algorithm -- five comparisons, every one the same off-by-a-sign waiting to
        // happen -- and the applying type supplies the one part only it can know. `compareTo` has no
        // body, so it is a SOCKET: a type that applies TComparer and forgets it is told so on its own
        // `applies` line, which an interface cannot do for a method nobody calls.
        //
        // `itself` in the parameters is what makes the socket expressible: it names the applying
        // type, which does not exist yet. Getting here took two compiler fixes and one correction of
        // my own reading -- see the note in System.Time.Duration for where the applying type spells
        // its own name instead.
        public transformer TComparer {
            public procedure compareTo(itself other) returns int;

            public procedure lessThan(itself other) returns boolean { return itself.compareTo(other) < 0; }
            public procedure atMost(itself other) returns boolean { return itself.compareTo(other) <= 0; }
            public procedure greaterThan(itself other) returns boolean { return itself.compareTo(other) > 0; }
            public procedure atLeast(itself other) returns boolean { return itself.compareTo(other) >= 0; }
            public procedure sameOrder(itself other) returns boolean { return itself.compareTo(other) == 0; }
        }
        // Hash map with open addressing (linear probing); capacity is a power of two, load factor
        // 0.75 (spec 34.1). Keys must be Hashable. get() on an absent key returns a zero/null value;
        // probe with containsKey() first.
        // Spreading a hash before a power-of-two table masks it (spec 34).
        //
        // `int.hash()` is the IDENTITY, and an open-addressed table keeps only the LOW bits of it. So
        // any key set with structure down there degenerates: keys of `i * 64` in a 64-slot table all
        // land in slot 0, and linear probing then walks the whole table for every one of them. That is
        // not a corner case -- indices scaled by a record size, pointers, ids allocated in blocks, all
        // have exactly that shape.
        //
        // `std::unordered_map` never notices, because its bucket count is PRIME and a modulo spreads
        // the structure for it. A power-of-two table has to spread it itself, which is what every map
        // of this shape does: Abseil, robin_hood, and Java's HashMap (`h ^ h >>> 16`).
        //
        // Fibonacci hashing: multiply by 2^64/phi so every input bit influences the high bits, then
        // fold those down into the low ones the mask keeps. One multiply and one xor-shift.
        //
        // AND IT IS NOT USED BY HashMap/HashSet, BECAUSE IT WAS MEASURED AND IT LOST. Applying it to
        // every lookup moved the benchmarks the wrong way, every one of them:
        //     mapkeys 0.43 -> 0.38 | collections 0.33 -> 0.26 | coll_map 0.63 -> 0.44
        //     coll_mapput 0.69 -> 0.54 | coll_mapoa 0.91 -> 0.60      (ratio vs GCC; >1 is a win)
        // The reason is the half of the argument that was left out. Those workloads use SEQUENTIAL
        // keys, and for sequential keys the identity hash is not merely adequate, it is optimal: zero
        // collisions AND consecutive slots, so a fill walks memory in order. Spreading them destroys
        // that locality and turns each probe into a cache miss -- which costs far more than the
        // clustering it was meant to prevent.
        //
        // So this is here for a map whose keys are known to be structured, and as the record of an
        // idea that is right in theory and lost on the machine. A table that ADAPTS -- identity until
        // a probe chain gets long, mixed after -- is the shape that would win both, and is unwritten.
        public class Hashing {
            public static method mix(long h) returns long {
                long x = h * 0x9E3779B97F4A7C15;
                return x ^ (x >> 32);
            }
        }

        public class HashMap<K, V> {
            // The three parallel arrays must stay the same length as the declared capacity -- that
            // is the assumption every probe makes when it masks an index and then indexes all three.
            // And the table must never fill: linear probing with count == cap does not terminate.
            invariant this.count >= 0;
            invariant this.count < this.cap;
            invariant this.keys.length() == this.cap;
            invariant this.values.length() == this.cap;
            invariant this.used.length() == this.cap;
            private mutable K[] keys;
            private mutable V[] values;
            // ONE BYTE PER SLOT, NOT FOUR. This was a `boolean[]`, and `boolean` in Polaron is an i32 --
            // four bytes to carry one bit, in the array every probe touches first and most often. At a
            // capacity of 262144 that array was a megabyte; it is now 256 KiB.
            //
            // KEPT FOR THE MEMORY AND NOT FOR THE SPEED, because the speed was measured and there was
            // none. Every map benchmark moved by less than the run-to-run noise, which the unrelated
            // benchmarks in the same runs put at about 4%:
            //     coll_map 6.4 -> 6.2 ms | coll_mapoa 6.6 -> 6.5 | coll_mapput 5.7 -> 6.0
            //     collections 12.3 -> 12.1 | mapkeys 9.3 -> 9.8   (quicksort and virtualcall, which
            //     this change cannot touch, moved 219 -> 221 and 96.0 -> 96.9 in the same pair of runs)
            //
            // So the occupancy array was NOT where the gap against `std::unordered_map` lives -- these
            // tables are small enough that a megabyte and 256 KiB are both misses or both not. That is
            // worth knowing before anyone spends a day making it a bitset, which would be an eighth
            // again and would put a shift and a mask on the path of every probe.
            private mutable byte[] used;
            private mutable int count;
            private mutable int cap;
            public constructor HashMap() {
                this.cap = 8;
                this.keys = new K[8]();
                this.values = new V[8]();
                this.used = new byte[8]();
                this.count = 0;
            }
            public destructor ~HashMap() returns void {
                delete this.keys;
                delete this.values;
                delete this.used;
            }
            private method slotFor(K key) returns int {
                int mask = this.cap - 1;
                mutable int i = cast<int>(key.hash()) & mask;
                while (this.used[i] != 0) {
                    if (this.keys[i].equalsKey(key)) { return i; }
                    i = (i + 1) & mask;
                }
                return i;
            }
            // THE LOAD FACTOR LIVES HERE, not at each insert. Every one of them asked the same
            // question in the same words, and a rule of the table that is written at its call sites
            // is one the next insert can be written without -- silently, because nothing anywhere
            // notices a table that stopped growing until it is full.
            private method reserveOneMore() returns void {
                if ((this.count + 1) * 4 < this.cap * 3) {
                    return;
                }
                int oldCap = this.cap;
                K[] oldK = this.keys;
                V[] oldV = this.values;
                byte[] oldU = this.used;
                // Quadruple, not double. Growth is the expensive part of filling a map: every step
                // allocates and ZEROES three fresh arrays and rehashes everything into them, so what
                // matters is how many times that happens, not how much slack it leaves. Doubling from
                // 8 to a quarter-million is fifteen rehashes; quadrupling is seven.
                this.cap = oldCap * 4;
                this.keys = new K[this.cap]();
                this.values = new V[this.cap]();
                this.used = new byte[this.cap]();
                // Reinsert DIRECTLY, not through put(). A rehash knows three things put() has to
                // re-establish for every element: every key is distinct, none is already present,
                // and the table cannot need to grow again. Going through put() paid for all three --
                // a load-factor branch, a full slotFor() probe with an equalsKey comparison at every
                // step, and the count bookkeeping -- on every element of every rehash, and a table
                // filled to 200k rehashes about fifteen times. Measured: this is where the map spent
                // its time (put-only was 7.1 ms against std::unordered_map's 3.8; the lookups were
                // already nearly free).
                int mask = this.cap - 1;
                for (mutable int j = 0; j < oldCap; j++) {
                    if (oldU[j] != 0) {
                        mutable int i = cast<int>(oldK[j].hash()) & mask;
                        while (this.used[i] != 0) { i = (i + 1) & mask; }  // free slot only: no equality
                        this.used[i] = cast<byte>(1);
                        this.keys[i] = oldK[j];
                        this.values[i] = oldV[j];
                    }
                }
                delete oldK;
                delete oldV;
                delete oldU;
            }
            public method put(K key, V value) returns void {
                this.reserveOneMore();
                int i = this.slotFor(key);
                if (this.used[i] == 0) { this.used[i] = cast<byte>(1); this.count = this.count + 1; }
                this.keys[i] = key;
                this.values[i] = value;
            }
            public method get(K key) returns V {
                return this.values[this.slotFor(key)];
            }
            public method containsKey(K key) returns boolean {
                return this.used[this.slotFor(key)] != 0;
            }
            // Single-lookup helpers so callers avoid re-hashing the key. getOrDefault reads with one probe;
            // merge inserts `value` or replaces the existing value with combine(old, value) -- the efficient
            // way to tally (counts.merge(k, 1, add)) instead of containsKey + get + put (three probes).
            public method getOrDefault(K key, V defaultValue) returns V {
                int i = this.slotFor(key);
                if (this.used[i] != 0) { return this.values[i]; }
                return defaultValue;
            }
            public method merge(K key, V value, function<V, V, V> combine) returns void {
                this.reserveOneMore();
                int i = this.slotFor(key);
                if (this.used[i] == 0) {
                    this.used[i] = cast<byte>(1);
                    this.count = this.count + 1;
                    this.keys[i] = key;
                    this.values[i] = value;
                } else {
                    this.values[i] = combine(this.values[i], value);
                }
            }
            public method remove(K key) returns boolean {  // backward-shift: reinsert the cluster after i
                int i = this.slotFor(key);
                if (this.used[i] == 0) { return false; }
                int mask = this.cap - 1;
                this.used[i] = cast<byte>(0);
                this.count = this.count - 1;
                mutable int j = (i + 1) & mask;
                while (this.used[j] != 0) {
                    K rk = this.keys[j];
                    V rv = this.values[j];
                    this.used[j] = cast<byte>(0);
                    this.count = this.count - 1;
                    this.put(rk, rv);
                    j = (j + 1) & mask;
                }
                return true;
            }
            public method keyArray() returns K[] {  // keys (arbitrary order); field is named `keys`
                K[] out = new K[this.count]();
                mutable int j = 0;
                for (mutable int i = 0; i < this.cap; i++) {
                    if (this.used[i] != 0) { out[j] = this.keys[i]; j = j + 1; }
                }
                return out;
            }
            // THE SAME KEYS AS A LIST, because that is what the caller then wants: an array has to be
            // deleted, and the loop that walks it into a list was being written at every call site.
            public method keys() returns ArrayList<K> {
                ArrayList<K> out = new ArrayList<K>() on heap;
                out.ensureCapacity(this.count);
                for (mutable int i = 0; i < this.cap; i++) {
                    if (this.used[i] != 0) { out.add(this.keys[i]); }
                }
                return out;
            }
            public method values() returns ArrayList<V> {
                ArrayList<V> out = new ArrayList<V>() on heap;
                out.ensureCapacity(this.count);
                for (mutable int i = 0; i < this.cap; i++) {
                    if (this.used[i] != 0) { out.add(this.values[i]); }
                }
                return out;
            }
            // Empty it without throwing the map away, which is what a cache does between runs and
            // what a reused scratch map does every iteration.
            public method clear() returns void {
                for (mutable int i = 0; i < this.cap; i++) { this.used[i] = cast<byte>(0); }
                this.count = 0;
            }
            public method valueArray() returns V[] {  // values (arbitrary order)
                V[] out = new V[this.count]();
                mutable int j = 0;
                for (mutable int i = 0; i < this.cap; i++) {
                    if (this.used[i] != 0) { out[j] = this.values[i]; j = j + 1; }
                }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // Hash set with open addressing (spec 34.1). Elements must be Hashable.
        public class HashSet<T> {
            private mutable T[] elems;
            private mutable byte[] used;   // one byte per slot, for the reason written out in HashMap
            private mutable int count;
            private mutable int cap;
            public constructor HashSet() {
                this.cap = 8;
                this.elems = new T[8]();
                this.used = new byte[8]();
                this.count = 0;
            }
            public destructor ~HashSet() returns void {
                delete this.elems;
                delete this.used;
            }
            private method slotFor(T value) returns int {
                int mask = this.cap - 1;
                mutable int i = cast<int>(value.hash()) & mask;
                while (this.used[i] != 0) {
                    if (this.elems[i].equalsKey(value)) { return i; }
                    i = (i + 1) & mask;
                }
                return i;
            }
            private method grow() returns void {
                int oldCap = this.cap;
                mutable T[] oldE = this.elems;
                byte[] oldU = this.used;
                this.cap = oldCap * 2;
                this.elems = new T[this.cap]();
                this.used = new byte[this.cap]();
                this.count = 0;
                for (mutable int j = 0; j < oldCap; j++) {
                    if (oldU[j] != 0) { this.add(oldE[j]); }
                }
                delete oldE;
                delete oldU;
            }
            public method add(T value) returns void {
                if ((this.count + 1) * 4 >= this.cap * 3) { this.grow(); }
                int i = this.slotFor(value);
                if (this.used[i] == 0) {
                    this.used[i] = cast<byte>(1);
                    this.elems[i] = value;
                    this.count = this.count + 1;
                }
            }
            public method contains(T value) returns boolean {
                return this.used[this.slotFor(value)] != 0;
            }
            public method remove(T value) returns boolean {  // backward-shift deletion
                int i = this.slotFor(value);
                if (this.used[i] == 0) { return false; }
                int mask = this.cap - 1;
                this.used[i] = cast<byte>(0);
                this.count = this.count - 1;
                mutable int j = (i + 1) & mask;
                while (this.used[j] != 0) {
                    mutable T re = this.elems[j];
                    this.used[j] = cast<byte>(0);
                    this.count = this.count - 1;
                    this.add(re);
                    j = (j + 1) & mask;
                }
                return true;
            }
            public method toArray() returns T[] {  // elements (arbitrary order)
                T[] out = new T[this.count]();
                mutable int j = 0;
                for (mutable int i = 0; i < this.cap; i++) {
                    if (this.used[i] != 0) { out[j] = this.elems[i]; j = j + 1; }
                }
                return out;
            }
            public method size() returns int { return this.count; }
            public method isEmpty() returns boolean { return this.count == 0; }
        }
        // Binary-search-tree node for TreeMap (self-referential generic).
        public class TreeNode<K, V> {
            public mutable K key;
            public mutable V value;
            public mutable nullable TreeNode<K, V>* left;
            public mutable nullable TreeNode<K, V>* right;
            public mutable int height;  // AVL subtree height, for O(log n) balancing
            public constructor TreeNode(K k, V v) {
                this.key = k; this.value = v; this.left = null; this.right = null; this.height = 1;
            }
        }
        // Ordered map backed by an (unbalanced) binary search tree (spec 34.1). Keys are Comparable.
        // get() on an absent key returns a zero/null value; probe with containsKey() first.
        public class TreeMap<K, V> {
            private mutable nullable TreeNode<K, V>* root;
            private mutable int count;
            public constructor TreeMap() { this.root = null; this.count = 0; }
            // Post-order release: children before the parent, so no node is read after it is freed.
            public destructor ~TreeMap() returns void {
                this.freeSubtree(this.root);
                this.root = null;
                this.count = 0;
            }
            private method freeSubtree(nullable TreeNode<K, V>* n) returns void {
                if (n == null) {
                    return;
                }
                this.freeSubtree(n.left);
                this.freeSubtree(n.right);
                delete n;
            }
            public method put(K key, V value) returns void {
                this.root = this.insertNode(this.root, key, value);
            }
