    // `OS`, not `Os`: two-letter acronyms are upper-cased, three or more are PascalCase. The rest of
    // the library already follows that rule -- `IO` and `OS` upper, `Ipc`/`Ecs`/`Json` Pascal -- and
    // this namespace was the single violation, which is how the library came to have BOTH `System.Os`
    // (holding Signals) and `System.OS` (holding ProcessResult, Subprocess, Pty). Same-named
    // namespace blocks merge, so naming it correctly is all the merge takes.
    public namespace OS {
        // THE SIGNALS AN OPERATING SYSTEM CAN SEND A RUNNING PROGRAM, and the way to answer one.
        //
        // This exists so that installing a handler does not begin with an `extern cdecl` in
        // somebody's own code. The `extern` has not disappeared -- it is right here, and reaching a
        // C symbol that way is the design -- it has disappeared from EVERYBODY'S program, which is
        // what a standard library is for.
        //
        // The numbers are the reason it earns its place. `2` is not a readable SIGINT, and the two
        // families disagree about which signals exist at all: SIGBREAK is Windows and has no POSIX
        // counterpart, SIGHUP is POSIX and does not exist on Windows. Only the two named below are
        // the same number in both, so only those are offered -- a constant that is portable in name
        // and not in behaviour is worse than no constant.
        //
        // What it is FOR: `interrupt` (spec 36 / docs/design/interrupt.md) is a method entered by
        // something outside the program at a moment the program did not choose, and on a hosted
        // system that is a signal. The handler must do almost nothing -- it may not allocate or
        // block, because the code it interrupted may be standing inside the allocator -- so the
        // shape that works is a flag stored into an `atomic<T>` or a `volatile` field, read by the
        // main loop at a point of its own choosing.
        //
        //     public interrupt(int sig) returns void { itself.asked.store(true); }
        //     Signals.answer(Signals.INTERRUPT, box.interrupt);
        // WHAT THE MACHINE UNDER THE PROGRAM IS (spec 20).
        //
        // The async pool has always asked how many threads it will run at once. A program written
        // in the language could not -- which left every worker pool anybody writes holding a number
        // somebody guessed, right on the desk it was written at: three quarters of a big machine
        // idle, and a small one oversubscribed into being slower than a single thread.
        public class Machine {
            // Never less than one. A program is going to divide by it.
            public static method threads() returns int {
                return System.OS.__machineThreads();
            }
            // Physical memory in bytes, or -1 when the system will not say. A program sizing a cache
            // against it must be able to tell "the machine has none" from "I could not find out" --
            // returning 0 for both is how a cache ends up sized at zero on the one platform that
            // refuses to answer.
            public static method memory() returns long {
                return System.OS.__machineMemory();
            }
            // HOW MUCH IS FREE RIGHT NOW -- a different question from how much the machine has, and
            // the one a program sizing a cache, a buffer pool or a batch actually needs. Sizing
            // against `memory()` is how something that behaves on an idle machine takes a busy one
            // down. -1 when the system will not say.
            public static method availableMemory() returns long {
                return System.OS.__availableMemory();
            }
            // Seconds since this machine started; -1 when it cannot be determined. A program
            // comparing its own age against the machine's can tell "restarted with the box" from
            // "restarted on its own", which is the first question when something died overnight.
            public static method uptime() returns long {
                return System.OS.__uptime();
            }
            // The granularity every mapping and every guard page is rounded to. A program that
            // allocates by page has to ask, because it is 4 KiB on x86 and 16 KiB on Apple silicon,
            // and a constant compiled in at somebody's desk is wrong on half the machines.
            public static method pageSize() returns long {
                return System.OS.__pageSize();
            }
            // "windows", "linux", "macos", "freebsd" -- the family, not the version. A program
            // branching on this wants to know which shape the world has; a version string invites
            // parsing that the next release breaks.
            public static method os() returns String {
                return System.OS.__osName();
            }
            public static method isWindows() returns boolean { return Machine.os().equals("windows"); }
            public static method isLinux() returns boolean { return Machine.os().equals("linux"); }
            public static method isMacOS() returns boolean { return Machine.os().equals("macos"); }
            // Empty when the host will not say, which is the honest answer for a container with no
            // name rather than a guess.
            public static method hostname() returns String {
                return System.OS.__hostname();
            }
            public static method user() returns String {
                return System.OS.__username();
            }
            // This program's own process id -- what it puts in a lock file, or hands to a supervisor.
            public static method processId() returns long {
                return System.OS.__pid();
            }
            // WHICH INSTRUCTION SET, which is a different question from which operating system:
            // "x86_64", "arm64", "x86", "arm", "riscv64", "wasm". A program choosing a SIMD path,
            // naming a downloaded binary, or reporting where a crash happened needs this one and not
            // `os()` -- and a Mac may be either of two answers.
            public static method architecture() returns String {
                return System.OS.__cpuArch();
            }
            public static method is64Bit() returns boolean {
                String arch = Machine.architecture();
                return arch.equals("x86_64") || arch.equals("arm64") || arch.equals("riscv64");
            }
        }

        // THE ENVIRONMENT, AND THE DIFFERENCE BETWEEN ABSENT AND EMPTY.
        //
        // The `Env` builtin answers "" for a variable that is not set AND for one set to "", so a
        // program could not tell a missing configuration from a deliberately blank one. Nothing
        // fails: it runs with a default it was never told to use, and the run looks healthy. It is
        // the same shape as reading a file that is not there and getting "" back -- the defect that
        // makes every printed number look right while the answer is wrong.
        //
        // So this class does not have a bare `get`. It has three, and each says what it does about
        // absence: `lookup` hands back an Option, `get` takes the fallback as an argument, and
        // `require` throws. A caller has to have decided.
        public class Environment {
            // Absent is None; set-to-empty is Some(""). The distinction the builtin cannot make.
            public static method lookup(String name) returns Option<String> {
                if (System.OS.__envHas(name) == 0) {
                    return None();
                }
                return Some(Env.get(name));
            }
            // The value, or this one. The common case, with the default written where a reader can
            // see it rather than buried in whatever "" flowed into.
            public static method get(String name, String fallback) returns String {
                if (System.OS.__envHas(name) == 0) {
                    return fallback;
                }
                return Env.get(name);
            }
            // For a variable whose absence is a misconfiguration -- which is most of them. Failing
            // here, naming the variable, beats failing four screens later with a default nobody
            // chose.
            public static method require(String name) throws(EnvironmentException) returns String {
                if (System.OS.__envHas(name) == 0) {
                    throw new EnvironmentException(name) on heap;
                }
                return Env.get(name);
            }
            public static method has(String name) returns boolean {
                return System.OS.__envHas(name) != 0;
            }
            // Answers whether the variable IS SET AFTERWARDS, which is not the same as whether the
            // call was accepted -- and on one platform they differ. Windows has no way to hold an
            // empty environment variable that `getenv` can see: the C runtime reads `set(name, "")`
            // as "remove it", and reports success for having done so. POSIX sets it to empty and
            // keeps it. Rather than paper over the difference or let it pass silently, the answer is
            // read back from the environment: on Windows `set(name, "")` returns false, because it
            // did not do what it was asked.
            public static method set(String name, String value) returns boolean {
                if (!Env.set(name, value)) {
                    return false;
                }
                return Environment.has(name);
            }
            // Remove it, so `has` answers false afterwards -- not set it to "", which is a different
            // state and the whole reason this class exists.
            public static method clear(String name) returns boolean {
                return System.OS.__envUnset(name) != 0;
            }
            // Everything, as a map. What a program prints when it wants to show what it was actually
            // given rather than what it believes it was given.
            public static method all() returns HashMap<String, String> {
                HashMap<String, String> map = new HashMap<String, String>() on heap;
                ArrayList<String> lines = Strings.split(System.OS.__envAll(), "\n");
                for (mutable int i = 0; i < lines.size(); i++) {
                    String line = lines.get(i);
                    int eq = line.indexOf("=");
                    if (eq > 0) {
                        map.put(line.substring(0, eq), line.substring(eq + 1, line.length()));
                    }
                }
                delete lines;
                return map;
            }
            // `;` on Windows, `:` everywhere else. A program joining a search path by hand gets this
            // wrong on the other platform, and the failure is a path that silently finds nothing.
            public static method pathSeparator() returns String {
                return Machine.isWindows() ? ";" : ":";
            }
            // PATH, already split. Empty pieces are dropped: a trailing separator is common and an
            // empty entry means "the current directory" on Windows, which is a security hazard
            // nobody asked for.
            public static method searchPath() returns ArrayList<String> {
                ArrayList<String> parts =
                    Strings.split(Environment.get("PATH", ""), Environment.pathSeparator());
                ArrayList<String> kept = new ArrayList<String>() on heap;
                for (mutable int i = 0; i < parts.size(); i++) {
                    if (parts.get(i).length() > 0) { kept.add(parts.get(i)); }
                }
                delete parts;
                return kept;
            }
        }

        // Thrown by `Environment.require`, naming the variable. A misconfiguration reported where it
        // is discovered, rather than four screens later as a default nobody chose.
        public class EnvironmentException extends Exception {
            private mutable String name;
            public constructor EnvironmentException(String name) { this.name = name; }
            public override method message() returns String {
                return "environment variable is not set: ".concat(this.name);
            }
        }

        // WHERE THE PROGRAM IS RUNNING, AND THE PLACES IT MAY WRITE.
        //
        // A program that cannot ask where it is has to be told, which means it grows a configuration
        // file whose first entry is a path somebody typed at their own desk. These are questions the
        // operating system already knows the answer to.
        public class Workspace {
            // The working directory -- what every relative path in the program is relative to.
            public static method current() returns String {
                return System.OS.__cwd();
            }
            // Change it, and say whether it took. False rather than a trap: a directory that has
            // been removed underneath the program is an ordinary thing to discover.
            public static method moveTo(String path) returns boolean {
                return System.OS.__chdir(path) != 0;
            }
            // The directory for scratch files. Every platform names it differently and a program
            // that hardcodes one is broken on the other: /tmp does not exist on Windows, and TEMP is
            // not set for a POSIX daemon.
            public static method tempDirectory() returns String {
                return System.OS.__tempDir();
            }
            // The user's home. Empty when the host will not say.
            public static method homeDirectory() returns String {
                return System.OS.__homeDir();
            }
            // This program's own file on disk -- for a tool that has to find the things installed
            // beside it, which is every tool with a data directory.
            public static method executable() returns String {
                return Env.executablePath();
            }
            public static method executableDirectory() returns String {
                return Paths.dirname(Env.executablePath());
            }
        }

        // HOW MUCH ROOM IS LEFT, on the volume holding a given path. A program about to write a
        // large file can ask first, instead of discovering the answer half way through with the
        // output already unusable.
        public class Disk {
            // Bytes this program may actually use -- not the volume's total free space, which on a
            // POSIX filesystem includes the reserve only root may touch. -1 when it cannot be
            // determined.
            public static method freeSpace(String path) returns long {
                return System.OS.__diskFree(path);
            }
            public static method totalSpace(String path) returns long {
                return System.OS.__diskTotal(path);
            }
            public static method usedSpace(String path) returns long {
                long total = Disk.totalSpace(path);
                long free = Disk.freeSpace(path);
                if (total < 0 || free < 0) { return 0 - 1; }
                return total - free;
            }
        }

        // A PROGRAM CAN FAIL ON PURPOSE.
        //
        // `main` returns `void`, so until this existed every Polaron program exited 0 -- one that
        // printed "I do not know that command" and one that did exactly what it was asked were the
        // same run to a script, a build, or a gate. This is the program's half of the conversation
        // the operating system starts with a signal.
        //
        // `exit` and not `_exit`: what was printed is flushed first, so the last thing a program
        // says actually reaches whoever is reading it.
        public class Exit {
            private extern cdecl static method exit(int code) returns void;

            // Stop now, and hand this number back. Zero means it went well, by the convention every
            // shell on earth already holds.
            public static method now(int code) returns void {
                Exit.exit(code);
                return;
            }

            // The two that have names, so a caller reads a verdict rather than a number.
            public static method ok() returns void {
                Exit.exit(0);
                return;
            }

            public static method failed() returns void {
                Exit.exit(1);
                return;
            }
        }

        public class Signals {
            // Ctrl-C, and the closest thing to "the user asked you to stop" that exists on both.
            public static fixed int INTERRUPT = 2;
            // A polite request to end, from `kill` or from a service manager.
            public static fixed int TERMINATE = 15;

            private extern cdecl static method signal(int sig, address handler) returns address;
            private extern cdecl static method raise(int sig) returns int;

            // Send a signal to THIS program. A real part of the interface -- a process asking
            // itself to stop is how a supervisor's request gets turned into the same shutdown path
            // an operator's Ctrl-C takes -- and the only way to exercise a handler without another
            // process, which is what makes the path testable at all.
            public static method sendToSelf(int sig) returns boolean {
                return Signals.raise(sig) == 0;
            }

            // Install `handler` for `sig`, and answer whether it took. The address comes from
            // binding an interrupt to an object -- `box.interrupt`, with no parentheses -- which is
            // one act because a vector holds an address and nothing else.
            //
            // False means the C runtime refused, which it does for a signal it does not know. The
            // caller is told rather than left with a handler that will never fire.
            public static method answer(int sig, address handler) returns boolean {
                address was = Signals.signal(sig, handler);
                // SIG_ERR is -1 cast to a pointer, and it is the one answer that means refused.
                return cast<long>(was) != (0 - 1);
            }

            // Put a signal back to what the runtime does by default -- for INTERRUPT, ending the
            // process. A program that has finished its own shutdown wants this before it stops
            // reading the flag, so a second Ctrl-C is not ignored by a handler nobody is watching.
            public static method giveBack(int sig) returns boolean {
                address was = Signals.signal(sig, cast<address>(0));
                return cast<long>(was) != (0 - 1);
            }
        }
    }
    public namespace OS {
        // The result of running a subprocess (spec 34): its captured stdout and exit code. Built by
        // the `Process.run(cmd)` builtin, which runs the command THROUGH THE SHELL -- and by
        // `Command.run()`, which does not.
        //
        // Which to use: `Process.run` when you mean a shell line and wrote every character of it
        // yourself (a pipeline, a redirection, a glob). `Command` whenever any part comes from
        // anywhere else -- a filename, a user, a config file -- because a string handed to a shell
        // has no way to say "this part is data". See the note on Command.
        public class ProcessResult {
            public String output;
            public int exitCode;
            public constructor ProcessResult(String output, int exitCode) {
                this.output = output;
                this.exitCode = exitCode;
            }
            public method success() returns boolean { return this.exitCode == 0; }
        }
        // A persistent child process (debugger/LSP support): spawn a command, then exchange bytes over its
        // stdin/stdout for its whole lifetime. Unlike Process.run (one-shot, captures stdout to EOF), this
        // stays open for request/response protocols like DAP. Require `import System.OS.Subprocess;`.
        //
        // `start`/`startCombined`/`startVisible` take a shell command line, with everything that
        // implies about arguments (see ProcessResult). `Command.start()` builds the same object from
        // a program and its arguments instead, and is the one to reach for when any part of the
        // command came from outside the program.
        public class Subprocess {
            private mutable long handle;
            private constructor Subprocess(long h) {
                this.handle = h;
            }
            // Spawn `command` (run through the system shell). Check isValid() before use.
            public static method start(String command) returns Subprocess {
                return new Subprocess(Subproc.spawn(command)) on heap;
            }
            // Same, but the child's stderr is merged into its stdout: one stream carries everything it
            // prints. That is what you want from a tool that reports on stderr (a compiler), and exactly
            // what you must NOT do to a child speaking a framed protocol -- a stray log line would be read
            // as part of a message. Hence two spawns, and a caller that says which one it means.
            public static method startCombined(String command) returns Subprocess {
                return new Subprocess(Subproc.spawnCombined(command)) on heap;
            }
            // Same as start(), but the child gets its OWN console window (Windows). start()/startCombined()
            // are windowless -- a background tool piped to us. startVisible() is for launching an interactive
            // console tool the user is meant to see and drive; its stdio is still piped, so you can read it too.
            public static method startVisible(String command) returns Subprocess {
                return new Subprocess(Subproc.spawnVisible(command)) on heap;
            }
            public method isValid() returns boolean {
                return this.handle != cast<long>(0);
            }
            // Write bytes to the child's stdin; returns the number written (-1 on error).
            public method write(String data) returns int {
                return Subproc.writeStr(this.handle, data);
            }
            // Read the next available chunk from the child's stdout (blocks until data or EOF). Empty on EOF.
            public method read() returns String {
                return Subproc.readChunk(this.handle);
            }
            public method isAlive() returns boolean {
                return Subproc.isAlive(this.handle);
            }
            // True when read() would return immediately (data ready or EOF): pump without blocking a UI loop.
            public method canRead() returns boolean {
                return Subproc.canRead(this.handle);
            }
            // Send EOF to the child's stdin without killing it, so a well-behaved child can finish and exit.
            public method closeInput() returns void {
                Subproc.closeStdin(this.handle);
            }
            // Close pipes and terminate the child if still running.
            public method close() returns void {
                Subproc.kill(this.handle);
            }
            // Wait for it to finish, and answer its exit code (-1 if that cannot be determined; on
            // POSIX, 128+N when a signal ended it, which is what every shell reports). Distinct from
            // `close`, which terminates it and throws the code away -- so a caller that wants to know
            // whether the thing WORKED waits first and closes after.
            public method wait() returns int {
                return Subproc.wait(this.handle);
            }
            // ...with a DEADLINE in milliseconds. Answers -2 when the time ran out and the child is
            // still going, which is a different thing from -1 ("could not find out") and calls for a
            // different response: one waits longer or gives up on it, the other reports.
            //
            // Without this, a parent that waits is a parent that a hung child hangs -- and a child
            // that prompts for input with nobody there to type hangs forever. A build, a test runner
            // and a language server all need to be able to stop waiting.
            public method waitFor(int millis) returns int {
                return Subproc.waitFor(this.handle, millis);
            }
            // Was it still running when the wait ran out? The name for the sentinel, so a caller
            // compares against a word rather than remembering that -2 means that.
            public static method timedOut(int code) returns boolean {
                return code == 0 - 2;
            }
            // Started from a Command, which is the form that does not go through a shell. Internal:
            // `Command.start()` is the way in.
            public static method fromHandle(long h) returns Subprocess {
                return new Subprocess(h) on heap;
            }
        }

        // RUNNING ANOTHER PROGRAM, WITHOUT A SHELL BETWEEN YOU AND IT.
        //
        // `Process.run(cmd)` and `Subprocess.start(cmd)` take ONE STRING and hand it to `cmd.exe` or
        // `/bin/sh`. That makes every argument shell syntax, and no care at the call site can fix it,
        // because the call site is where the string is built:
        //
        //     Process.run("grep " + pattern + " " + file)
        //
        // A `file` holding a space silently becomes two arguments. A `pattern` holding `&`, `|` or
        // `$(...)` becomes a SECOND COMMAND, and it runs. That is not an exotic attack: it is what
        // happens the first time somebody drags in a file called `my notes.txt`.
        //
        // A Command keeps the program and its arguments apart the whole way down, so nothing is ever
        // parsed as syntax:
        //
        //     ProcessResult r = new Command("git") on heap
        //         .arg("log").arg("--oneline").arg(userSupplied)
        //         .directory(repo)
        //         .run();
        //
        // It also carries the two things a command string CANNOT: the directory to run in, and the
        // environment to run with. Both were simply impossible before -- `cd x && ...` is shell
        // syntax, which is the thing being removed.
        public class Command {
            // `exe` and not `program`, which is reserved: `program Name;` opens every file.
            private mutable String exe;
            private mutable ArrayList<String> arguments;
            private mutable ArrayList<String> variables;   // "NAME=VALUE"
            private mutable String dir;                    // "" -> inherit ours
            private mutable boolean ownEnvironment;        // false -> inherit ours
            private mutable boolean combineStderr;
            private mutable boolean visible;
            private mutable String toWrite;      // fed to the child's stdin by `run`
            private mutable int deadlineMillis;  // 0 = wait as long as it takes

            public constructor Command(String path) {
                this.exe = path;
                this.arguments = new ArrayList<String>() on heap;
                this.variables = new ArrayList<String>() on heap;
                this.dir = "";
                this.ownEnvironment = false;
                this.combineStderr = false;
                this.visible = false;
                this.toWrite = "";
                this.deadlineMillis = 0;
            }

            // `Command*` and not `Command`, and it has to be: assignment here is a COPY, so a fluent
            // method returning by value would add each argument to a duplicate and hand back a
            // command with one argument in it.
            public method arg(String value) returns Command* {
                this.arguments.add(value);
                return this;
            }
            public method argAll(ArrayList<String> values) returns Command* {
                for (mutable int i = 0; i < values.size(); i++) {
                    this.arguments.add(values.get(i));
                }
                return this;
            }
            // Where to run. `directory` and not `in`, which is reserved (`new X in region`).
            public method directory(String path) returns Command* {
                this.dir = path;
                return this;
            }
            // Add a variable to the child's environment, starting from a copy of ours. The first call
            // takes the copy, so a caller that sets one variable does not have to rebuild the rest --
            // which is what makes an environment usable at all.
            public method env(String name, String value) returns Command* {
                if (!this.ownEnvironment) {
                    HashMap<String, String> inherited = Environment.all();
                    ArrayList<String> names = inherited.keys();
                    for (mutable int i = 0; i < names.size(); i++) {
                        String key = names.get(i);
                        this.variables.add(key.concat("=").concat(inherited.get(key)));
                    }
                    delete names;
                    delete inherited;
                    this.ownEnvironment = true;
                }
                this.variables.add(name.concat("=").concat(value));
                return this;
            }
            // Start from an EMPTY environment instead of a copy of ours -- for running something that
            // must not see what this program was given.
            public method clearEnv() returns Command* {
                this.variables.clear();
                this.ownEnvironment = true;
                return this;
            }
            // The child's stderr shares its stdout, so one read sees everything it printed. What you
            // want from a compiler; what would corrupt a child speaking a framed protocol.
            public method mergeStderr() returns Command* {
                this.combineStderr = true;
                return this;
            }
            // Give the child its own console window (Windows). For an interactive tool the user is
            // meant to see and drive.
            public method showWindow() returns Command* {
                this.visible = true;
                return this;
            }
            // What to write to the child's stdin before reading its output -- piping INTO a program,
            // which is half of what a pipeline is for and which `run` could not do at all. The
            // stream is closed after, so a filter that reads to EOF finishes instead of waiting.
            public method input(String text) returns Command* {
                this.toWrite = text;
                return this;
            }
            // Give up after this many milliseconds. `run` then reports -2 (Subprocess.timedOut) and
            // ends the child, rather than waiting for a program that is never going to finish.
            public method timeout(int millis) returns Command* {
                this.deadlineMillis = millis;
                return this;
            }

            // The program and its arguments as one NUL-separated blob. A Polaron String carries its
            // own length, so a NUL inside it is a separator rather than an end -- which is what lets
            // an argument hold anything at all, including the characters a shell would act on.
            private method argvBlob() returns String {
                StringBuilder blob = new StringBuilder() on heap;
                blob.append(this.exe);
                blob.appendChar(cast<char>(0));
                for (mutable int i = 0; i < this.arguments.size(); i++) {
                    blob.append(this.arguments.get(i));
                    blob.appendChar(cast<char>(0));
                }
                return blob.toString();
            }
            private method envBlob() returns String {
                StringBuilder blob = new StringBuilder() on heap;
                for (mutable int i = 0; i < this.variables.size(); i++) {
                    blob.append(this.variables.get(i));
                    blob.appendChar(cast<char>(0));
                }
                return blob.toString();
            }

            // Start it and hand back the running child, for a caller that wants to talk to it.
            // `ownEnvironment` travels separately from the COUNT, because an empty environment and
            // "inherit mine" are different instructions -- and passing only the count made them the
            // same value, so `clearEnv()` handed the child everything this program had. Nothing
            // failed; the child simply saw it all, and only a program that used the feature for real
            // found it.
            public method start() returns Subprocess {
                return Subprocess.fromHandle(
                    Subproc.spawnArgv(this.argvBlob(), this.arguments.size() + 1, this.dir,
                                      this.envBlob(), this.variables.size(),
                                      this.ownEnvironment ? 1 : 0,
                                      this.combineStderr ? 1 : 0, this.visible ? 1 : 0));
            }

            // Start it, read everything it prints, wait, and report both. The one-shot form, and the
            // replacement for `Process.run` -- same answer, no shell.
            //
            // stdin is closed first: a child that reads it sees EOF rather than waiting forever for a
            // parent that is itself waiting for output. That deadlock is the classic way a one-shot
            // subprocess hangs, and it hangs the parent with it.
            public method run() returns ProcessResult {
                Subprocess child = this.start();
                if (!child.isValid()) {
                    return new ProcessResult("", 0 - 1) on heap;
                }
                if (this.toWrite.length() > 0) {
                    child.write(this.toWrite);
                }
                child.closeInput();
                StringBuilder output = new StringBuilder() on heap;
                if (this.deadlineMillis <= 0) {
                    mutable String chunk = child.read();
                    while (chunk.length() > 0) {
                        output.append(chunk);
                        chunk = child.read();
                    }
                    int code = child.wait();
                    child.close();
                    return new ProcessResult(output.toString(), code) on heap;
                }
                // THE DEADLINE HAS TO COVER THE READING TOO, and the first version of this did not:
                // it drained the child's output and only then started counting. A hung child holds
                // its stdout OPEN, so `read` blocks and the deadline is never reached -- the timeout
                // protected exactly the case that could not happen and missed the one it was for.
                // Measured the honest way, by writing a child that spins forever and watching the
                // parent spin with it.
                //
                // So the loop asks `canRead` first, which answers immediately, and only reads when
                // there is something there. A child that is neither readable nor alive is finished.
                mutable int left = this.deadlineMillis;
                mutable boolean finished = false;
                while (left > 0 && !finished) {
                    if (child.canRead()) {
                        String chunk = child.read();
                        if (chunk.length() == 0) {
                            finished = true;   // end of output
                        } else {
                            output.append(chunk);
                        }
                    } else if (!child.isAlive()) {
                        finished = true;
                    } else {
                        Time.sleep(1);
                        left = left - 1;
                    }
                }
                int code = finished ? child.waitFor(left > 0 ? left : 1) : 0 - 2;
                child.close();
                return new ProcessResult(output.toString(), code) on heap;
            }
        }
        // A child attached to a pseudo-console (ConPTY on Windows): unlike Subprocess (a plain line pipe),
        // the child believes it is on a real terminal, so it emits ANSI colour/cursor sequences -- what an
        // integrated terminal needs to run interactive/full-screen tools. Give the initial size in cells.
        // Require `import System.OS.Pty;`.
        public class Pty {
            private mutable long handle;
            private constructor Pty(long h) {
                this.handle = h;
            }
            public static method start(String command, int cols, int rows) returns Pty {
                return new Pty(Conpty.spawn(command, cols, rows)) on heap;
            }
            public method isValid() returns boolean {
                return this.handle != cast<long>(0);
            }
            public method write(String data) returns int {
                return Conpty.writeStr(this.handle, data);
            }
            // The next available chunk of the child's output (raw, ANSI included). Empty when nothing is ready.
            public method read() returns String {
                return Conpty.readChunk(this.handle);
            }
            public method canRead() returns boolean {
                return Conpty.canRead(this.handle);
            }
            public method isAlive() returns boolean {
                return Conpty.isAlive(this.handle);
            }
            // Tell the pseudo-console the viewport changed size (cells), so the child re-wraps its output.
            public method resize(int cols, int rows) returns void {
                Conpty.resize(this.handle, cols, rows);
                return;
            }
            public method close() returns void {
                Conpty.close(this.handle);
                return;
            }
        }
    }
