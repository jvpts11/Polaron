                        uint s0 = Sha256.rotr(w[t-15],7) ^ Sha256.rotr(w[t-15],18) ^ (w[t-15] >> 3);
                        uint s1 = Sha256.rotr(w[t-2],17) ^ Sha256.rotr(w[t-2],19) ^ (w[t-2] >> 10);
                        w[t] = w[t-16] + s0 + w[t-7] + s1;
