    public namespace IO {
        // Console I/O (spec 2.9 / 4). The methods are recognized by the compiler and lower to
        // libc printf/scanf; this class exists so `import System.IO.Console;` resolves and the
        // usual namespace-visibility rules require importing it before use.
        public class Console {
        }
        // Line-oriented file helpers (spec 34.4): the File builtin reads and writes whole contents, and
        // Files layers lines on top of it through Strings, so a program reads a file into a list of lines
        // and writes a list back without handling the newline joins itself.
        // Thrown when a file operation the program REQUIRED to work did not. Carries the operation
        // and the path, because "could not read" without the path is a message that sends its reader
        // back to the code to find out which file -- and there is always more than one.
        public class IoException extends Exception {
            private mutable String op;
            private mutable String path;
            public constructor IoException(String op, String path) {
                this.op = op;
                this.path = path;
            }
            public method path() returns String { return this.path; }
            public override method message() returns String {
                return "cannot ".concat(this.op).concat(" '").concat(this.path).concat("'");
            }
        }

        public class Files {
            // Each line is terminated with a newline, and a trailing empty piece from the final newline is
            // dropped on read, so writeLines then readLines round-trips and appendLine adds a clean line.
            public static method readLines(String path) returns ArrayList<String> {
                ArrayList<String> lines = Strings.split(File.readAll(path), "\n");
                if (lines.size() > 0 && lines.get(lines.size() - 1).length() == 0) {
                    lines.removeAt(lines.size() - 1);
                }
                return lines;
            }
            public static method writeLines(String path, ArrayList<String> lines) returns void {
                StringBuilder sb = new StringBuilder() on heap;  // concat in a loop was O(total^2)
                for (mutable int i = 0; i < lines.size(); i++) {
                    sb.append(lines.get(i));
                    sb.appendChar(cast<char>(10));  // '\n'
                }
                File.writeAll(path, sb.toString());
                return;
            }
            public static method appendLine(String path, String line) returns void {
                File.appendAll(path, line.concat("\n"));
                return;
            }
            // The entries of a directory (spec 34.4), one per element. Empty if the path is not a
            // directory. Wraps the newline-separated File.list.
            public static method listDir(String path) returns ArrayList<String> {
                ArrayList<String> entries = Strings.split(File.list(path), "\n");
                if (entries.size() > 0 && entries.get(entries.size() - 1).length() == 0) {
                    entries.removeAt(entries.size() - 1);
                }
                return entries;
            }

            // WHOLE CONTENTS, which `Files` did not offer at all: a program that wanted the text of a
            // file rather than its lines had to reach past the library to `File.readAll`, the compiler
            // builtin. Six of the ten builtins were unreachable this way -- the runtime has had
            // exists/size/remove/isDir/mkdir/rename since file I/O landed, and only four of them ever
            // came out through a class.
            // A FILE THAT IS NOT THERE READS AS "" THROUGH THE BUILTIN, exactly like an empty one --
            // the same defect as an unset environment variable reading as "". Nothing fails: the
            // program parses nothing, finds nothing, and reports zero of whatever it counts, and the
            // run looks healthy. So the plain read REFUSES rather than inventing an empty file, and
            // says which path it could not read. The three ways to ask are the same three
            // `Environment` offers, and each states what it does about absence:
            //
            //   read      -> throws IoException. For a file the program requires.
            //   tryRead   -> Option<String>. For a file whose absence is an ordinary outcome.
            //   readOr    -> the fallback. For a config file with defaults.
            //
            // The check costs one `exists` call and only on the empty answer, so an ordinary read of
            // an ordinary file pays nothing for it -- and a genuinely empty file still reads "".
            public static method read(String path) throws(IoException) returns String {
                String content = File.readAll(path);
                if (content.length() == 0 && !Files.isFile(path)) {
                    throw new IoException("read", path) on heap;
                }
                return content;
            }
            public static method tryRead(String path) returns Option<String> {
                String content = File.readAll(path);
                if (content.length() == 0 && !Files.isFile(path)) {
                    return None();
                }
                return Some(content);
            }
            public static method readOr(String path, String fallback) returns String {
                String content = File.readAll(path);
                if (content.length() == 0 && !Files.isFile(path)) {
                    return fallback;
                }
                return content;
            }
            // Writing answers whether it worked, rather than throwing: a full disk, a read-only file
            // and a path whose directory does not exist are all things a program is expected to cope
            // with, and the runtime already reports them. What it must not do is stay silent, which
            // is what returning void did -- every failed write in every program was discarded.
            public static method write(String path, String content) returns boolean {
                return File.writeAll(path, content);
            }
            public static method append(String path, String content) returns boolean {
                return File.appendAll(path, content);
            }

            // ---- WHOLE FILES AS BYTES. ----
            //
            // Everything above moves a String, which carries its own length and so survives a NUL --
            // but a String is TEXT, and every method on it (`split`, `charAt`, the Utf8 helpers)
            // reads it as text. A PNG is not text, and treating it as such is how a program that
            // "works" corrupts the one file that happens to hold a byte no encoding allows.
            //
            // THE CALLER OWNS THE BUFFER, and that is the design rather than an omission. A Buffer
            // frees itself when it goes out of scope, and assignment here is a COPY -- so a method
            // returning one by value would hand back a duplicate holding the SAME address, and both
            // would free it. Polaron has `move` for exactly this, but Buffer is not declared movable,
            // and inventing an owning return that quietly double-frees is worse than two lines at
            // the call site:
            //
            //     mutable Buffer* bytes = new Buffer(cast<int>(Files.size(path))) on heap;
            //     int n = Files.readInto(path, bytes);
            //
            // Answers how many bytes were read, which is 0 for a file that is not there -- and the
            // caller already knows the size it asked for, so short means something went wrong.
            public static method readInto(String path, Buffer* into) returns int {
                FileStream stream = FileStream.read(path);
                if (!stream.isOpen()) { return 0; }
                int n = stream.readBytes(into, into.length());
                stream.close();
                return n;
            }
            // `count` rather than the whole buffer, because a buffer is usually bigger than what is
            // in it -- a read of 300 bytes into a 4096-byte one should write 300.
            public static method writeBytes(String path, Buffer* from, int count) returns boolean {
                FileStream stream = FileStream.write(path);
                if (!stream.isOpen()) { return false; }
                int n = stream.writeBytes(from, count);
                stream.close();
                return n == count;
            }
            public static method appendBytes(String path, Buffer* from, int count) returns boolean {
                FileStream stream = FileStream.append(path);
                if (!stream.isOpen()) { return false; }
                int n = stream.writeBytes(from, count);
                stream.close();
                return n == count;
            }

            // ---- Metadata. Asking is not the same as trying and failing. ----
            public static method exists(String path) returns boolean {
                return File.exists(path);
            }
            // Bytes, or -1 when the path does not exist. Kept as the runtime reports it rather than
            // trapping: "how big is it" is a question a program asks about files it is not sure of.
            public static method size(String path) returns long {
                return File.size(path);
            }
            public static method isDirectory(String path) returns boolean {
                return File.isDir(path);
            }
            public static method isFile(String path) returns boolean {
                return File.exists(path) && !File.isDir(path);
            }
            // Last modification, in seconds since the epoch; -1 when the path is not there. Seconds
            // because that is the resolution every filesystem this runs on agrees about, and a build
            // tool comparing two timestamps wants one unit that never lies.
            public static method modifiedAt(String path) returns long {
                return File.mtime(path);
            }
            // True when `path` is newer than `other`, or when `other` is not there at all -- the
            // question a build asks, phrased the way it asks it.
            public static method isNewerThan(String path, String other) returns boolean {
                return File.mtime(path) > File.mtime(other);
            }
            // WHEN IT WAS MADE, or -1 WHEN THE FILESYSTEM DOES NOT RECORD THAT -- which is most Linux
            // ones, and is the reason this answers -1 rather than a number.
            //
            // `st_ctime` is the inode's STATUS-CHANGE time: it moves when permissions change or a
            // link is added. Every library that answers "created" with it reports a file chmod'd
            // yesterday as made yesterday, and nothing complains. Windows records a real creation
            // time; macOS and FreeBSD keep `st_birthtime`; Linux has it only through `statx` on a
            // filesystem that stores it. A caller that gets -1 can print "unknown" instead of a date
            // that means something else.
            public static method createdAt(String path) returns long {
                return System.IO.__fileCreated(path);
            }
            // Last read. -1 when the path is not there. Worth knowing that many systems mount with
            // `relatime` or `noatime`, so this may be stale by design rather than wrong.
            public static method accessedAt(String path) returns long {
                return System.IO.__fileAccessed(path);
            }
            // Whether a write would be refused. Windows has a read-only ATTRIBUTE and POSIX has
            // permission bits, so this asks the same question of two different things: on POSIX it
            // reports the owner's write bit.
            public static method isReadOnly(String path) returns boolean {
                return System.IO.__fileReadOnly(path) == 1;
            }
            public static method setReadOnly(String path, boolean value) returns boolean {
                return System.IO.__setReadOnly(path, value ? 1 : 0) != 0;
            }
            // Mark it current without rewriting it, creating it empty if absent -- `touch`. What a
            // build tool does to say a target is up to date.
            public static method touch(String path) returns boolean {
                return System.IO.__fileTouch(path) != 0;
            }

            // ---- LINKS: one name for a file that lives somewhere else. ----
            //
            // These need their own calls because the ordinary ones FOLLOW a link and so answer about
            // the target: `exists` on a link pointing at nothing says "not there" while the link is
            // plainly in the directory, and `modifiedAt` reports the target's time, so a build
            // comparing timestamps compares the wrong file.
            public static method isSymbolicLink(String path) returns boolean {
                return System.IO.__isLink(path) != 0;
            }
            // What it points at, as stored -- which may be relative, and may name nothing. Empty when
            // the path is not a link.
            public static method linkTarget(String path) returns String {
                return System.IO.__readLink(path);
            }
            // A link to a FILE. Answers whether it was made: Windows needs a privilege for this that
            // an ordinary account does not have unless Developer Mode is on, so a program that treats
            // success as given is a program that breaks on somebody else's machine.
            public static method createSymbolicLink(String target, String linkPath) returns boolean {
                return System.IO.__symLink(target, linkPath) != 0;
            }
            // A link to a DIRECTORY. Separate because Windows must be told at creation which kind it
            // is -- it cannot look at a target that does not exist yet.
            public static method createDirectoryLink(String target, String linkPath) returns boolean {
                return System.IO.__symLinkDir(target, linkPath) != 0;
            }
            // A second NAME for the same file, rather than a path stored in place of one. Deleting
            // either leaves the data reachable through the other; a symbolic link left dangling.
            public static method createHardLink(String target, String linkPath) returns boolean {
                return System.IO.__hardLink(target, linkPath) != 0;
            }

            // ---- Mutating the tree. Each answers whether it worked, rather than trapping: a
            // directory that already exists is the ordinary case, not a failure. ----
            // Either kind. `remove` does not take a directory on Windows, so a caller who did not
            // already know which it was had no call that worked -- and the failure was silent, because
            // it returned false into code that mostly ignores it. The library asks; the caller should
            // not have to.
            public static method delete(String path) returns boolean {
                if (File.isDir(path)) { return File.rmdir(path); }
                return File.remove(path);
            }
            // An empty directory, and only that. Separate from `delete` for the callers who want the
            // refusal: removing a directory you believed was empty and was not is worth an answer.
            public static method deleteDirectory(String path) returns boolean {
                return File.rmdir(path);
            }
            public static method createDirectory(String path) returns boolean {
                return File.mkdir(path);
            }
            // Every missing parent, then the leaf -- `mkdir -p`. Already-there counts as success,
            // which is what makes it usable at the top of a program that just wants the path to be
            // there. Walks forward so each parent exists before its child is attempted.
            public static method createDirectories(String path) returns boolean {
                if (File.isDir(path)) { return true; }
                mutable int i = 0;
                while (i < path.length()) {
                    char c = path.charAt(i);
                    if ((c == '/' || c == cast<char>(92)) && i > 0) {   // 92 = backslash
                        String parent = path.substring(0, i);
                        if (parent.length() > 0 && !File.isDir(parent)) {
                            File.mkdir(parent);
                        }
                    }
                    i = i + 1;
                }
                File.mkdir(path);
                return File.isDir(path);
            }
            public static method rename(String from, String to) returns boolean {
                return File.rename(from, to);
            }
            // MOVING IT, wherever it is going. `rename` cannot cross a volume -- on both platforms it
            // simply FAILS, and a program that ignores the boolean has lost the file it was moving.
            // So this falls back to copy-then-delete, which is what every `mv` does, and the caller
            // stops having to know which case it is in.
            public static method move(String from, String to) returns boolean {
                if (File.rename(from, to)) { return true; }
                if (!Files.copy(from, to)) { return false; }
                return Files.delete(from);
            }
            // WRITING A FILE WITHOUT EVER HAVING HALF OF IT ON DISK.
            //
            // A plain `write` truncates and then fills. A crash, a full disk or a kill between those
            // two leaves the file EMPTY or half-written -- and it is the caller's save file, config
            // or index that is gone. The fix is as old as filesystems: write a temporary BESIDE it
            // and rename, because a rename either happened or it did not. Every database does this;
            // almost no program that writes a config does.
            //
            // Beside it, in the SAME directory, and that matters: a temporary in the system scratch
            // directory is usually on another volume, where the rename cannot be atomic and degrades
            // to a copy -- which is the very thing being avoided.
            public static method replace(String path, String content) returns boolean {
                StringBuilder temp = new StringBuilder() on heap;
                temp.append(path);
                temp.append(".");
                temp.appendLong(Machine.processId());
                temp.append(".new");
                String scratch = temp.toString();
                if (!File.writeAll(scratch, content)) {
                    Files.delete(scratch);
                    return false;
                }
                if (System.IO.__replaceFile(scratch, path) != 0) { return true; }
                Files.delete(scratch);   // leave nothing behind when the swap could not happen
                return false;
            }
            // Contents, not the file: metadata and permissions are not carried, and the destination is
            // replaced. Written over read/write rather than a runtime call so it works on every target
            // the language reaches, including the ones with no copy syscall of their own.
            public static method copy(String from, String to) returns boolean {
                if (!File.exists(from)) { return false; }
                File.writeAll(to, File.readAll(from));
                return File.exists(to);
            }

            // ---- Walking. `listDir` gives one level; this gives all of them. ----
            // Every file beneath `root`, as full paths, directories descended into but not themselves
            // listed. Depth-first, with a bound: a filesystem can contain a cycle through a link, and a
            // walk with no floor turns that into a hang rather than an error.
            public static method walk(String root) returns ArrayList<String> {
                ArrayList<String>* found = new ArrayList<String>() on heap;
                Files.walkInto(root, found, 64);
                return found;
            }
            // The accumulator is a POINTER and has to be. Passing it by value is a deep copy in
            // Polaron, so each level filled a list of its own and the caller got back the empty one it
            // started with -- a walk that answered 0 on a tree with three files in it, with nothing
            // failing anywhere. This is the language working as designed; `T*` is how you say "the
            // same list".
            private static method walkInto(String dir, ArrayList<String>* found, int depth) returns void {
                if (depth <= 0) { return; }
                ArrayList<String> entries = Files.listDir(dir);
                for (mutable int i = 0; i < entries.size(); i++) {
                    String full = Paths.join(dir, entries.get(i));
                    if (File.isDir(full)) {
                        Files.walkInto(full, found, depth - 1);
                    } else {
                        found.add(full);
                    }
                }
                return;
            }
            // The directories beneath `root`, same bound and same order as `walk`.
            public static method walkDirectories(String root) returns ArrayList<String> {
                ArrayList<String>* found = new ArrayList<String>() on heap;
                Files.walkDirsInto(root, found, 64);
                return found;
            }
            private static method walkDirsInto(String dir, ArrayList<String>* found, int depth) returns void {
                if (depth <= 0) { return; }
                ArrayList<String> entries = Files.listDir(dir);
                for (mutable int i = 0; i < entries.size(); i++) {
                    String full = Paths.join(dir, entries.get(i));
                    if (File.isDir(full)) {
                        found.add(full);
                        Files.walkDirsInto(full, found, depth - 1);
                    }
                }
                return;
            }
            // A directory and everything under it. Depth-first so a directory is emptied before it is
            // removed, which is the only order the underlying call accepts.
            public static method deleteRecursively(String path) returns boolean {
                if (!File.isDir(path)) { return File.remove(path); }
                ArrayList<String> entries = Files.listDir(path);
                for (mutable int i = 0; i < entries.size(); i++) {
                    Files.deleteRecursively(Paths.join(path, entries.get(i)));
                }
                return File.rmdir(path);
            }
            // A directory and everything under it, to a new place. Directories are created as they
            // are reached, so a partially-existing destination is filled in rather than refused.
            // Answers false the moment any one file fails and stops there: half a copy that reports
            // success is worse than a failure, because whatever reads it will find a tree that looks
            // whole.
            public static method copyDirectory(String from, String to) returns boolean {
                if (!File.isDir(from)) { return false; }
                if (!Files.createDirectories(to)) { return false; }
                ArrayList<String> entries = Files.listDir(from);
                mutable boolean ok = true;
                for (mutable int i = 0; i < entries.size() && ok; i++) {
                    String src = Paths.join(from, entries.get(i));
                    String dst = Paths.join(to, entries.get(i));
                    ok = File.isDir(src) ? Files.copyDirectory(src, dst) : Files.copy(src, dst);
                }
                delete entries;
                return ok;
            }

            // Every byte under `root`, files only -- what a program reports before it copies a tree,
            // and what it checks against `Disk.freeSpace` before it starts. Directories themselves
            // are not counted: their own size is a filesystem detail that varies by filesystem and
            // is not what anybody means by "how big is this folder".
            public static method directorySize(String root) returns long {
                ArrayList<String> found = Files.walk(root);
                mutable long total = cast<long>(0);
                for (mutable int i = 0; i < found.size(); i++) {
                    long n = Files.size(found.get(i));
                    if (n > cast<long>(0)) { total = total + n; }
                }
                delete found;
                return total;
            }

            // NAMES MATCHED BY A PATTERN, which is how a person says which files they mean.
            //
            // `*` stands for any run of characters within one component, `?` for one character, and
            // `**` crosses directories. Without this, every tool that takes "*.pol" on its command
            // line writes its own matcher, and each writes a slightly different one -- usually the
            // one that forgets `**`, so a pattern silently matches only the top level.
            //
            // Backtracking rather than a compiled automaton: patterns are short, the tree is the
            // expensive part, and a matcher somebody can read is a matcher whose corners can be
            // fixed.
            public static method matches(String pattern, String path) returns boolean {
                return Files.matchFrom(pattern, 0, path, 0);
            }
            private static method matchFrom(String pat, int pi, String s, int si) returns boolean {
                mutable int p = pi;
                mutable int i = si;
                while (p < pat.length()) {
                    char c = pat.charAt(p);
                    if (c == '*') {
                        // `**` crosses separators; a single `*` stops at one.
                        boolean deep = p + 1 < pat.length() && pat.charAt(p + 1) == '*';
                        int next = deep ? p + 2 : p + 1;
                        // Try every length, shortest first -- including zero.
                        mutable int j = i;
                        while (true) {
                            if (Files.matchFrom(pat, next, s, j)) { return true; }
                            if (j >= s.length()) { return false; }
                            char sc = s.charAt(j);
                            if (!deep && (sc == '/' || sc == '\\')) { return false; }
                            j = j + 1;
                        }
                    }
                    if (i >= s.length()) { return false; }
                    if (c == '?') {
                        char sc = s.charAt(i);
                        if (sc == '/' || sc == '\\') { return false; }
                    } else if (c == '/' || c == '\\') {
                        // A separator in the pattern matches either kind, so one pattern works on
                        // both platforms -- which is the whole reason a program writes one.
                        char sc = s.charAt(i);
                        if (sc != '/' && sc != '\\') { return false; }
                    } else if (pat.charAt(p) != s.charAt(i)) {
                        return false;
                    }
                    p = p + 1;
                    i = i + 1;
                }
                return i == s.length();
            }
            // Every file beneath `root` whose path relative to `root` matches `pattern`. The paths
            // returned are full, so they can be opened; the matching is on the relative one, so a
            // pattern does not have to know where the root is.
            public static method glob(String root, String pattern) returns ArrayList<String> {
                ArrayList<String> all = Files.walk(root);
                ArrayList<String> hits = new ArrayList<String>() on heap;
                hits.ensureCapacity(all.size());   // the filter can only take away
                for (mutable int i = 0; i < all.size(); i++) {
                    if (Files.matches(pattern, Paths.relative(root, all.get(i)))) {
                        hits.add(all.get(i));
                    }
                }
                delete all;
                return hits;
            }
        }
        // AN OPEN FILE, which the language did not have.
        //
        // Everything in `Files` moves a whole file: the first line of a log cost the whole log, and
        // appending a record meant reading and rewriting. That was never a limit of the platform --
        // no handle had ever crossed into Polaron.
        //
        // The handle is closed by `close()`, and by the destructor if the caller forgets, so a stream
        // bound to a local is safe under RAII the way every other owned resource is. Closing twice is
        // harmless: the handle is cleared, and a cleared handle is what `isOpen` reports on.
        public class FileStream {
            private mutable long handle;

            // The C modes, deliberately: "rb", "wb", "ab", "r+b" name themselves, and an enum here
            // would be a translation table whose entire content is those four strings.
            private constructor FileStream(long handle) {
                this.handle = handle;
            }
            // `null` is not the answer for a file that will not open, because the caller who ignores it
            // gets a null dereference two lines later instead of here. A closed stream is returned and
            // `isOpen()` is the question.
            public static method open(String path, String mode) returns FileStream {
                return new FileStream(File.open(path, mode)) on heap;
            }
            public static method read(String path) returns FileStream {
                return FileStream.open(path, "rb");
            }
            public static method write(String path) returns FileStream {
                return FileStream.open(path, "wb");
            }
            public static method append(String path) returns FileStream {
                return FileStream.open(path, "ab");
            }
            public method isOpen() returns boolean {
                return this.handle != 0;
            }

            // ---- Bytes. The buffer is a System.Memory.Buffer, which is the language's own name for
            // a block of bytes with a length -- so binary I/O needs no new type. ----
            // Bytes actually read: short at the end of the file, and 0 there. That IS the loop
            // condition, which is why it is returned rather than swallowed.
            public method readBytes(Buffer& into, int count) returns int {
                if (this.handle == 0) { return 0; }
                return cast<int>(File.readInto(this.handle, into.start(), cast<long>(count)));
            }
            public method writeBytes(Buffer& from, int count) returns int {
                if (this.handle == 0) { return 0; }
                return cast<int>(File.writeFrom(this.handle, from.start(), cast<long>(count)));
            }

            // ---- KEEPING TWO PROGRAMS OFF THIS FILE. ----
            //
            // Held on the OPEN HANDLE, and released by the operating system if the process dies --
            // which is the whole difference from a lock FILE. A crashed program leaves a lock file
            // behind forever, so every program that uses one grows a "is this stale?" guess, and the
            // guess is sometimes wrong in both directions: it either refuses to start after a crash
            // or starts twice.
            //
            // `lock` waits for its turn; `tryLock` answers false straight away. Both are wanted -- a
            // build waits, an "am I already running?" check must not.
            public method lock() returns boolean {
                return File.lock(this.handle, true, true);
            }
            public method tryLock() returns boolean {
                return File.lock(this.handle, true, false);
            }
            // A SHARED lock: many readers, no writer. Several programs may hold one at once, and an
            // exclusive one waits for all of them.
            public method lockShared() returns boolean {
                return File.lock(this.handle, false, true);
            }
            public method unlock() returns boolean {
                return File.unlock(this.handle);
            }

            // ---- Position. `seek` is from the start; the other two say where from, because a stream
            // reading fixed-size records wants "back one record" and a tail wants "from the end". ----
            public method seek(long offset) returns boolean {
                return File.seek(this.handle, offset, 0);
            }
            public method seekFromHere(long offset) returns boolean {
                return File.seek(this.handle, offset, 1);
            }
            public method seekFromEnd(long offset) returns boolean {
                return File.seek(this.handle, offset, 2);
            }
            public method position() returns long {
                return File.tell(this.handle);
            }
            // End-of-file is only true AFTER a read came up short -- C's rule, kept rather than
            // smoothed, because smoothing it means peeking one byte ahead and a peek on a pipe blocks.
            public method atEnd() returns boolean {
                return File.atEnd(this.handle);
            }
            public method flush() returns boolean {
                return File.flush(this.handle);
            }
            public method close() returns boolean {
                if (this.handle == 0) { return false; }
                boolean ok = File.close(this.handle);
                this.handle = 0;
                return ok;
            }
            // The forgotten close. A stream on a local is closed at scope exit like any other owned
            // resource; one that was closed by hand has a zero handle here and does nothing.
            public destructor ~FileStream() returns void {
                if (this.handle != 0) {
                    File.close(this.handle);
                    this.handle = 0;
                }
                return;
            }
        }
        // Path-string manipulation (spec 34.4): join segments, and pull apart a path into its directory,
        // final component, and extension. Pure string work over "/" -- it does not touch the filesystem.
        public class Paths {
            public static method join(String base, String name) returns String {
                if (base.length() == 0) { return name; }
                if (base.endsWith("/")) { return base.concat(name); }
                return base.concat("/").concat(name);
            }
            // ANY NUMBER OF SEGMENTS, which `join` cannot take: Polaron has no method overloading
            // and no variadic parameters outside `extern`, so joining three parts meant nesting two
            // calls -- and the first real tool written against this library hit that in its fourth
            // line. Empty segments are skipped, so a list with a gap in it does not produce a path
            // with a double separator in it.
            public static method joinAll(ArrayList<String> parts) returns String {
                mutable String out = "";
                for (mutable int i = 0; i < parts.size(); i++) {
                    if (parts.get(i).length() == 0) { continue; }
                    out = out.length() == 0 ? parts.get(i) : Paths.join(out, parts.get(i));
                }
                return out;
            }
            public static method basename(String path) returns String {
                int cut = Paths.lastSep(path);
                return cut < 0 ? path : path.substring(cut + 1, path.length());
            }
            public static method dirname(String path) returns String {
                int cut = Paths.lastSep(path);
                return cut < 0 ? "" : path.substring(0, cut);
            }
            // Index of the last path separator -- '/' or, on Windows, '\\'. -1 if there is none. Handling
            // both keeps dirname/basename correct on native Windows paths (e.g. an executable's own path).
            private static method lastSep(String path) returns int {
                mutable int last = 0 - 1; mutable int i = 0;
                while (i < path.length()) {
                    char c = path.charAt(i);
                    if (c == '/' || c == '\\') { last = i; }
                    i = i + 1;
                }
                return last;
            }
            public static method extension(String path) returns String {
                String base = Paths.basename(path);
                ArrayList<String> parts = Strings.split(base, ".");
                if (parts.size() < 2) { return ""; }
                return parts.get(parts.size() - 1);
            }

            // THE REST OF WHAT A PATH IS. `join`/`basename`/`dirname`/`extension` were the four a
            // program writes by hand in an afternoon; these are the ones it gets wrong. Every one of
            // them is a string operation somebody would otherwise write with `indexOf` and a guess
            // about which separator this machine uses.

            // The separator this platform writes. Reading either is always right -- `lastSep` takes
            // both -- but WRITING the wrong one produces a path that works until it is shown to a
            // person or handed to another program.
            public static method separator() returns String {
                return Machine.isWindows() ? "\\" : "/";
            }
            // Rooted rather than relative: a leading separator, or a drive letter on Windows. This is
            // the question behind "may I join this onto a base directory", and getting it wrong turns
            // a base into a prefix of nothing.
            public static method isAbsolute(String path) returns boolean {
                if (path.length() == 0) { return false; }
                if (path.charAt(0) == '/' || path.charAt(0) == '\\') { return true; }
                return path.length() > 2 && path.charAt(1) == ':' &&
                       (path.charAt(2) == '/' || path.charAt(2) == '\\');
            }
            // The name without its extension: "report.tar.gz" -> "report.tar". The LAST dot, so a
            // versioned name keeps its version, and a leading dot is a hidden file rather than an
            // empty name with an extension.
            public static method stem(String path) returns String {
                String base = Paths.basename(path);
                mutable int last = 0 - 1;
                for (mutable int i = 1; i < base.length(); i++) {
                    if (base.charAt(i) == '.') { last = i; }
                }
                return last < 0 ? base : base.substring(0, last);
            }
            // The same path with a different extension, given without the dot. An empty `ext`
            // removes it.
            public static method withExtension(String path, String ext) returns String {
                String dir = Paths.dirname(path);
                String name = ext.length() == 0 ? Paths.stem(path)
                                                : Paths.stem(path).concat(".").concat(ext);
                return dir.length() == 0 ? name : Paths.join(dir, name);
            }
            // Every component, separators of both kinds honoured, empty pieces dropped. What a
            // program walks when it wants to compare two paths component by component rather than as
            // strings -- which is the only way to compare them correctly.
            public static method split(String path) returns ArrayList<String> {
                ArrayList<String> parts = new ArrayList<String>() on heap;
                StringBuilder piece = new StringBuilder() on heap;
                for (mutable int i = 0; i < path.length(); i++) {
                    char c = path.charAt(i);
                    if (c == '/' || c == '\\') {
                        if (piece.length() > 0) { parts.add(piece.toString()); }
                        piece.clear();
                    } else {
                        piece.appendChar(c);
                    }
                }
                if (piece.length() > 0) { parts.add(piece.toString()); }
                return parts;
            }
            // `.` and `..` resolved, redundant separators dropped, WITHOUT asking the filesystem --
            // so it works on a path that does not exist yet, which is exactly when a program is
            // building one. A `..` that would climb past the root is dropped rather than kept: it
            // names nothing, and keeping it would let a joined path escape its base.
            public static method normalize(String path) returns String {
                ArrayList<String> parts = Paths.split(path);
                ArrayList<String> kept = new ArrayList<String>() on stack;
                kept.ensureCapacity(parts.size());   // `..` can only take segments away
                for (mutable int i = 0; i < parts.size(); i++) {
                    String p = parts.get(i);
                    if (p.equals(".")) { continue; }
                    if (p.equals("..")) {
                        if (kept.size() > 0 && !kept.get(kept.size() - 1).equals("..")) {
                            kept.removeAt(kept.size() - 1);
                        } else if (!Paths.isAbsolute(path)) {
                            kept.add(p);   // a relative path may legitimately begin above itself
                        }
                        continue;
                    }
                    kept.add(p);
                }
                StringBuilder out = new StringBuilder() on heap;
                if (Paths.isAbsolute(path) && path.charAt(0) != '/' && path.charAt(0) != '\\') {
                    out.append(path.substring(0, 2));   // the drive letter, which is not a component
                }
                for (mutable int i = 0; i < kept.size(); i++) {
                    if (i > 0 || Paths.isAbsolute(path)) { out.append(Paths.separator()); }
                    out.append(kept.get(i));
                }
                delete parts;
                String result = out.toString();
                return result.length() == 0 ? "." : result;
            }
            // Resolved against the working directory and against the filesystem -- links followed,
            // `..` collapsed as the operating system collapses it. Empty when the path cannot be
            // resolved, which on POSIX includes "it does not exist": `realpath` refuses to guess
            // about a component it cannot see. Use `normalize` for a path that is not there yet.
            public static method absolute(String path) returns String {
                return System.OS.__pathAbsolute(path);
            }
            // `path` written relative to `base`, or `path` unchanged when it is not underneath it.
            // What a tool prints: an error naming a file forty characters into a repository is read
            // by a person who already knows where the repository is.
            public static method relative(String base, String path) returns String {
                ArrayList<String> b = Paths.split(Paths.normalize(base));
                ArrayList<String> p = Paths.split(Paths.normalize(path));
                mutable int common = 0;
                while (common < b.size() && common < p.size() &&
                       b.get(common).equals(p.get(common))) {
                    common = common + 1;
                }
                StringBuilder out = new StringBuilder() on heap;
                if (common < b.size()) {
                    // Not underneath: climbing out of the base with `..` is correct but unreadable
                    // past a step or two, so the whole path is the more useful answer.
                    delete p;
                    delete b;
                    return path;
                }
                for (mutable int i = common; i < p.size(); i++) {
                    if (out.length() > 0) { out.append(Paths.separator()); }
                    out.append(p.get(i));
                }
                delete p;
                delete b;
                String result = out.toString();
                return result.length() == 0 ? "." : result;
            }
        }
        // A FILE READ ONE LINE AT A TIME, WITHOUT LOADING IT.
        //
        // `Files.readLines` reads the whole file into a String and then splits it into a list: a two
        // gigabyte log costs two gigabytes, and then two gigabytes again in pieces. That is fine for
        // a config file and impossible for the thing people actually process line by line, which is
        // a log. The distinction is not a nicety -- it is the difference between a program that runs
        // and one that is killed by the allocator.
        //
        //     mutable LineReader* lines = new LineReader(path) on heap;
        //     while (lines.hasNext()) { process(lines.next()); }
        //     delete lines;
        //
        // A fixed buffer is filled from the stream and lines are taken out of it; when it runs dry it
        // is filled again. Memory is the buffer, whatever the file's size. A line longer than the
        // buffer is returned in the pieces the buffer can hold, which is stated rather than hidden --
        // the alternative is growing without bound on a file whose first "line" is the whole thing.
        // `implements Iterator<String>` for free: `hasNext`/`next` are already exactly that
        // interface, so every generic algorithm written over an Iterator works on a file without
        // knowing it is one -- which is the point of having the interface at all.
        public class LineReader implements Iterator<String> {
            private mutable FileStream stream;
            private mutable unique Buffer* chunk;
            private mutable String held;      // bytes read but not yet returned as a line
            private mutable boolean drained;  // the stream reached its end

            public constructor LineReader(String path) {
                this.stream = FileStream.read(path);
                this.chunk = new Buffer(8192) on heap;
                this.held = "";
                this.drained = false;
            }
            public method isOpen() returns boolean { return this.stream.isOpen(); }

            // Pull one more chunk into `held`. False when there is nothing left to pull.
            private method fill() returns boolean {
                if (this.drained || !this.stream.isOpen()) { return false; }
                int n = this.stream.readBytes(this.chunk, 8192);
                if (n <= 0) {
                    this.drained = true;
                    return false;
                }
                StringBuilder more = new StringBuilder() on heap;
                more.append(this.held);
                for (mutable int i = 0; i < n; i++) {
                    more.appendChar(cast<char>(this.chunk.readByte(i)));
                }
                this.held = more.toString();
                return true;
            }

            // Whether another line is available -- which may require reading, so this is the method
            // that does the work and `next` merely takes what it prepared.
            public override method hasNext() returns boolean {
                while (this.held.indexOf("\n") < 0 && this.fill()) { }
                return this.held.length() > 0 || this.held.indexOf("\n") >= 0;
            }
            // The next line, without its newline. A trailing `\r` is dropped too, so a file written
            // on Windows and read on POSIX does not hand every line an invisible last character --
            // the commonest reason a comparison that looks right fails.
            public override method next() returns String {
                while (this.held.indexOf("\n") < 0 && this.fill()) { }
                int cut = this.held.indexOf("\n");
                mutable String line = "";
                if (cut < 0) {
                    line = this.held;               // the last line, with no newline after it
                    this.held = "";
                } else {
                    line = this.held.substring(0, cut);
                    this.held = this.held.substring(cut + 1, this.held.length());
                }
                if (line.length() > 0 && line.charAt(line.length() - 1) == cast<char>(13)) {
                    line = line.substring(0, line.length() - 1);
                }
                return line;
            }
            public method close() returns void {
                this.stream.close();
                return;
            }
            public destructor ~LineReader() returns void {
                this.stream.close();
                delete this.chunk;
            }
        }

        // WHAT CHANGED UNDER A DIRECTORY, between one look and the next.
        //
        // The three lists a watcher exists to produce, kept apart because a caller does different
        // things with each: a build recompiles what changed, drops what was removed, and indexes
        // what appeared.
        public class DirectoryChanges {
            public ArrayList<String> added;
            public ArrayList<String> removed;
            public ArrayList<String> changed;
            public constructor DirectoryChanges() {
                this.added = new ArrayList<String>() on heap;
                this.removed = new ArrayList<String>() on heap;
                this.changed = new ArrayList<String>() on heap;
            }
            public method any() returns boolean {
                return this.added.size() + this.removed.size() + this.changed.size() > 0;
            }
            public method count() returns int {
                return this.added.size() + this.removed.size() + this.changed.size();
            }
            public destructor ~DirectoryChanges() returns void {
                delete this.changed;
                delete this.removed;
                delete this.added;
            }
        }

        // WATCHING A DIRECTORY FOR CHANGES.
        //
        // BY COMPARING SNAPSHOTS, not by asking the kernel -- and that is a decision, so here is the
        // reasoning. Every platform has a native notifier and no two agree: ReadDirectoryChangesW,
        // inotify, FSEvents, kqueue. Four bodies of code with four sets of edge cases (inotify's
        // per-watch descriptors and its queue overflow; FSEvents' coalescing; ReadDirectoryChangesW's
        // buffer that silently drops events when it fills), of which exactly ONE can be run and
        // tested from here. A library whose behaviour differs per platform in ways nobody can
        // exercise is worse than one that behaves identically everywhere.
        //
        // A snapshot is a path and its (size, modification time). Diffing two of them gives the same
        // three answers with no platform code at all, and it is what a great many real build tools
        // do. What it costs is honest and worth stating: it sees changes when ASKED rather than when
        // they happen, it walks the tree each time, and a file changed twice within one clock tick
        // and back to the same size can slip past. For a build, a reloader, or a test runner --
        // which is what people watch directories for -- that is the right trade.
        //
        //     mutable DirectoryWatcher* w = new DirectoryWatcher(root) on heap;
        //     mutable DirectoryChanges c = w.poll();     // whatever moved since the last look
        public class DirectoryWatcher {
            private mutable String root;
            private mutable ArrayList<String> paths;
            private mutable ArrayList<String> marks;   // "<size>:<mtime>", parallel to `paths`

            // The first snapshot is taken here, so the first `poll` reports what changed since the
            // watcher was made rather than announcing every file as new.
            public constructor DirectoryWatcher(String root) {
                this.root = root;
                this.paths = new ArrayList<String>() on heap;
                this.marks = new ArrayList<String>() on heap;
                this.take();
            }

            private method take() returns void {
                this.paths.clear();
                this.marks.clear();
                ArrayList<String> found = Files.walk(this.root);
                for (mutable int i = 0; i < found.size(); i++) {
                    String p = found.get(i);
                    StringBuilder mark = new StringBuilder() on heap;
                    mark.appendLong(Files.size(p));
                    mark.append(":");
                    mark.appendLong(Files.modifiedAt(p));
                    this.paths.add(p);
                    this.marks.add(mark.toString());
                }
                delete found;
                return;
            }

            private method markOf(String path) returns String {
                int at = this.paths.indexOf(path);
                return at < 0 ? "" : this.marks.get(at);
            }

            // What moved since the last look. Takes a new snapshot, so two polls in a row report the
            // second as empty -- a change is reported ONCE, which is what a caller acting on it needs.
            public method poll() returns DirectoryChanges {
                DirectoryChanges changes = new DirectoryChanges() on heap;
                ArrayList<String> now = Files.walk(this.root);
                for (mutable int i = 0; i < now.size(); i++) {
                    String p = now.get(i);
                    String was = this.markOf(p);
                    if (was.length() == 0) {
                        changes.added.add(p);
                    } else {
                        StringBuilder mark = new StringBuilder() on heap;
                        mark.appendLong(Files.size(p));
                        mark.append(":");
                        mark.appendLong(Files.modifiedAt(p));
                        if (!mark.toString().equals(was)) { changes.changed.add(p); }
                    }
                }
                for (mutable int i = 0; i < this.paths.size(); i++) {
                    if (now.indexOf(this.paths.get(i)) < 0) {
                        changes.removed.add(this.paths.get(i));
                    }
                }
                delete now;
                this.take();
                return changes;
            }

            // How many files are being watched -- for a caller that wants to say so, and for a test
            // that wants to know the snapshot was taken at all.
            public method watching() returns int {
                return this.paths.size();
            }

            public destructor ~DirectoryWatcher() returns void {
                delete this.marks;
                delete this.paths;
            }
        }

        // A FILE THAT CLEANS ITSELF UP.
        //
        // Every program that writes a scratch file writes the same three things wrong: a name that
        // collides when two copies run at once, a directory that does not exist on the other
        // platform, and a delete that is skipped on the path where something failed -- which is the
        // path that matters, because that is when the file has something in it.
        //
        //     using (TempFile t = new TempFile("build") on stack) {
        //         Files.write(t.path(), text);
        //     }                      // gone here, whatever happened inside
        //
        // THE CONSTRUCTOR DOES THE WORK, and there is no `create` factory, because assignment here
        // is a COPY: a factory returning one by value would hand back a duplicate and destroy the
        // original -- deleting the file the caller had just been given. A resource whose lifetime is
        // its object's is built where the object is.
        //
        // The name carries the process id, so two runs cannot pick the same one, and a counter, so
        // one run asking twice cannot either.
        public class TempFile {
            private static mutable int counter = 0;
            private mutable String file;
            private mutable boolean kept;

            // In the platform's scratch directory, named after `prefix`. The file is CREATED here,
            // empty, so the name is taken -- choosing a name and creating it later is the race this
            // exists to close.
            public constructor TempFile(String prefix) {
                this.kept = false;
                this.file = "";
                TempFile.counter = TempFile.counter + 1;
                mutable int tries = 0;
                while (tries < 1000) {
                    StringBuilder name = new StringBuilder() on heap;
                    name.append(prefix);
                    name.append("-");
                    name.appendInt(cast<int>(Machine.processId()));
                    name.append("-");
                    name.appendInt(TempFile.counter + tries);
                    name.append(".tmp");
                    String candidate = Paths.join(Workspace.tempDirectory(), name.toString());
                    this.file = candidate;
                    if (!Files.exists(candidate)) {
                        Files.write(candidate, "");
                        tries = 1000;
                    } else {
                        tries = tries + 1;
                    }
                }
            }
            public method path() returns String { return this.file; }
            // Keep it after all -- for the failure a person is going to want to look at. The
            // destructor then leaves it alone.
            public method keep() returns void {
                this.kept = true;
                return;
            }
            public destructor ~TempFile() returns void {
                if (!this.kept) {
                    Files.delete(this.file);
                }
            }
        }

        // The same for a directory, contents and all. `deleteRecursively` on the way out, because a
        // scratch directory that is not empty is the ordinary case and an empty-only remove would
        // silently leave it behind.
        public class TempDirectory {
            private static mutable int counter = 0;
            private mutable String dir;
            private mutable boolean kept;

            public constructor TempDirectory(String prefix) {
                this.kept = false;
                this.dir = "";
                TempDirectory.counter = TempDirectory.counter + 1;
                mutable int tries = 0;
                while (tries < 1000) {
                    StringBuilder name = new StringBuilder() on heap;
                    name.append(prefix);
                    name.append("-");
                    name.appendInt(cast<int>(Machine.processId()));
                    name.append("-");
                    name.appendInt(TempDirectory.counter + tries);
                    String candidate = Paths.join(Workspace.tempDirectory(), name.toString());
                    this.dir = candidate;
                    if (!Files.exists(candidate)) {
                        Files.createDirectory(candidate);
                        tries = 1000;
                    } else {
                        tries = tries + 1;
                    }
                }
            }
            public method path() returns String { return this.dir; }
            public method keep() returns void {
                this.kept = true;
                return;
            }
            public destructor ~TempDirectory() returns void {
                if (!this.kept) {
                    Files.deleteRecursively(this.dir);
                }
            }
        }

        // Leveled logging to the console (spec 34): each message carries a level (debug/info/warn/error)
        // and is printed with the logger's name only when its level is at or above the configured minimum,
        // which starts at info. A quick way to get structured, filterable output without a framework.
        public class Logger {
            private mutable String name;
            private mutable int minLevel;
            public constructor Logger(String name) {
                this.name = name;
                this.minLevel = 1;
            }
            public method setLevel(int level) returns void {
                this.minLevel = level;
                return;
            }
            private method emit(String level, String message) returns void {
                System.IO.Console.printf("[%s] %s: %s\n", level, this.name, message);
                return;
            }
            public method debug(String message) returns void {
                if (this.minLevel <= 0) { this.emit("DEBUG", message); }
                return;
            }
            public method info(String message) returns void {
                if (this.minLevel <= 1) { this.emit("INFO", message); }
                return;
            }
            public method warn(String message) returns void {
                if (this.minLevel <= 2) { this.emit("WARN", message); }
                return;
            }
            public method error(String message) returns void {
                if (this.minLevel <= 3) { this.emit("ERROR", message); }
                return;
            }
        }
        // Reads a program's command-line arguments (spec 34): has tests for a flag, value returns the token
        // after a flag (empty if absent), and get/count index the raw arguments. Wraps the String[] handed
        // to main, so a program parses its options without scanning the array by hand.
        public class Args {
            private mutable String[] argv;
            public constructor Args(String[] argv) {
                this.argv = argv;
            }
            public method has(String flag) returns boolean {
                for (mutable int i = 0; i < this.argv.length(); i++) {
                    if (this.argv[i].equals(flag)) { return true; }
                }
                return false;
            }
            public method value(String flag) returns String {
                for (mutable int i = 0; i < this.argv.length(); i++) {
                    if (this.argv[i].equals(flag) && i + 1 < this.argv.length()) {
                        return this.argv[i + 1];
                    }
                }
                return "";
            }
            public method count() returns int { return this.argv.length(); }
            public method get(int i) returns String { return this.argv[i]; }
        }
    }
