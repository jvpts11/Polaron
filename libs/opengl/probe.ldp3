import System.IO.Console;

// LDP3-OpenGL slice 1 -- offscreen context probe.
// Stands up an OpenGL context on a hidden window entirely through FFI, clears the framebuffer to a
// known colour (LDP3 amber), and reads one pixel back with glReadPixels. If the pixel comes back amber,
// the whole offscreen path is validated: FFI into user32/gdi32/opengl32, the Win32 PIXELFORMATDESCRIPTOR
// layout, WGL context creation, and rendering with no visible window. Uses the built-in "STATIC" window
// class so no window class / WNDPROC callback is needed. Handles are passed as `long` (pointer-sized on
// x64). Fixed-function GL 1.1 only, so it runs on the headless GDI generic software renderer.

program GlProbe;

public bundle main {
    public namespace gl {

        // The Win32 pixel-format descriptor (40 bytes, natural alignment matches C).
        public struct PixelFormatDescriptor {
            public mutable short nSize;
            public mutable short nVersion;
            public mutable int dwFlags;
            public mutable byte iPixelType;
            public mutable byte cColorBits;
            public mutable byte cRedBits;      public mutable byte cRedShift;
            public mutable byte cGreenBits;    public mutable byte cGreenShift;
            public mutable byte cBlueBits;     public mutable byte cBlueShift;
            public mutable byte cAlphaBits;    public mutable byte cAlphaShift;
            public mutable byte cAccumBits;    public mutable byte cAccumRedBits;
            public mutable byte cAccumGreenBits; public mutable byte cAccumBlueBits;
            public mutable byte cAccumAlphaBits; public mutable byte cDepthBits;
            public mutable byte cStencilBits;  public mutable byte cAuxBuffers;
            public mutable byte iLayerType;    public mutable byte bReserved;
            public mutable int dwLayerMask;
            public mutable int dwVisibleMask;
            public mutable int dwDamageMask;
        }

        // One RGBA pixel read back from the framebuffer.
        public struct Pixel {
            public mutable byte r; public mutable byte g;
            public mutable byte b; public mutable byte a;
        }

        // FFI bindings (x64: stdcall == cdecl; symbols are undecorated). Handles are `long`.
        public class Win {
            public extern stdcall static method CreateWindowExA(int exStyle, string cls, string name,
                int style, int x, int y, int w, int h, long parent, long menu, long inst, long param)
                returns long;
            public extern stdcall static method GetDC(long hwnd) returns long;
        }
        public class Gdi {
            public extern stdcall static method ChoosePixelFormat(long hdc, PixelFormatDescriptor* pfd)
                returns int;
            public extern stdcall static method SetPixelFormat(long hdc, int fmt,
                PixelFormatDescriptor* pfd) returns int;
        }
        public class Gl {
            public extern stdcall static method wglCreateContext(long hdc) returns long;
            public extern stdcall static method wglMakeCurrent(long hdc, long ctx) returns int;
            public extern stdcall static method glClearColor(float r, float g, float b, float a)
                returns void;
            public extern stdcall static method glClear(int mask) returns void;
            public extern stdcall static method glFinish() returns void;
            public extern stdcall static method glReadPixels(int x, int y, int w, int h, int fmt,
                int typ, Pixel* data) returns void;
        }

        public class Main {
            public static method main(string[] args) returns void {
                // WS_OVERLAPPED = 0; the window is never shown. 64x64 is enough for the probe.
                long hwnd = Win.CreateWindowExA(0, "STATIC", "glprobe", 0, 0, 0, 64, 64, 0, 0, 0, 0);
                System.IO.Console.printf("hwnd != 0 ? %d\n", cast<int>(hwnd));
                long hdc = Win.GetDC(hwnd);

                PixelFormatDescriptor* pfd = new PixelFormatDescriptor() on heap;
                pfd.nSize = cast<short>(40);
                pfd.nVersion = cast<short>(1);
                pfd.dwFlags = 0x25;          // DRAW_TO_WINDOW | SUPPORT_OPENGL | DOUBLEBUFFER
                pfd.iPixelType = cast<byte>(0);   // PFD_TYPE_RGBA
                pfd.cColorBits = cast<byte>(32);
                pfd.cDepthBits = cast<byte>(24);
                pfd.iLayerType = cast<byte>(0);   // PFD_MAIN_PLANE

                int fmt = Gdi.ChoosePixelFormat(hdc, pfd);
                int setok = Gdi.SetPixelFormat(hdc, fmt, pfd);
                System.IO.Console.printf("pixelformat=%d setok=%d\n", fmt, setok);

                long ctx = Gl.wglCreateContext(hdc);
                int cur = Gl.wglMakeCurrent(hdc, ctx);
                System.IO.Console.printf("ctx != 0 ? %d  makecurrent=%d\n", cast<int>(ctx), cur);

                Gl.glClearColor(0.92, 0.63, 0.20, 1.0);   // LDP3 amber
                Gl.glClear(0x4000);                         // GL_COLOR_BUFFER_BIT
                Gl.glFinish();

                Pixel* px = new Pixel() on heap;
                // GL_RGB = 0x1907, GL_UNSIGNED_BYTE = 0x1401
                Gl.glReadPixels(0, 0, 1, 1, 0x1907, 0x1401, px);
                System.IO.Console.printf("pixel rgb = %d %d %d  (want ~235 161 51)\n",
                    cast<int>(px.r), cast<int>(px.g), cast<int>(px.b));
                return;
            }
        }
    }
}
