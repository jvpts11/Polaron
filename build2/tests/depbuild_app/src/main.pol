import System.IO.Console;
import mathlib.math.Calc;
program Consumer;
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int r = Calc.square(7);
                System.IO.Console.printf("square = %d\n", r);
                return;
            }
        }
    }
}
