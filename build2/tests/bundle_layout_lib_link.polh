program LayoutLib;

public bundle layoutlib {
    public namespace shapes {
        public layout Packed extends Object { }
        public struct Tick implements Packed {
            public mutable byte flag;
            public mutable int when;
            public mutable byte kind;
            public mutable int value;
            public method equalsKey(Tick other) returns boolean;
            public method hash() returns long;
            public method compareTo(Tick other) returns int;
        }
        public class Maker extends Object {
            public static method make() returns Tick;
        }
    }
}
