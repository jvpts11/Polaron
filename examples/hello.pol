// The classic hello world in Polaron.
//
// Build & run:  powershell -ExecutionPolicy Bypass -File scripts\run.ps1 examples\hello.pol

import System.IO.Console;

program Hello;

public bundle main {
    public namespace examples {
        public class Main {
            public static method main(string[] args) returns void {
                System.IO.Console.printf("Hello, world!\n");
                System.IO.Console.printf("This is Polaron, the beginning of something greater.\n");
            }
        }
    }
}
