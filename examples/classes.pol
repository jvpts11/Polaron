// Demonstrates Polaron's OOP core: classes, fields, a constructor with a parameter, a
// destructor (RAII), instance methods, a static method that takes objects as arguments,
// new on stack / on heap, and delete.
//
// Expected output:
//   transferred? 1
//   alice = 50
//   bob = 120
//   closing account with balance 120   <- delete bob (heap)
//   closing account with balance 50    <- end of main: alice (stack) is destroyed

import System.IO.Console;

program Classes;

public bundle main {
    public namespace examples {

        // A simple bank account.
        public class Account {
            private mutable int balance;

            public constructor Account(int initial) {
                this.balance = initial;
            }

            public method deposit(int amount) returns void {
                this.balance = this.balance + amount;
                return;
            }

            public method withdraw(int amount) returns boolean {
                if (amount > this.balance) {
                    return false;
                }
                this.balance = this.balance - amount;
                return true;
            }

            public method balanceOf() returns int {
                return this.balance;
            }

            public destructor ~Account() returns void {
                System.IO.Console.println($"closing account with balance {this.balance}");
            }
        }

        // A static utility: operates on two accounts, with no Bank instance.
        public class Bank {
            public static method transfer(Account from, Account to, int amount) returns boolean {
                if (from.withdraw(amount)) {
                    to.deposit(amount);
                    return true;
                }
                return false;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Account alice = new Account(100) on stack;  // destroyed at end of main
                Account bob = new Account(50) on heap;       // destroyed on delete

                alice.deposit(20);
                boolean ok = Bank.transfer(alice, bob, 70);

                System.IO.Console.println($"transferred? {ok}");
                System.IO.Console.println($"alice = {alice.balanceOf()}");
                System.IO.Console.println($"bob = {bob.balanceOf()}");

                delete bob;
                return;
            }
        }
    }
}
