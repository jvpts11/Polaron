// Control flow in LDP3: if/else, for, while.
//
// Run with:  powershell -ExecutionPolicy Bypass -File scripts\run.ps1 examples\control_flow.ldp3

import System.IO.Console;

program ControlFlow;

public bundle main {
    public namespace examples {
        public class Main {
            public static method main(string[] args) returns void {
                // if / else
                int n = 7;
                if (n % 2 == 0) {
                    System.IO.Console.printf("%d is even\n", n);
                } else {
                    System.IO.Console.printf("%d is odd\n", n);
                }

                // for loop: sum 1..5
                mutable int sum = 0;
                for (mutable int i = 1; i <= 5; i++) {
                    sum = sum + i;
                }
                System.IO.Console.printf("sum 1..5 = %d\n", sum);

                // while loop: countdown
                mutable int k = 3;
                while (k > 0) {
                    System.IO.Console.printf("k = %d\n", k);
                    k--;
                }
            }
        }
    }
}
