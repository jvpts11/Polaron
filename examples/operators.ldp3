// Operators and expressions in LDP3.
//
// Run with:  powershell -ExecutionPolicy Bypass -File scripts\run.ps1 examples\operators.ldp3

import System.IO.Console;

program Operators;

public bundle main {
    public namespace examples {
        public class Main {
            public static method main(string[] args) returns void {
                int a = 17;
                int b = 5;

                // Arithmetic, with precedence (* binds tighter than +).
                System.IO.Console.printf("a + b * 2 = %d\n", a + b * 2);
                System.IO.Console.printf("a divided by b = %d\n", a / b);
                System.IO.Console.printf("a modulo b = %d\n", a % b);

                // Comparison and logical operators produce booleans (printed as 0/1).
                boolean inRange = a > 10 && a < 20;
                System.IO.Console.printf("10 < a < 20 ? %d\n", inRange);
                System.IO.Console.printf("negation = %d\n", !inRange);

                // Increment / decrement.
                mutable int n = 0;
                n++;
                n++;
                System.IO.Console.printf("n after two ++ = %d\n", n);
            }
        }
    }
}
