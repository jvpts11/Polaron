program Car;

// Forma ergonômica (sem cerimônia):
//   - 'new Carro(...)' sem 'on stack/heap' -> default stack (RAII, sem delete)
//   - System.IO.println -> quebra de linha automática (sem \n no fim)
// Quando você precisa do "canhão" (controle manual de heap), aí sim escreve
// 'on heap' + 'delete' — veja examples/classes.ldp3.

public bundle main {
    public namespace main {
        public class Carro {
            private int pneus = 4;
            private int portas = 4;
            private mutable boolean isRunning = false;

            public constructor Carro(boolean isRunning) {
                this.isRunning = isRunning;
                System.IO.println("Constructor called!");
            }

            public method getState() returns boolean {
                return this.isRunning;
            }

            public method setBoolean(boolean state) returns void {
                this.isRunning = state;
                System.IO.println("Setted state for isRunning!");
                return;
            }
        }

        public class Main {
            public static method main(string[] args) returns void {
                Carro carro1 = new Carro(false);   // sem cerimônia: default stack

                System.IO.println($"Carro1 state: {carro1.getState()}");
                carro1.setBoolean(true);
                System.IO.println($"Carro1 state after setting: {carro1.getState()}");

                return;   // carro1 (stack) é liberado automaticamente no fim do escopo
            }
        }
    }
}
