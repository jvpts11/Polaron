// I/O in LDP3: System.IO.Console.printf is a C-style formatter. The FIRST argument is
// always a LITERAL string (the "format"). Printing plain text is just a string with no
// specifiers. To print values, they go into the format: %d (int/boolean), %c (char),
// with the escapes \n and \t.

import System.IO.Console;

program IO;

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                // 1) Plain text, no specifiers: perfectly fine.
                System.IO.Console.printf("Hello, world!\n");

                // 2) Text with one value interpolated through the format.
                System.IO.Console.printf("Sum: %d\n", 2 + 3);

                // 3) A char with %c and the \t (tab) escape.
                System.IO.Console.printf("Letter:\t%c\n", 'A');

                return;
            }
        }
    }
}
