// A minimal bootable Polaron kernel (spec 36.9). Freestanding: no managed runtime, no heap -- it writes a
// message straight to the VGA text buffer at 0xB8000 (each cell is a 16-bit value: low byte the ASCII
// character, high byte the colour attribute) and then halts. The boot stub (boot.s) sets up long mode and
// calls the entry; the codegen emits a no-argv `kmain` for a bare-metal target so nothing needs libc.
program Kernel freestanding;

public bundle main {
    public namespace kernel {
        public class Main {
            public static method main(string[] args) returns void {
                int16* vga = cast<int16*>(0xB8000);
                int attr = 3840;   // 0x0F00: bright white on black, in the high byte
                // "Polaron kernel OK" -- 17 cells. The decompiler's `harness_kern` reads these cells back
                // out of VGA memory and compares them, so this text, its LENGTH, and the harness must
                // move together. (The rename to Polaron changed all three: it is three characters longer
                // than the name that was here before.)
                vga[0]  = cast<int16>(80 + attr);   // P
                vga[1]  = cast<int16>(111 + attr);  // o
                vga[2]  = cast<int16>(108 + attr);  // l
                vga[3]  = cast<int16>(97 + attr);   // a
                vga[4]  = cast<int16>(114 + attr);  // r
                vga[5]  = cast<int16>(111 + attr);  // o
                vga[6]  = cast<int16>(110 + attr);  // n
                vga[7]  = cast<int16>(32 + attr);   // (space)
                vga[8]  = cast<int16>(107 + attr);  // k
                vga[9]  = cast<int16>(101 + attr);  // e
                vga[10] = cast<int16>(114 + attr);  // r
                vga[11] = cast<int16>(110 + attr);  // n
                vga[12] = cast<int16>(101 + attr);  // e
                vga[13] = cast<int16>(108 + attr);  // l
                vga[14] = cast<int16>(32 + attr);   // (space)
                vga[15] = cast<int16>(79 + attr);   // O
                vga[16] = cast<int16>(75 + attr);   // K
                while (true) { }   // nothing more to do: spin forever
                return;
            }
        }
    }
}
