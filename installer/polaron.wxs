<?xml version="1.0" encoding="UTF-8"?>
<!-- The Polaron toolchain installer (WiX 4+). Builds a self-contained .msi: the bundled compiler + linker +
     CRT/import libs mean Polaron compiles on a bare Windows 10/11 x64 machine. Three selectable features:
     the compiler (required), the polaron-studio TUI, and installing the VS Code extension. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Polaron Toolchain" Manufacturer="Joao Victor Pereira Tavares"
           Version="1.0.131.0" UpgradeCode="7f3a1c9e-2b4d-4e6a-9f10-3c5d7e8a1b20"
           Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Polaron is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="PolaronIco" SourceFile="../branding/icon.ico" />
    <Icon Id="PolaronFileIco" SourceFile="../branding/file-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PolaronIco" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Polaron" />
    </StandardDirectory>

    <!-- Features the user can select in the wizard. -->
    <Feature Id="Compiler" Title="Compiler and toolchain (required)"
             Description="polaron, polc, the language server, a self-contained clang/lld/CRT, and the lldb-dap debugger (with its Python runtime) so Polaron builds and debugs with no other tools installed."
             Level="1" AllowAbsent="no" TypicalDefault="install">
      <ComponentGroupRef Id="CoreFiles" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="FileAssociation" />
    </Feature>
    <Feature Id="Tui" Title="Project manager (polaron-studio TUI)"
             Description="The terminal project/environment manager, launched with 'polaron studio'."
             Level="1">
      <ComponentGroupRef Id="TuiFiles" />
    </Feature>
    <Feature Id="VsCode" Title="Install the VS Code extension"
             Description="Copies the Polaron VS Code extension and registers it in this machine's VS Code (needs 'code' on PATH)."
             Level="1">
      <ComponentGroupRef Id="VsCodeFiles" />
      <ComponentRef Id="VsCodeInstall" />
    </Feature>

    <!-- Core toolchain files (compiler, driver, LSP, clang/lld, runtime lib, DLLs and lib\). -->
    <ComponentGroup Id="CoreFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\stage\core\**" />
    </ComponentGroup>

    <!-- The TUI is a separate component so it can be omitted. -->
    <ComponentGroup Id="TuiFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\stage\tui\**" />
    </ComponentGroup>

    <!-- The VS Code extension files, plus a component that registers it in VS Code on demand. -->
    <ComponentGroup Id="VsCodeFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\stage\vscode\**" Subdirectory="vscode" />
    </ComponentGroup>
    <Component Id="VsCodeInstall" Directory="INSTALLFOLDER" Guid="a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d">
      <File Id="InstallVsCodeCmd" Source="install-vscode.cmd" Name="install-vscode.cmd" />
    </Component>

    <!-- Register the .pol extension so source files carry the lattice mark in Explorer. -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER" Guid="c3d4e5f6-7a8b-4c9d-0e1f-2a3b4c5d6e7f">
      <File Id="PolaronFileIcoFile" Source="../branding/file-icon.ico" Name="polaron-file.ico" />
      <ProgId Id="Polaron.SourceFile" Description="Polaron source file" Icon="PolaronFileIcoFile">
        <Extension Id="polaron" ContentType="text/x-polaron" />
      </ProgId>
    </Component>

    <!-- Put the install directory on the system PATH (a single component owns the change). -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER" Guid="b2c3d4e5-6f70-4b8c-9d0e-1f2a3b4c5d6e">
      <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last"
                   System="yes" Permanent="no" />
    </Component>

    <!-- Run the VS Code extension install after files are laid down, only if that feature is selected;
         Return='ignore' so a machine without VS Code still installs cleanly. -->
    <CustomAction Id="RunInstallVsCode" Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]install-vscode.cmd&quot; &quot;[INSTALLFOLDER]vscode&quot;"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RunInstallVsCode" After="InstallFiles" Condition="&amp;VsCode=3" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_FeatureTree" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" />
  </Package>
</Wix>
