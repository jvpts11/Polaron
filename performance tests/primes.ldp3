program Primes;

// Sieve of Eratosthenes up to N, counting primes. Integer work + a large array (memory
// bandwidth / cache). `sieve[i]` true means composite.

public bundle main {
    import System.IO.Console;
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 20000000;
                boolean[] sieve = new boolean[n]();
                mutable int count = 0;
                for (mutable int i = 2; i < n; i++) {
                    if (sieve[i] == false) {
                        count = count + 1;
                        for (mutable int j = i + i; j < n; j = j + i) {
                            sieve[j] = true;
                        }
                    }
                }
                System.IO.Console.printf("primes=%d\n", count);
                delete sieve;
                return;
            }
        }
    }
}
