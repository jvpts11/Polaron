import System.IO.Console;
program QuickSort;

// In-place quicksort (Hoare partition, middle pivot) of N ints filled by an LCG. Recursion,
// branch-heavy comparisons, and memory traffic. Arrays pass by reference in LDP3, so the
// sort mutates in place across recursive calls.

public bundle main {
    public namespace app {
        public class Main {
            public static method qsort(int[] a, int lo, int hi) returns void {
                if (lo >= hi) {
                    return;
                }
                int pivot = a[(lo + hi) / 2];
                mutable int i = lo;
                mutable int j = hi;
                while (i <= j) {
                    while (a[i] < pivot) {
                        i = i + 1;
                    }
                    while (a[j] > pivot) {
                        j = j - 1;
                    }
                    if (i <= j) {
                        int tmp = a[i];
                        a[i] = a[j];
                        a[j] = tmp;
                        i = i + 1;
                        j = j - 1;
                    }
                }
                Main.qsort(a, lo, j);
                Main.qsort(a, i, hi);
            }
            public static method main(string[] args) returns void {
                int n = 5000000;
                int[] a = new int[n]();
                mutable uint32 s = cast<uint32>(12345);
                for (mutable int k = 0; k < n; k++) {
                    s = s * 1103515245 + 12345;
                    a[k] = cast<int>(s >> 16);
                }
                Main.qsort(a, 0, n - 1);
                mutable int acc = 0;
                for (mutable int k = 0; k < n; k = k + 1000) {
                    acc = (acc + a[k]) % 1000000007;
                }
                System.IO.Console.printf("checksum=%d\n", acc);
                delete a;
                return;
            }
        }
    }
}
