import System.IO.Console;
program MonteCarlo;

// Monte Carlo pi estimation: N random points, count those inside the unit quarter-circle
// (x^2 + y^2 <= 1, no sqrt needed). A uint32 LCG drives it -- integer + FP throughput. The
// `inside` count is exact and identical across languages (same LCG).

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 50000000;
                mutable uint32 s = cast<uint32>(12345);
                mutable int inside = 0;
                for (mutable int i = 0; i < n; i++) {
                    s = s * 1103515245 + 12345;
                    double x = cast<double>(s >> 16) / 65536.0;
                    s = s * 1103515245 + 12345;
                    double y = cast<double>(s >> 16) / 65536.0;
                    if (x * x + y * y <= 1.0) {
                        inside = inside + 1;
                    }
                }
                System.IO.Console.printf("inside=%d\n", inside);
                return;
            }
        }
    }
}
