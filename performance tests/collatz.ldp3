import System.IO.Console;
program Collatz;

// Longest Collatz chain for starting values below N. Integer work, heavy branching, and
// long arithmetic (3x+1 can exceed 32 bits mid-sequence).

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 1000000;
                mutable int maxLen = 0;
                mutable int maxStart = 0;
                long one = cast<long>(1);
                long two = cast<long>(2);
                long three = cast<long>(3);
                long zero = cast<long>(0);
                for (mutable int start = 1; start < n; start++) {
                    mutable long x = cast<long>(start);
                    mutable int len = 0;
                    while (x != one) {
                        if (x % two == zero) {
                            x = x / two;
                        } else {
                            x = three * x + one;
                        }
                        len = len + 1;
                    }
                    if (len > maxLen) {
                        maxLen = len;
                        maxStart = start;
                    }
                }
                System.IO.Console.printf("maxLen=%d maxStart=%d\n", maxLen, maxStart);
                return;
            }
        }
    }
}
