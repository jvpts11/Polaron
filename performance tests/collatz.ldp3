program Collatz;

// Longest Collatz chain for starting values below N. Integer work, heavy branching, and
// int64 arithmetic (3x+1 can exceed 32 bits mid-sequence).

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 1000000;
                mutable int maxLen = 0;
                mutable int maxStart = 0;
                int64 one = cast<int64>(1);
                int64 two = cast<int64>(2);
                int64 three = cast<int64>(3);
                int64 zero = cast<int64>(0);
                for (mutable int start = 1; start < n; start++) {
                    mutable int64 x = cast<int64>(start);
                    mutable int len = 0;
                    while (x != one) {
                        if (x % two == zero) {
                            x = x / two;
                        } else {
                            x = three * x + one;
                        }
                        len = len + 1;
                    }
                    if (len > maxLen) {
                        maxLen = len;
                        maxStart = start;
                    }
                }
                System.IO.printf("maxLen=%d maxStart=%d\n", maxLen, maxStart);
                return;
            }
        }
    }
}
