import System.IO.Console;
import System.Collections.ArrayList;
import System.Collections.HashMap;
program Collections;

// The two containers every program reaches for: a growable list and a hash map. Fills, looks up,
// and checksums. C++'s std::vector / std::unordered_map are the reference.

public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 20000000;
                ArrayList<int>* list = new ArrayList<int>() on heap;
                for (mutable int i = 0; i < n; i++) {
                    list.add(i * 3 % 1000);
                }
                mutable int acc = 0;
                for (mutable int i = 0; i < n; i++) {
                    acc = (acc + list.get(i)) % 1000000007;
                }
                HashMap<int, int>* map = new HashMap<int, int>() on heap;
                for (mutable int i = 0; i < 4000000; i++) {
                    map.put(i, i * 7);
                }
                for (mutable int i = 0; i < 4000000; i++) {
                    acc = (acc + map.get(i)) % 1000000007;
                }
                System.IO.Console.printf("acc=%d size=%d\n", acc, list.size());
                delete list;
                delete map;
                return;
            }
        }
    }
}
