import System.IO.Console;
program PrimesTrial;

// Trial-division prime count, mirroring the reference C program exactly:
//   isPrime(n): for i in 2..n/2, if n % i == 0 return false; else true
//   count primes in [2, 250000]  ->  expected 22044
// "brute compute" version: raw loops, static methods, no stdlib collections.

public bundle main {
    public namespace app {
        public class Main {

            public static method isPrime(int n) returns boolean {
                for (mutable int i = 2; i <= n / 2; i++) {
                    if (n % i == 0) {
                        return false;
                    }
                }
                return true;
            }

            public static method main(string[] args) returns void {
                mutable int numPrimes = 0;
                for (mutable int i = 2; i < 250001; i++) {
                    if (Main.isPrime(i)) {
                        numPrimes = numPrimes + 1;
                    }
                }
                System.IO.Console.printf("%d\n", numPrimes);
                return;
            }
        }
    }
}
