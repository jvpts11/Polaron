import System.IO.Console;
import System.Collections.ArrayList;
program CollList;
// Só a ArrayList.
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int n = 20000000;
                ArrayList<int>* list = new ArrayList<int>() on heap;
                for (mutable int i = 0; i < n; i++) { list.add(i * 3 % 1000); }
                mutable int acc = 0;
                for (mutable int i = 0; i < n; i++) { acc = (acc + list.get(i)) % 1000000007; }
                System.IO.Console.printf("acc=%d size=%d\n", acc, list.size());
                delete list;
                return;
            }
        }
    }
}
