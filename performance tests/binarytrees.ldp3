import System.IO.Console;
program BinaryTrees;

// Allocation churn: build, check, and free perfect binary trees of a given depth, many
// times. Millions of new/delete -- stresses the allocator and pointer chasing.

public bundle main {
    public namespace app {
        public class Tree {
            public mutable Tree* left;
            public mutable Tree* right;
            public constructor Tree() {
                this.left = null;
                this.right = null;
            }
        }
        public class Main {
            public static method make(int depth) returns Tree* {
                Tree* t = new Tree() on heap;
                if (depth > 0) {
                    t.left = Main.make(depth - 1);
                    t.right = Main.make(depth - 1);
                }
                return t;
            }
            public static method check(Tree* t) returns int {
                if (t.left == null) {
                    return 1;
                }
                return 1 + Main.check(t.left) + Main.check(t.right);
            }
            public static method free(Tree* t) returns void {
                if (t.left != null) {
                    Main.free(t.left);
                    Main.free(t.right);
                }
                delete t;
            }
            public static method main(string[] args) returns void {
                int depth = 18;
                mutable int total = 0;
                for (mutable int i = 0; i < 30; i++) {
                    Tree* t = Main.make(depth);
                    total = total + Main.check(t);
                    Main.free(t);
                }
                System.IO.Console.printf("nodes=%d\n", total);
                return;
            }
        }
    }
}
