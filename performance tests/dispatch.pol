import System.IO.Console;
program Dispatch;

// A BYTECODE INTERPRETER'S INNER LOOP, which is where a closed `switch` actually lives.
//
// The construct the language recommends for a closed set is `switch` over an enum or a small
// integer, and the shape that exercises it is not a `switch` somewhere in a program -- it is a
// `switch` that runs tens of millions of times on a subject nothing can know in advance. So this
// is a tiny stack machine with a sixty-four opcode instruction set, run to a fixed budget.
//
// FOUR THINGS ABOUT THIS FILE ARE THE MEASUREMENT AND NOT THE PROGRAM, and each of them was got
// wrong first, so each is written down.
//
// 1. THE OPCODE STREAM IS GENERATED, NOT CYCLIC. The first version stepped through a fixed
//    twenty-four-slot program in a ring, which makes every branch in the dispatch PERFECTLY
//    predictable: a compare chain then costs almost nothing, because the processor has seen the
//    same outcomes a million times and never takes a misprediction. That is not what an interpreter
//    does. A linear congruential step picks each opcode here, so the dispatch is as unpredictable
//    as a real instruction stream and a chain pays for its depth.
//
// 2. THE ARMS DO NOT ALL DO THE SAME THING. With every arm `acc + <constant>`, the closed set is a
//    MAPPING and not a dispatch: LLVM turns it into one load from a constant array, or -- if the
//    constants happen to be an arithmetic progression, which the second version's were -- into
//    `acc += op + 1` with no branch and no table at all. Either way what is being measured is
//    constant folding. Eight different operations cycle through the arms below, so no table of
//    values can stand in for the arms and the dispatch has to actually happen.
//
// 3. THERE ARE SIXTY-FOUR OF THEM, and that is above a threshold rather than a round number. Below
//    roughly forty arms, LLVM's own simplification recovers a `switch` out of a compare chain and
//    both lowerings produce the same machine code -- 8, 16 and 24 arms measured exactly equal.
//    Above it the recovery stops and the chain stays a chain, which is where the difference is.
//    A benchmark at twenty-four arms would have reported, correctly and uselessly, that emitting a
//    `switch` changes nothing.
//
// 4. THE TWO ARMS OF A COMPARISON MUST PRINT THE SAME NUMBER. Every operation here is on values the
//    program already has, in a fixed order, so a lowering change cannot move the answer. A
//    benchmark whose answer changes between arms is not a benchmark, it is two benchmarks.
//
// Prints:
//   acc=... steps=... other=0
public bundle main {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                int steps = 20000000;

                mutable long acc = cast<long>(1);
                mutable long seed = cast<long>(12345);
                mutable int taken = 0;

                for (mutable int i = 0; i < steps; i++) {
                    // Knuth's LCG, then the top bits -- the low bits of an LCG cycle short, and a
                    // dispatch driven by them would be predictable again by another route.
                    seed = seed * cast<long>(6364136223846793005) + cast<long>(1442695040888963407);
                    mutable int op = cast<int>((seed >> 33) % cast<long>(64));
                    if (op < 0) {
                        op = op + 64;
                    }
                    switch (op) {
                        case 0  { acc = acc + cast<long>(2373);                              break; }
                        case 1  { acc = acc - cast<long>(4508);                              break; }
                        case 2  { acc = acc ^ cast<long>(6643);                              break; }
                        case 3  { acc = acc * cast<long>(6);                                 break; }
                        case 4  { acc = acc | cast<long>(940);                               break; }
                        case 5  { acc = (acc >> cast<long>(6)) + cast<long>(3075);           break; }
                        case 6  { acc = acc & cast<long>(36471);                             break; }
                        case 7  { acc = acc / cast<long>(4) + cast<long>(7345);              break; }
                        case 8  { acc = acc + cast<long>(9480);                              break; }
                        case 9  { acc = acc - cast<long>(1642);                              break; }
                        case 10 { acc = acc ^ cast<long>(3777);                              break; }
                        case 11 { acc = acc * cast<long>(13);                                break; }
                        case 12 { acc = acc | cast<long>(8047);                              break; }
                        case 13 { acc = (acc >> cast<long>(7)) + cast<long>(209);            break; }
                        case 14 { acc = acc & cast<long>(16409);                             break; }
                        case 15 { acc = acc / cast<long>(2) + cast<long>(4479);              break; }
                        case 16 { acc = acc + cast<long>(6614);                              break; }
                        case 17 { acc = acc - cast<long>(8749);                              break; }
                        case 18 { acc = acc ^ cast<long>(911);                               break; }
                        case 19 { acc = acc * cast<long>(7);                                 break; }
                        case 20 { acc = acc | cast<long>(5181);                              break; }
                        case 21 { acc = (acc >> cast<long>(1)) + cast<long>(7316);           break; }
                        case 22 { acc = acc & cast<long>(66158);                             break; }
                        case 23 { acc = acc / cast<long>(5) + cast<long>(1613);              break; }
                        case 24 { acc = acc + cast<long>(3748);                              break; }
                        case 25 { acc = acc - cast<long>(5883);                              break; }
                        case 26 { acc = acc ^ cast<long>(8018);                              break; }
                        case 27 { acc = acc * cast<long>(14);                                break; }
                        case 28 { acc = acc | cast<long>(2315);                              break; }
                        case 29 { acc = (acc >> cast<long>(2)) + cast<long>(4450);           break; }
                        case 30 { acc = acc & cast<long>(46096);                             break; }
                        case 31 { acc = acc / cast<long>(3) + cast<long>(8720);              break; }
                        case 32 { acc = acc + cast<long>(882);                               break; }
                        case 33 { acc = acc - cast<long>(3017);                              break; }
                        case 34 { acc = acc ^ cast<long>(5152);                              break; }
                        case 35 { acc = acc * cast<long>(10);                                break; }
                        case 36 { acc = acc | cast<long>(9422);                              break; }
                        case 37 { acc = (acc >> cast<long>(3)) + cast<long>(1584);           break; }
                        case 38 { acc = acc & cast<long>(26034);                             break; }
                        case 39 { acc = acc / cast<long>(6) + cast<long>(5854);              break; }
                        case 40 { acc = acc + cast<long>(7989);                              break; }
                        case 41 { acc = acc - cast<long>(151);                               break; }
                        case 42 { acc = acc ^ cast<long>(2286);                              break; }
                        case 43 { acc = acc * cast<long>(4);                                 break; }
                        case 44 { acc = acc | cast<long>(6556);                              break; }
                        case 45 { acc = (acc >> cast<long>(4)) + cast<long>(8691);           break; }
                        case 46 { acc = acc & cast<long>(5972);                              break; }
                        case 47 { acc = acc / cast<long>(4) + cast<long>(2988);              break; }
                        case 48 { acc = acc + cast<long>(5123);                              break; }
                        case 49 { acc = acc - cast<long>(7258);                              break; }
                        case 50 { acc = acc ^ cast<long>(9393);                              break; }
                        case 51 { acc = acc * cast<long>(11);                                break; }
                        case 52 { acc = acc | cast<long>(3690);                              break; }
                        case 53 { acc = (acc >> cast<long>(5)) + cast<long>(5825);           break; }
                        case 54 { acc = acc & cast<long>(55721);                             break; }
                        case 55 { acc = acc / cast<long>(2) + cast<long>(122);               break; }
                        case 56 { acc = acc + cast<long>(2257);                              break; }
                        case 57 { acc = acc - cast<long>(4392);                              break; }
                        case 58 { acc = acc ^ cast<long>(6527);                              break; }
                        case 59 { acc = acc * cast<long>(7);                                 break; }
                        case 60 { acc = acc | cast<long>(824);                               break; }
                        case 61 { acc = (acc >> cast<long>(6)) + cast<long>(2959);           break; }
                        case 62 { acc = acc & cast<long>(35659);                             break; }
                        case 63 { acc = acc / cast<long>(5) + cast<long>(7229);              break; }
                        default { taken = taken + 1; }
                    }
                }

                System.IO.Console.printf("acc=%lld steps=%d other=%d\n", acc, steps, taken);
                return;
            }
        }
    }
}
