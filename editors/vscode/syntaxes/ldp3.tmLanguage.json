{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LDP3",
  "scopeName": "source.ldp3",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#declarations" },
    { "include": "#operators" },
    { "include": "#type-names" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.ldp3",
          "begin": "///",
          "end": "$",
          "patterns": [{ "match": "\\S", "name": "comment.block.documentation.ldp3" }]
        },
        {
          "name": "comment.line.double-slash.ldp3",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.ldp3",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.ldp3",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ldp3", "match": "\\\\." },
            {
              "name": "meta.interpolation.ldp3",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.ldp3" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.ldp3" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.ldp3",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.ldp3", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.ldp3",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.ldp3", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.ldp3", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.ldp3", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.octal.ldp3", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.float.ldp3", "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][-+]?[0-9]+)?[fmd]?\\b" },
        { "name": "constant.numeric.integer.ldp3", "match": "\\b[0-9][0-9_]*[fmdlL]?\\b" }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.ldp3",
          "match": "\\[\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.annotation.ldp3" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ldp3",
          "match": "\\b(if|else|while|do|for|switch|match|case|default|break|continue|return|yield|try|catch|finally|throw|throws|goto|comefrom|abstainfrom|reinstate|step|defer|using|await|async|synchronized|expecting|onFailure)\\b"
        },
        {
          "name": "storage.modifier.ldp3",
          "match": "\\b(public|private|protected|internal|static|abstract|final|override|mutable|nullable|sealed|permits|var|move|movable|unique|partitionable|extern|cdecl|stdcall|fastcall|freestanding|persistent|eternal|transient|comptime|literal|fixed|volatile|cascade|lazy|external|release|reimport|unimport|requires|ensures|invariant|static_assert|extends|implements)\\b"
        },
        {
          "name": "keyword.operator.word.ldp3",
          "match": "\\b(new|delete|on|in|is|as|cast|of|accepts|rejects)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.ldp3",
          "match": "\\b(program|bundle|namespace|class|interface|struct|record|union|enum|catalog|byCatalog|method|operator|constructor|destructor|returns|import|annotation|typealias|newtype|region|label|lambda|function|methodref)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ldp3",
          "match": "\\b(void|boolean|char|string|String|int8|int16|int32|int64|int|uint8|uint16|uint32|uint64|short|long|byte|float32|float64|float|double|Decimal)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.ldp3", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.ldp3", "match": "\\b(this|super|itself)\\b" }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "match": "\\b(class|interface|enum|struct|record|extends|implements|new)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ldp3" },
            "2": { "name": "entity.name.type.ldp3" }
          }
        },
        {
          "match": "\\b(method|constructor|destructor)\\s+(~?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ldp3" },
            "2": { "name": "entity.name.function.ldp3" }
          }
        },
        { "name": "entity.name.type.ldp3", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.ldp3" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ldp3",
          "match": "(\\+\\+|--|->|=>|\\.\\.=|\\.\\.|&&|\\|\\||==|!=|<=|>=|<<|>>|[-+*/%<>=!&|^~?:])"
        }
      ]
    }
  }
}
