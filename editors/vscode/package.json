{
  "name": "ldp3",
  "displayName": "LDP3",
  "description": "Language support and project tooling for LDP3.",
  "version": "0.1.0",
  "publisher": "ldp3",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ldp3",
    "onView:ldp3Projects"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Editing, syntax, formatting and building work in untrusted folders. The toolchain comes from your installed LDP3, not the workspace; the compiler/LSP path settings are ignored in untrusted folders so a workspace cannot redirect the toolchain to another binary.",
      "restrictedConfigurations": [
        "ldp3.path",
        "ldp3.compilerPath",
        "ldp3.lspPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ldp3",
        "aliases": [
          "LDP3",
          "ldp3"
        ],
        "extensions": [
          ".ldp3"
        ],
        "icon": {
          "light": "./media/file-icon-light.svg",
          "dark": "./media/file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ldp3",
        "scopeName": "source.ldp3",
        "path": "./syntaxes/ldp3.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "ldp3.build", "title": "LDP3: Build", "category": "LDP3" },
      { "command": "ldp3.run", "title": "LDP3: Run", "category": "LDP3" },
      { "command": "ldp3.test", "title": "LDP3: Test", "category": "LDP3" },
      { "command": "ldp3.doc", "title": "LDP3: Generate Docs", "category": "LDP3" },
      { "command": "ldp3.fmt", "title": "LDP3: Format Project", "category": "LDP3" },
      { "command": "ldp3.new", "title": "LDP3: New Project", "category": "LDP3" },
      { "command": "ldp3.dashboard", "title": "LDP3: Open Studio Dashboard", "category": "LDP3", "icon": "$(dashboard)" },
      { "command": "ldp3.refresh", "title": "Refresh", "category": "LDP3", "icon": "$(refresh)" },
      { "command": "ldp3.tree.build", "title": "Build", "category": "LDP3", "icon": "$(tools)" },
      { "command": "ldp3.tree.run", "title": "Run", "category": "LDP3", "icon": "$(play)" },
      { "command": "ldp3.tree.test", "title": "Test", "category": "LDP3", "icon": "$(beaker)" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ldp3",
          "title": "LDP3",
          "icon": "media/ldp3.svg"
        }
      ]
    },
    "views": {
      "ldp3": [
        { "id": "ldp3Projects", "name": "Projects" },
        { "id": "ldp3Environments", "name": "Environments" },
        { "id": "ldp3Libraries", "name": "Libraries" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "ldp3.dashboard", "when": "view == ldp3Projects", "group": "navigation@1" },
        { "command": "ldp3.refresh", "when": "view == ldp3Projects", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "ldp3.tree.run", "when": "view == ldp3Projects && viewItem == ldp3Project", "group": "inline@1" },
        { "command": "ldp3.tree.build", "when": "view == ldp3Projects && viewItem == ldp3Project", "group": "inline@2" },
        { "command": "ldp3.tree.test", "when": "view == ldp3Projects && viewItem == ldp3Project", "group": "1_run@1" }
      ]
    },
    "configuration": {
      "title": "LDP3",
      "properties": {
        "ldp3.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ldp3 CLI. When empty, the extension uses the repo build output if present, otherwise 'ldp3' from PATH."
        },
        "ldp3.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ldp3c compiler. When empty, the extension uses the repo build output if present, otherwise 'ldp3c' from PATH."
        },
        "ldp3.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ldp3-lsp language server. When empty, the extension uses the repo build output if present, otherwise 'ldp3-lsp' from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[ldp3]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0"
  }
}
