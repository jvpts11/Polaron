{
  "name": "polaron",
  "displayName": "Polaron",
  "description": "Language support and project tooling for Polaron.",
  "version": "0.2.0",
  "publisher": "polaron",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:polaron",
    "onView:polaronProjects"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Editing, syntax, formatting and building work in untrusted folders. The toolchain comes from your installed Polaron, not the workspace; the compiler/LSP path settings are ignored in untrusted folders so a workspace cannot redirect the toolchain to another binary.",
      "restrictedConfigurations": [
        "polaron.path",
        "polaron.compilerPath",
        "polaron.lspPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "polaron",
        "aliases": [
          "Polaron",
          "polaron"
        ],
        "extensions": [
          ".pol"
        ],
        "icon": {
          "light": "./media/file-icon-light.svg",
          "dark": "./media/file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "polaron",
        "scopeName": "source.pol",
        "path": "./syntaxes/polaron.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "polaron.build", "title": "Polaron: Build", "category": "Polaron" },
      { "command": "polaron.run", "title": "Polaron: Run", "category": "Polaron" },
      { "command": "polaron.test", "title": "Polaron: Test", "category": "Polaron" },
      { "command": "polaron.doc", "title": "Polaron: Generate Docs", "category": "Polaron" },
      { "command": "polaron.fmt", "title": "Polaron: Format Project", "category": "Polaron" },
      { "command": "polaron.new", "title": "Polaron: New Project", "category": "Polaron" },
      { "command": "polaron.dashboard", "title": "Polaron: Open Studio Dashboard", "category": "Polaron", "icon": "$(dashboard)" },
      { "command": "polaron.refresh", "title": "Refresh", "category": "Polaron", "icon": "$(refresh)" },
      { "command": "polaron.tree.build", "title": "Build", "category": "Polaron", "icon": "$(tools)" },
      { "command": "polaron.tree.run", "title": "Run", "category": "Polaron", "icon": "$(play)" },
      { "command": "polaron.tree.test", "title": "Test", "category": "Polaron", "icon": "$(beaker)" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "polaron",
          "title": "Polaron",
          "icon": "media/polaron.svg"
        }
      ]
    },
    "views": {
      "polaron": [
        { "id": "polaronProjects", "name": "Projects" },
        { "id": "polaronEnvironments", "name": "Environments" },
        { "id": "polaronLibraries", "name": "Libraries" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "polaron.dashboard", "when": "view == polaronProjects", "group": "navigation@1" },
        { "command": "polaron.refresh", "when": "view == polaronProjects", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "polaron.tree.run", "when": "view == polaronProjects && viewItem == polaronProject", "group": "inline@1" },
        { "command": "polaron.tree.build", "when": "view == polaronProjects && viewItem == polaronProject", "group": "inline@2" },
        { "command": "polaron.tree.test", "when": "view == polaronProjects && viewItem == polaronProject", "group": "1_run@1" }
      ]
    },
    "configuration": {
      "title": "Polaron",
      "properties": {
        "polaron.path": {
          "type": "string",
          "default": "",
          "description": "Path to the polaron CLI. When empty, the extension uses the repo build output if present, otherwise 'polaron' from PATH."
        },
        "polaron.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the polc compiler. When empty, the extension uses the repo build output if present, otherwise 'polc' from PATH."
        },
        "polaron.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the polaron-lsp language server. When empty, the extension uses the repo build output if present, otherwise 'polaron-lsp' from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[polaron]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0"
  }
}
