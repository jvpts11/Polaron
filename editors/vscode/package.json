{
  "name": "ldp3",
  "displayName": "LDP3",
  "description": "Language support and project tooling for LDP3.",
  "version": "0.1.0",
  "publisher": "ldp3",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ldp3"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ldp3",
        "aliases": [
          "LDP3",
          "ldp3"
        ],
        "extensions": [
          ".ldp3"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ldp3",
        "scopeName": "source.ldp3",
        "path": "./syntaxes/ldp3.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "ldp3.build", "title": "LDP3: Build", "category": "LDP3" },
      { "command": "ldp3.run", "title": "LDP3: Run", "category": "LDP3" },
      { "command": "ldp3.test", "title": "LDP3: Test", "category": "LDP3" },
      { "command": "ldp3.doc", "title": "LDP3: Generate Docs", "category": "LDP3" },
      { "command": "ldp3.fmt", "title": "LDP3: Format Project", "category": "LDP3" },
      { "command": "ldp3.new", "title": "LDP3: New Project", "category": "LDP3" }
    ],
    "configuration": {
      "title": "LDP3",
      "properties": {
        "ldp3.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ldp3 CLI. When empty, the extension uses the repo build output if present, otherwise 'ldp3' from PATH."
        },
        "ldp3.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ldp3c compiler. When empty, the extension uses the repo build output if present, otherwise 'ldp3c' from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[ldp3]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0"
  }
}
